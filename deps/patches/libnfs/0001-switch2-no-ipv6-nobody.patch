diff --git a/lib/switch2_compat.h b/lib/switch2_compat.h
new file mode 100644
index 0000000..bc3dfc5
--- /dev/null
+++ b/lib/switch2_compat.h
@@ -0,0 +1,17 @@
+/* Switch 2 (Kodi port): what libnfs expects from Linux headers that newlib/libounce do not give
+ * the same way. Force-included into every libnfs source (deps/build-deps.sh build_libnfs). */
+#ifndef LIBNFS_SWITCH2_COMPAT_H
+#define LIBNFS_SWITCH2_COMPAT_H
+#include <sys/types.h>
+#include <time.h>
+#include <utime.h>      /* struct utimbuf (its header needs time_t first) */
+#include <arpa/inet.h>  /* htonl/ntohl: libounce has them here only, not in <netinet/in.h> */
+#include <netinet/in.h>
+#ifndef SOL_TCP
+#define SOL_TCP IPPROTO_TCP
+#endif
+#ifndef major
+#define major(dev) ((unsigned int)(((dev) >> 8) & 0xfff))
+#define minor(dev) ((unsigned int)(((dev) & 0xff) | (((dev) >> 12) & 0xfff00)))
+#endif
+#endif
