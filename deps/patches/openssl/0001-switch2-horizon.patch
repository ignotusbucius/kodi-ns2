diff -ru a/crypto/armcap.c b/crypto/armcap.c
--- a/crypto/armcap.c	2026-11-20 18:53:10.078233307 +0200
+++ b/crypto/armcap.c	2026-11-20 18:56:10.418513865 +0200
@@ -24,7 +24,37 @@
 unsigned int OPENSSL_arm_midr = 0;
 unsigned int OPENSSL_armv8_rsa_neonized = 0;
 
-#if __ARM_MAX_ARCH__ < 7
+#if defined(__SWITCH__) && __ARM_MAX_ARCH__ >= 7
+/*
+ * Horizon (libnx/libounce) has no getauxval(), no sigsetjmp() and no SIGILL
+ * delivery, so probing would kill the process. On Switch 2 hardware the first
+ * ARMv8-crypto SHA-256 digest killed the process: advertise NEON only.
+ * MIDR_EL1 is not readable from EL0, so ARMV8_CPUID and the A72/N1 RSA
+ * tuning stay off. OPENSSL_armcap is honoured as on other platforms.
+ */
+uint32_t OPENSSL_rdtsc(void)
+{
+    return 0;
+}
+
+void OPENSSL_cpuid_setup(void) __attribute__((constructor));
+void OPENSSL_cpuid_setup(void)
+{
+    const char *e;
+    static int trigger = 0;
+
+    if (trigger)
+        return;
+    trigger = 1;
+
+    if ((e = getenv("OPENSSL_armcap")) != NULL) {
+        OPENSSL_armcap_P = (unsigned int)strtoul(e, NULL, 0);
+        return;
+    }
+    /* No ARMV8_AES/PMULL/SHA1/SHA256: see above (Kodi rev 16 nettest). */
+    OPENSSL_armcap_P = ARMV7_NEON;
+}
+#elif __ARM_MAX_ARCH__ < 7
 void OPENSSL_cpuid_setup(void)
 {
 }
