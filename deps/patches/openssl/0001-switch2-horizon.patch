diff -ru a/providers/implementations/rands/seeding/rand_unix.c b/providers/implementations/rands/seeding/rand_unix.c
--- a/providers/implementations/rands/seeding/rand_unix.c	2026-11-20 18:53:10.072611236 +0200
+++ b/providers/implementations/rands/seeding/rand_unix.c	2026-11-20 18:53:10.101396803 +0200
@@ -355,6 +355,18 @@
      * Note: Sometimes getentropy() can be provided but not implemented
      * internally. So we need to check errno for ENOSYS
      */
+#if defined(__SWITCH__)
+    /*
+     * Horizon (libnx/libounce): newlib's getentropy() has no _getentropy_r
+     * backend and there is no /dev/urandom. randomGet() is the kernel CSPRNG.
+     */
+    {
+        extern void randomGet(void *buf, size_t len);
+
+        randomGet(buf, buflen);
+        return (ssize_t)buflen;
+    }
+#endif
 #if !defined(__DragonFly__) && !defined(__NetBSD__)
