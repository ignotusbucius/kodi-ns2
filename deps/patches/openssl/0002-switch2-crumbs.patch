diff --git a/include/internal/switch2_crumb.h b/include/internal/switch2_crumb.h
new file mode 100644
index 0000000..2e38323
--- /dev/null
+++ b/include/internal/switch2_crumb.h
@@ -0,0 +1,19 @@
+/*
+ * Switch 2 (Kodi port) source breadcrumbs. Switch2OsslCrumb is a weak reference: Kodi defines it
+ * (xbmc/platform/switch2/OsslTrace.cpp, which logs only while its trace window is armed); in any
+ * other link it is NULL and S2CRUMB does nothing, so the library builds and links standalone.
+ */
+#ifndef OSSL_INTERNAL_SWITCH2_CRUMB_H
+# define OSSL_INTERNAL_SWITCH2_CRUMB_H
+# include <stdint.h>
+
+extern void Switch2OsslCrumb(const char *where, uintptr_t a, uintptr_t b)
+    __attribute__((weak));
+
+# define S2CRUMB(w, a, b) \
+    do { \
+        if (Switch2OsslCrumb) \
+            Switch2OsslCrumb((w), (uintptr_t)(a), (uintptr_t)(b)); \
+    } while (0)
+
+#endif
