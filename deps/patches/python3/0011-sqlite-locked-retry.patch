+/* First step of a freshly bound statement: retried on SQLITE_LOCKED on Switch 2 (util.h).
+   Later steps (rows already returned) use stmt_step() and are never retried. */
+static inline int
+stmt_step_first(sqlite3_stmt *statement)
+{
+    int rc;
+
+    Py_BEGIN_ALLOW_THREADS
+    rc = pysqlite_step_retry(statement);
+    Py_END_ALLOW_THREADS
+
+    return rc;
+}
