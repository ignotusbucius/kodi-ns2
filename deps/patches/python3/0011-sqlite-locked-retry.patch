diff --git a/Modules/_sqlite/util.h b/Modules/_sqlite/util.h
index a22bcd8..0d4b76c 100644
--- a/Modules/_sqlite/util.h
+++ b/Modules/_sqlite/util.h
@@ -37,4 +37,56 @@ int _pysqlite_seterror(pysqlite_state *state, sqlite3 *db);
 
 sqlite_int64 _pysqlite_long_as_int64(PyObject * value);
 
+/* Switch 2 (Kodi port): Kodi enables SQLite's process-wide shared cache (a second open of a file
+ * that is open for writing fails on this file system), so every connection of the process, the
+ * add-ons' included, shares one cache per database file. A table or schema held by another
+ * connection is then reported as SQLITE_LOCKED / SQLITE_LOCKED_SHAREDCACHE, for which SQLite never
+ * calls the busy handler (Connection timeout= covers only SQLITE_BUSY). These wrappers retry such a
+ * prepare or first step with a bounded backoff (1 ms doubling to 50 ms, about 2 s in all), as
+ * Kodi's own ExecRetry (xbmc/dbwrappers/sqlitedataset.cpp) does. Call them with the GIL released.
+ * pysqlite_step_retry() is only used for a statement's FIRST step (no row returned yet): it resets
+ * the statement (bindings are kept) before stepping again. On other platforms both are the plain
+ * SQLite calls. */
+#ifdef __SWITCH__
+static inline int
+pysqlite_locked_backoff(int rc, int *waited_ms, int *step_ms)
+{
+    if ((rc & 0xff) != SQLITE_LOCKED || *waited_ms >= 2000) {
+        return 0;
+    }
+    sqlite3_sleep(*step_ms);
+    *waited_ms += *step_ms;
+    *step_ms = *step_ms < 50 ? *step_ms * 2 : 50;
+    return 1;
+}
+#endif
+
+static inline int
+pysqlite_prepare_retry(sqlite3 *db, const char *sql, int nbyte,
+                       sqlite3_stmt **stmt, const char **tail)
+{
+    int rc = sqlite3_prepare_v2(db, sql, nbyte, stmt, tail);
+#ifdef __SWITCH__
+    int waited_ms = 0, step_ms = 1;
+    while (pysqlite_locked_backoff(rc, &waited_ms, &step_ms)) {
+        rc = sqlite3_prepare_v2(db, sql, nbyte, stmt, tail);
+    }
+#endif
+    return rc;
+}
+
+static inline int
+pysqlite_step_retry(sqlite3_stmt *stmt)
+{
+    int rc = sqlite3_step(stmt);
+#ifdef __SWITCH__
+    int waited_ms = 0, step_ms = 1;
+    while (pysqlite_locked_backoff(rc, &waited_ms, &step_ms)) {
+        (void)sqlite3_reset(stmt);
+        rc = sqlite3_step(stmt);
+    }
+#endif
+    return rc;
+}
+
 #endif
