diff --git a/Python/thread_pthread.h b/Python/thread_pthread.h
index ddc28c4..346eb4a 100644
--- a/Python/thread_pthread.h
+++ b/Python/thread_pthread.h
@@ -67,6 +67,14 @@
 #undef  THREAD_STACK_SIZE
 #define THREAD_STACK_SIZE       0x100000
 #endif
+/* Switch 2 (libounce/newlib): a thread created with attributes but no stack
+   size gets 128 KiB, which deep C recursion (re, json, pickle, ElementTree)
+   overflows. Kodi's own default is 1 MiB (PosixCompat.cpp __wrap_pthread_create);
+   Python threads get 2 MiB. threading.stack_size() can still change it. */
+#if defined(__SWITCH__) && defined(THREAD_STACK_SIZE) && THREAD_STACK_SIZE == 0
+#undef  THREAD_STACK_SIZE
+#define THREAD_STACK_SIZE       0x200000
+#endif
 /* for safety, ensure a viable minimum stacksize */
 #define THREAD_STACK_MIN        0x8000  /* 32 KiB */
 #else  /* !_POSIX_THREAD_ATTR_STACKSIZE */
