diff --git a/xbmc/platform/switch2/StartupProbe.cpp b/xbmc/platform/switch2/StartupProbe.cpp
new file mode 100644
index 0000000..c5f794d
--- /dev/null
+++ b/xbmc/platform/switch2/StartupProbe.cpp
@@ -0,0 +1,234 @@
+/*
+ *  Copyright (C) 2026 Team Kodi
+ *  This file is part of Kodi - https://kodi.tv
+ *
+ *  SPDX-License-Identifier: GPL-2.0-or-later
+ *  See LICENSES/README.md for more information.
+ */
+
+// Switch 2 sqlite set-up, run before Kodi: shared-cache mode (this FS refuses a second open of a
+// file that is open for writing), and sqlite's own error log to sdmc:/switch/kodi/sqlite.log
+// (capped; LOCKED/BUSY, which Kodi's wrapper retries, are not logged). One summary line goes to
+// sdmc:/switch/kodi/boot.txt. Build with -DSWITCH2_STARTUP_PROBE=1 for the rev 4-9 bring-up probe
+// of the FS and sqlite (touches only sdmc:/switch/kodi/probe*.bin|db, removed again).
+
+#include "StartupProbe.h"
+
+#include "PosixCompat.h"
+
+#include <atomic>
+#include <cerrno>
+#include <cstdarg>
+#include <cstdio>
+#include <cstring>
+#include <initializer_list>
+#include <fcntl.h>
+#include <sys/stat.h>
+#include <unistd.h>
+
+#include <sqlite3.h>
+#include <switch.h>
+
+#ifndef SWITCH2_STARTUP_PROBE
+#define SWITCH2_STARTUP_PROBE 0
+#endif
+
+namespace
+{
+// Formats one "<ms> ..." line and appends it with the shared raw writer (Switch2RawAppend), the
+// single writer path for boot.txt; `file` is an fs path under /switch/kodi/.
+void Line(const char* file, const char* fmt, ...)
+{
+  char line[512];
+  int n = snprintf(line, sizeof(line), "%llu ",
+                   static_cast<unsigned long long>(armTicksToNs(armGetSystemTick()) / 1000000ULL));
+  if (n < 0)
+    return;
+  va_list ap;
+  va_start(ap, fmt);
+  const int m = vsnprintf(line + n, sizeof(line) - static_cast<size_t>(n) - 1, fmt, ap);
+  va_end(ap);
+  if (m > 0)
+    n += m;
+  if (n > static_cast<int>(sizeof(line)) - 2)
+    n = static_cast<int>(sizeof(line)) - 2;
+  line[n++] = '\n';
+  Switch2RawAppend(file, line, static_cast<unsigned long>(n));
+}
+
+constexpr const char* BOOT = "/switch/kodi/boot.txt";
+constexpr const char* SQLLOG = "/switch/kodi/sqlite.log";
+
+std::atomic<int> g_sqliteLogLines{0};
+
+void SqliteLog(void*, int code, const char* msg)
+{
+  // LOCKED/BUSY are retried by Kodi's wrapper (sqlitedataset.cpp) and would flood the log.
+  const int primary = code & 0xff;
+  if (primary == SQLITE_LOCKED || primary == SQLITE_BUSY)
+    return;
+  if (g_sqliteLogLines.fetch_add(1) >= 200)
+    return;
+  Line(SQLLOG, "sqlite rc=%d %s", code, msg ? msg : "");
+}
+
+#if SWITCH2_STARTUP_PROBE
+
+long long FdSize(int fd)
+{
+  struct stat st;
+  return fstat(fd, &st) == 0 ? static_cast<long long>(st.st_size) : -1;
+}
+
+void RawFileProbe()
+{
+  const char* path = "/switch/kodi/probe.bin";
+  unlink(path);
+  char page[4096];
+  int fd = open(path, O_RDWR | O_CREAT, 0644);
+  Line(BOOT, "fs open-create fd=%d errno=%d", fd, fd < 0 ? errno : 0);
+  if (fd < 0)
+    return;
+  memset(page, 'B', sizeof(page));
+  off_t o = lseek(fd, 4096, SEEK_SET);
+  ssize_t w = write(fd, page, sizeof(page));
+  Line(BOOT, "fs write-past-eof lseek=%lld write=%zd errno=%d size=%lld", (long long)o, w, w < 0 ? errno : 0, FdSize(fd));
+  memset(page, 'A', sizeof(page));
+  o = lseek(fd, 0, SEEK_SET);
+  w = write(fd, page, sizeof(page));
+  Line(BOOT, "fs write-at-0 lseek=%lld write=%zd size=%lld", (long long)o, w, FdSize(fd));
+  char buf[16] = {};
+  o = lseek(fd, 4096, SEEK_SET);
+  ssize_t r = read(fd, buf, sizeof(buf));
+  Line(BOOT, "fs read-4096 lseek=%lld read=%zd first='%c'", (long long)o, r, r > 0 ? buf[0] : '?');
+  o = lseek(fd, 8192, SEEK_SET);
+  r = read(fd, buf, sizeof(buf));
+  Line(BOOT, "fs read-at-eof lseek=%lld read=%zd errno=%d", (long long)o, r, r < 0 ? errno : 0);
+  // Linux returns 0 for a read past EOF; sqlite relies on that (journal header probe).
+  errno = 0;
+  o = lseek(fd, 12288, SEEK_SET);
+  r = read(fd, buf, sizeof(buf));
+  Line(BOOT, "fs read-past-eof lseek=%lld read=%zd errno=%d", (long long)o, r, r < 0 ? errno : 0);
+  int t = ftruncate(fd, 4096);
+  Line(BOOT, "fs ftruncate-4096 rc=%d size=%lld", t, FdSize(fd));
+  int s = fsync(fd);
+  Line(BOOT, "fs fsync rc=%d errno=%d", s, s < 0 ? errno : 0);
+  close(fd);
+  struct stat st;
+  int st_rc = stat(path, &st);
+  Line(BOOT, "fs stat-after-close rc=%d size=%lld", st_rc, st_rc == 0 ? (long long)st.st_size : -1LL);
+  fd = open(path, O_RDWR);
+  Line(BOOT, "fs reopen-rdwr fd=%d size=%lld", fd, fd >= 0 ? FdSize(fd) : -1LL);
+  if (fd >= 0)
+    close(fd);
+  // Fresh 0-byte files: fstat right after create, and a sqlite-journal-like name.
+  for (const char* p : {"/switch/kodi/probe-fresh.bin", "/switch/kodi/probe.db-journal"})
+  {
+    unlink(p);
+    errno = 0;
+    int f2 = open(p, O_RDWR | O_CREAT, 0644);
+    struct stat s2;
+    errno = 0;
+    int frc = f2 >= 0 ? fstat(f2, &s2) : -2;
+    int ferr = errno;
+    errno = 0;
+    int src = stat(p, &s2);
+    Line(BOOT, "fs fresh %s fd=%d fstat=%d errno=%d stat=%d errno=%d", p, f2, frc, ferr, src, errno);
+    if (f2 >= 0)
+      close(f2);
+    unlink(p);
+  }
+  // Second open of a file that is open O_RDWR (expected refused on this FS).
+  {
+    const char* p = "/switch/kodi/probe-twice.bin";
+    unlink(p);
+    int a = open(p, O_RDWR | O_CREAT, 0644);
+    errno = 0;
+    int b = open(p, O_RDWR);
+    int berr = errno;
+    errno = 0;
+    int c = open(p, O_RDONLY);
+    Line(BOOT, "fs twice first=%d second-rdwr=%d errno=%d second-rdonly=%d errno=%d", a, b, berr, c, errno);
+    if (c >= 0)
+      close(c);
+    if (b >= 0)
+      close(b);
+    if (a >= 0)
+      close(a);
+    unlink(p);
+  }
+  int missing = open("/switch/kodi/probe-missing.bin", O_RDWR);
+  Line(BOOT, "fs open-missing-no-creat fd=%d errno=%d", missing, missing < 0 ? errno : 0);
+  if (missing >= 0)
+    close(missing);
+  Line(BOOT, "fs unlink rc=%d", unlink(path));
+}
+
+void SqliteProbe()
+{
+  const char* path = "/switch/kodi/probe.db";
+  // Leftovers from a probe that crashed would make every later probe report BUSY.
+  rmdir("/switch/kodi/probe.db.lock");
+  unlink("/switch/kodi/probe.db-journal");
+  unlink(path);
+  sqlite3* db = nullptr;
+  int rc = sqlite3_open_v2(path, &db, SQLITE_OPEN_READWRITE | SQLITE_OPEN_CREATE, nullptr);
+  Line(BOOT, "sql open rc=%d vfs=%s", rc, sqlite3_vfs_find(nullptr) ? sqlite3_vfs_find(nullptr)->zName : "?");
+  if (rc == SQLITE_OK)
+  {
+    // Same order as Kodi's create path (SqliteDatabase::exists, Database.cpp Connect), then a table.
+    const char* steps[] = {"PRAGMA empty_result_callbacks=ON", "SELECT * FROM sqlite_master",
+                           "PRAGMA page_size=4096", "PRAGMA default_cache_size=4096",
+                           "CREATE TABLE t(a INTEGER, b TEXT)", "INSERT INTO t VALUES(1,'one')",
+                           "PRAGMA cache_size=4096", "PRAGMA synchronous='NORMAL'",
+                           "SELECT count(*) FROM t"};
+    for (const char* sql : steps)
+    {
+      char* err = nullptr;
+      rc = sqlite3_exec(db, sql, nullptr, nullptr, &err);
+      Line(BOOT, "sql '%s' rc=%d ext=%d syserr=%d %s", sql, rc, sqlite3_extended_errcode(db),
+           sqlite3_system_errno(db), err ? err : "");
+      sqlite3_free(err);
+    }
+  }
+  // Second connection to the same open database (shared cache on).
+  {
+    sqlite3* db2 = nullptr;
+    int rc2o = sqlite3_open_v2(path, &db2, SQLITE_OPEN_READWRITE | SQLITE_OPEN_CREATE, nullptr);
+    char* e2 = nullptr;
+    int rc2s = rc2o == SQLITE_OK ? sqlite3_exec(db2, "SELECT count(*) FROM t", nullptr, nullptr, &e2) : -1;
+    Line(BOOT, "sql second-connection open rc=%d select rc=%d %s", rc2o, rc2s, e2 ? e2 : "");
+    sqlite3_free(e2);
+    sqlite3_close(db2);
+  }
+  sqlite3_close(db);
+  struct stat st;
+  int st_rc = stat(path, &st);
+  Line(BOOT, "sql file-size-after-close rc=%d size=%lld", st_rc, st_rc == 0 ? (long long)st.st_size : -1LL);
+  db = nullptr;
+  rc = sqlite3_open_v2(path, &db, SQLITE_OPEN_READWRITE, nullptr);
+  char* err = nullptr;
+  int rc2 = rc == SQLITE_OK ? sqlite3_exec(db, "SELECT count(*) FROM t", nullptr, nullptr, &err) : -1;
+  Line(BOOT, "sql reopen rc=%d select rc=%d %s", rc, rc2, err ? err : "");
+  sqlite3_free(err);
+  sqlite3_close(db);
+  Line(BOOT, "sql unlink rc=%d", unlink(path));
+}
+#endif // SWITCH2_STARTUP_PROBE
+} // namespace
+
+void Switch2StartupProbe()
+{
+  // Must run before any other sqlite call (sqlite3_config is only valid before initialisation).
+  const int logRc = sqlite3_config(SQLITE_CONFIG_LOG, SqliteLog, nullptr);
+  // This FS refuses a second open of a file that is open for writing (rev 7 flight: Kodi's second
+  // connection to Addons33.db got SQLITE_CANTOPEN). Shared-cache mode makes all connections to one
+  // database file in this process share a single pager and file handle.
+  const int sharedRc = sqlite3_enable_shared_cache(1);
+#if SWITCH2_STARTUP_PROBE
+  RawFileProbe();
+  SqliteProbe();
+#endif
+  Line(BOOT, "sqlite %s threadsafe=%d config_log=%d shared_cache=%d probe=%d", sqlite3_libversion(),
+       sqlite3_threadsafe(), logRc, sharedRc, SWITCH2_STARTUP_PROBE);
+}
