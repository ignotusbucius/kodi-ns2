+
+extern "C" int __real_pthread_create(pthread_t*, const pthread_attr_t*, void* (*)(void*), void*);
+
+#if SWITCH2_DIAG
+// Diagnostics build only (ENABLE_SWITCH2_DIAG): counters for the memory monitor (main.cpp), one
+// boot.txt line per created thread, and start/exit lines for CPython's threads.
+std::atomic<long> g_switch2ThreadsCreated{0};
+std::atomic<long> g_switch2PyThreadsLive{0};
+
+namespace
+{
+// CPython creates its threads with an attribute whose stack size is THREAD_STACK_SIZE (0x200000,
+// deps/patches/python3/0004); nothing else in kodi.bin asks for exactly that. Those threads get a
+// trampoline that logs one boot.txt line when they start and when their start routine returns
+// (CPython 3.11 threads return from pythread_wrapper; nothing in kodi.bin calls pthread_exit).
+constexpr size_t kPyThreadStack = 0x200000;
+
+struct PyStart
+{
+  void* (*start)(void*);
+  void* arg;
+};
+
+void* PyThreadTrampoline(void* p)
+{
+  PyStart s = *static_cast<PyStart*>(p);
+  std::free(p);
+  u64 tid = 0;
+  svcGetThreadId(&tid, CUR_THREAD_HANDLE);
+  const long live = g_switch2PyThreadsLive.fetch_add(1) + 1;
+  Switch2BootLog("pythread-start tid", static_cast<long long>(tid));
+  Switch2BootLog("pythread-live", live);
+  void* rv = s.start(s.arg);
+  g_switch2PyThreadsLive.fetch_sub(1);
+  Switch2BootLog("pythread-exit tid", static_cast<long long>(tid));
+  return rv;
+}
+
+// "<ms> THREAD create rc=.. stack=<bytes> start=<off> lr=<off>" (offsets from the image base;
+// stack = the attribute's size, or the 1 MiB default applied here).
+void ThreadCreateLog(int rc, size_t stack, void* (*start)(void*), uintptr_t lr)
+{
+  const unsigned long long base = Switch2TextBase();
+  const uintptr_t s = reinterpret_cast<uintptr_t>(start);
+  char line[200];
+  const int n = snprintf(line, sizeof(line), "%llu THREAD create rc=%d stack=%zu start=0x%llx lr=0x%llx\n",
+                         static_cast<unsigned long long>(armTicksToNs(armGetSystemTick()) / 1000000ULL),
+                         rc, stack, static_cast<unsigned long long>(s >= base ? s - base : s),
+                         static_cast<unsigned long long>(lr >= base ? lr - base : lr));
+  if (n > 0)
+    Switch2RawAppend("/switch/kodi/boot.txt", line,
+                     static_cast<size_t>(n) < sizeof(line) ? static_cast<size_t>(n) : sizeof(line) - 1);
+}
+} // namespace
+#endif // SWITCH2_DIAG
+
+namespace
+{
+int CreateThread(pthread_t* thread, const pthread_attr_t* attr, void* (*start)(void*), void* arg)
+{
+#if SWITCH2_DIAG
+  g_switch2ThreadsCreated.fetch_add(1, std::memory_order_relaxed);
+#endif
+  if (attr)
+  {
+#if SWITCH2_DIAG
+    size_t stack = 0;
+    if (pthread_attr_getstacksize(attr, &stack) == 0 && stack == kPyThreadStack)
+    {
+      if (auto* p = static_cast<PyStart*>(std::malloc(sizeof(PyStart))))
+      {
+        p->start = start;
+        p->arg = arg;
+        const int rc = __real_pthread_create(thread, attr, PyThreadTrampoline, p);
+        if (rc != 0)
+        {
+          std::free(p);
+          Switch2BootLog("pythread-create-failed rc", rc);
+        }
+        return rc;
+      }
+    }
+#endif
+    return __real_pthread_create(thread, attr, start, arg);
+  }
+  pthread_attr_t big;
+  pthread_attr_init(&big);
+  pthread_attr_setstacksize(&big, 1u << 20);
+  const int rc = __real_pthread_create(thread, &big, start, arg);
+  pthread_attr_destroy(&big);
+  return rc;
+}
+} // namespace
+
+extern "C" int __wrap_pthread_create(pthread_t* thread,
+                                     const pthread_attr_t* attr,
+                                     void* (*start)(void*),
+                                     void* arg)
+{
+  const int rc = CreateThread(thread, attr, start, arg);
+#if SWITCH2_DIAG
+  size_t stack = 1u << 20;
+  if (attr)
+    pthread_attr_getstacksize(attr, &stack);
+  ThreadCreateLog(rc, stack, start, reinterpret_cast<uintptr_t>(__builtin_return_address(0)));
+#endif
+  return rc;
+}
+
+// pthread_detach() wrapper (linked with -Wl,--wrap=pthread_detach, see Install.cmake).
+// libounce links no __syscall_thread_detach, so pthread_detach() always returns ENOSYS and
+// std::thread::detach() throws std::system_error; CThread's autodelete path detaches its own
+// thread inside a noexcept destructor -> std::terminate (rev 8 crash ~30 s after the home screen,
+// finding 1499). Here "detach" hands the thread to a reaper that joins it once it has exited,
+// which is what frees its stack and handle on this platform.
+#include <condition_variable>
+#include <deque>
+#include <mutex>
+
+namespace
+{
+std::mutex g_reapMutex;
+std::condition_variable g_reapCv;
+std::deque<pthread_t> g_reapQueue;
+bool g_reaperRunning = false;
+
+void* Reaper(void*)
+{
+  for (;;)
+  {
+    pthread_t t;
+    {
+      std::unique_lock<std::mutex> lock(g_reapMutex);
+      g_reapCv.wait(lock, [] { return !g_reapQueue.empty(); });
+      t = g_reapQueue.front();
+      g_reapQueue.pop_front();
+    }
+    pthread_join(t, nullptr); // waits until t has really exited; the reaper never queues itself
+  }
+  return nullptr;
+}
+
+void StartReaper()
+{
+  pthread_attr_t attr;
+  pthread_attr_init(&attr);
+  pthread_attr_setstacksize(&attr, 64 * 1024);
+  pthread_t reaper;
+  const int rc = __real_pthread_create(&reaper, &attr, Reaper, nullptr);
+  pthread_attr_destroy(&attr);
+  g_reaperRunning = rc == 0;
+  // Without a reaper, detached threads are never joined (their stacks and handles leak), but
+  // detach still succeeds: failing it would bring back the std::terminate of finding 1499.
+#if SWITCH2_DIAG
+  Switch2BootLog(rc == 0 ? "reaper-started" : "reaper-pthread_create-failed", rc);
+#else
+  if (rc != 0)
+    Switch2BootLog("reaper-pthread_create-failed", rc);
+#endif
+}
+} // namespace
+
+extern "C" int __wrap_pthread_detach(pthread_t thread)
+{
+  static std::once_flag once;
+  std::call_once(once, StartReaper);
+  if (!g_reaperRunning)
+    return 0;
+  {
+    std::lock_guard<std::mutex> lock(g_reapMutex);
+    g_reapQueue.push_back(thread);
+  }
+  g_reapCv.notify_one();
+  return 0;
+}
+
+// ----------------------------------------------------------------------------------------------
+// fsdev (SD card) POSIX fixes. Measured on hardware (findings 1496-1498):
+//  * read() at or past end-of-file fails with EIO where POSIX returns 0 (sqlite maps EIO to
+//    SQLITE_CORRUPT/IOERR);
+//  * stat() of a file reopens it by path, and any second open of a file that is open for writing
+//    fails with EIO, so stat()/access() of an open database, log or settings file fails.
+// Wrapped at the newlib reentrant layer (-Wl,--wrap=_read_r,--wrap=_stat_r,--wrap=_open_r,
+// --wrap=_close_r,--wrap=lstat, see cmake/scripts/switch2/Install.cmake), so read(), stat(),
+// access(), fopen()/fread() (newlib __sread) and sqlite's system-call table all go through here.
+// ----------------------------------------------------------------------------------------------
+#include <atomic>
+#include <cerrno>
+#include <cstdint>
+#include <cstdio>
+#include <cstring>
+#include <fcntl.h>
+#include <reent.h>
+#include <sys/stat.h>
+#include <unistd.h>
+
+#include <switch.h>
+
+extern "C" _ssize_t __real__read_r(struct _reent* r, int fd, void* buf, size_t count);
+extern "C" int __real__open_r(struct _reent* r, const char* path, int flags, int mode);
+extern "C" int __real__close_r(struct _reent* r, int fd);
+extern "C" int __real__stat_r(struct _reent* r, const char* path, struct stat* st);
+extern "C" int __real_lstat(const char* path, struct stat* st);
+
+// Build with -DSWITCH2_STATFAIL_LOG=1 to append every stat()/lstat() failure other than ENOENT to
+// sdmc:/switch/kodi/boot.txt (rev 6 instrument; off by default, it was the bulk of boot.txt).
+#ifndef SWITCH2_STATFAIL_LOG
+#define SWITCH2_STATFAIL_LOG 0
+#endif
+
+namespace
+{
+// fd registry: which newlib fds are fsdev files, opened readable, and under which path. Indexed by
+// fd, lock-free (an fd number is only reused after its close). Lets read() bound itself by the file
+// size and lets stat() of an open file take its size from the open fd instead of a second open.
+constexpr int kMaxTrackedFd = 1024;
+constexpr uint32_t kTracked = 1u << 0;
+constexpr uint32_t kReadable = 1u << 1;
+// open() access mode + 1 in bits 4-5 (0 = unknown), for fcntl(F_GETFL) on files.
+constexpr uint32_t kAccShift = 4;
+constexpr uint32_t kAccMask = 3u << kAccShift;
+
+struct FdInfo
+{
+  std::atomic<uint64_t> hash{0};
+  std::atomic<uint32_t> flags{0};
+};
+FdInfo g_fds[kMaxTrackedFd];
+
+uint64_t PathHash(const FsFileSystem* fs, const char* fspath)
+{
+  uint64_t h = 1469598103934665603ULL ^ reinterpret_cast<uintptr_t>(fs);
+  for (const unsigned char* p = reinterpret_cast<const unsigned char*>(fspath); *p; ++p)
+  {
+    h ^= *p;
+    h *= 1099511628211ULL;
+  }
+  return h ? h : 1;
+}
+
+// Resolves `path` to its fsdev file system and fs path (relative paths use fsdev's cwd).
+bool Translate(const char* path, FsFileSystem** fs, char (&fspath)[FS_MAX_PATH])
+{
+  *fs = nullptr;
+  fspath[0] = '\0';
+  const int saved = errno;
+  const bool ok = path && fsdevTranslatePath(path, fs, fspath) == 0 && *fs;
+  errno = saved;
+  return ok;
+}
+
+int FindOpenFd(uint64_t hash)
+{
+  for (int fd = 0; fd < kMaxTrackedFd; ++fd)
+    if ((g_fds[fd].flags.load(std::memory_order_acquire) & kTracked) &&
+        g_fds[fd].hash.load(std::memory_order_relaxed) == hash)
+      return fd;
+  return -1;
+}
+
+#if SWITCH2_STATFAIL_LOG
+std::atomic<int> g_statFailLines{0};
+
+void StatFailLog(const char* what, const char* path, int err, bool recovered)
+{
+  if (g_statFailLines.fetch_add(1) >= 256) // bounded: a hot failing path must not flood the SD
+    return;
+  char line[400];
+  const int n = snprintf(line, sizeof(line), "%s-fail path=%s errno=%d fallback=%d\n", what,
+                         path ? path : "-", err, recovered ? 1 : 0);
+  if (n > 0)
+    Switch2RawAppend("/switch/kodi/boot.txt", line,
+                     static_cast<size_t>(n) < sizeof(line) ? static_cast<size_t>(n) : sizeof(line) - 1);
+}
+#endif
+
+// stat() answer for a path whose fsdev stat failed with EIO because the file is open for writing in
+// this process (the measured cause: fsdev's stat reopens the file by path, and this FS refuses a
+// second open of a file open for writing). Answered only when that is the case: the entry exists
+// (fsFsGetEntryType, no open) and, for a file, our fd registry has it open (size and times then
+// come from that fd). A file that is not open in this process keeps its real EIO (rev 25: before,
+// any existing path with an EIO stat was reported as existing, size 0). Directories are answered
+// from the entry type alone.
+bool StatFallback(struct _reent* r, const char* path, struct stat* st)
+{
+  FsFileSystem* fs;
+  char fspath[FS_MAX_PATH];
+  FsDirEntryType type;
+  if (!Translate(path, &fs, fspath) || R_FAILED(fsFsGetEntryType(fs, fspath, &type)))
+    return false;
+  std::memset(st, 0, sizeof(*st));
+  st->st_nlink = 1;
+  if (type != FsDirEntryType_File)
+  {
+    st->st_mode = S_IFDIR | 0755;
+    return true;
+  }
+  const int fd = FindOpenFd(PathHash(fs, fspath));
+  if (fd < 0)
+    return false; // not open here: a genuine EIO
+  st->st_mode = S_IFREG | 0644;
+  struct stat fst;
+  const int saved = r->_errno;
+  if (_fstat_r(r, fd, &fst) == 0 && S_ISREG(fst.st_mode))
+  {
+    *st = fst;
+    st->st_mode |= 0644;
+    if (st->st_nlink == 0)
+      st->st_nlink = 1;
+  }
+  r->_errno = saved;
+  return true;
+}
+} // namespace
+
+extern "C" int Switch2PathIsOpen(const char* path)
+{
+  FsFileSystem* fs;
+  char fspath[FS_MAX_PATH];
+  return Translate(path, &fs, fspath) && FindOpenFd(PathHash(fs, fspath)) >= 0;
+}
+
+extern "C" int __wrap__open_r(struct _reent* r, const char* path, int flags, int mode)
+{
+  const int fd = __real__open_r(r, path, flags, mode);
+  if (fd >= 0 && fd < kMaxTrackedFd)
+  {
+    FsFileSystem* fs;
+    char fspath[FS_MAX_PATH];
+    if (Translate(path, &fs, fspath))
+    {
+      g_fds[fd].hash.store(PathHash(fs, fspath), std::memory_order_relaxed);
+      g_fds[fd].flags.store(kTracked | ((flags & O_ACCMODE) != O_WRONLY ? kReadable : 0) |
+                                ((static_cast<uint32_t>(flags & O_ACCMODE) + 1) << kAccShift),
+                            std::memory_order_release);
+    }
+    else
+      g_fds[fd].flags.store(0, std::memory_order_release);
+  }
+  return fd;
+}
+
+extern "C" int __wrap__close_r(struct _reent* r, int fd)
+{
+  if (fd >= 0 && fd < kMaxTrackedFd)
+    g_fds[fd].flags.store(0, std::memory_order_release);
+  return __real__close_r(r, fd);
+}
+
+// read(): for a readable fsdev file, take the position and size first: at/after EOF return 0 without
+// calling fsdev (whose EOF read fails with EIO, and whose bounce-buffer path would loop), otherwise
+// clamp the count to the bytes that exist. Sockets, romfs and other devices pass straight through.
+extern "C" _ssize_t __wrap__read_r(struct _reent* r, int fd, void* buf, size_t count)
+{
+  if (count != 0 && fd >= 0 && fd < kMaxTrackedFd &&
+      (g_fds[fd].flags.load(std::memory_order_acquire) & kReadable))
+  {
+    const int saved = r->_errno;
+    const _off_t pos = _lseek_r(r, fd, 0, SEEK_CUR);
+    struct stat st;
+    if (pos >= 0 && _fstat_r(r, fd, &st) == 0 && S_ISREG(st.st_mode))
+    {
+      if (pos >= st.st_size)
+      {
+        r->_errno = saved;
+        return 0;
+      }
+      const uint64_t left = static_cast<uint64_t>(st.st_size - pos);
+      if (count > left)
+        count = static_cast<size_t>(left);
+    }
+    r->_errno = saved;
+  }
+  const _ssize_t n = __real__read_r(r, fd, buf, count);
+  if (n < 0 && r->_errno == EIO)
+  {
+    // Untracked fd, or the file shrank under us: keep the rev 5 rule (EIO at/after EOF -> 0).
+    const int saved = r->_errno;
+    const _off_t pos = _lseek_r(r, fd, 0, SEEK_CUR);
+    struct stat st;
+    if (pos >= 0 && _fstat_r(r, fd, &st) == 0 && S_ISREG(st.st_mode) && pos >= st.st_size)
+    {
+      r->_errno = saved;
+      return 0;
+    }
+    r->_errno = saved;
+  }
+  return n;
+}
+
+extern "C" int __wrap__stat_r(struct _reent* r, const char* path, struct stat* st)
+{
+  const int before = r->_errno;
+  const int rc = __real__stat_r(r, path, st);
+  if (rc == 0 || r->_errno != EIO)
+    return rc;
+  const int err = r->_errno;
+  const bool ok = StatFallback(r, path, st);
+#if SWITCH2_STATFAIL_LOG
+  StatFailLog("stat", path, err, ok);
+#endif
+  r->_errno = ok ? before : err;
+  return ok ? 0 : rc;
+}
+
+// lstat() is its own libsysbase entry (it calls the devoptab directly, not _stat_r).
+extern "C" int __wrap_lstat(const char* path, struct stat* st)
+{
+  const int before = errno;
+  const int rc = __real_lstat(path, st);
+  if (rc == 0 || errno != EIO)
+    return rc;
+  const int err = errno;
+  const bool ok = StatFallback(_REENT, path, st);
+#if SWITCH2_STATFAIL_LOG
+  StatFailLog("lstat", path, err, ok);
+#endif
+  errno = ok ? before : err;
+  return ok ? 0 : rc;
+}
+
+// fcntl() wrapper (-Wl,--wrap=fcntl, see Install.cmake). libounce's fcntl() is the BSD-socket one:
+// it accepts only F_GETFL/F_SETFL, on socket fds, and returns 95 (EOPNOTSUPP as a value, not -1 with
+// errno) for every other command. CPython's _Py_dup (F_DUPFD_CLOEXEC) then took "95" as the new fd.
+// Socket fds (the newlib handle's devoptab is libounce's "soc", the test its own _socketGetFd makes)
+// keep the real F_GETFL/F_SETFL (O_NONBLOCK); every other command, on any fd, is answered here:
+//   F_DUPFD/F_DUPFD_CLOEXEC dup() until the new fd is >= arg (extras closed); F_GETFD -> FD_CLOEXEC
+//   (there is no exec); F_SETFD, F_SETLK, F_SETLKW -> 0 (one process, no other lock holder);
+//   F_GETLK -> l_type = F_UNLCK; F_GETFL on a file -> its open() access mode (O_RDWR if unknown);
+//   F_SETFL on a file -> 0; anything else -> -1/EINVAL.
+#include <cstdarg>
+#include <sys/iosupport.h>
+
+extern "C" int __real_fcntl(int fd, int cmd, ...);
+
+namespace
+{
+bool IsSocketFd(int fd)
+{
+  __handle* h = __get_handle(fd);
+  if (!h || h->device >= STD_MAX || !devoptab_list[h->device] || !devoptab_list[h->device]->name)
+    return false;
+  return std::strcmp(devoptab_list[h->device]->name, "soc") == 0;
+}
+
+int DupAtLeast(int fd, int minfd)
+{
+  if (minfd < 0)
+  {
+    errno = EINVAL;
+    return -1;
+  }
+  int extras[64];
+  int nextras = 0;
+  int nfd = dup(fd);
+  while (nfd >= 0 && nfd < minfd && nextras < 64)
+  {
+    extras[nextras++] = nfd;
+    nfd = dup(fd);
+  }
+  const int saved = errno;
+  for (int i = 0; i < nextras; ++i)
+    close(extras[i]);
+  if (nfd >= 0 && nfd < minfd)
+  {
+    close(nfd);
+    errno = EMFILE;
+    return -1;
+  }
+  if (nfd >= 0 && nfd < kMaxTrackedFd && fd >= 0 && fd < kMaxTrackedFd)
+  {
+    // The duplicate refers to the same file: same registry entry (read() bound, stat() fallback).
+    g_fds[nfd].hash.store(g_fds[fd].hash.load(std::memory_order_relaxed), std::memory_order_relaxed);
+    g_fds[nfd].flags.store(g_fds[fd].flags.load(std::memory_order_acquire), std::memory_order_release);
+  }
+  if (nfd < 0)
+    errno = saved;
+  return nfd;
+}
+} // namespace
+
+extern "C" int __wrap_fcntl(int fd, int cmd, ...)
+{
+  va_list ap;
+  va_start(ap, cmd);
+  int rc;
+  switch (cmd)
+  {
+    case F_GETFL:
+      if (IsSocketFd(fd))
+        rc = __real_fcntl(fd, F_GETFL);
+      else if (!__get_handle(fd))
+      {
+        errno = EBADF;
+        rc = -1;
+      }
+      else
+      {
+        const uint32_t f = fd >= 0 && fd < kMaxTrackedFd
+                               ? g_fds[fd].flags.load(std::memory_order_acquire)
+                               : 0;
+        rc = (f & kAccMask) ? static_cast<int>(((f & kAccMask) >> kAccShift) - 1) : O_RDWR;
+      }
+      break;
+    case F_SETFL:
+    {
+      const int flags = va_arg(ap, int);
+      if (IsSocketFd(fd))
+        rc = __real_fcntl(fd, F_SETFL, flags);
+      else if (__get_handle(fd))
+        rc = 0;
+      else
+      {
+        errno = EBADF;
+        rc = -1;
+      }
+      break;
+    }
+    case F_DUPFD:
+    case F_DUPFD_CLOEXEC:
+      rc = DupAtLeast(fd, va_arg(ap, int));
+      break;
+    case F_GETFD:
+      rc = __get_handle(fd) ? FD_CLOEXEC : -1;
+      if (rc == -1)
+        errno = EBADF;
+      break;
+    case F_SETFD:
+      (void)va_arg(ap, int);
+      rc = __get_handle(fd) ? 0 : -1;
+      if (rc == -1)
+        errno = EBADF;
+      break;
+    case F_GETLK:
+    {
+      struct flock* fl = va_arg(ap, struct flock*);
+      if (fl)
+        fl->l_type = F_UNLCK;
+      rc = 0;
+      break;
+    }
+    case F_SETLK:
+    case F_SETLKW:
+      (void)va_arg(ap, struct flock*);
+      rc = 0;
+      break;
+    default:
+      errno = EINVAL;
+      rc = -1;
+      break;
+  }
+  va_end(ap);
+  return rc;
+}
+
+#if SWITCH2_DIAG
+// TLS keys (-Wl,--wrap=pthread_key_create/pthread_key_delete/pthread_setspecific, Install.cmake).
+// libounce backs each key with a thread-TLS slot (threadTlsAlloc: 12 in all), so every create and
+// delete is logged to boot.txt with its result, and setspecific only when it fails:
+//   "<ms> KEY create rc=<rc> key=<k> dtor=<off> lr=<off>" (offsets from the image base).
+extern "C" int __real_pthread_key_create(pthread_key_t* key, void (*dtor)(void*));
+extern "C" int __real_pthread_key_delete(pthread_key_t key);
+extern "C" int __real_pthread_setspecific(pthread_key_t key, const void* value);
+
+namespace
+{
+void KeyLog(const char* what, int rc, long long key, uintptr_t dtor, uintptr_t lr)
+{
+  const unsigned long long base = Switch2TextBase();
+  char line[200];
+  const int n = snprintf(line, sizeof(line), "%llu KEY %s rc=%d key=%lld dtor=0x%llx lr=0x%llx\n",
+                         static_cast<unsigned long long>(armTicksToNs(armGetSystemTick()) / 1000000ULL),
+                         what, rc, key,
+                         static_cast<unsigned long long>(dtor && dtor >= base ? dtor - base : dtor),
+                         static_cast<unsigned long long>(lr >= base ? lr - base : lr));
+  if (n > 0)
+    Switch2RawAppend("/switch/kodi/boot.txt", line,
+                     static_cast<size_t>(n) < sizeof(line) ? static_cast<size_t>(n) : sizeof(line) - 1);
+}
+} // namespace
+
+extern "C" int __wrap_pthread_key_create(pthread_key_t* key, void (*dtor)(void*))
+{
+  const int rc = __real_pthread_key_create(key, dtor);
+  KeyLog("create", rc, rc == 0 && key ? static_cast<long long>(*key) : -1,
+         reinterpret_cast<uintptr_t>(dtor), reinterpret_cast<uintptr_t>(__builtin_return_address(0)));
+  return rc;
+}
+
+extern "C" int __wrap_pthread_key_delete(pthread_key_t key)
+{
+  const int rc = __real_pthread_key_delete(key);
+  KeyLog("delete", rc, static_cast<long long>(key), 0,
+         reinterpret_cast<uintptr_t>(__builtin_return_address(0)));
+  return rc;
+}
+
+extern "C" int __wrap_pthread_setspecific(pthread_key_t key, const void* value)
+{
+  const int rc = __real_pthread_setspecific(key, value);
+  if (rc != 0)
+    KeyLog("setspecific-failed", rc, static_cast<long long>(key), 0,
+           reinterpret_cast<uintptr_t>(__builtin_return_address(0)));
+  return rc;
+}
+
+#endif // SWITCH2_DIAG
+
+// socketpair() wrapper (-Wl,--wrap=socketpair, Install.cmake). libounce's socketpair() is a stub
+// (-1, ENOSYS): libmicrohttpd's inter-thread wake-up (MHD_itc_init_), CPython's socket.socketpair
+// (asyncio's self-pipe) and curl's multi-handle wake-up all need one. For AF_UNIX/AF_INET with
+// SOCK_STREAM or SOCK_DGRAM and protocol 0 the pair is emulated over loopback, the way Windows code
+// does it: TCP = a listener on 127.0.0.1:0, a blocking connect, accept of exactly that client
+// (peer address checked, anything else is refused), listener closed, TCP_NODELAY on both ends;
+// UDP = two sockets bound to 127.0.0.1:0 and connect()ed to each other. SOCK_NONBLOCK is applied
+// with fcntl(O_NONBLOCK) afterwards, SOCK_CLOEXEC is meaningless here (no exec). No shared state.
+// Anything else goes to the real stub (ENOSYS).
+#include <arpa/inet.h>
+#include <netinet/in.h>
+#include <netinet/tcp.h>
+#include <sys/socket.h>
+
+extern "C" int __real_socketpair(int domain, int type, int protocol, int* sv);
+
+namespace
+{
+void CloseKeepErrno(int fd)
+{
+  if (fd >= 0)
+  {
+    const int saved = errno;
+    close(fd);
+    errno = saved;
+  }
+}
+
+sockaddr_in Loopback(uint16_t port)
+{
+  sockaddr_in a;
+  std::memset(&a, 0, sizeof(a));
+  a.sin_len = sizeof(a);
+  a.sin_family = AF_INET;
+  a.sin_port = port;
+  a.sin_addr.s_addr = htonl(INADDR_LOOPBACK);
+  return a;
+}
+
+bool LocalAddr(int fd, sockaddr_in* out)
+{
+  socklen_t len = sizeof(*out);
+  return getsockname(fd, reinterpret_cast<sockaddr*>(out), &len) == 0 && out->sin_family == AF_INET;
+}
+
+int TcpPair(int sv[2])
+{
+  int lst = -1, cli = -1, srv = -1;
+  sockaddr_in a = Loopback(0), ca, peer;
+  lst = socket(AF_INET, SOCK_STREAM, 0);
+  if (lst < 0)
+    return -1;
+  if (bind(lst, reinterpret_cast<sockaddr*>(&a), sizeof(a)) != 0 || listen(lst, 1) != 0 ||
+      !LocalAddr(lst, &a))
+    goto fail;
+  a.sin_addr.s_addr = htonl(INADDR_LOOPBACK);
+  cli = socket(AF_INET, SOCK_STREAM, 0);
+  if (cli < 0 || connect(cli, reinterpret_cast<sockaddr*>(&a), sizeof(a)) != 0 || !LocalAddr(cli, &ca))
+    goto fail;
+  for (int tries = 0; tries < 8 && srv < 0; ++tries)
+  {
+    socklen_t plen = sizeof(peer);
+    const int s = accept(lst, reinterpret_cast<sockaddr*>(&peer), &plen);
+    if (s < 0)
+      goto fail;
+    if (peer.sin_family == AF_INET && peer.sin_port == ca.sin_port &&
+        peer.sin_addr.s_addr == htonl(INADDR_LOOPBACK))
+      srv = s;
+    else
+      CloseKeepErrno(s); // not our client
+  }
+  if (srv < 0)
+  {
+    errno = ECONNREFUSED;
+    goto fail;
+  }
+  CloseKeepErrno(lst);
+  {
+    const int one = 1;
+    setsockopt(cli, IPPROTO_TCP, TCP_NODELAY, &one, sizeof(one));
+    setsockopt(srv, IPPROTO_TCP, TCP_NODELAY, &one, sizeof(one));
+  }
+  sv[0] = cli;
+  sv[1] = srv;
+  return 0;
+fail:
+  CloseKeepErrno(srv);
+  CloseKeepErrno(cli);
+  CloseKeepErrno(lst);
+  return -1;
+}
+
+int UdpPair(int sv[2])
+{
+  int s0 = socket(AF_INET, SOCK_DGRAM, 0);
+  int s1 = s0 >= 0 ? socket(AF_INET, SOCK_DGRAM, 0) : -1;
+  sockaddr_in a0 = Loopback(0), a1 = Loopback(0);
+  if (s1 < 0 || bind(s0, reinterpret_cast<sockaddr*>(&a0), sizeof(a0)) != 0 ||
+      bind(s1, reinterpret_cast<sockaddr*>(&a1), sizeof(a1)) != 0 || !LocalAddr(s0, &a0) ||
+      !LocalAddr(s1, &a1))
+    goto fail;
+  a0.sin_addr.s_addr = a1.sin_addr.s_addr = htonl(INADDR_LOOPBACK);
+  if (connect(s0, reinterpret_cast<sockaddr*>(&a1), sizeof(a1)) != 0 ||
+      connect(s1, reinterpret_cast<sockaddr*>(&a0), sizeof(a0)) != 0)
+    goto fail;
+  sv[0] = s0;
+  sv[1] = s1;
+  return 0;
+fail:
+  CloseKeepErrno(s1);
+  CloseKeepErrno(s0);
+  return -1;
+}
+} // namespace
+
+extern "C" int __wrap_socketpair(int domain, int type, int protocol, int* sv)
+{
+  const int extra = type & (SOCK_NONBLOCK | SOCK_CLOEXEC);
+  const int base = type & ~(SOCK_NONBLOCK | SOCK_CLOEXEC);
+  if (!sv || (domain != AF_UNIX && domain != AF_INET) || protocol != 0 ||
+      (base != SOCK_STREAM && base != SOCK_DGRAM))
+    return __real_socketpair(domain, type, protocol, sv);
+  if ((base == SOCK_STREAM ? TcpPair(sv) : UdpPair(sv)) != 0)
+    return -1;
+  if (extra & SOCK_NONBLOCK)
+  {
+    for (int i = 0; i < 2; ++i)
+    {
+      const int fl = fcntl(sv[i], F_GETFL, 0);
+      if (fl < 0 || fcntl(sv[i], F_SETFL, fl | O_NONBLOCK) != 0)
+      {
+        CloseKeepErrno(sv[0]);
+        CloseKeepErrno(sv[1]);
+        return -1;
+      }
+    }
+  }
+  return 0;
+}
+
+// sha256CalculateHash wrapper (-Wl,--wrap=sha256CalculateHash): libounce's _sha256ProcessBlocks uses
+// the ARMv8 SHA2 instructions unconditionally; curl's Curl_libnx_sha256sum is the only caller in
+// kodi.bin. OpenSSL's SHA256() takes the code path its armcap allows (NEON only in this port).
+extern "C" unsigned char* SHA256(const unsigned char* d, size_t n, unsigned char* md);
+
+extern "C" void __wrap_sha256CalculateHash(void* dst, const void* src, size_t size)
+{
+  SHA256(static_cast<const unsigned char*>(src), size, static_cast<unsigned char*>(dst));
+}
+
+// clock_gettime() wrapper (-Wl,--wrap=clock_gettime, see Install.cmake). libounce's
+// __syscall_clock_gettime accepts only CLOCK_REALTIME (1) and CLOCK_MONOTONIC (4); every other id
+// returns EINVAL without touching the timespec, and callers that ignore the return value (Kodi's
+// CurrentHostCounter used CLOCK_MONOTONIC_RAW) then read stack garbage. Map the Linux aliases.
+#include <time.h>
+
+extern "C" int __real_clock_gettime(clockid_t id, struct timespec* ts);
+
+extern "C" int __wrap_clock_gettime(clockid_t id, struct timespec* ts)
+{
+  switch (id)
+  {
+    case CLOCK_REALTIME_COARSE:
+#ifdef CLOCK_REALTIME_ALARM
+    case CLOCK_REALTIME_ALARM:
+#endif
+      id = CLOCK_REALTIME;
+      break;
+    case CLOCK_MONOTONIC_RAW:
+    case CLOCK_MONOTONIC_COARSE:
+    case CLOCK_BOOTTIME:
+#ifdef CLOCK_BOOTTIME_ALARM
+    case CLOCK_BOOTTIME_ALARM:
+#endif
+      id = CLOCK_MONOTONIC;
+      break;
+    default:
+      break;
+  }
+  const int rc = __real_clock_gettime(id, ts);
+  // A failed CLOCK_MONOTONIC read falls back to the CPU tick counter (also monotonic, from boot), so
+  // callers that ignore the return value never see an untouched timespec (rev 25).
+  if (rc != 0 && id == CLOCK_MONOTONIC && ts)
+  {
+    const u64 ns = armTicksToNs(armGetSystemTick());
+    ts->tv_sec = static_cast<time_t>(ns / 1000000000ULL);
+    ts->tv_nsec = static_cast<long>(ns % 1000000000ULL);
+    return 0;
+  }
+  return rc;
+}
+
+// Implementations behind the Switch 2 compat headers (compat/sys/sysinfo.h, compat/sys/utsname.h).
+
+#include <cstring>
+
+#include <sys/sysinfo.h>
+#include <sys/utsname.h>
+#include <time.h>
+
+#include <switch.h>
+
+extern "C" int sysinfo(struct sysinfo* info)
+{
+  if (!info)
+    return -1;
+  std::memset(info, 0, sizeof(*info));
+  u64 total = 0, used = 0;
+  svcGetInfo(&total, InfoType_TotalMemorySize, CUR_PROCESS_HANDLE, 0);
+  svcGetInfo(&used, InfoType_UsedMemorySize, CUR_PROCESS_HANDLE, 0);
+  info->totalram = total;
+  info->freeram = total > used ? total - used : 0;
+  info->uptime = static_cast<long>(armTicksToNs(armGetSystemTick()) / 1000000000ULL);
+  info->procs = 1;
+  info->mem_unit = 1;
+  return 0;
+}
+
+extern "C" int get_nprocs(void)
+{
+  return 3; // cores available to an application on the console
+}
+
+extern "C" int get_nprocs_conf(void)
+{
+  return 8;
+}
+
+extern "C" int uname(struct utsname* name)
+{
+  if (!name)
+    return -1;
+  std::memset(name, 0, sizeof(*name));
+  std::strncpy(name->sysname, "Horizon", sizeof(name->sysname) - 1);
+  std::strncpy(name->nodename, "switch2", sizeof(name->nodename) - 1);
+  std::strncpy(name->release, "kaiHEN", sizeof(name->release) - 1);
+  std::strncpy(name->version, "libounce", sizeof(name->version) - 1);
+  std::strncpy(name->machine, "aarch64", sizeof(name->machine) - 1);
+  return 0;
+}
+
+// Days from 1970-01-01 to y-m-d in the proleptic Gregorian calendar (Howard Hinnant's algorithm).
+static long long DaysFromCivil(long long y, unsigned m, unsigned d)
+{
+  y -= m <= 2;
+  const long long era = (y >= 0 ? y : y - 399) / 400;
+  const unsigned yoe = static_cast<unsigned>(y - era * 400);
+  const unsigned doy = (153 * (m + (m > 2 ? -3 : 9)) + 2) / 5 + d - 1;
+  const unsigned doe = yoe * 365 + yoe / 4 - yoe / 100 + doy;
+  return era * 146097 + static_cast<long long>(doe) - 719468;
+}
+
+extern "C" time_t timegm(struct tm* tm)
+{
+  if (!tm)
+    return static_cast<time_t>(-1);
+  // Normalise month overflow like mktime does.
+  long long year = 1900LL + tm->tm_year + tm->tm_mon / 12;
+  int mon = tm->tm_mon % 12;
+  if (mon < 0)
+  {
+    mon += 12;
+    year -= 1;
+  }
+  const long long days = DaysFromCivil(year, static_cast<unsigned>(mon + 1), 1) + (tm->tm_mday - 1);
+  const long long secs = days * 86400LL + tm->tm_hour * 3600LL + tm->tm_min * 60LL + tm->tm_sec;
+  const time_t t = static_cast<time_t>(secs);
+  struct tm norm;
+  if (gmtime_r(&t, &norm))
+    *tm = norm;
+  return t;
+}
+
+// Process APIs newlib declares but the console cannot provide: Kodi only calls them for
+// external players and resource accounting, so they fail with ENOSYS.
+#include <cerrno>
+#include <sys/resource.h>
+#include <sys/wait.h>
+#include <unistd.h>
+
+extern "C" int getrusage(int, struct rusage* usage)
+{
+  if (usage)
+    std::memset(usage, 0, sizeof(*usage));
+  return 0;
+}
+
+extern "C" pid_t waitpid(pid_t, int*, int)
+{
+  errno = ECHILD;
+  return -1;
+}
+
+extern "C" int execvp(const char*, char* const[])
+{
+  errno = ENOSYS;
+  return -1;
+}
+
+// No child processes on the console: Kodi's few popen() users (temperature commands,
+// external tools) take their failure path.
+#include <cstdio>
+
+extern "C" FILE* popen(const char*, const char*)
+{
+  errno = ENOSYS;
+  return nullptr;
+}
+
+extern "C" int pclose(FILE*)
+{
+  errno = ECHILD;
+  return -1;
+}
