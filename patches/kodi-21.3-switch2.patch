+bool CWinSystemSwitch2GLESContext::InitWindowSystem()
+{
+  // Per-windowing registrations, as in the gbm/X11 GLES contexts: without a video renderer,
+  // VideoPlayer loops on "OutputPicture - failed to configure renderer" (rev 10 flight).
+  // Decoding is FFmpeg software (no HW accels).
+  VIDEOPLAYER::CRendererFactory::ClearRenderer();
+  CDVDFactoryCodec::ClearHWAccels();
+  CLinuxRendererGLES::Register();
+  CProcessInfo::RegisterProcessControl("switch2", CProcessInfoSwitch2::Create);
+  KODI::RETRO::CRPProcessInfo::RegisterProcessControl(CRPProcessInfoSwitch2::Create);
+  KODI::RETRO::CRPProcessInfo::RegisterRendererFactory(new KODI::RETRO::CRendererFactoryOpenGLES);
+  CScreenshotSurfaceGLES::Register();
+
+  padConfigureInput(1, HidNpadStyleSet_NpadStandard);
+  padInitializeDefault(&m_pad);
+  // Fix the touch coordinate range so the scaling in PollTouch() is right whatever the default is.
+  const Result touchRc = hidSetTouchScreenOutputRanges(1280, 720);
+  if (R_FAILED(touchRc))
+    CLog::Log(LOGWARNING, "Switch2: hidSetTouchScreenOutputRanges failed 0x{:x}", touchRc);
+  hidInitializeTouchScreen();
+
+  m_window = nwindowGetDefault();
+
+  m_operationMode = static_cast<int>(appletGetOperationMode());
+  QueryDisplaySize(m_screenWidth, m_screenHeight, m_displayWidth, m_displayHeight);
+  CLog::Log(LOGINFO, "Switch2: display mode={} output {}x{} window {}x{}", m_operationMode,
+            m_screenWidth, m_screenHeight, m_displayWidth, m_displayHeight);
+  Switch2DiagLog("display mode=%d window=%dx%d default=%dx%d", m_operationMode, m_displayWidth,
+                 m_displayHeight, m_screenWidth, m_screenHeight);
+
+  if (!m_eglContext.CreateDisplay(EGL_DEFAULT_DISPLAY))
+    return false;
+  if (!m_eglContext.InitializeDisplay(EGL_OPENGL_ES_API))
+    return false;
+  if (!m_eglContext.ChooseConfig(EGL_OPENGL_ES3_BIT))
+    return false;
+  // CEGLContextUtils::ChooseConfig returns true even when no config matched; fail loudly instead.
+  if (m_eglContext.GetEGLConfig() == nullptr)
+  {
+    CLog::Log(LOGFATAL, "Switch2: no EGL config matched (ES3, RGB888, window)");
+    return false;
+  }
+
+  CEGLAttributesVec contextAttribs;
+  contextAttribs.Add({{EGL_CONTEXT_MAJOR_VERSION, 3}, {EGL_CONTEXT_MINOR_VERSION, 0}});
+  if (!m_eglContext.CreateContext(contextAttribs))
+    return false;
+
+  return CWinSystemBase::InitWindowSystem();
+}
+
+bool CWinSystemSwitch2GLESContext::DestroyWindowSystem()
+{
+  m_eglContext.Destroy();
+  return true;
+}
+
+bool CWinSystemSwitch2GLESContext::CreateNewWindow(const std::string& name,
+                                                   bool fullScreen,
+                                                   RESOLUTION_INFO& res)
+{
+  if (m_bWindowCreated)
+  {
+    // Same size: nothing to do; else a new EGL surface on the resized NWindow.
+    if (m_nWidth == m_displayWidth && m_nHeight == m_displayHeight)
+      return true;
+    return RecreateSurface(m_displayWidth, m_displayHeight);
+  }
+
+  // A fixed size (not nwindowSetModeDimensions with 0x0): Kodi renders its GUI and video into one
+  // GLES surface of the GUI resolution, so the buffers must have that size (<= 1920x1080); AM scales
+  // the layer to the TV output. MessagePump re-sizes it when the mode or the TV setting changes.
+  nwindowSetDimensions(m_window, m_displayWidth, m_displayHeight);
+  if (!m_eglContext.CreateSurface(reinterpret_cast<EGLNativeWindowType>(m_window)))
+    return false;
+  if (!m_eglContext.BindContext())
+    return false;
+
+  m_nWidth = m_displayWidth;
+  m_nHeight = m_displayHeight;
+  m_bFullScreen = true;
+  m_bWindowCreated = true;
+  return true;
+}
+
+bool CWinSystemSwitch2GLESContext::DestroyWindow()
+{
+  m_eglContext.DestroySurface();
+  m_bWindowCreated = false;
+  return true;
+}
