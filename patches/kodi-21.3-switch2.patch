--- /dev/null
+++ b/xbmc/cores/VideoPlayer/DVDCodecs/Video/DVDVideoCodecSwitch2.cpp
@@ -0,0 +1,1092 @@
+/*
+ *  Copyright (C) 2026 Team Kodi
+ *  This file is part of Kodi - https://kodi.tv
+ *
+ *  SPDX-License-Identifier: GPL-2.0-or-later
+ *  See LICENSES/README.md for more information.
+ */
+
+// Switch 2 hardware video decoder (rev 37). libounce's videoDecoder* API (switch2/video/decoder.h),
+// used as the flown probes did (findings 1553, 1556, 1557; KaiVideo's openHardware/submit/takeFrames):
+//  * config {codec, width/height (H.264: rounded up to 16, 1080 -> 1088: configured as 1080 the
+//    decoder stalls on B-frames, finding 1556), frame rate from the stream (default 30),
+//    max_sample_size 16 MiB, tiling 0 (pitch-linear; block-linear for AV1), colour policy 0,
+//    image_count 0}, H.264 codec_config = SPS/PPS after 00 00 00 01 (FFmpeg's h264_mp4toannexb
+//    output extradata); VP9 samples through vp9_superframe_split; AV1/VP8 as demuxed;
+//  * every sample submitted with a 2 ms timeout, TimedOut/SUBMIT_BUSY retried with
+//    videoDecoderGetFrame(.., 0) in between; end_of_stream only on the last sample (one sample is
+//    held back for that); a failed GetFrame is skipped (libounce returns that image);
+//  * frames are NV12 (pitch-linear, pitch 2048 at 1088, crop = the visible size, limited range,
+//    finding 1557) and are copied at once into a Kodi YUV420P buffer (the renderer path every
+//    software-decoded frame uses), then returned to the decoder.
+// The decoder needs frame mode 2 with bit 1 permitted and the GPU/VM chain: Kodi's EGL/OunceVK
+// start-up provides both (it calls gsvRegisterFrame(2); its permitted mode is captured by a
+// --wrap below). This file never calls consoleInit or gsvRegisterFrame.
+// Threads: Open only checks the stream; the decoder is created on the first AddData, so every
+// videoDecoder* call runs on the VideoPlayerVideo thread (Close: the thread that destroys the
+// codec, after the last decode call).
+// One decoder at a time (68-240 MiB work memory at 1080p); a second concurrent Open falls back.
+// Any failure (create, submit, a stream that gives no frames) switches this object to FFmpeg.
+//
+// Creator lifetime: videoDecoderCreate/Close call viddecInitialize/viddecExit, a reference-counted
+// service guard (libounce viddec.o: _serviceGuardAddOpen/_serviceGuardRemoveOpen); the last exit
+// closes the creator session, and gsv.h warns "Open the creator only once for each root
+// initialization" (the display keeps the root initialized for the whole process). So the first
+// hardware open takes one viddecInitialize reference of its own and keeps it until Kodi exits
+// (Shutdown, from CApplication::Cleanup before the render/window system teardown, with a backstop
+// call in main): the creator is opened once per process and every later decoder is created from
+// the same creator (each create/close moves the count 1 <-> 2). If that first viddecInitialize
+// fails, hardware decoding is off for the run. Seeks use videoDecoderFlush, never close + create.
+
+#include "DVDVideoCodecSwitch2.h"
+
+#include "DVDVideoCodecFFmpeg.h"
+#include "ServiceBroker.h"
+#include "Switch2HwCodecUtil.h"
+#include "cores/VideoPlayer/DVDCodecs/DVDFactoryCodec.h"
+#include "cores/VideoPlayer/Interface/TimingConstants.h"
+#include "platform/switch2/PosixCompat.h"
+#include "settings/Settings.h"
+#include "settings/SettingsComponent.h"
+#include "utils/log.h"
+
+#include <algorithm>
+#include <atomic>
+#include <chrono>
+#include <cmath>
+#include <mutex>
+#include <thread>
+
+extern "C"
+{
+#include <libavcodec/bsf.h>
+#include <libavutil/mem.h>
+#include <libavutil/pixdesc.h>
+}
+
+#include <switch.h>
+#include <switch2/services/viddec.h>
+#include <switch2/video/decoder.h>
+
+namespace
+{
+std::atomic<bool> g_inUse{false}; // one decoder instance at a time
+std::atomic<bool> g_frameRegistered{false};
+std::atomic<uint64_t> g_permittedMode{0};
+std::mutex g_creatorMutex;
+bool g_creatorPinned = false; // our own viddecInitialize reference (until Shutdown)
+bool g_creatorReleased = false; // Shutdown ran: no hardware decoding for the rest of the run
+std::atomic<bool> g_hwUnavailable{false}; // the pin failed: FFmpeg only for the rest of the run
+
+constexpr size_t kMaxReady = 4; // decoded frames kept before AddData pushes back
+constexpr uint64_t kSubmitTimeoutNs = 2000000ULL; // 2 ms per submit try (KaiVideo, S1e)
+constexpr unsigned kSubmitTriesPerCall = 8;
+constexpr unsigned kSubmitStuckLimit = 2500; // ~5 s of refused submits in a row (S1e)
+// A decoder that gives no frame for this many samples after it was created or reset (both start at
+// a keyframe) has stalled (the S1-S1d 0xfa66f stall at a 1080 configuration came at sample 10).
+constexpr unsigned kStallSamples = 48;
+// Failed GetFrame calls in a row before the stream counts as one the decoder cannot decode. High
+// enough for a restart in the middle of a GOP (after a drain), which fails until the next keyframe.
+constexpr unsigned kGetFrameFailLimit = 300;
+constexpr uint64_t kDrainWaitNs = 1000000000ULL; // end of stream: wait this long for the last frames
+
+// Rev 39c: H.264, VP9, AV1 and VP8 go to the hardware by default (VP9/AV1/VP8 passed two launches
+// with the rev 37b opt-in flag, finding 1585); sdmc:/switch/kodi/hwdec-h264only.flag restores the
+// rev 37b H.264-only routing.
+bool Switch2FlagFile(const char* name)
+{
+  const std::string path = std::string("sdmc:/switch/kodi/") + name;
+  FILE* f = fopen(path.c_str(), "rb");
+  if (!f)
+    return false;
+  fclose(f);
+  return true;
+}
+
+// Rev 37b: the work memory of the last closed decoder. libounce frees it only once the service has
+// given it back (CPU permission RW again, waited for up to 2 s inside videoDecoderClose); if it has
+// not, that memory is lost for the run. The process's UsedMemorySize cannot show this (the heap is
+// mapped whole at start: every rev 35 monitor line reads used=7198539776 of 7202668544), so the
+// check is the range's permission, right after the close and again at the next Open.
+std::mutex g_memMutex;
+uintptr_t g_lastWork = 0;
+uint64_t g_lastWorkSize = 0;
+uint64_t g_lastCloseNs = 0;
+bool g_lastWorkChecked = true;
+
+unsigned long long UsedMemory()
+{
+  u64 used = 0;
+  svcGetInfo(&used, InfoType_UsedMemorySize, CUR_PROCESS_HANDLE, 0);
+  return static_cast<unsigned long long>(used);
+}
+
+// true when the range is readable and writable by the CPU again (given back by the service).
+bool WorkReturned(uintptr_t work)
+{
+  MemoryInfo info = {};
+  u32 pageInfo = 0;
+  if (R_FAILED(svcQueryMemory(&info, &pageInfo, work)))
+    return false;
+  return (info.perm & Perm_Rw) == Perm_Rw;
+}
+
+uint64_t NowNs()
+{
+  return armTicksToNs(armGetSystemTick());
+}
+
+const char* CodecName(AVCodecID id)
+{
+  switch (id)
+  {
+    case AV_CODEC_ID_H264:
+      return "h264";
+    case AV_CODEC_ID_VP9:
+      return "vp9";
+    case AV_CODEC_ID_AV1:
+      return "av1";
+    case AV_CODEC_ID_VP8:
+      return "vp8";
+    default:
+      return "other";
+  }
+}
+
+// Rev 37c: the decoder's input format (colour policy, viddec.h viddecDecoderInitialize note) from the
+// stream's colour tags. Colour-policy sweep (finding 1561, logs/viddecs1g/compare/report.txt): 3 (=
+// libounce's default at >= 1920x1080) is the near-identity map closest to FFmpeg; 1/2 apply a
+// 601<->709 matrix (+range), 4 full->limited, 5/6 change the output format, 7 gamut/transfer.
+// libounce's default picks 1 below 1920x1080, which put a 601 conversion on 720p H.264 in rev 37b.
+//   untagged HD or BT.709 limited -> 3; BT.709 full (BT.709 transfer) -> 4; BT.601 (BT470BG/
+//   SMPTE170M/SMPTE240M/FCC, or untagged SD as the renderer treats it) limited -> 1, full (601
+//   transfer) -> 2; BT.2020/HDR -> 0 = not for the hardware (5-7 are never used).
+struct ColorChoice
+{
+  unsigned policy; // 0 = refuse
+  std::string why;
+};
+
+ColorChoice ChooseColorPolicy(const CDVDStreamInfo& h)
+{
+  const bool hdr = h.colorSpace == AVCOL_SPC_BT2020_NCL || h.colorSpace == AVCOL_SPC_BT2020_CL ||
+                   h.colorPrimaries == AVCOL_PRI_BT2020 ||
+                   h.colorTransferCharacteristic == AVCOL_TRC_SMPTE2084 ||
+                   h.colorTransferCharacteristic == AVCOL_TRC_ARIB_STD_B67;
+  const bool sdMatrix = h.colorSpace == AVCOL_SPC_BT470BG || h.colorSpace == AVCOL_SPC_SMPTE170M ||
+                        h.colorSpace == AVCOL_SPC_SMPTE240M || h.colorSpace == AVCOL_SPC_FCC;
+  // An untagged matrix with SD primaries counts as 601.
+  const bool sdPrimaries = h.colorPrimaries == AVCOL_PRI_BT470BG ||
+                           h.colorPrimaries == AVCOL_PRI_SMPTE170M ||
+                           h.colorPrimaries == AVCOL_PRI_SMPTE240M;
+  // Rev 37e: an untagged matrix counts as 601 where the software renderer takes it as BT470BG
+  // (YUV2RGBShaderGLES.cpp: untagged and not (width > 1024 or height >= 600)), so hardware and
+  // software decoding of the same untagged SD file look the same.
+  const bool sd = sdMatrix || (h.colorSpace == AVCOL_SPC_UNSPECIFIED &&
+                               (sdPrimaries || (h.width <= 1024 && h.height < 600)));
+  // Full-range policies (2, 4) only with full range AND the family's standard transfer
+  // (viddec.h: "2/4 if r=1 and t=3, else 1/3"); otherwise the limited-range policy.
+  const bool full = h.colorRange == AVCOL_RANGE_JPEG;
+  const bool trc709 = h.colorTransferCharacteristic == AVCOL_TRC_BT709;
+  const bool trc601 = h.colorTransferCharacteristic == AVCOL_TRC_SMPTE170M ||
+                      h.colorTransferCharacteristic == AVCOL_TRC_GAMMA28 ||
+                      h.colorTransferCharacteristic == AVCOL_TRC_GAMMA22;
+  ColorChoice c;
+  c.policy = hdr ? 0 : sd ? ((full && trc601) ? 2 : 1) : ((full && trc709) ? 4 : 3);
+  auto name = [](const char* n) { return std::string(n ? n : "?"); }; // NULL for reserved values
+  c.why = "primaries=" + name(av_color_primaries_name(h.colorPrimaries)) +
+          " matrix=" + name(av_color_space_name(h.colorSpace)) +
+          " range=" + name(av_color_range_name(h.colorRange)) +
+          " transfer=" + name(av_color_transfer_name(h.colorTransferCharacteristic));
+  return c;
+}
+
+std::string Hex(Result rc)
+{
+  char b[16];
+  snprintf(b, sizeof(b), "0x%x", static_cast<unsigned>(rc));
+  return b;
+}
+} // namespace
+
+// Kodi's EGL/OunceVK display start-up registers frame mode 2 (nvkmd_nvgpu_native_runtime_open,
+// libouncevk-gl.a); the decoder's native image memory needs bit 1 in the mode the root permitted
+// (finding 1553). libounce keeps that value private, so it is captured here
+// (-Wl,--wrap=gsvRegisterFrame, Install.cmake).
+extern "C" Result __real_gsvRegisterFrame(u64 mode, u64* out_permitted_mode);
+extern "C" Result __wrap_gsvRegisterFrame(u64 mode, u64* out_permitted_mode)
+{
+  u64 permitted = 0;
+  const Result rc = __real_gsvRegisterFrame(mode, &permitted);
+  if (R_SUCCEEDED(rc))
+  {
+    g_permittedMode.store(permitted);
+    g_frameRegistered.store(true);
+  }
+  Switch2DiagLog("hwdec: gsvRegisterFrame(%llu) rc=0x%x permitted=0x%llx",
+                 static_cast<unsigned long long>(mode), static_cast<unsigned>(rc),
+                 static_cast<unsigned long long>(permitted));
+  if (out_permitted_mode)
+    *out_permitted_mode = permitted;
+  return rc;
+}
