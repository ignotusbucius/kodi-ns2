+extern "C" int __wrap_pthread_create(pthread_t* thread,
+                                     const pthread_attr_t* attr,
+                                     void* (*start)(void*),
+                                     void* arg)
+{
+  g_switch2ThreadsCreated.fetch_add(1, std::memory_order_relaxed);
+  t_threadStep = 0;
+  t_threadRc = 0;
+  size_t stack = 0;
+  const int rc = CreateThread(thread, attr, start, arg, &stack);
+  const uintptr_t lr = reinterpret_cast<uintptr_t>(__builtin_return_address(0));
+  if (rc != 0)
+  {
+    g_switch2ThreadCreateFailures.fetch_add(1, std::memory_order_relaxed);
+    CaptureFirstFailure(rc, stack, t_threadStep, t_threadRc, lr);
+    LogFirstFailureToKodiLog();
+  }
+#if SWITCH2_DIAG
+  uintptr_t fps[3];
+  CallerChain(static_cast<const uintptr_t*>(__builtin_frame_address(0)), fps);
+  ThreadCreateLog(rc, stack, start, lr, fps);
+#endif
+  return rc;
+}
