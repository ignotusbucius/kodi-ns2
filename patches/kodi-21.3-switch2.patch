+namespace
+{
+// Shared-cache mode (on for Switch 2, see platform/switch2/StartupProbe.cpp) reports a table or
+// schema held by another connection of this process as SQLITE_LOCKED[_SHAREDCACHE], and the busy
+// handler is not called for it. Retry such a call with a bounded backoff (~2 s in all) instead of
+// failing the query.
+bool IsLocked(int rc)
+{
+  return (rc & 0xff) == SQLITE_LOCKED;
+}
+
+class LockedRetry
+{
+public:
+  // True after sleeping when `rc` is LOCKED and the budget is not used up: call again.
+  bool Again(int rc)
+  {
+    if (!IsLocked(rc) || m_waitedMs >= 2000)
+      return false;
+    KODI::TIME::Sleep(std::chrono::milliseconds(m_stepMs));
+    m_waitedMs += m_stepMs;
+    m_stepMs = m_stepMs < 50 ? m_stepMs * 2 : 50;
+    return true;
+  }
+
+private:
+  int m_waitedMs = 0;
+  int m_stepMs = 1;
+};
+
+// True when `sql` holds more than one statement. sqlite3_exec runs statements in order, so a
+// LOCKED from a later statement comes after earlier ones were applied: such SQL is not retried.
+// Only called on the LOCKED path. A first statement that does not even prepare ran nothing, so it
+// counts as single.
+bool IsMultiStatement(sqlite3* conn, const char* sql)
+{
+  sqlite3_stmt* stmt = nullptr;
+  const char* tail = nullptr;
+  const int rc = sqlite3_prepare_v2(conn, sql, -1, &stmt, &tail);
+  sqlite3_finalize(stmt);
+  if (rc != SQLITE_OK || !tail)
+    return false;
+  for (; *tail; ++tail)
+    if (*tail != ';' && !isspace(static_cast<unsigned char>(*tail)))
+      return true;
+  return false;
+}
+
+int ExecRetry(sqlite3* conn,
+              const char* sql,
+              int (*cb)(void*, int, char**, char**),
+              void* arg,
+              char** errmsg,
+              result_set* res = nullptr)
+{
+  LockedRetry retry;
+  int rc;
+  for (;;)
+  {
+    if (res)
+      res->clear();
+    if (errmsg)
+      *errmsg = nullptr;
+    rc = sqlite3_exec(conn, sql, cb, arg, errmsg);
+    if (!IsLocked(rc) || IsMultiStatement(conn, sql) || !retry.Again(rc))
+      return rc;
+    if (errmsg && *errmsg)
+    {
+      sqlite3_free(*errmsg);
+      *errmsg = nullptr;
+    }
+  }
+}
