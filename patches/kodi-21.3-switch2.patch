diff --git a/xbmc/platform/switch2/PosixCompat.cpp b/xbmc/platform/switch2/PosixCompat.cpp
new file mode 100644
index 0000000..cd627a0
--- /dev/null
+++ b/xbmc/platform/switch2/PosixCompat.cpp
@@ -0,0 +1,1490 @@
+/*
+ *  Copyright (C) 2026 Team Kodi
+ *  This file is part of Kodi - https://kodi.tv
+ *
+ *  SPDX-License-Identifier: GPL-2.0-or-later
+ *  See LICENSES/README.md for more information.
+ */
+
+#include "PosixCompat.h"
+
+// pthread_create wrapper (linked with -Wl,--wrap=pthread_create, see Install.cmake): newlib/libounce
+// give a thread without attributes 128 KiB of stack; Kodi, FFmpeg and Mesa expect Linux-sized stacks.
+// Also, in every build (rev 35): live/created/failed thread counters, and on the FIRST failed
+// creation one line with the platform's view of it (kodi.log, and boot.txt).
+// Rev 36: every thread keeps a record until it is joined (zombie count = exited, not yet joined:
+// each one still holds its kernel thread and its stack), detached threads are joined as soon as they
+// exit (the rev <= 35 reaper joined them in detach order and blocked on the first long-lived one),
+// and a startup probe measures how many kernel threads the process may still create.
+#include <pthread.h>
+
+#include <atomic>
+#include <cstdio>
+#include <cstdlib>
+#include <malloc.h>
+#include <new>
+
+#include <switch.h>
+
+#include "ServiceBroker.h"
+#include "utils/log.h"
+
+extern "C" int __real_pthread_create(pthread_t*, const pthread_attr_t*, void* (*)(void*), void*);
+extern "C" int __real_pthread_join(pthread_t, void**);
+extern "C" void __real_pthread_exit(void*) __attribute__((noreturn));
+
+// Counters (PosixCompat.h): creation attempts, threads whose start routine has not returned (a
+// thread that ends in pthread_exit is taken off the count by the pthread_exit wrapper), failures,
+// threads that have ended but are not joined yet (kernel thread and stack still held), threads
+// queued for the reaper.
+std::atomic<long> g_switch2ThreadsCreated{0};
+std::atomic<long> g_switch2ThreadsLive{0};
+std::atomic<long> g_switch2ThreadCreateFailures{0};
+std::atomic<long> g_switch2ThreadsZombie{0};
+std::atomic<long> g_switch2ThreadsReapQueued{0};
+namespace
+{
+// Threads created around the records (the reaper; a thread whose record could not be allocated,
+// never taken off): part of the kernel thread count.
+std::atomic<long> g_threadsUntracked{0};
+} // namespace
+
+namespace
+{
+// libounce's __syscall_thread_create returns ENOMEM for every failure (the 64-byte control block,
+// threadCreate = stack heap allocation + virtmemFindStack + svcMapMemory + svcCreateThread,
+// svcSetThreadCoreMask, threadStart) and drops the Result. Its calls to these three cross an object
+// boundary (newlib.o -> thread.o/svc.o), so -Wl,--wrap (Install.cmake) sees them: the creating
+// thread keeps the last step and Result here.
+thread_local int t_threadStep = 0; // 0 none yet, 1 threadCreate, 2 svcSetThreadCoreMask, 3 threadStart
+thread_local Result t_threadRc = 0;
+
+const char* ThreadStepName(int step)
+{
+  switch (step)
+  {
+    case 1:
+      return "threadCreate";
+    case 2:
+      return "svcSetThreadCoreMask";
+    case 3:
+      return "threadStart";
+    default:
+      return "before-threadCreate";
+  }
+}
+
+// Startup probe (Switch2ThreadLimitProbe): how many more kernel threads the process could create
+// before any Kodi thread existed, and the kernel resource-limit handle query. -1 = not run.
+long g_tlFree = -1;
+bool g_tlCapped = false; // the probe stopped at its cap, not at a failure
+int g_tlCap = 0; // the probe's cap (rev 38h: 1024 DIAG, 160 release)
+Result g_tlStopRc = 0;
+long g_tlOursAtProbe = 0; // main + live + zombie threads of ours when the probe ran
+int g_tlCloseFails = 0; // probe threads whose threadClose failed (their slot stays taken)
+Result g_tlReprobeRc = 0; // one more create + close after the probe: the slots came back
+Result g_tlReprobeCloseRc = 0;
+unsigned long long g_tlProbeMs = 0;
+Result g_rlQueryRc = 0;
+unsigned long long g_rlHandle = 0;
+long long g_rlCur = -1, g_rlLimit = -1; // DIAG + flag only (see Switch2ThreadLimitProbe)
+#if SWITCH2_DIAG
+Result g_rlCurRc = 0, g_rlLimitRc = 0;
+#endif
+} // namespace
+
+extern "C" Result __real_threadCreate(Thread*, ThreadFunc, void*, void*, size_t, int, int);
+extern "C" Result __real_threadStart(Thread*);
+extern "C" Result __real_svcSetThreadCoreMask(Handle, s32, u32);
+
+extern "C" Result __wrap_threadCreate(
+    Thread* t, ThreadFunc entry, void* arg, void* stack_mem, size_t stack_sz, int prio, int cpuid)
+{
+  const Result rc = __real_threadCreate(t, entry, arg, stack_mem, stack_sz, prio, cpuid);
+  t_threadStep = 1;
+  t_threadRc = rc;
+  return rc;
+}
+
+extern "C" Result __wrap_threadStart(Thread* t)
+{
+  const Result rc = __real_threadStart(t);
+  t_threadStep = 3;
+  t_threadRc = rc;
+  return rc;
+}
+
+extern "C" Result __wrap_svcSetThreadCoreMask(Handle handle, s32 preferred_core, u32 affinity_mask)
+{
+  const Result rc = __real_svcSetThreadCoreMask(handle, preferred_core, affinity_mask);
+  t_threadStep = 2;
+  t_threadRc = rc;
+  return rc;
+}
+
+// ---------------------------------------------------------------------------------------------
+// Kernel thread limit (rev 36). The rev 35 first-failure line asked svcGetInfo(ResourceLimit) with
+// CUR_PROCESS_HANDLE: the kernel wants INVALID_HANDLE there (0xe401 InvalidHandle, operator log
+// 2026-11-25) and the limit read nothing. Reading the limit itself needs svcGetResourceLimitLimitValue/
+// CurrentValue (0x30/0x31), which are not known to be in this title's SVC mask (S2 mask unmeasured; a
+// denied SVC ends the process, finding 1022): release builds never call them, a diagnostics build
+// only with sdmc:/switch/kodi/diag-rlimit.flag and a flushed boot.txt line before each call.
+// What every build does instead: before Kodi starts any thread, create (never start) up to 160 (DIAG: 1024, rev 38g)
+// kernel threads with 4 KiB stacks until creation fails, then close them all. svcCreateThread
+// reserves from the process's thread limit at creation, so the count is the free part of the
+// limit; the cap keeps the probe from taking more than the cap of the console's kernel thread objects
+// for those few milliseconds.
+// ---------------------------------------------------------------------------------------------
+namespace
+{
+void ProbeEntry(void*)
+{
+} // never runs: the probe threads are created, never started
+
+#if SWITCH2_DIAG
+bool FileExists(const char* path)
+{
+  FILE* f = fopen(path, "rb");
+  if (!f)
+    return false;
+  fclose(f);
+  return true;
+}
+#endif
+
+long OursNow()
+{
+  return 1 + g_switch2ThreadsLive.load() + g_switch2ThreadsZombie.load() + g_threadsUntracked.load();
+}
+} // namespace
+
+extern "C" void Switch2ThreadLimitProbe(void)
+{
+  if (g_tlFree >= 0)
+    return;
+  u64 h = 0;
+  g_rlQueryRc = svcGetInfo(&h, InfoType_ResourceLimit, INVALID_HANDLE, 0);
+  g_rlHandle = h;
+  const Handle limit = static_cast<Handle>(h);
+  if (R_SUCCEEDED(g_rlQueryRc) && limit != INVALID_HANDLE)
+  {
+#if SWITCH2_DIAG
+    if (FileExists("sdmc:/switch/kodi/diag-rlimit.flag"))
+    {
+      s64 v = 0;
+      Switch2DiagLog("rlimit: svcGetResourceLimitLimitValue(0x%x, Threads) pre (if the log ends "
+                     "here, SVC 0x30 is not permitted for this title)",
+                     static_cast<unsigned>(limit));
+      g_rlLimitRc = svcGetResourceLimitLimitValue(&v, limit, LimitableResource_Threads);
+      if (R_SUCCEEDED(g_rlLimitRc))
+        g_rlLimit = v;
+      Switch2DiagLog("rlimit: svcGetResourceLimitCurrentValue pre (limit rc=0x%x value=%lld)",
+                     static_cast<unsigned>(g_rlLimitRc), g_rlLimit);
+      g_rlCurRc = svcGetResourceLimitCurrentValue(&v, limit, LimitableResource_Threads);
+      if (R_SUCCEEDED(g_rlCurRc))
+        g_rlCur = v;
+      Switch2DiagLog("rlimit: done (current rc=0x%x value=%lld)", static_cast<unsigned>(g_rlCurRc),
+                     g_rlCur);
+    }
+#endif
+    svcCloseHandle(limit);
+  }
+
+  // Rev 38g/38h: DIAG builds probe up to 1024 (160 was always reached: ">=161"), so they find the real
+  // free count and a later launch in the same loader process shows kernel threads an earlier launch
+  // left. Release keeps 160: kernel thread/memory objects are console-wide, and taking 1024 of them for
+  // a few ms at every launch is a small risk for system processes (reviewer, rev 38h).
+#if SWITCH2_DIAG
+  constexpr int kMax = 1024;
+#else
+  constexpr int kMax = 160;
+#endif
+  g_tlCap = kMax;
+  static Thread probe[kMax];
+  const u64 t0 = armGetSystemTick();
+  int n = 0;
+  Result stop = 0;
+  for (; n < kMax; ++n)
+  {
+    stop = threadCreate(&probe[n], ProbeEntry, nullptr, nullptr, 0x1000, 0x3B, -2);
+    if (R_FAILED(stop))
+      break;
+  }
+  for (int i = 0; i < n; ++i)
+    if (R_FAILED(threadClose(&probe[i])))
+      ++g_tlCloseFails;
+  // The slots must be free again: one more thread created and closed (fails if the closes did not
+  // give the kernel threads back and the probe ended at the limit).
+  {
+    static Thread again;
+    g_tlReprobeRc = threadCreate(&again, ProbeEntry, nullptr, nullptr, 0x1000, 0x3B, -2);
+    if (R_SUCCEEDED(g_tlReprobeRc))
+      g_tlReprobeCloseRc = threadClose(&again);
+  }
+  g_tlProbeMs = armTicksToNs(armGetSystemTick() - t0) / 1000000ULL;
+  g_tlCapped = n == kMax;
+  g_tlStopRc = g_tlCapped ? 0 : stop;
+  g_tlOursAtProbe = OursNow();
+  g_tlFree = n;
+  t_threadStep = 0;
+  t_threadRc = 0;
+  char line[320];
+  Switch2ThreadLimitLine(line, sizeof(line));
+  Switch2DiagLog("%s", line);
+}
+
+extern "C" int Switch2ThreadLimitLine(char* buf, unsigned long size)
+{
+  if (!buf || size == 0)
+    return 0;
+  if (g_tlFree < 0)
+    return snprintf(buf, size, "thread limit cur/limit: not probed");
+  const long limit = g_tlOursAtProbe + g_tlFree;
+  char kern[96] = "";
+  if (g_rlLimit >= 0 || g_rlCur >= 0)
+    snprintf(kern, sizeof(kern), "; kernel resource limit %lld/%lld", g_rlCur, g_rlLimit);
+  return snprintf(buf, size,
+                  "thread limit cur/limit: %ld/%s%ld at startup (probe cap %d created %ld more in %llu ms, "
+                  "%s 0x%x (module %u desc %u); close failures %d; reprobe %s rc=0x%x close rc=0x%x; "
+                  "resource-limit handle query rc=0x%x handle=0x%llx%s)",
+                  g_tlOursAtProbe, g_tlCapped ? ">=" : "", limit, g_tlCap, g_tlFree, g_tlProbeMs,
+                  g_tlCapped ? "cap reached, stop" : "stopped by", static_cast<unsigned>(g_tlStopRc),
+                  R_MODULE(g_tlStopRc), R_DESCRIPTION(g_tlStopRc), g_tlCloseFails,
+                  R_SUCCEEDED(g_tlReprobeRc) && R_SUCCEEDED(g_tlReprobeCloseRc) ? "ok" : "fail",
+                  static_cast<unsigned>(g_tlReprobeRc), static_cast<unsigned>(g_tlReprobeCloseRc),
+                  static_cast<unsigned>(g_rlQueryRc),
+                  g_rlHandle, kern);
+}
+
+extern "C" int Switch2ThreadCountsLine(char* buf, unsigned long size)
+{
+  if (!buf || size == 0)
+    return 0;
+  const long ours = OursNow();
+  if (g_tlFree < 0)
+    return snprintf(buf, size, "threads ours=%ld live=%ld zombie=%ld reapq=%ld created=%ld failed=%ld",
+                    ours, g_switch2ThreadsLive.load(), g_switch2ThreadsZombie.load(),
+                    g_switch2ThreadsReapQueued.load(), g_switch2ThreadsCreated.load(),
+                    g_switch2ThreadCreateFailures.load());
+  const long limit = g_tlOursAtProbe + g_tlFree;
+  // cur = main + running + exited-unjoined threads of ours (every kernel thread of kodi.bin is a
+  // pthread: the only threadCreate caller is libounce's __syscall_thread_create); limit as probed.
+  return snprintf(buf, size,
+                  "threads cur/limit=%ld/%s%ld live=%ld zombie=%ld reapq=%ld created=%ld failed=%ld",
+                  ours, g_tlCapped ? ">=" : "", limit, g_switch2ThreadsLive.load(),
+                  g_switch2ThreadsZombie.load(), g_switch2ThreadsReapQueued.load(),
+                  g_switch2ThreadsCreated.load(), g_switch2ThreadCreateFailures.load());
+}
+
+namespace
+{
+std::atomic<bool> g_tlLogged{false};
+}
+
+extern "C" void Switch2LogThreadLimit(void)
+{
+  if (!CServiceBroker::IsLoggingUp() || g_tlLogged.exchange(true))
+    return;
+  char line[320];
+  Switch2ThreadLimitLine(line, sizeof(line));
+  try
+  {
+    CLog::Log(LOGINFO, "switch2: {}", line);
+  }
+  catch (...)
+  {
+  }
+}
+
+namespace
+{
+// The first failure, captured where it happened; written to kodi.log once (now, or by the next
+// Switch2LogThreadCreateFailure() if Kodi's log was not up yet).
+std::atomic<bool> g_tcfCaptured{false};
+std::atomic<bool> g_tcfLogged{false};
+std::atomic<bool> g_tcfReady{false};
+char g_tcfLine[640];
+
+void CaptureFirstFailure(int rc, size_t stack, int step, Result res, uintptr_t lr)
+{
+  if (g_tcfCaptured.exchange(true))
+    return;
+  u64 used = 0, total = 0;
+  svcGetInfo(&used, InfoType_UsedMemorySize, CUR_PROCESS_HANDLE, 0);
+  svcGetInfo(&total, InfoType_TotalMemorySize, CUR_PROCESS_HANDLE, 0);
+  const struct mallinfo mi = mallinfo();
+  const unsigned long long base = Switch2TextBase();
+  char counts[200];
+  Switch2ThreadCountsLine(counts, sizeof(counts));
+  const int n = snprintf(
+      g_tcfLine, sizeof(g_tcfLine),
+      "first thread create failure: rc=%d stack=%zu last=%s result=0x%x (module %u desc %u) %s "
+      "mem used=%llu total=%llu heap arena=%llu inuse=%llu free=%llu lr=0x%llx",
+      rc, stack, ThreadStepName(step), static_cast<unsigned>(res), R_MODULE(res),
+      R_DESCRIPTION(res), counts, static_cast<unsigned long long>(used),
+      static_cast<unsigned long long>(total), static_cast<unsigned long long>(mi.arena),
+      static_cast<unsigned long long>(mi.uordblks), static_cast<unsigned long long>(mi.fordblks),
+      static_cast<unsigned long long>(lr >= base ? lr - base : lr));
+  if (n <= 0)
+    return;
+  g_tcfReady.store(true);
+  // boot.txt: "<ms> first thread create failure: ..." (raw fs IPC, safe before/after CLog).
+  Switch2DiagLog("%s", g_tcfLine);
+}
+
+void LogFirstFailureToKodiLog()
+{
+  if (!g_tcfReady.load() || g_tcfLogged.load())
+    return;
+  // CLog exists from CAppEnvironment::SetUp to TearDown; threads created outside that window
+  // (OpenSSL warm-up, USB attach) leave the line for the next caller.
+  if (!CServiceBroker::IsLoggingUp())
+    return;
+  if (g_tcfLogged.exchange(true))
+    return;
+  try
+  {
+    CLog::Log(LOGERROR, "switch2: {}", g_tcfLine);
+    char line[320];
+    Switch2ThreadLimitLine(line, sizeof(line));
+    CLog::Log(LOGERROR, "switch2: {}", line);
+  }
+  catch (...)
+  {
+  }
+}
+} // namespace
+
+extern "C" void Switch2LogThreadCreateFailure(void)
+{
+  LogFirstFailureToKodiLog();
+}
+
+#if SWITCH2_DIAG
+// Diagnostics build only (ENABLE_SWITCH2_DIAG): one boot.txt line per created thread, start/exit
+// lines for CPython's threads, and the memory monitor (main.cpp) reads the counters.
+std::atomic<long> g_switch2PyThreadsLive{0};
+
+namespace
+{
+// CPython creates its threads with an attribute whose stack size is THREAD_STACK_SIZE (0xC0000,
+// deps/patches/python3/0004; before rev 35 the patch was dead code and Python threads had NULL
+// attributes). No other thread creation in Kodi's own sources asks for exactly that size.
+constexpr size_t kPyThreadStack = 0xC0000;
+
+// "<ms> THREAD create rc=.. stack=<bytes> start=<off> lr=<off> fp=<off>,<off>,<off>" (offsets from
+// the image base; stack = the attribute's size, or the 1 MiB default applied here). fp = return
+// addresses of the next three frames above the caller (frame-pointer chain), which name the creator
+// behind a shared trampoline (std::thread, Mesa's thrd_create, CPython). "cur=" = Switch2ThreadCountsLine.
+void ThreadCreateLog(int rc, size_t stack, void* (*start)(void*), uintptr_t lr, const uintptr_t* fps)
+{
+  const unsigned long long base = Switch2TextBase();
+  const uintptr_t s = reinterpret_cast<uintptr_t>(start);
+  auto off = [base](uintptr_t a) {
+    return static_cast<unsigned long long>(a >= base ? a - base : a);
+  };
+  char counts[200];
+  Switch2ThreadCountsLine(counts, sizeof(counts));
+  char line[400];
+  const int n = snprintf(line, sizeof(line),
+                         "%llu THREAD create rc=%d stack=%zu start=0x%llx lr=0x%llx fp=0x%llx,0x%llx,0x%llx %s\n",
+                         static_cast<unsigned long long>(armTicksToNs(armGetSystemTick()) / 1000000ULL),
+                         rc, stack, off(s), off(lr), off(fps[0]), off(fps[1]), off(fps[2]), counts);
+  if (n > 0)
+    Switch2RawAppend("/switch/kodi/boot.txt", line,
+                     static_cast<size_t>(n) < sizeof(line) ? static_cast<size_t>(n) : sizeof(line) - 1);
+}
+
+// Return addresses of up to three frames above `fp` (the frame of __wrap_pthread_create's caller).
+// Stops at a frame record that is null, misaligned, not above the previous one or more than 1 MiB
+// away (a thread's stack is at most a few MiB; this never reads outside the current stack).
+void CallerChain(const uintptr_t* fp, uintptr_t* out)
+{
+  out[0] = out[1] = out[2] = 0;
+  for (int i = 0; i < 3 && fp; ++i)
+  {
+    const uintptr_t* next = reinterpret_cast<const uintptr_t*>(fp[0]);
+    const uintptr_t cur = reinterpret_cast<uintptr_t>(fp);
+    const uintptr_t nxt = reinterpret_cast<uintptr_t>(next);
+    if (!next || (nxt & 0xF) || nxt <= cur || nxt - cur > (1u << 20))
+      break;
+    out[i] = next[1];
+    fp = next;
+  }
+}
+} // namespace
+#endif // SWITCH2_DIAG
+
+// ---------------------------------------------------------------------------------------------
+// Thread records (rev 36; rev 38f: no pthread_t value joined twice): ThreadRecords.inc, shared with the
+// host test homebrew/kodi/hosttools/tests/thread_records_test.cpp. Hooks it needs from here:
+// ---------------------------------------------------------------------------------------------
+namespace
+{
+// svcArbitrateLock diagnostic (rev 38f, CrashHandler.cpp __wrap_svcArbitrateLock): the kernel handle of
+// every recorded thread, lock-free so it can be read inside a failing mutexLock. state 1 = running,
+// 2 = ended (not joined); a joined thread's handle goes to a small ring of recently closed handles.
+constexpr int kHandleSlots = 512;
+std::atomic<u32> g_thrHandle[kHandleSlots];
+std::atomic<u8> g_thrHandleState[kHandleSlots];
+constexpr unsigned kJoinedRing = 128;
+std::atomic<u32> g_joinedHandles[kJoinedRing];
+std::atomic<unsigned> g_joinedNext{0};
+
+void ThreadHandleBegin(int* slot)
+{
+  const u32 h = threadGetCurHandle();
+  for (int i = 0; i < kHandleSlots; ++i)
+  {
+    u32 expected = 0;
+    if (g_thrHandle[i].load(std::memory_order_relaxed) == 0 &&
+        g_thrHandle[i].compare_exchange_strong(expected, h))
+    {
+      g_thrHandleState[i].store(1);
+      *slot = i;
+      return;
+    }
+  }
+}
+void ThreadHandleEnded(int slot)
+{
+  if (slot >= 0)
+    g_thrHandleState[slot].store(2);
+}
+void ThreadHandleJoined(int slot)
+{
+  if (slot < 0)
+    return;
+  const u32 h = g_thrHandle[slot].load();
+  g_joinedHandles[g_joinedNext.fetch_add(1) % kJoinedRing].store(h);
+  g_thrHandleState[slot].store(0);
+  g_thrHandle[slot].store(0);
+}
+void DetachUnknownLeaked(long n)
+{
+  if (n <= 4 || n % 100 == 0)
+    Switch2BootLog("detach-without-record leaked (not joined) n", n);
+}
+void ReaperStopped(int rc)
+{
+  Switch2BootLog("reaper-stopped join rc", rc);
+}
+void ReaperStarted(int rc)
+{
+#if SWITCH2_DIAG
+  Switch2BootLog(rc == 0 ? "reaper-started" : "reaper-pthread_create-failed", rc);
+#else
+  if (rc != 0)
+    Switch2BootLog("reaper-pthread_create-failed", rc);
+#endif
+}
+} // namespace
+
+// 0 = not a recorded thread's handle, 1 = running, 2 = ended not joined, 3 = recently joined (closed).
+extern "C" int Switch2ThreadHandleState(unsigned int h)
+{
+  if (!h)
+    return 0;
+  for (int i = 0; i < kHandleSlots; ++i)
+    if (g_thrHandle[i].load(std::memory_order_relaxed) == h)
+      return g_thrHandleState[i].load(std::memory_order_relaxed);
+  for (unsigned i = 0; i < kJoinedRing; ++i)
+    if (g_joinedHandles[i].load(std::memory_order_relaxed) == h)
+      return 3;
+  return 0;
+}
+
