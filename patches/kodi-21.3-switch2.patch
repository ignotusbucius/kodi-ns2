+// ----------------------------------------------------------------------------------------------
+// fsdev (SD card) POSIX fixes. Measured on hardware (findings 1496-1498):
+//  * read() at or past end-of-file fails with EIO where POSIX returns 0 (sqlite maps EIO to
+//    SQLITE_CORRUPT/IOERR);
+//  * stat() of a file reopens it by path, and any second open of a file that is open for writing
+//    fails with EIO, so stat()/access() of an open database, log or settings file fails.
+// Wrapped at the newlib reentrant layer (-Wl,--wrap=_read_r,--wrap=_stat_r,--wrap=_open_r,
+// --wrap=_close_r,--wrap=lstat, see cmake/scripts/switch2/Install.cmake), so read(), stat(),
+// access(), fopen()/fread() (newlib __sread) and sqlite's system-call table all go through here.
+// ----------------------------------------------------------------------------------------------
+#include <atomic>
+#include <cerrno>
+#include <cstdint>
+#include <cstdio>
+#include <cstring>
+#include <fcntl.h>
+#include <reent.h>
+#include <sys/stat.h>
+#include <unistd.h>
+
+#include <switch.h>
+
+extern "C" _ssize_t __real__read_r(struct _reent* r, int fd, void* buf, size_t count);
+extern "C" int __real__open_r(struct _reent* r, const char* path, int flags, int mode);
+extern "C" int __real__close_r(struct _reent* r, int fd);
+extern "C" int __real__stat_r(struct _reent* r, const char* path, struct stat* st);
+extern "C" int __real_lstat(const char* path, struct stat* st);
+
+// Build with -DSWITCH2_STATFAIL_LOG=1 to append every stat()/lstat() failure other than ENOENT to
+// sdmc:/switch/kodi/boot.txt (rev 6 instrument; off by default, it was the bulk of boot.txt).
+#ifndef SWITCH2_STATFAIL_LOG
+#define SWITCH2_STATFAIL_LOG 0
+#endif
+
+namespace
+{
+// fd registry: which newlib fds are fsdev files, opened readable, and under which path. Indexed by
+// fd, lock-free (an fd number is only reused after its close). Lets read() bound itself by the file
+// size and lets stat() of an open file take its size from the open fd instead of a second open.
+constexpr int kMaxTrackedFd = 1024;
+constexpr uint32_t kTracked = 1u << 0;
+constexpr uint32_t kReadable = 1u << 1;
+// open() access mode + 1 in bits 4-5 (0 = unknown), for fcntl(F_GETFL) on files.
+constexpr uint32_t kAccShift = 4;
+constexpr uint32_t kAccMask = 3u << kAccShift;
+
+struct FdInfo
+{
+  std::atomic<uint64_t> hash{0};
+  std::atomic<uint32_t> flags{0};
+};
+FdInfo g_fds[kMaxTrackedFd];
+
+uint64_t PathHash(const FsFileSystem* fs, const char* fspath)
+{
+  uint64_t h = 1469598103934665603ULL ^ reinterpret_cast<uintptr_t>(fs);
+  for (const unsigned char* p = reinterpret_cast<const unsigned char*>(fspath); *p; ++p)
+  {
+    h ^= *p;
+    h *= 1099511628211ULL;
+  }
+  return h ? h : 1;
+}
+
+// Resolves `path` to its fsdev file system and fs path (relative paths use fsdev's cwd).
+bool Translate(const char* path, FsFileSystem** fs, char (&fspath)[FS_MAX_PATH])
+{
+  *fs = nullptr;
+  fspath[0] = '\0';
+  const int saved = errno;
+  const bool ok = path && fsdevTranslatePath(path, fs, fspath) == 0 && *fs;
+  errno = saved;
+  return ok;
+}
+
+int FindOpenFd(uint64_t hash)
+{
+  for (int fd = 0; fd < kMaxTrackedFd; ++fd)
+    if ((g_fds[fd].flags.load(std::memory_order_acquire) & kTracked) &&
+        g_fds[fd].hash.load(std::memory_order_relaxed) == hash)
+      return fd;
+  return -1;
+}
+
+// Closes in flight: the path hash of every tracked fd whose close() has started but not returned.
+// close() takes the fd out of the registry before the FS has closed the file, and until it has, a
+// stat() or open() of that path still fails with EIO, yet the registry no longer explains why (rev
+// 33d: Kodi's database connections open and close the same file on several threads at once). Such
+// a stat()/open() waits here for the close to finish and then asks the FS again. A full table only
+// loses the wait (the old behaviour).
+constexpr int kClosingSlots = 64;
+std::atomic<uint64_t> g_closing[kClosingSlots];
+
+int ClosingBegin(uint64_t hash)
+{
+  for (int i = 0; i < kClosingSlots; ++i)
+  {
+    uint64_t expected = 0;
+    if (g_closing[i].compare_exchange_strong(expected, hash, std::memory_order_acq_rel))
+      return i;
+  }
+  return -1;
+}
+
+void ClosingEnd(int slot)
+{
+  if (slot >= 0)
+    g_closing[slot].store(0, std::memory_order_release);
+}
+
+bool IsClosing(uint64_t hash)
+{
+  for (int i = 0; i < kClosingSlots; ++i)
+    if (g_closing[i].load(std::memory_order_acquire) == hash)
+      return true;
+  return false;
+}
+
+// True when a close of `hash` was in flight; returns once it has finished (at most ~1 s).
+bool WaitWhileClosing(uint64_t hash)
+{
+  if (!IsClosing(hash))
+    return false;
+  int ms = 0;
+  for (; ms < 1000 && IsClosing(hash); ++ms)
+    svcSleepThread(1000000LL);
+  SWITCH2_DIAG_LOG("fs close-wait %d ms%s", ms, ms >= 1000 ? " (gave up)" : ""); // DIAG only
+  return true;
+}
+
+#if SWITCH2_STATFAIL_LOG
+std::atomic<int> g_statFailLines{0};
+
+void StatFailLog(const char* what, const char* path, int err, bool recovered)
+{
+  if (g_statFailLines.fetch_add(1) >= 256) // bounded: a hot failing path must not flood the SD
+    return;
+  char line[400];
+  const int n = snprintf(line, sizeof(line), "%s-fail path=%s errno=%d fallback=%d\n", what,
+                         path ? path : "-", err, recovered ? 1 : 0);
+  if (n > 0)
+    Switch2RawAppend("/switch/kodi/boot.txt", line,
+                     static_cast<size_t>(n) < sizeof(line) ? static_cast<size_t>(n) : sizeof(line) - 1);
+}
+#endif
+
+// stat() answer for a path whose fsdev stat failed with EIO because the file is open for writing in
+// this process (the measured cause: fsdev's stat reopens the file by path, and this FS refuses a
+// second open of a file open for writing). Answered only when that is the case: the entry exists
+// (fsFsGetEntryType, no open) and, for a file, our fd registry has it open (size and times then
+// come from that fd). A file that is not open in this process keeps its real EIO (rev 25: before,
+// any existing path with an EIO stat was reported as existing, size 0). Directories are answered
+// from the entry type alone. A file whose close() is in flight is waited for and reported as
+// kRetry: the caller asks the FS again (rev 34).
+enum class StatFb
+{
+  kAnswered,
+  kGenuine,
+  kRetry
+};
+
+StatFb StatFallback(struct _reent* r, const char* path, struct stat* st)
+{
+  FsFileSystem* fs;
+  char fspath[FS_MAX_PATH];
+  FsDirEntryType type;
+  if (!Translate(path, &fs, fspath) || R_FAILED(fsFsGetEntryType(fs, fspath, &type)))
+    return StatFb::kGenuine;
+  if (type != FsDirEntryType_File)
+  {
+    std::memset(st, 0, sizeof(*st));
+    st->st_nlink = 1;
+    st->st_mode = S_IFDIR | 0755;
+    return StatFb::kAnswered;
+  }
+  const uint64_t hash = PathHash(fs, fspath);
+  const int fd = FindOpenFd(hash);
+  if (fd < 0) // not open here: a genuine EIO, unless a close of it was still on its way
+    return WaitWhileClosing(hash) ? StatFb::kRetry : StatFb::kGenuine;
+  std::memset(st, 0, sizeof(*st));
+  st->st_nlink = 1;
+  st->st_mode = S_IFREG | 0644;
+  struct stat fst;
+  const int saved = r->_errno;
+  if (_fstat_r(r, fd, &fst) == 0 && S_ISREG(fst.st_mode))
+  {
+    *st = fst;
+    st->st_mode |= 0644;
+    if (st->st_nlink == 0)
+      st->st_nlink = 1;
+  }
+  r->_errno = saved;
+  return StatFb::kAnswered;
+}
+
+// stat()/lstat() through `real` with the EIO fallback above; one FS retry after a close in flight.
+template<typename Real>
+int StatWithFallback(struct _reent* r, const char* path, struct stat* st, const char* what, Real real)
+{
+  const int before = r->_errno;
+  int rc = real();
+  for (int attempt = 0; rc != 0 && r->_errno == EIO; ++attempt)
+  {
+    const int err = r->_errno;
+    const StatFb fb = StatFallback(r, path, st);
+#if SWITCH2_STATFAIL_LOG
+    StatFailLog(what, path, err, fb == StatFb::kAnswered);
+#else
+    (void)what;
+#endif
+    if (fb == StatFb::kAnswered)
+    {
+      r->_errno = before;
+      return 0;
+    }
+    r->_errno = err;
+    if (fb != StatFb::kRetry || attempt > 0)
+      break;
+    rc = real();
+  }
+  return rc;
+}
+} // namespace
+
+extern "C" int Switch2PathIsOpen(const char* path)
+{
+  FsFileSystem* fs;
+  char fspath[FS_MAX_PATH];
+  return Translate(path, &fs, fspath) && FindOpenFd(PathHash(fs, fspath)) >= 0;
+}
+
+extern "C" int __wrap__open_r(struct _reent* r, const char* path, int flags, int mode)
+{
+  int fd = __real__open_r(r, path, flags, mode);
+  if (fd < 0 && r->_errno == EIO)
+  {
+    // The FS refuses a second open of a file that is open for writing; when that file's close()
+    // was in flight in another thread, wait for it and open again (rev 34).
+    FsFileSystem* fs;
+    char fspath[FS_MAX_PATH];
+    if (Translate(path, &fs, fspath) && WaitWhileClosing(PathHash(fs, fspath)))
+      fd = __real__open_r(r, path, flags, mode);
+  }
+  if (fd >= 0 && fd < kMaxTrackedFd)
+  {
+    FsFileSystem* fs;
+    char fspath[FS_MAX_PATH];
+    if (Translate(path, &fs, fspath))
+    {
+      g_fds[fd].hash.store(PathHash(fs, fspath), std::memory_order_relaxed);
+      g_fds[fd].flags.store(kTracked | ((flags & O_ACCMODE) != O_WRONLY ? kReadable : 0) |
+                                ((static_cast<uint32_t>(flags & O_ACCMODE) + 1) << kAccShift),
+                            std::memory_order_release);
+    }
+    else
+      g_fds[fd].flags.store(0, std::memory_order_release);
+  }
+  return fd;
+}
+
+extern "C" int __wrap__close_r(struct _reent* r, int fd)
+{
+  // Listed as closing before it leaves the registry, so a concurrent stat()/open() of the path
+  // always sees one of the two until the FS close has returned.
+  int slot = -1;
+  if (fd >= 0 && fd < kMaxTrackedFd)
+  {
+    if (g_fds[fd].flags.load(std::memory_order_acquire) & kTracked)
+      slot = ClosingBegin(g_fds[fd].hash.load(std::memory_order_relaxed));
+    g_fds[fd].flags.store(0, std::memory_order_release);
+  }
+  const int rc = __real__close_r(r, fd);
+  ClosingEnd(slot);
+  return rc;
+}
+
+// read(): for a readable fsdev file, take the position and size first: at/after EOF return 0 without
+// calling fsdev (whose EOF read fails with EIO, and whose bounce-buffer path would loop), otherwise
+// clamp the count to the bytes that exist. Sockets, romfs and other devices pass straight through.
+extern "C" _ssize_t __wrap__read_r(struct _reent* r, int fd, void* buf, size_t count)
+{
+  if (count != 0 && fd >= 0 && fd < kMaxTrackedFd &&
+      (g_fds[fd].flags.load(std::memory_order_acquire) & kReadable))
+  {
+    const int saved = r->_errno;
+    const _off_t pos = _lseek_r(r, fd, 0, SEEK_CUR);
+    struct stat st;
+    if (pos >= 0 && _fstat_r(r, fd, &st) == 0 && S_ISREG(st.st_mode))
+    {
+      if (pos >= st.st_size)
+      {
+        r->_errno = saved;
+        return 0;
+      }
+      const uint64_t left = static_cast<uint64_t>(st.st_size - pos);
+      if (count > left)
+        count = static_cast<size_t>(left);
+    }
+    r->_errno = saved;
+  }
+  const _ssize_t n = __real__read_r(r, fd, buf, count);
+  if (n < 0 && r->_errno == EIO)
+  {
+    // Untracked fd, or the file shrank under us: keep the rev 5 rule (EIO at/after EOF -> 0).
+    const int saved = r->_errno;
+    const _off_t pos = _lseek_r(r, fd, 0, SEEK_CUR);
+    struct stat st;
+    if (pos >= 0 && _fstat_r(r, fd, &st) == 0 && S_ISREG(st.st_mode) && pos >= st.st_size)
+    {
+      r->_errno = saved;
+      return 0;
+    }
+    r->_errno = saved;
+  }
+  return n;
+}
+
+extern "C" int __wrap__stat_r(struct _reent* r, const char* path, struct stat* st)
+{
+  return StatWithFallback(r, path, st, "stat", [&] { return __real__stat_r(r, path, st); });
+}
+
+// lstat() is its own libsysbase entry (it calls the devoptab directly, not _stat_r); it sets errno,
+// which is _REENT->_errno.
+extern "C" int __wrap_lstat(const char* path, struct stat* st)
+{
+  return StatWithFallback(_REENT, path, st, "lstat", [&] { return __real_lstat(path, st); });
+}
+
+// fcntl() wrapper (-Wl,--wrap=fcntl, see Install.cmake). libounce's fcntl() is the BSD-socket one:
+// it accepts only F_GETFL/F_SETFL, on socket fds, and returns 95 (EOPNOTSUPP as a value, not -1 with
+// errno) for every other command. CPython's _Py_dup (F_DUPFD_CLOEXEC) then took "95" as the new fd.
+// Socket fds (the newlib handle's devoptab is libounce's "soc", the test its own _socketGetFd makes)
+// keep the real F_GETFL/F_SETFL (O_NONBLOCK); every other command, on any fd, is answered here:
+//   F_DUPFD/F_DUPFD_CLOEXEC dup() until the new fd is >= arg (extras closed); F_GETFD -> FD_CLOEXEC
+//   (there is no exec); F_SETFD, F_SETLK, F_SETLKW -> 0 (one process, no other lock holder);
+//   F_GETLK -> l_type = F_UNLCK; F_GETFL on a file -> its open() access mode (O_RDWR if unknown);
+//   F_SETFL on a file -> 0; anything else -> -1/EINVAL.
+#include <cstdarg>
+#include <sys/iosupport.h>
+
+extern "C" int __real_fcntl(int fd, int cmd, ...);
+
+namespace
+{
+bool IsSocketFd(int fd)
+{
+  __handle* h = __get_handle(fd);
+  if (!h || h->device >= STD_MAX || !devoptab_list[h->device] || !devoptab_list[h->device]->name)
+    return false;
+  return std::strcmp(devoptab_list[h->device]->name, "soc") == 0;
+}
+
+int DupAtLeast(int fd, int minfd)
+{
+  if (minfd < 0)
+  {
+    errno = EINVAL;
+    return -1;
+  }
+  int extras[64];
+  int nextras = 0;
+  int nfd = dup(fd);
+  while (nfd >= 0 && nfd < minfd && nextras < 64)
+  {
+    extras[nextras++] = nfd;
+    nfd = dup(fd);
+  }
+  const int saved = errno;
+  for (int i = 0; i < nextras; ++i)
+    close(extras[i]);
+  if (nfd >= 0 && nfd < minfd)
+  {
+    close(nfd);
+    errno = EMFILE;
+    return -1;
+  }
+  if (nfd >= 0 && nfd < kMaxTrackedFd && fd >= 0 && fd < kMaxTrackedFd)
+  {
+    // The duplicate refers to the same file: same registry entry (read() bound, stat() fallback).
+    g_fds[nfd].hash.store(g_fds[fd].hash.load(std::memory_order_relaxed), std::memory_order_relaxed);
+    g_fds[nfd].flags.store(g_fds[fd].flags.load(std::memory_order_acquire), std::memory_order_release);
+  }
+  if (nfd < 0)
+    errno = saved;
+  return nfd;
+}
+} // namespace
+
+extern "C" int __wrap_fcntl(int fd, int cmd, ...)
+{
+  va_list ap;
+  va_start(ap, cmd);
+  int rc;
+  switch (cmd)
+  {
+    case F_GETFL:
+      if (IsSocketFd(fd))
+        rc = __real_fcntl(fd, F_GETFL);
+      else if (!__get_handle(fd))
+      {
+        errno = EBADF;
+        rc = -1;
+      }
+      else
+      {
+        const uint32_t f = fd >= 0 && fd < kMaxTrackedFd
+                               ? g_fds[fd].flags.load(std::memory_order_acquire)
+                               : 0;
+        rc = (f & kAccMask) ? static_cast<int>(((f & kAccMask) >> kAccShift) - 1) : O_RDWR;
+      }
+      break;
+    case F_SETFL:
+    {
+      const int flags = va_arg(ap, int);
+      if (IsSocketFd(fd))
+        rc = __real_fcntl(fd, F_SETFL, flags);
+      else if (__get_handle(fd))
+        rc = 0;
+      else
+      {
+        errno = EBADF;
+        rc = -1;
+      }
+      break;
+    }
+    case F_DUPFD:
+    case F_DUPFD_CLOEXEC:
+      rc = DupAtLeast(fd, va_arg(ap, int));
+      break;
+    case F_GETFD:
+      rc = __get_handle(fd) ? FD_CLOEXEC : -1;
+      if (rc == -1)
+        errno = EBADF;
+      break;
+    case F_SETFD:
+      (void)va_arg(ap, int);
+      rc = __get_handle(fd) ? 0 : -1;
+      if (rc == -1)
+        errno = EBADF;
+      break;
+    case F_GETLK:
+    {
+      struct flock* fl = va_arg(ap, struct flock*);
+      if (fl)
+        fl->l_type = F_UNLCK;
+      rc = 0;
+      break;
+    }
+    case F_SETLK:
+    case F_SETLKW:
+      (void)va_arg(ap, struct flock*);
+      rc = 0;
+      break;
+    default:
+      errno = EINVAL;
+      rc = -1;
+      break;
+  }
+  va_end(ap);
+  return rc;
+}
+
