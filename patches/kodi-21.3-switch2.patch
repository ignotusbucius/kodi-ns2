diff --git a/cmake/platform/switch2/switch2.cmake b/cmake/platform/switch2/switch2.cmake
new file mode 100644
index 0000000..cd08eec
--- /dev/null
+++ b/cmake/platform/switch2/switch2.cmake
@@ -0,0 +1,4 @@
+# Switch 2: one window (the default NWindow), GLES 3 through OunceVK's EGL.
