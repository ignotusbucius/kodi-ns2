+    return false;
+  CRenderSystemGLES::ResetRenderSystem(m_displayWidth, m_displayHeight);
+  return true;
+}
+
+void CWinSystemSwitch2GLESContext::QueryDisplaySize(int& outputW,
+                                                    int& outputH,
+                                                    int& guiW,
+                                                    int& guiH) const
+{
+  // AM's default display resolution for the current mode: 1920x1080 handheld, the TV output setting
+  // docked. Read only; nothing is changed (no appletUpdateDefaultDisplayResolution, no set:sys).
+  s32 w = 0, h = 0;
+  if (R_FAILED(appletGetDefaultDisplayResolution(&w, &h)) || w <= 0 || h <= 0)
+  {
+    w = 1920;
+    h = 1080;
+  }
+  outputW = w;
+  outputH = h;
+  // GUI cap, like GBM's videoscreen.limitguisize: never more than 1920x1080.
+  if (w > 1920 || h > 1080)
+  {
+    const float scale = std::min(1920.f / static_cast<float>(w), 1080.f / static_cast<float>(h));
+    w = static_cast<s32>(static_cast<float>(w) * scale + 0.5f);
+    h = static_cast<s32>(static_cast<float>(h) * scale + 0.5f);
+  }
+  guiW = w;
+  guiH = h;
+}
+
+// Called from MessagePump (the main/render thread) after appletMainLoop: on an operation-mode
+// message at once, otherwise at most every 2 s (the TV setting can change while docked).
+void CWinSystemSwitch2GLESContext::CheckDisplayChange()
+{
+  if (!m_bWindowCreated)
+    return;
+  const int mode = static_cast<int>(appletGetOperationMode());
+  const uint64_t nowNs = armTicksToNs(armGetSystemTick());
+  if (mode == m_operationMode && nowNs < m_nextDisplayPollNs)
+    return;
+  m_nextDisplayPollNs = nowNs + 2000000000ULL;
+
+  int outW, outH, guiW, guiH;
+  QueryDisplaySize(outW, outH, guiW, guiH);
+  if (mode == m_operationMode && outW == m_screenWidth && outH == m_screenHeight &&
+      guiW == m_displayWidth && guiH == m_displayHeight)
+    return;
+
+  Switch2DiagLog("display change mode=%d output=%dx%d window=%dx%d", mode, outW, outH, guiW, guiH);
+  CLog::Log(LOGINFO, "Switch2: display change mode={} output {}x{} window {}x{}", mode, outW, outH,
+            guiW, guiH);
+  m_operationMode = mode;
+  m_screenWidth = outW;
+  m_screenHeight = outH;
+  if (guiW == m_displayWidth && guiH == m_displayHeight)
+    return; // e.g. handheld <-> docked on a 1080p or 4K TV setting: same 1920x1080 surface
+
+  m_displayWidth = guiW;
+  m_displayHeight = guiH;
+  UpdateResolutions();
+  // Kodi -> SetFullScreen(RES_DESKTOP) -> CreateNewWindow -> RecreateSurface at the new size.
+  GetGfxContext().SetVideoResolution(RES_DESKTOP, true);
+}
+
+bool CWinSystemSwitch2GLESContext::RecreateSurface(int width, int height)
+{
+  {
+    std::unique_lock<CCriticalSection> lock(m_resourceSection);
+    for (IDispResource* resource : m_resources)
+      resource->OnLostDisplay();
+  }
+
+  // The NWindow cannot change size while buffers are registered: the EGL surface goes first.
+  m_eglContext.DestroySurface();
+  const Result rc = nwindowSetDimensions(m_window, width, height);
+  if (R_FAILED(rc))
+    CLog::Log(LOGERROR, "Switch2: nwindowSetDimensions({}x{}) failed 0x{:x}", width, height, rc);
+  if (!m_eglContext.CreateSurface(reinterpret_cast<EGLNativeWindowType>(m_window)) ||
+      !m_eglContext.BindContext())
+  {
+    Switch2DiagLog("egl surface recreate FAILED %dx%d", width, height);
+    return false;
+  }
+
+  EGLint sw = 0, sh = 0;
+  eglQuerySurface(m_eglContext.GetEGLDisplay(), m_eglContext.GetEGLSurface(), EGL_WIDTH, &sw);
+  eglQuerySurface(m_eglContext.GetEGLDisplay(), m_eglContext.GetEGLSurface(), EGL_HEIGHT, &sh);
+  Switch2DiagLog("egl surface %dx%d", sw, sh);
+
+  m_nWidth = width;
+  m_nHeight = height;
+  CRenderSystemGLES::ResetRenderSystem(width, height);
+
+  {
+    std::unique_lock<CCriticalSection> lock(m_resourceSection);
+    for (IDispResource* resource : m_resources)
+      resource->OnResetDisplay();
+  }
+  return true;
+}
+
+void CWinSystemSwitch2GLESContext::UpdateResolutions()
+{
+  CWinSystemBase::UpdateResolutions();
+
+  // iWidth/iHeight = iScreenWidth/iScreenHeight = the GUI/surface size (<= 1920x1080; AM scales the
+  // layer to the output). Not a split GUI/screen size: CBaseRenderer scales video rects by
+  // iScreenWidth/iWidth for a separate video plane, and here video is drawn into the GUI surface.
+  RESOLUTION_INFO& desktop = CDisplaySettings::GetInstance().GetResolutionInfo(RES_DESKTOP);
+  UpdateDesktopResolution(desktop, "Switch2", m_displayWidth, m_displayHeight, 60.0f, 0);
+  CServiceBroker::GetWinSystem()->GetGfxContext().ResetOverscan(desktop);
+  CDisplaySettings::GetInstance().ClearCustomResolutions();
+  CDisplaySettings::GetInstance().AddResolutionInfo(desktop);
+  CDisplaySettings::GetInstance().ApplyCalibrations();
+}
+
+void CWinSystemSwitch2GLESContext::Register(IDispResource* resource)
+{
+  std::unique_lock<CCriticalSection> lock(m_resourceSection);
+  m_resources.push_back(resource);
+}
+
+void CWinSystemSwitch2GLESContext::Unregister(IDispResource* resource)
+{
+  std::unique_lock<CCriticalSection> lock(m_resourceSection);
+  m_resources.erase(std::remove(m_resources.begin(), m_resources.end(), resource),
+                    m_resources.end());
+}
