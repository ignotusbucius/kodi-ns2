+void CDVDVideoCodecSwitch2::Shutdown()
+{
+  std::lock_guard<std::mutex> lock(g_creatorMutex);
+  g_creatorReleased = true;
+  g_hwUnavailable.store(true);
+  if (g_creatorPinned && !g_inUse.load())
+  {
+    viddecExit();
+    g_creatorPinned = false;
+    Switch2DiagLog("hwdec: creator released at exit");
+  }
+}
