diff --git a/xbmc/platform/switch2/main.cpp b/xbmc/platform/switch2/main.cpp
new file mode 100644
index 0000000..88f73de
--- /dev/null
+++ b/xbmc/platform/switch2/main.cpp
@@ -0,0 +1,116 @@
+/*
+ *  Copyright (C) 2026 Team Kodi
+ *  This file is part of Kodi - https://kodi.tv
+ *
+ *  SPDX-License-Identifier: GPL-2.0-or-later
+ *  See LICENSES/README.md for more information.
+ */
+
+// Entry point of the Switch 2 NRO. Brings up the console services Kodi needs
+// (sockets, HID, audio, time), points Kodi at sdmc:/switch/kodi and runs it.
+
+#include "application/AppEnvironment.h"
+#include "application/AppParamParser.h"
+#include "platform/xbmc.h"
+#include "platform/switch2/PosixCompat.h"
+#include "platform/switch2/StartupProbe.h"
+
+#include <cstdio>
+#include <cstdlib>
+#include <cstring>
+#include <dirent.h>
+#include <string>
+#include <locale.h>
+#include <sys/stat.h>
+#include <unistd.h>
+
+#include <switch.h>
+
+namespace
+{
+// Device-qualified for mkdir/chdir (makes sdmc the default device); Kodi itself gets KODI_HOME.
+constexpr const char* KODI_ROOT = "sdmc:/switch/kodi";
+// Kodi and sqlite only treat paths starting with "/" as absolute (CURL::IsFullPath, unixFullPathname).
+constexpr const char* KODI_HOME = "/switch/kodi";
+
+void BringUpServices()
+{
+  // Leave the CPU at the title's setting; ask applet for focus events so HOME suspends us cleanly.
+  appletSetFocusHandlingMode(AppletFocusHandlingMode_SuspendHomeSleepNotify);
+  // Delay a HOME->Close exit (15 s limit) so appletMainLoop() reports it and Kodi saves its state.
+  appletLockExit();
+  // Every exit path (incl. exit() deep inside Kodi) must unlock before the process ends (applet.h).
+  atexit([] { appletUnlockExit(); });
+
+  SocketInitConfig sockCfg = *socketGetDefaultInitConfig();
+  sockCfg.tcp_tx_buf_size = 0x40000;
+  sockCfg.tcp_rx_buf_size = 0x80000;
+  sockCfg.tcp_tx_buf_max_size = 0x100000;
+  sockCfg.tcp_rx_buf_max_size = 0x200000;
+  sockCfg.sb_efficiency = 8;
+  socketInitialize(&sockCfg);
+
+  // Mirror stdout/stderr to nxlink when hbmenu's NetLoader started us.
+  nxlinkStdio();
+}
+
+void TearDownServices()
+{
+  socketExit();
+}
+// One flushed line per stage, before Kodi's own log exists (CLog starts in CApplication::Create).
+// Same raw writer as every other boot.txt line (PosixCompat.h): one writer path, serialised.
+void BootMark(const char* what, int value = 0)
+{
+  Switch2BootLog(what, value);
+}
+
+// Only one Kodi process can exist, so any sqlite dot-file lock left by a crash is stale.
+void ClearStaleDbLocks()
+{
+  const std::string dir = "sdmc:/switch/kodi/.kodi/userdata/Database";
+  DIR* d = opendir(dir.c_str());
+  if (!d)
+    return;
+  int removed = 0;
+  while (dirent* e = readdir(d))
+  {
+    const size_t len = std::strlen(e->d_name);
+    if (len > 5 && std::strcmp(e->d_name + len - 5, ".lock") == 0)
+      removed += rmdir((dir + "/" + e->d_name).c_str()) == 0;
+  }
+  closedir(d);
+  BootMark("stale-db-locks-removed", removed);
+}
+} // namespace
+
+int main(int argc, char* argv[])
+{
+  // First: crash.txt diagnostics for native exceptions, std::terminate and abort (CrashHandler.cpp).
+  Switch2InstallCrashHandlers();
+  BringUpServices();
+
+  mkdir(KODI_ROOT, 0777);
+  chdir(KODI_ROOT);
+  // Must be set before CAppEnvironment::SetUp: InitDirectoriesLinux derives special://home from
+  // $HOME (SettingsComponent.cpp), so user data lands in sdmc:/switch/kodi/.kodi.
+  setenv("HOME", KODI_HOME, 1);
+  // special://xbmcbin: /proc/self/exe does not exist here.
+  setenv("KODI_BIN_HOME", KODI_HOME, 1);
+  setlocale(LC_NUMERIC, "C");
+  BootMark("main-entered");
+  ClearStaleDbLocks();
+  Switch2StartupProbe();
+
+  CAppParamParser appParamParser;
+  appParamParser.Parse(argv, argc);
+
+  CAppEnvironment::SetUp(appParamParser.GetAppParams());
+  BootMark("xbmc-run-start");
+  int status = XBMC_Run(true);
+  BootMark("xbmc-run-returned", status);
+  CAppEnvironment::TearDown();
+
+  TearDownServices();
+  return status;
+}
