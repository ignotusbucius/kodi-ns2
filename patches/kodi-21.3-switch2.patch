diff --git a/xbmc/cores/AudioEngine/Sinks/AESinkSwitch2.cpp b/xbmc/cores/AudioEngine/Sinks/AESinkSwitch2.cpp
new file mode 100644
index 0000000..54a2636
--- /dev/null
+++ b/xbmc/cores/AudioEngine/Sinks/AESinkSwitch2.cpp
@@ -0,0 +1,713 @@
+/*
+ *  Copyright (C) 2026 Team Kodi
+ *  This file is part of Kodi - https://kodi.tv
+ *
+ *  SPDX-License-Identifier: GPL-2.0-or-later
+ *  See LICENSES/README.md for more information.
+ */
+
+#include "AESinkSwitch2.h"
+
+#include "ServiceBroker.h"
+#include "cores/AudioEngine/AESinkFactory.h"
+#include "cores/AudioEngine/Utils/AEUtil.h"
+#include "platform/switch2/DiagLog.h"
+#include "settings/Settings.h"
+#include "settings/SettingsComponent.h"
+#include "utils/log.h"
+
+#include <algorithm>
+#include <atomic>
+#include <cstdio>
+#include <cstdlib>
+#include <cstring>
+#include <string>
+
+namespace
+{
+constexpr unsigned int kRate = 48000;
+constexpr size_t kAlign = 0x1000;
+
+// Rev 39b: an audout or audren session (and its transfer-memory work buffer) is open. Kodi runs inside
+// the loader's process (findings 1575/1577): a session still open at the end of main would survive into
+// the next launch, so ExitCheck (main.cpp) ends the process instead of returning to the loader.
+std::atomic<bool> g_audioSessionOpen{false};
+
+// ---- Multichannel (audren) path, rev 39. Nothing below runs unless the setting is on. ----
+
+// Renderer configuration of route-id (finding 1570: accepted docked with six mix buffers), with
+// six mix buffers always. libounce limits: a voice takes PcmFormat_Int16 or Adpcm only and a device
+// sink at most 6 inputs, so the path is 5.1 S16; 7.1 sources are downmixed to 5.1 by ActiveAE.
+constexpr int kMcVoices = 24;
+constexpr size_t kMcSlotBytes = CAESinkSwitch2::kFramesPerBuffer * CAESinkSwitch2::kMcFrameBytes;
+static_assert(kMcSlotBytes % 0x40 == 0, "wave buffers need 0x40 alignment");
+static_assert((kMcSlotBytes * CAESinkSwitch2::kBuffers) % 0x1000 == 0, "pool must be whole pages");
+
+// One process-lifetime pool (like route-id's static samples): the renderer never sees heap memory
+// that could be freed and reused while a stop/exit is still settling. One owner at a time.
+alignas(0x1000) uint8_t g_mcPool[kMcSlotBytes * CAESinkSwitch2::kBuffers];
+bool g_mcPoolInUse = false;
+// A refusal is final for this launch (no retry per stream); the log says so.
+bool g_mcRefused = false;
+
+bool MultichannelSettingOn()
+{
+  const auto component = CServiceBroker::GetSettingsComponent();
+  if (!component)
+    return false;
+  const auto settings = component->GetSettings();
+  return settings && settings->GetBool(CSettings::SETTING_AUDIOOUTPUT_SWITCH2MULTICHANNEL);
+}
+
+// Hardware bin i of the device sink plays Kodi channel map[i]. Default = the nn::audio 5.1 order
+// FL FR FC LFE BL BR, unmeasured on speakers until route-id's AVR session; the optional file
+// sdmc:/switch/kodi/surround-map.txt (one line, six distinct names of FL FR FC LFE BL BR SL SR)
+// replaces it without a rebuild. ActiveAE remaps every stream into this order.
+struct McMap
+{
+  std::array<AEChannel, CAESinkSwitch2::kMcChannels> ch{AE_CH_FL, AE_CH_FR, AE_CH_FC,
+                                                        AE_CH_LFE, AE_CH_BL, AE_CH_BR};
+  bool fromFile = false;
+  std::string note = "default";
+
+  CAEChannelInfo Layout() const
+  {
+    CAEChannelInfo info;
+    for (AEChannel c : ch)
+      info += c;
+    return info;
+  }
+};
+
+bool ChannelFromName(const std::string& name, AEChannel& out)
+{
+  static const struct
+  {
+    const char* name;
+    AEChannel ch;
+  } kNames[] = {{"FL", AE_CH_FL}, {"FR", AE_CH_FR}, {"FC", AE_CH_FC}, {"LFE", AE_CH_LFE},
+                {"BL", AE_CH_BL}, {"BR", AE_CH_BR}, {"SL", AE_CH_SL}, {"SR", AE_CH_SR}};
+  for (const auto& n : kNames)
+    if (name == n.name)
+    {
+      out = n.ch;
+      return true;
+    }
+  return false;
+}
+
+McMap LoadMap()
+{
+  McMap map;
+  FILE* f = fopen("sdmc:/switch/kodi/surround-map.txt", "rb");
+  if (!f)
+    return map;
+  char buf[128] = {};
+  const size_t got = fread(buf, 1, sizeof(buf) - 1, f);
+  fclose(f);
+  std::string line(buf, got);
+  const size_t eol = line.find_first_of("\r\n");
+  if (eol != std::string::npos)
+    line.resize(eol); // only the first line counts
+  for (char& c : line)
+    c = (c >= 'a' && c <= 'z') ? static_cast<char>(c - 32) : (c == ',' || c == '\t') ? ' ' : c;
+
+  std::array<AEChannel, CAESinkSwitch2::kMcChannels> parsed{};
+  unsigned int n = 0;
+  bool ok = true;
+  size_t pos = 0;
+  while (ok)
+  {
+    pos = line.find_first_not_of(' ', pos);
+    if (pos == std::string::npos)
+      break;
+    const size_t end = std::min(line.find(' ', pos), line.size());
+    AEChannel ch;
+    if (n >= parsed.size() || !ChannelFromName(line.substr(pos, end - pos), ch))
+      ok = false;
+    else
+      parsed[n++] = ch;
+    pos = end;
+  }
+  for (unsigned int i = 0; ok && i < n; ++i)
+    for (unsigned int j = i + 1; j < n; ++j)
+      if (parsed[i] == parsed[j])
+        ok = false;
+  if (!ok || n != parsed.size())
+  {
+    map.note = "default (surround-map.txt ignored: need six distinct names of FL FR FC LFE BL BR SL SR)";
+    return map;
+  }
+  map.ch = parsed;
+  map.fromFile = true;
+  map.note = "surround-map.txt";
+  return map;
+}
+
+std::string MapText(const McMap& map)
+{
+  std::string text;
+  for (unsigned int i = 0; i < map.ch.size(); ++i)
+  {
+    if (i)
+      text += ' ';
+    text += std::to_string(i) + '=' + CAEChannelInfo::GetChName(map.ch[i]);
+  }
+  return text;
+}
+
+// The multichannel path's log lines go to kodi.log and boot.txt (release builds too): the AVR
+// session reads the negotiated format from boot.txt without a debug log.
+void McLog(int level, const std::string& text)
+{
+  CLog::Log(level, "CAESinkSwitch2: {}", text);
+  Switch2DiagLog("switch2 audio: %s", text.c_str());
+}
+
+std::string Hex(Result rc)
+{
+  char buf[16];
+  snprintf(buf, sizeof(buf), "0x%x", static_cast<unsigned int>(rc));
+  return buf;
+}
+} // namespace
+
+bool Switch2AudioSessionOpen()
+{
+  return g_audioSessionOpen.load();
+}
+
+void CAESinkSwitch2::Register()
+{
+  AE::AESinkRegEntry entry;
+  entry.sinkName = "SWITCH2";
+  entry.createFunc = CAESinkSwitch2::Create;
+  entry.enumerateFunc = CAESinkSwitch2::EnumerateDevicesEx;
+  AE::CAESinkFactory::RegisterSink(entry);
+}
+
+std::unique_ptr<IAESink> CAESinkSwitch2::Create(std::string& device, AEAudioFormat& desiredFormat)
+{
+  auto sink = std::make_unique<CAESinkSwitch2>();
+  if (sink->Initialize(desiredFormat, device))
+    return sink;
+  return {};
+}
+
+void CAESinkSwitch2::EnumerateDevicesEx(AEDeviceInfoList& list, bool force)
+{
+  CAEDeviceInfo info;
+  info.m_deviceName = "default";
+  info.m_displayName = "Switch 2";
+  info.m_displayNameExtra = "audout";
+  info.m_deviceType = AE_DEVTYPE_PCM;
+  info.m_channels = AE_CH_LAYOUT_2_0;
+  info.m_sampleRates.push_back(kRate);
+  info.m_dataFormats.push_back(AE_FMT_S16NE);
+  info.m_wantsIECPassthrough = false;
+  if (MultichannelSettingOn() && appletGetOperationMode() == AppletOperationMode_Console)
+  {
+    // Advertised 5.1 (docked at enumeration time; display only, ActiveAE negotiates by the
+    // Number of channels setting) in hardware bin order; Initialize still opens stereo when handheld, for
+    // stereo sources, or after a refusal.
+    info.m_displayNameExtra = "audout / audren 5.1 (experimental)";
+    info.m_channels = LoadMap().Layout();
+  }
+  list.push_back(info);
+}
+
+CAESinkSwitch2::~CAESinkSwitch2()
+{
+  Deinitialize();
+}
+
+bool CAESinkSwitch2::Initialize(AEAudioFormat& format, std::string& device)
+{
+  // A fallback device can be opened directly by AE, bypassing device enumeration.
+  if (format.m_dataFormat == AE_FMT_RAW)
+    return false;
+
+  // Setting off (default) or a stereo request: the audout path below, unchanged.
+  if (format.m_channelLayout.Count() > 2 && MultichannelSettingOn())
+  {
+    if (InitializeRenderer(format, device))
+      return true;
+  }
+  return InitializeAudout(format, device);
+}
+
+bool CAESinkSwitch2::InitializeAudout(AEAudioFormat& format, std::string& device)
+{
+  Result rc = audoutInitialize();
+  if (R_FAILED(rc))
+  {
+    CLog::Log(LOGERROR, "CAESinkSwitch2: audoutInitialize failed 0x{:x}", rc);
+    return false;
+  }
+  g_audioSessionOpen = true;
+  const auto rate = audoutGetSampleRate();
+  const auto channels = audoutGetChannelCount();
+  const auto pcm = audoutGetPcmFormat();
+  if (rate != kRate || channels != 2 || pcm != PcmFormat_Int16)
+  {
+    CLog::Log(LOGERROR, "CAESinkSwitch2: unsupported audout format: {} Hz, {} channels, PCM {}",
+              rate, channels, static_cast<int>(pcm));
+    audoutExit();
+    g_audioSessionOpen = false;
+    return false;
+  }
+  rc = audoutStartAudioOut();
+  if (R_FAILED(rc))
+  {
+    CLog::Log(LOGERROR, "CAESinkSwitch2: audoutStartAudioOut failed 0x{:x}", rc);
+    audoutExit();
+    g_audioSessionOpen = false;
+    return false;
+  }
+  m_open = true;
+  m_started = true;
+
+  m_bufferBytes = (kFramesPerBuffer * kFrameBytes + kAlign - 1) & ~(kAlign - 1);
+  for (Slot& slot : m_slots)
+  {
+    slot.mem = std::aligned_alloc(kAlign, m_bufferBytes);
+    if (!slot.mem)
+    {
+      Deinitialize();
+      return false;
+    }
+    std::memset(slot.mem, 0, m_bufferBytes);
+    slot.out = {};
+    slot.out.buffer = slot.mem;
+    slot.out.buffer_size = m_bufferBytes;
+    slot.queued = false;
+  }
+  m_next = 0;
+  m_appendedFrames = 0;
+
+  format.m_dataFormat = AE_FMT_S16NE;
+  format.m_sampleRate = kRate;
+  format.m_channelLayout = AE_CH_LAYOUT_2_0;
+  format.m_frameSize = kFrameBytes;
+  format.m_frames = kFramesPerBuffer;
+  device = "default";
+  return true;
+}
+
+void CAESinkSwitch2::Deinitialize()
+{
+  if (m_renderer)
+  {
+    DeinitializeRenderer();
+    return;
+  }
+  if (m_started)
+  {
+    bool flushed = false;
+    audoutFlushAudioOutBuffers(&flushed);
+    audoutStopAudioOut();
+    m_started = false;
+  }
+  if (m_open)
+  {
+    audoutExit();
+    g_audioSessionOpen = false;
+    m_open = false;
+  }
+  for (Slot& slot : m_slots)
+  {
+    std::free(slot.mem);
+    slot.mem = nullptr;
+    slot.queued = false;
+  }
+}
+
+void CAESinkSwitch2::MarkReleased(AudioOutBuffer* released)
+{
+  for (Slot& slot : m_slots)
+  {
+    if (&slot.out == released)
+    {
+      slot.queued = false;
+      return;
+    }
+  }
+}
+
+bool CAESinkSwitch2::ReclaimOne(uint64_t timeoutNs)
+{
+  // audoutWaitPlayFinish hands back only the first released buffer; drain the rest without
+  // waiting, or buffers released together are never reused and audout runs dry.
+  AudioOutBuffer* released = nullptr;
+  u32 count = 0;
+  Result rc = audoutWaitPlayFinish(&released, &count, timeoutNs);
+  if (R_FAILED(rc) || count == 0 || !released)
+    return false;
+  MarkReleased(released);
+  for (int guard = 0; guard < static_cast<int>(kBuffers); ++guard)
+  {
+    AudioOutBuffer* more = nullptr;
+    u32 n = 0;
+    if (R_FAILED(audoutGetReleasedAudioOutBuffer(&more, &n)) || n == 0 || !more)
+      break;
+    MarkReleased(more);
+  }
+  return true;
+}
+
+unsigned int CAESinkSwitch2::QueuedFrames() const
+{
+  unsigned int frames = 0;
+  for (const Slot& slot : m_slots)
+    if (slot.queued)
+      frames += static_cast<unsigned int>(slot.out.data_size / kFrameBytes);
+  return frames;
+}
+
+unsigned int CAESinkSwitch2::AddPackets(uint8_t** data, unsigned int frames, unsigned int offset)
+{
+  if (m_renderer)
+    return AddPacketsRenderer(data, frames, offset);
+  if (!m_open)
+    return 0;
+
+  Slot& slot = m_slots[m_next];
+  if (slot.queued)
+  {
+    // Wait at most one buffer's length for the oldest buffer to come back.
+    const uint64_t oneBufferNs = 1000000000ULL * kFramesPerBuffer / kRate;
+    while (slot.queued)
+    {
+      if (!ReclaimOne(oneBufferNs * 2))
+        return 0;
+    }
+  }
+
+  const unsigned int n = std::min(frames, kFramesPerBuffer);
+  std::memcpy(slot.mem, data[0] + offset * kFrameBytes, n * kFrameBytes);
+  slot.out.data_size = n * kFrameBytes;
+  slot.out.data_offset = 0;
+  if (R_FAILED(audoutAppendAudioOutBuffer(&slot.out)))
+    return 0;
+  slot.queued = true;
+  m_appendedFrames += n;
+  m_next = (m_next + 1) % kBuffers;
+  return n;
+}
+
+void CAESinkSwitch2::GetDelay(AEDelayStatus& status)
+{
+  if (m_renderer)
+  {
+    GetDelayRenderer(status);
+    return;
+  }
+  // Collect buffers that have finished without blocking.
+  while (ReclaimOne(0))
+  {
+  }
+  // Exact delay = frames appended but not yet played (the playing buffer counts only its unplayed part).
+  u64 played = 0;
+  if (R_SUCCEEDED(audoutGetAudioOutPlayedSampleCount(&played)) && played <= m_appendedFrames)
+    status.SetDelay(static_cast<double>(m_appendedFrames - played) / kRate);
+  else
+    status.SetDelay(static_cast<double>(QueuedFrames()) / kRate);
+}
+
+double CAESinkSwitch2::GetCacheTotal()
+{
+  return static_cast<double>(kBuffers * kFramesPerBuffer) / kRate;
+}
+
+void CAESinkSwitch2::Drain()
+{
+  if (m_renderer)
+  {
+    DrainRenderer();
+    return;
+  }
+  while (QueuedFrames() > 0)
+  {
+    if (!ReclaimOne(100000000ULL))
+      break;
+  }
+}
+
+// ---- Multichannel (audren) path, rev 39 ----
+
+bool CAESinkSwitch2::InitializeRenderer(AEAudioFormat& format, std::string& device)
+{
+  const std::string requested = std::string(format.m_channelLayout) + " " +
+                                CAEUtil::DataFormatToStr(format.m_dataFormat) + " " +
+                                std::to_string(format.m_sampleRate) + " Hz";
+  if (g_mcRefused)
+  {
+    CLog::Log(LOGINFO, "CAESinkSwitch2: multichannel refused earlier in this launch; stereo for {}",
+              requested);
+    return false;
+  }
+  if (appletGetOperationMode() != AppletOperationMode_Console)
+  {
+    McLog(LOGINFO, "multichannel only while docked (handheld now); stereo for " + requested);
+    return false;
+  }
+  if (g_mcPoolInUse)
+  {
+    McLog(LOGWARNING, "multichannel pool in use by another sink; stereo for " + requested);
+    return false;
+  }
+
+  // Which output the system has selected (as route-id reports it); informational only.
+  std::string active = "unavailable";
+  if (R_SUCCEEDED(auddevInitialize()))
+  {
+    AudioDeviceName name{};
+    if (R_SUCCEEDED(auddevGetActiveAudioDeviceName(&name)))
+    {
+      name.name[sizeof(name.name) - 1] = 0;
+      active = name.name;
+    }
+    auddevExit();
+  }
+
+  const McMap map = LoadMap();
+  m_renderer = true;
+  g_mcPoolInUse = true;
+  m_poolOwner = true;
+  auto refuse = [&](const char* step, Result rc) {
+    McLog(LOGWARNING, std::string("multichannel ") + step + " failed rc=" + Hex(rc) +
+                          "; stereo fallback for the rest of this launch (requested " + requested +
+                          ")");
+    DeinitializeRenderer();
+    g_mcRefused = true;
+    return false;
+  };
+
+  const AudioRendererConfig cfg = {.output_rate = AudioRendererOutputRate_48kHz,
+                                   .num_voices = kMcVoices,
+                                   .num_effects = 0,
+                                   .num_sinks = 1,
+                                   .num_mix_objs = 1,
+                                   .num_mix_buffers = static_cast<int>(kMcChannels)};
+  Result rc = audrenInitialize(&cfg);
+  if (R_FAILED(rc))
+    return refuse("audrenInitialize", rc);
+  m_renOpen = true;
+  g_audioSessionOpen = true;
+  rc = audrvCreate(&m_driver, &cfg, static_cast<int>(kMcChannels));
+  if (R_FAILED(rc))
+    return refuse("audrvCreate", rc);
+  m_drvOpen = true;
+
+  std::memset(g_mcPool, 0, sizeof(g_mcPool));
+  armDCacheFlush(g_mcPool, sizeof(g_mcPool));
+  const int pool = audrvMemPoolAdd(&m_driver, g_mcPool, sizeof(g_mcPool));
+  if (pool < 0 || !audrvMemPoolAttach(&m_driver, pool))
+    return refuse("memory pool add/attach", 0);
+  const u8 bins[kMcChannels] = {0, 1, 2, 3, 4, 5};
+  if (audrvDeviceSinkAdd(&m_driver, AUDREN_DEFAULT_DEVICE_NAME, static_cast<int>(kMcChannels),
+                         bins) < 0)
+    return refuse("device sink add (6 inputs)", 0);
+  if (!audrvVoiceInit(&m_driver, 0, static_cast<int>(kMcChannels), PcmFormat_Int16, kRate))
+    return refuse("6-channel S16 voice init", 0);
+  audrvVoiceSetDestinationMix(&m_driver, 0, AUDREN_FINAL_MIX_ID);
+  // Identity: voice channel c (Kodi's c-th channel of the reported layout) -> final mix buffer c
+  // -> device sink input c.
+  for (unsigned int c = 0; c < kMcChannels; ++c)
+    for (unsigned int b = 0; b < kMcChannels; ++b)
+      audrvVoiceSetMixFactor(&m_driver, 0, c == b ? 1.0f : 0.0f, static_cast<int>(c),
+                             static_cast<int>(b));
+  rc = audrvUpdate(&m_driver);
+  if (R_FAILED(rc))
+    return refuse("first audrvUpdate", rc);
+  rc = audrenStartAudioRenderer();
+  if (R_FAILED(rc))
+    return refuse("audrenStartAudioRenderer", rc);
+  m_renStarted = true;
+
+  m_waves = {};
+  m_next = 0;
+  m_renAppended = 0;
+  m_underruns = 0;
+  m_stalls = 0;
+  m_lastDrops = 0;
+  m_voiceStarted = false;
+
+  format.m_dataFormat = AE_FMT_S16NE;
+  format.m_sampleRate = kRate;
+  format.m_channelLayout = map.Layout();
+  format.m_frameSize = kMcFrameBytes;
+  format.m_frames = kFramesPerBuffer;
+  device = "default";
+  McLog(LOGINFO, "multichannel open: audren 48000 Hz S16 6 ch, MainAudioOut inputs " +
+                     MapText(map) + " (map " + map.note + "), requested " + requested +
+                     ", active device '" + active + "', docked");
+  return true;
+}
+
+void CAESinkSwitch2::DeinitializeRenderer()
+{
+  if (m_renStarted)
+  {
+    const uint32_t played = audrvVoiceGetPlayedSampleCount(&m_driver, 0);
+    const uint32_t drops = audrvVoiceGetVoiceDropsCount(&m_driver, 0);
+    const Result rc = audrenStopAudioRenderer();
+    McLog(LOGINFO, "multichannel close: appended " + std::to_string(m_renAppended) + " played " +
+                       std::to_string(played) + " underruns " + std::to_string(m_underruns) +
+                       " voice drops " + std::to_string(drops) + " stop rc=" + Hex(rc));
+    m_renStarted = false;
+  }
+  if (m_drvOpen)
+  {
+    audrvClose(&m_driver);
+    m_drvOpen = false;
+  }
+  if (m_renOpen)
+  {
+    audrenExit();
+    g_audioSessionOpen = false;
+    m_renOpen = false;
+  }
+  m_driver = {};
+  m_waves = {};
+  m_voiceStarted = false;
+  if (m_poolOwner)
+  {
+    g_mcPoolInUse = false;
+    m_poolOwner = false;
+  }
+  m_renderer = false;
+}
+
+bool CAESinkSwitch2::RendererUpdate(uint64_t waitNs)
+{
+  if (waitNs)
+    eventWait(audrenGetFrameEvent(), waitNs); // a timeout is not an error; the caller's deadline is
+  const Result rc = audrvUpdate(&m_driver);
+  if (R_FAILED(rc))
+  {
+    SWITCH2_DIAG_LOG("switch2 audio: multichannel audrvUpdate failed rc=0x%x",
+                     static_cast<unsigned int>(rc));
+    if (!g_mcRefused)
+      McLog(LOGERROR, "multichannel audrvUpdate failed rc=" + Hex(rc) +
+                          "; the next open uses stereo for the rest of this launch");
+    g_mcRefused = true;
+    return false;
+  }
+  return true;
+}
+
+unsigned int CAESinkSwitch2::RendererQueuedFrames() const
+{
+  unsigned int frames = 0;
+  for (const AudioDriverWaveBuf& w : m_waves)
+    if (w.state == AudioDriverWaveBufState_Waiting || w.state == AudioDriverWaveBufState_Queued ||
+        w.state == AudioDriverWaveBufState_Playing)
+      frames += static_cast<unsigned int>(w.end_sample_offset);
+  return frames;
+}
+
+unsigned int CAESinkSwitch2::AddPacketsRenderer(uint8_t** data,
+                                                unsigned int frames,
+                                                unsigned int offset)
+{
+  if (!m_renStarted)
+    return 0;
+
+  AudioDriverWaveBuf& wave = m_waves[m_next];
+  auto busy = [](const AudioDriverWaveBuf& w) {
+    return w.state != AudioDriverWaveBufState_Free && w.state != AudioDriverWaveBufState_Done;
+  };
+  if (busy(wave))
+  {
+    // Wait at most two buffers' length for the oldest buffer to come back (renderer frames: 5 ms).
+    const uint64_t oneBufferNs = 1000000000ULL * kFramesPerBuffer / kRate;
+    const uint64_t deadline = armTicksToNs(armGetSystemTick()) + oneBufferNs * 2;
+    while (busy(wave))
+    {
+      const uint64_t now = armTicksToNs(armGetSystemTick());
+      if (now >= deadline)
+      {
+        // Three stalls in a row without a buffer coming back: the renderer is not playing; the
+        // next open (ActiveAE reopens after zero returns) uses stereo.
+        if (++m_stalls == 3 && !g_mcRefused)
+        {
+          McLog(LOGERROR, "multichannel renderer returned no buffer in 3 waits of " +
+                              std::to_string(oneBufferNs * 2 / 1000000) +
+                              " ms; the next open uses stereo for the rest of this launch");
+          g_mcRefused = true;
+        }
+        SWITCH2_DIAG_LOG("switch2 audio: multichannel stall %u: no buffer back in %llu ms",
+                         m_stalls, static_cast<unsigned long long>(oneBufferNs * 2 / 1000000));
+        return 0;
+      }
+      if (!RendererUpdate(std::min<uint64_t>(deadline - now, 10000000ULL)))
+        return 0;
+    }
+  }
+  else if (m_voiceStarted && RendererQueuedFrames() == 0)
+  {
+    ++m_underruns;
+    SWITCH2_DIAG_LOG("switch2 audio: multichannel underrun %u (appended %u)", m_underruns,
+                     m_renAppended);
+  }
+
+  m_stalls = 0;
+  const unsigned int n = std::min(frames, kFramesPerBuffer);
+  uint8_t* mem = g_mcPool + static_cast<size_t>(m_next) * kMcSlotBytes;
+  std::memcpy(mem, data[0] + static_cast<size_t>(offset) * kMcFrameBytes,
+              static_cast<size_t>(n) * kMcFrameBytes);
+  armDCacheFlush(mem, static_cast<size_t>(n) * kMcFrameBytes);
+  wave = {};
+  wave.data_raw = mem;
+  wave.size = static_cast<u64>(n) * kMcFrameBytes;
+  wave.start_sample_offset = 0;
+  wave.end_sample_offset = static_cast<s32>(n);
+  if (!audrvVoiceAddWaveBuf(&m_driver, 0, &wave))
+  {
+    CLog::Log(LOGERROR, "CAESinkSwitch2: multichannel wave buffer refused");
+    return 0;
+  }
+  m_renAppended += n;
+  m_next = (m_next + 1) % kBuffers;
+  if (!m_voiceStarted)
+  {
+    audrvVoiceStart(&m_driver, 0);
+    m_voiceStarted = true;
+  }
+  RendererUpdate(0); // hand the buffer to the renderer now; a failure shows on the next call
+  return n;
+}
+
+void CAESinkSwitch2::GetDelayRenderer(AEDelayStatus& status)
+{
+  if (m_renStarted)
+    RendererUpdate(0);
+  // Exact delay = frames appended but not yet played; u32 arithmetic like the played counter.
+  const uint32_t played = m_renStarted ? audrvVoiceGetPlayedSampleCount(&m_driver, 0) : 0;
+  uint32_t pending = m_renAppended - played;
+  if (pending > kBuffers * kFramesPerBuffer)
+    pending = RendererQueuedFrames();
+  status.SetDelay(static_cast<double>(pending) / kRate);
+#if SWITCH2_DIAG
+  const uint32_t drops = m_renStarted ? audrvVoiceGetVoiceDropsCount(&m_driver, 0) : 0;
+  if (drops != m_lastDrops)
+  {
+    SWITCH2_DIAG_LOG("switch2 audio: multichannel voice drops %u (played %u appended %u)", drops,
+                     played, m_renAppended);
+    m_lastDrops = drops;
+  }
+#endif
+}
+
+void CAESinkSwitch2::DrainRenderer()
+{
+  // Bounded: the whole ring plus 200 ms.
+  const uint64_t deadline = armTicksToNs(armGetSystemTick()) +
+                            1000000000ULL * kBuffers * kFramesPerBuffer / kRate + 200000000ULL;
+  while (m_renStarted && RendererQueuedFrames() > 0)
+  {
+    if (armTicksToNs(armGetSystemTick()) >= deadline || !RendererUpdate(10000000ULL))
+      break;
+  }
+}
