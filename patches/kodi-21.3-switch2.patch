+
+#pragma once
+
+// Switch 2 hardware video decoder (libounce videoDecoder*), registered before FFmpeg in
+// CDVDFactoryCodec (TARGET_SWITCH2). 8-bit H.264 and VP9 up to 1920x1088, 8-bit AV1 and VP8 up to
+// 3840x2160; everything else, and any failure, decodes in software (an FFmpeg codec this object
+// switches to, or the factory's FFmpeg codec when Open refuses).
+
+#include "DVDVideoCodec.h"
+#include "cores/VideoPlayer/DVDStreamInfo.h"
+
+#include <deque>
+
+// Set together with DVD_CODEC_CTRL_DRAIN by VideoPlayerVideo's stillframe squeeze (a stalled
+// demuxer, not end of file) on Switch 2: the hardware decoder then does not end its stream.
+#define DVD_CODEC_CTRL_SWITCH2_STALL 0x00800000
+#include <memory>
+#include <string>
+
+struct AVBSFContext;
+struct AVPacket;
+class CDVDVideoCodecFFmpeg;
+
+class CDVDVideoCodecSwitch2 : public CDVDVideoCodec
+{
+public:
+  explicit CDVDVideoCodecSwitch2(CProcessInfo& processInfo);
+  ~CDVDVideoCodecSwitch2() override;
+
+  static std::unique_ptr<CDVDVideoCodec> Create(CProcessInfo& processInfo);
+  static void Register();
+  // From main after Kodi has stopped: releases the process's pinned decoder creator (see the .cpp).
+  static void Shutdown();
+
+  bool Open(CDVDStreamInfo& hints, CDVDCodecOptions& options) override;
+  bool AddData(const DemuxPacket& packet) override;
+  void Reset() override;
+  VCReturn GetPicture(VideoPicture* pVideoPicture) override;
+  const char* GetName() override;
+  unsigned GetConvergeCount() override;
+  unsigned GetAllowedReferences() override;
+  void SetCodecControl(int flags) override;
+  void SetSpeed(int iSpeed) override;
+  bool GetCodecStats(double& pts, int& droppedFrames, int& skippedPics) override;
+  void Reopen() override;
+  bool Reconfigure(CDVDStreamInfo& hints) override;
+
+private:
+  struct Pending
+  {
+    std::vector<uint8_t> data;
+    int64_t ns = 0; // timestamp in ns (0 when the packet had none)
+    bool eos = false; // submit with end_of_stream
+  };
+  struct Ready
+  {
+    CVideoBuffer* buffer;
+    int64_t ns;
+    unsigned width;
+    unsigned height;
+  };
+
+  bool CreateDecoder();
+  bool ClaimAfterHandover();
+  static void LogLastWork();
+  void CloseDecoder();
+  bool Filter(const DemuxPacket& packet, std::deque<Pending>& out);
+  void PumpSubmit();
+  void TakeFrames(uint64_t timeoutNs);
+  bool CopyOut(const void* frame, Ready& out);
+  void ClearQueues();
+  bool SwitchToSoftware(const std::string& reason);
+  void Fail(const std::string& reason);
+  void DiagTick();
+
+  CDVDStreamInfo m_hints;
+  std::string m_codecName; // "h264", "vp9", "av1", "vp8"
+  int m_viddecCodec = 0; // ViddecCodec
+  unsigned m_cfgWidth = 0;
+  unsigned m_cfgHeight = 0;
+  unsigned m_frameRate = 0;
+  unsigned m_colorPolicy = 3; // VideoDecoderConfig.color_policy (rev 37c, ChooseColorPolicy)
+  std::string m_colorWhy;
+  bool m_claimed = false; // holds the one-instance slot
+  bool m_handover = false; // opened while another decoder held the slot: claim at the first packet
+  static constexpr unsigned kHandoverWaitMs = 500;
+  bool m_created = false; // videoDecoderCreate succeeded
+  void* m_decoder = nullptr; // VideoDecoder (switch2/video/decoder.h, kept out of this header)
+  AVBSFContext* m_bsf = nullptr;
+  AVPacket* m_pkt = nullptr;
+  std::vector<uint8_t> m_codecConfig;
+
+  std::deque<Pending> m_toSubmit; // filtered samples not yet taken by the decoder
+  bool m_haveHeld = false; // one sample is held back for end_of_stream
+  Pending m_held;
+  bool m_eosQueued = false; // the held sample went out with end_of_stream
+  bool m_eosSeen = false; // the end_of_stream frame came out
+  bool m_needFlush = false; // the decoder saw end_of_stream: flush before new data
+  std::deque<Ready> m_ready; // decoded frames copied out, display order
+  int64_t m_submittedMax = INT64_MIN;
+  int m_codecFlags = 0;
+  bool m_failed = false; // runtime failure: GetPicture returns VC_REOPEN once
+  bool m_dead = false; // neither hardware nor software decoding could be opened
+  bool m_sawNoPts = false; // a packet had no timestamp (submitted as 0)
+  uint64_t m_drainStart = 0;
+  std::string m_failReason;
+  std::vector<uint8_t> m_scratch; // block-linear frames: the UV plane from videoDecoderCopyFrame
+
+  // Stall detection and statistics.
+  unsigned m_submittedSinceFlush = 0;
+  unsigned m_framesSinceFlush = 0;
+  unsigned long long m_usedBeforeCreate = 0;
+  bool m_stallWatch = true; // since create/reset (a keyframe start): no frame for kStallSamples = stall
+  unsigned m_framesTotal = 0;
+  unsigned m_getFrameFailsInRow = 0;
+  unsigned m_getFrameFails = 0;
+  unsigned m_submitRetries = 0;
+  unsigned m_submitStuckTries = 0;
+  double m_lastPts = 0;
+  // DIAG: per-second line.
+  uint64_t m_diagT0 = 0;
+  unsigned m_diagFrames = 0;
+  unsigned m_diagRetries = 0;
+  double m_diagCopyMs = 0;
+
+  std::unique_ptr<CDVDVideoCodecFFmpeg> m_sw; // software decoding after a fallback
+  std::string m_name = "switch2-hw";
+};
diff --git a/xbmc/cores/VideoPlayer/DVDCodecs/Video/Switch2HwCodecUtil.h b/xbmc/cores/VideoPlayer/DVDCodecs/Video/Switch2HwCodecUtil.h
new file mode 100644
index 0000000..2a2a19a
--- /dev/null
+++ b/xbmc/cores/VideoPlayer/DVDCodecs/Video/Switch2HwCodecUtil.h
@@ -0,0 +1,372 @@
+/*
+ *  Copyright (C) 2026 Team Kodi
+ *  This file is part of Kodi - https://kodi.tv
+ *
+ *  SPDX-License-Identifier: GPL-2.0-or-later
+ *  See LICENSES/README.md for more information.
+ */
+
+#pragma once
+
+// Switch 2 hardware decoder (CDVDVideoCodecSwitch2): the parts without console or Kodi
+// dependencies, so they can be compiled and tested on a host: H.264 SPS and AV1 av1C parsing,
+// the hardware/software routing decision, and the NV12 -> YUV420P copy.
+
+#include <algorithm>
+#include <atomic>
+#include <cstddef>
+#include <cstdint>
+#include <cstring>
+#include <string>
+#include <vector>
+
+#if defined(__aarch64__)
+#include <arm_neon.h>
+#endif
+
+namespace SWITCH2HW
+{
+
+enum class Codec
+{
+  H264,
+  VP9,
+  AV1,
+  VP8,
+  Other,
+};
+
+// What the stream looks like, from the demuxer hints and the codec configuration.
+struct StreamFacts
+{
+  Codec codec = Codec::Other;
+  int width = 0;
+  int height = 0;
+  int bitDepth = 0; // 0 = unknown
+  bool interlaced = false; // demuxer field order, or H.264 frame_mbs_only_flag == 0
+  bool chroma420 = true; // 4:2:0 (H.264 chroma_format_idc 1, AV1 subsampling 1/1, VP9 profile 0)
+  bool haveConfig = true; // H.264: an SPS was found and parsed; AV1: av1C or a known bit depth
+  bool encrypted = false;
+  double fps = 0;
+};
+
+// Largest picture the decoder takes without stalling for H.264 and VP9 (KaiVideo swframeRoute:
+// over 1080p the console's decoder stalls on H.264 and VP9; 1080 lines are coded as 1088).
+constexpr int kMaxHwWidth = 1920;
+constexpr int kMaxHwHeight = 1088;
+// AV1 and VP8: up to UHD (the service's limit is width * height * fps <= 3840 * 2160 * 30).
+constexpr int kMaxHwWidthLarge = 3840;
+constexpr int kMaxHwHeightLarge = 2160;
+constexpr unsigned long long kPixelRate = 248832000ULL; // VIDEO_DECODER_PIXEL_RATE
+
+inline int Align16(int v)
+{
+  return (v + 15) & ~15;
+}
+
+// Hardware or not, and why not (empty string = hardware).
+inline std::string RouteReason(const StreamFacts& f)
+{
+  if (f.encrypted)
+    return "encrypted";
+  if (f.codec == Codec::Other)
+    return "codec";
+  if (f.width <= 0 || f.height <= 0)
+    return "no size";
+  if (f.interlaced)
+    return "interlaced";
+  if (!f.chroma420)
+    return "not 4:2:0";
+  if (!f.haveConfig)
+    return "no codec configuration";
+  if (f.bitDepth != 0 && f.bitDepth != 8)
+    return std::to_string(f.bitDepth) + "-bit";
+  const bool smallOnly = f.codec == Codec::H264 || f.codec == Codec::VP9;
+  const int w = f.codec == Codec::H264 ? Align16(f.width) : f.width;
+  const int h = f.codec == Codec::H264 ? Align16(f.height) : f.height;
+  if (smallOnly && (w > kMaxHwWidth || h > kMaxHwHeight))
+    return "larger than 1920x1088";
+  if (!smallOnly && (w > kMaxHwWidthLarge || h > kMaxHwHeightLarge))
+    return "larger than 3840x2160";
+  const double fps = (f.fps >= 1 && f.fps <= 60) ? f.fps : 30;
+  if (static_cast<double>(w) * h * fps > static_cast<double>(kPixelRate))
+    return "pixel rate";
+  return std::string();
+}
+
+// ------------------------------------------------------------------------------------------------
+// The one-decoder slot (rev 39c). Never two live hardware decoders: a codec claims the slot before
+// it creates a decoder and releases it after the decoder is closed. A codec opened while another
+// one holds the slot (an adaptive quality/stream switch: VideoPlayer opens the new codec on its own
+// thread while the old one still decodes) does not refuse any more: it claims at its first packet
+// (VideoPlayerVideo thread), after CVideoPlayerVideo::OpenStream has destroyed the old codec, and
+// waits at most waitMs for a release still in flight. nowMs()/sleepMs(n) are injected for tests.
+// ------------------------------------------------------------------------------------------------
+inline bool SlotTryClaim(std::atomic<bool>& slot)
+{
+  return !slot.exchange(true);
+}
+
+template<class NowMs, class SleepMs, class Abandon>
+inline bool SlotClaimWithin(std::atomic<bool>& slot, unsigned waitMs, NowMs nowMs, SleepMs sleepMs,
+                            Abandon abandon, unsigned& waitedMs)
+{
+  const auto start = nowMs();
+  for (;;)
+  {
+    waitedMs = static_cast<unsigned>(nowMs() - start);
+    if (abandon())
+      return false;
+    if (SlotTryClaim(slot))
+      return true;
+    if (waitedMs >= waitMs)
+      return false;
+    sleepMs(std::min<unsigned>(10, waitMs - waitedMs));
+  }
+}
+
+// ------------------------------------------------------------------------------------------------
+// H.264 SPS (ITU-T H.264 7.3.2.1.1), as far as frame_mbs_only_flag.
+// ------------------------------------------------------------------------------------------------
+class BitReader
+{
+public:
+  BitReader(const std::vector<uint8_t>& rbsp) : m_d(rbsp) {}
+  bool Ok() const { return !m_overrun; }
+  unsigned Bit()
+  {
+    if (m_pos >= m_d.size() * 8)
+    {
+      m_overrun = true;
+      return 0;
+    }
+    const unsigned b = (m_d[m_pos / 8] >> (7 - (m_pos % 8))) & 1;
+    ++m_pos;
+    return b;
+  }
+  unsigned Bits(int n)
+  {
+    unsigned v = 0;
+    for (int i = 0; i < n; ++i)
+      v = (v << 1) | Bit();
+    return v;
+  }
+  unsigned Ue()
+  {
+    int zeros = 0;
+    while (Bit() == 0)
+    {
+      if (++zeros > 31 || m_overrun)
+      {
+        m_overrun = true;
+        return 0;
+      }
+    }
+    return ((1u << zeros) - 1) + Bits(zeros);
+  }
+  int Se()
+  {
+    const unsigned k = Ue();
+    return (k & 1) ? static_cast<int>((k + 1) / 2) : -static_cast<int>(k / 2);
+  }
+
+private:
+  const std::vector<uint8_t>& m_d;
+  size_t m_pos = 0;
+  bool m_overrun = false;
+};
+
+struct SpsInfo
+{
+  bool valid = false;
+  unsigned profileIdc = 0;
+  unsigned chromaFormatIdc = 1;
+  unsigned bitDepthLuma = 8;
+  unsigned bitDepthChroma = 8;
+  bool frameMbsOnly = true;
+};
+
+// NAL payload (after the 1-byte header) without emulation prevention bytes.
+inline std::vector<uint8_t> Unescape(const uint8_t* p, size_t n)
+{
+  std::vector<uint8_t> out;
+  out.reserve(n);
+  int zeros = 0;
+  for (size_t i = 0; i < n; ++i)
+  {
+    if (zeros >= 2 && p[i] == 3)
+    {
+      zeros = 0;
+      continue;
+    }
+    zeros = p[i] == 0 ? zeros + 1 : 0;
+    out.push_back(p[i]);
+  }
+  return out;
+}
+
+inline void SkipScalingList(BitReader& br, int size)
+{
+  int last = 8, next = 8;
+  for (int j = 0; j < size; ++j)
+  {
+    if (next != 0)
+      next = (last + br.Se() + 256) % 256;
+    last = next == 0 ? last : next;
+  }
+}
+
+// `nal` = the SPS NAL unit including its header byte.
+inline SpsInfo ParseSps(const uint8_t* nal, size_t size)
+{
+  SpsInfo s;
+  if (size < 4 || (nal[0] & 0x1F) != 7)
+    return s;
+  const std::vector<uint8_t> rbsp = Unescape(nal + 1, size - 1);
+  BitReader br(rbsp);
+  s.profileIdc = br.Bits(8);
+  br.Bits(8); // constraint flags
+  br.Bits(8); // level_idc
+  br.Ue(); // seq_parameter_set_id
+  switch (s.profileIdc)
+  {
+    case 100: case 110: case 122: case 244: case 44: case 83: case 86: case 118: case 128:
+    case 138: case 139: case 134: case 135:
+    {
+      s.chromaFormatIdc = br.Ue();
+      if (s.chromaFormatIdc == 3)
+        br.Bit(); // separate_colour_plane_flag
+      s.bitDepthLuma = br.Ue() + 8;
+      s.bitDepthChroma = br.Ue() + 8;
+      br.Bit(); // qpprime_y_zero_transform_bypass_flag
+      if (br.Bit()) // seq_scaling_matrix_present_flag
+      {
+        const int lists = s.chromaFormatIdc != 3 ? 8 : 12;
+        for (int i = 0; i < lists; ++i)
+          if (br.Bit())
+            SkipScalingList(br, i < 6 ? 16 : 64);
+      }
+      break;
+    }
+    default:
+      break;
+  }
+  br.Ue(); // log2_max_frame_num_minus4
+  const unsigned pocType = br.Ue();
+  if (pocType == 0)
+    br.Ue(); // log2_max_pic_order_cnt_lsb_minus4
+  else if (pocType == 1)
+  {
+    br.Bit(); // delta_pic_order_always_zero_flag
+    br.Se(); // offset_for_non_ref_pic
+    br.Se(); // offset_for_top_to_bottom_field
+    const unsigned n = br.Ue();
+    if (n > 255)
+      return s;
+    for (unsigned i = 0; i < n; ++i)
+      br.Se();
+  }
+  br.Ue(); // max_num_ref_frames
+  br.Bit(); // gaps_in_frame_num_value_allowed_flag
+  br.Ue(); // pic_width_in_mbs_minus1
+  br.Ue(); // pic_height_in_map_units_minus1
+  s.frameMbsOnly = br.Bit() != 0;
+  s.valid = br.Ok();
+  return s;
+}
+
+// The first SPS in H.264 extradata: avcC (ISO/IEC 14496-15) or Annex B.
+inline SpsInfo FindSps(const uint8_t* d, size_t n)
+{
+  if (!d || n < 4)
+    return SpsInfo();
+  if (d[0] == 1 && n >= 8) // avcC
+  {
+    const unsigned numSps = d[5] & 0x1F;
+    size_t pos = 6;
+    for (unsigned i = 0; i < numSps && pos + 2 <= n; ++i)
+    {
+      const size_t len = (static_cast<size_t>(d[pos]) << 8) | d[pos + 1];
+      pos += 2;
+      if (pos + len > n)
+        break;
+      SpsInfo s = ParseSps(d + pos, len);
+      if (s.valid)
+        return s;
+      pos += len;
+    }
+    return SpsInfo();
+  }
+  // Annex B: 00 00 01 or 00 00 00 01 start codes.
+  for (size_t i = 0; i + 3 < n; ++i)
+  {
+    if (d[i] == 0 && d[i + 1] == 0 && d[i + 2] == 1)
+    {
+      const size_t start = i + 3;
+      size_t end = start;
+      while (end + 2 < n && !(d[end] == 0 && d[end + 1] == 0 && (d[end + 2] == 1 || d[end + 2] == 0)))
+        ++end;
+      if (end + 2 >= n)
+        end = n;
+      if (start < n && (d[start] & 0x1F) == 7)
+      {
+        SpsInfo s = ParseSps(d + start, end - start);
+        if (s.valid)
+          return s;
+      }
+      i = start - 1;
+    }
+  }
+  return SpsInfo();
+}
+
+// AV1 av1C (AV1 ISOBMFF binding 2.3): bit depth and 4:2:0. Returns false if `d` is not av1C.
+inline bool ParseAv1C(const uint8_t* d, size_t n, int& bitDepth, bool& chroma420)
+{
+  if (!d || n < 4 || (d[0] & 0x80) == 0 || (d[0] & 0x7F) != 1)
+    return false;
+  const unsigned profile = d[1] >> 5;
+  const bool highBitdepth = (d[2] & 0x40) != 0;
+  const bool twelveBit = (d[2] & 0x20) != 0;
+  const bool mono = (d[2] & 0x10) != 0;
+  const bool subX = (d[2] & 0x08) != 0;
+  const bool subY = (d[2] & 0x04) != 0;
+  bitDepth = highBitdepth ? (twelveBit ? 12 : 10) : 8;
+  chroma420 = profile == 0 && !mono && subX && subY;
+  return true;
+}
+
+// ------------------------------------------------------------------------------------------------
+// NV12 (Y + interleaved UV) -> YUV420P planes. `w`, `h` even.
+// ------------------------------------------------------------------------------------------------
+inline void DeinterleaveRow(const uint8_t* uv, uint8_t* u, uint8_t* v, int pairs)
+{
+  int i = 0;
+#if defined(__aarch64__)
+  for (; i + 16 <= pairs; i += 16)
+  {
+    const uint8x16x2_t p = vld2q_u8(uv + 2 * i);
+    vst1q_u8(u + i, p.val[0]);
+    vst1q_u8(v + i, p.val[1]);
+  }
+#endif
+  for (; i < pairs; ++i)
+  {
+    u[i] = uv[2 * i];
+    v[i] = uv[2 * i + 1];
+  }
+}
+
+inline void Nv12ToYuv420p(const uint8_t* y, size_t yPitch, const uint8_t* uv, size_t uvPitch, int w,
+                          int h, uint8_t* dy, int dyStride, uint8_t* du, int duStride, uint8_t* dv,
+                          int dvStride, bool copyY = true)
+{
+  if (copyY)
+    for (int r = 0; r < h; ++r)
+      std::memcpy(dy + static_cast<size_t>(r) * dyStride, y + r * yPitch, static_cast<size_t>(w));
+  for (int r = 0; r < h / 2; ++r)
+    DeinterleaveRow(uv + r * uvPitch, du + static_cast<size_t>(r) * duStride,
+                    dv + static_cast<size_t>(r) * dvStride, w / 2);
+}
+
+} // namespace SWITCH2HW
