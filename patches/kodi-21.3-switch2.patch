+
+#pragma once
+
+#include "cores/AudioEngine/Interfaces/AESink.h"
+#include "cores/AudioEngine/Utils/AEDeviceInfo.h"
+
+#include <array>
+#include <memory>
+
+#include <switch.h>
+
+// True while an audout or audren session opened by this sink is open (rev 39b, main.cpp ExitCheck).
+bool Switch2AudioSessionOpen();
+
+// PCM output through audout: 48 kHz, 2 channels, signed 16-bit, a ring of 0x1000-aligned buffers.
+// Rev 39: with the setting "Switch 2 multichannel output (experimental)" on (default off), a request
+// for more than two channels while docked opens the audio renderer instead (audren, the API of
+// route-id, finding 1570): one 6-channel S16 voice, identity mix into a 6-buffer final mix, device
+// sink MainAudioOut with inputs 0-5. Any refusal falls back to the audout stereo path above.
+class CAESinkSwitch2 : public IAESink
+{
+public:
+  const char* GetName() override { return "switch2"; }
+
+  CAESinkSwitch2() = default;
+  ~CAESinkSwitch2() override;
+
+  static void Register();
+  static std::unique_ptr<IAESink> Create(std::string& device, AEAudioFormat& desiredFormat);
+  static void EnumerateDevicesEx(AEDeviceInfoList& list, bool force = false);
+
+  bool Initialize(AEAudioFormat& format, std::string& device) override;
+  void Deinitialize() override;
+
+  void GetDelay(AEDelayStatus& status) override;
+  double GetCacheTotal() override;
+  unsigned int AddPackets(uint8_t** data, unsigned int frames, unsigned int offset) override;
+  void Drain() override;
+
+  static constexpr unsigned int kBuffers = 4;
+  static constexpr unsigned int kFramesPerBuffer = 1024; // 21.3 ms at 48 kHz
+  static constexpr unsigned int kFrameBytes = 4; // 2 channels x s16
+  static constexpr unsigned int kMcChannels = 6; // device sink and voice limit (libounce audrv)
+  static constexpr unsigned int kMcFrameBytes = kMcChannels * 2; // 6 channels x s16
+
+private:
+  bool InitializeAudout(AEAudioFormat& format, std::string& device);
+  bool ReclaimOne(uint64_t timeoutNs);
+  void MarkReleased(AudioOutBuffer* released);
+  unsigned int QueuedFrames() const;
+
+  // Multichannel (audren) path, used only when m_renderer is true.
+  bool InitializeRenderer(AEAudioFormat& format, std::string& device);
+  void DeinitializeRenderer();
+  bool RendererUpdate(uint64_t waitNs);
+  unsigned int RendererQueuedFrames() const;
+  unsigned int AddPacketsRenderer(uint8_t** data, unsigned int frames, unsigned int offset);
+  void GetDelayRenderer(AEDelayStatus& status);
+  void DrainRenderer();
+
+  struct Slot
+  {
+    AudioOutBuffer out{};
+    void* mem = nullptr;
+    bool queued = false;
+  };
+  std::array<Slot, kBuffers> m_slots{};
+  size_t m_bufferBytes = 0;
+  unsigned int m_next = 0;
+  bool m_open = false;
+  bool m_started = false;
+  uint64_t m_appendedFrames = 0; // frames handed to audout since Initialize
+
+  bool m_renderer = false; // this instance plays through audren
+  bool m_renOpen = false;
+  bool m_drvOpen = false;
+  bool m_renStarted = false;
+  bool m_voiceStarted = false;
+  bool m_poolOwner = false;
+  AudioDriver m_driver{};
+  std::array<AudioDriverWaveBuf, kBuffers> m_waves{};
+  uint32_t m_renAppended = 0; // u32 like audrvVoiceGetPlayedSampleCount
+  unsigned int m_underruns = 0;
+  unsigned int m_stalls = 0; // consecutive AddPackets waits that timed out
+  uint32_t m_lastDrops = 0;
+};
