+void CloseCrashSession()
+{
+  const Handle h = g_crashSession.exchange(INVALID_HANDLE);
+  if (h != INVALID_HANDLE)
+    svcCloseHandle(h); // later crash.txt writes go through fsFileWrite until fsExit
+}
+
+// rev 38: every launch appends to boot.txt (about 30 lines per release launch: 23602 lines after 126
+// launches on the rig) and crash.txt is never cut. At start-up only (so one launch's lines stay in one
+// file), a file over its limit becomes <name>.old.txt, replacing the previous one, as kodi.log does.
+s64 RotateIfLarger(const char* path, const char* oldPath, s64 limit)
+{
+  FsFile f;
+  s64 size = 0;
+  if (R_FAILED(fsFsOpenFile(g_sdmc, path, FsOpenMode_Read, &f)))
+    return 0;
+  const bool big = R_SUCCEEDED(fsFileGetSize(&f, &size)) && size > limit;
+  fsFileClose(&f);
+  if (!big)
+    return 0;
+  fsFsDeleteFile(g_sdmc, oldPath); // fails harmlessly when there is none
+  return R_SUCCEEDED(fsFsRenameFile(g_sdmc, path, oldPath)) ? size : -1;
+}
