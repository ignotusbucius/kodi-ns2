+// svcBreak: libounce's mutexLock/mutexUnlock call it when svcArbitrateLock/Unlock fails, and
+// diagAbortWithResult and the exception return path end in it. Notification-only breaks return.
+extern "C" Result __wrap_svcBreak(u32 breakReason, uintptr_t inval1, uintptr_t inval2)
+{
+  // rc= is the break reason; a/b the two arguments. diagAbortWithResult passes (&result, 4).
+  char text[40];
+  const char* t = nullptr;
+  if (inval2 == 4 && inval1 && Readable(inval1, 4))
+  {
+    std::snprintf(text, sizeof(text), "result=0x%x", *reinterpret_cast<const u32*>(inval1));
+    t = text;
+  }
+  FatalLog("svcBreak", breakReason, reinterpret_cast<u64>(__builtin_return_address(0)),
+           reinterpret_cast<u64>(__builtin_frame_address(0)), t, true, inval1, inval2);
+  return __real_svcBreak(breakReason, inval1, inval2);
+}
+
+// svcArbitrateLock pass-through (rev 38f, -Wl,--wrap=svcArbitrateLock): libounce's mutexLock calls it with
+// the owner's tag (its thread handle) from the lock word and svcBreaks when it fails (rev 38b/38ed thread-end
+// crash, findings 1571/1573: the kernel no longer knew the owner handle). On a failure, one line to crash.txt
+// before mutexLock's svcBreak: result, owner tag, the lock word now, our own tag, where the lock is, and what
+// the thread records say about the owner handle (Switch2ThreadHandleState: 0 unknown, 1 running, 2 ended not
+// joined, 3 recently joined = closed), plus a backtrace. No lock and no allocation here (it runs inside the
+// failing lock attempt): a stack buffer, an offset reservation and one IPC on crash.txt's own session.
+extern "C" Result __real_svcArbitrateLock(u32 wait_tag, u32* tag_location, u32 self_tag);
+namespace
+{
+std::atomic<int> g_arbFailLines{0};
+} // namespace
+extern "C" Result __wrap_svcArbitrateLock(u32 wait_tag, u32* tag_location, u32 self_tag)
+{
+  const Result rc = __real_svcArbitrateLock(wait_tag, tag_location, self_tag);
+  if (R_SUCCEEDED(rc) || !g_crashOpen.load() || g_arbFailLines.fetch_add(1) >= 4)
+    return rc;
+  ResolveModule();
+  char buf[2048];
+  Out o(buf);
+  o.Dec(static_cast<long long>(armTicksToNs(armGetSystemTick()) / 1000000ULL));
+  o.Put(" ARBITRATE-LOCK-FAIL");
+  o.Kv("rc", rc);
+  o.Kv("owner", wait_tag);
+  const u64 at = reinterpret_cast<u64>(tag_location);
+  o.Kv("word", Readable(at, 4) ? *tag_location : 0xdeadbeefULL);
+  o.Kv("self", self_tag);
+  o.Kv("at", at);
+  if (g_textBase && at >= g_textBase)
+  {
+    o.Put("(+");
+    o.Hex(at - g_textBase);
+    o.Put(")");
+  }
+  o.Put(" owner_state=");
+  o.Dec(Switch2ThreadHandleState(wait_tag & ~0x40000000u));
+  o.Put(" self_state=");
+  o.Dec(Switch2ThreadHandleState(self_tag));
+  u64 tid = 0;
+  svcGetThreadId(&tid, CUR_THREAD_HANDLE);
+  o.Put(" tid=");
+  o.Dec(static_cast<long long>(tid));
+  o.Put("\n");
+  o.Backtrace(reinterpret_cast<u64>(__builtin_frame_address(0)));
+  const s64 off = g_crashOff.fetch_add(static_cast<s64>(o.n));
+  CrashFileWrite(off, o.buf, o.n);
+  return rc;
+}
