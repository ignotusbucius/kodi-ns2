diff --git a/xbmc/platform/switch2/StaticAddons.cpp b/xbmc/platform/switch2/StaticAddons.cpp
new file mode 100644
index 0000000..430e8ac
--- /dev/null
+++ b/xbmc/platform/switch2/StaticAddons.cpp
@@ -0,0 +1,95 @@
+/*
+ *  Copyright (C) 2026 Team Kodi
+ *  This file is part of Kodi - https://kodi.tv
+ *
+ *  SPDX-License-Identifier: GPL-2.0-or-later
+ *  See LICENSES/README.md for more information.
+ */
+
+#include "StaticAddons.h"
+
+#include <cstring>
+
+// Kodi 21 resolves exactly these entry points from a binary add-on
+// (xbmc/addons/binary-addons/DllAddon.h): ADDON_Create and ADDON_GetTypeVersion (required),
+// ADDON_GetTypeMinVersion (optional). Every add-on built with kodi-dev-kit's ADDONCREATOR defines all three.
+//
+// To add an add-on:
+//   1. pack it like homebrew/kodi/isa/build.sh does, with its own prefix (pfx_ADDON_Create, ...),
+//   2. add KODI_STATIC_ADDON_DECLARE(pfx) and a table row KODI_STATIC_ADDON_ROW("<library>", pfx)
+//      guarded by its own KODI_STATIC_ADDON_<ID> define,
+//   3. ship its data folder with addon.xml library="<library>" and a placeholder file of that name
+//      (CAddonDll::GetDllPath requires the file to exist).
+
+#define KODI_STATIC_ADDON_DECLARE(pfx) \
+  extern "C" int pfx##_ADDON_Create(void* addonInterface); \
+  extern "C" const char* pfx##_ADDON_GetTypeVersion(int type); \
+  extern "C" const char* pfx##_ADDON_GetTypeMinVersion(int type); \
+  static const KodiStaticAddonSymbol pfx##_symbols[] = { \
+      {"ADDON_Create", reinterpret_cast<void*>(&pfx##_ADDON_Create)}, \
+      {"ADDON_GetTypeVersion", reinterpret_cast<void*>(&pfx##_ADDON_GetTypeVersion)}, \
+      {"ADDON_GetTypeMinVersion", reinterpret_cast<void*>(&pfx##_ADDON_GetTypeMinVersion)}, \
+      {nullptr, nullptr}};
+
+#define KODI_STATIC_ADDON_ROW(library, pfx) {library, pfx##_symbols},
+
+#if defined(KODI_STATIC_ADDON_INPUTSTREAM_ADAPTIVE)
+KODI_STATIC_ADDON_DECLARE(isa)
+#endif
+
+namespace
+{
+const KodiStaticAddon kAddons[] = {
+#if defined(KODI_STATIC_ADDON_INPUTSTREAM_ADAPTIVE)
+    KODI_STATIC_ADDON_ROW("inputstream.adaptive.so", isa)
+#endif
+    {nullptr, nullptr}};
+
+constexpr size_t kAddonCount = sizeof(kAddons) / sizeof(kAddons[0]) - 1;
+
+const char* BaseName(const char* path)
+{
+  const char* base = path;
+  for (const char* p = path; *p; ++p)
+  {
+    if (*p == '/' || *p == '\\')
+      base = p + 1;
+  }
+  return base;
+}
+} // namespace
+
+extern "C" const KodiStaticAddon* kodi_static_addon_find(const char* path)
+{
+  if (!path)
+    return nullptr;
+  const char* base = BaseName(path);
+  for (size_t i = 0; i < kAddonCount; ++i)
+  {
+    if (std::strcmp(kAddons[i].library, base) == 0)
+      return &kAddons[i];
+  }
+  return nullptr;
+}
+
+extern "C" int kodi_static_addon_is_handle(const void* handle)
+{
+  for (size_t i = 0; i < kAddonCount; ++i)
+  {
+    if (handle == &kAddons[i])
+      return 1;
+  }
+  return 0;
+}
+
+extern "C" void* kodi_static_addon_symbol(const KodiStaticAddon* addon, const char* name)
+{
+  if (!addon || !name)
+    return nullptr;
+  for (const KodiStaticAddonSymbol* s = addon->symbols; s->name; ++s)
+  {
+    if (std::strcmp(s->name, name) == 0)
+      return s->address;
+  }
+  return nullptr;
+}
diff --git a/xbmc/platform/switch2/StaticAddons.h b/xbmc/platform/switch2/StaticAddons.h
new file mode 100644
index 0000000..266ee05
--- /dev/null
+++ b/xbmc/platform/switch2/StaticAddons.h
@@ -0,0 +1,50 @@
+/*
+ *  Copyright (C) 2026 Team Kodi
+ *  This file is part of Kodi - https://kodi.tv
+ *
+ *  SPDX-License-Identifier: GPL-2.0-or-later
+ *  See LICENSES/README.md for more information.
+ */
+
+#pragma once
+
+// Static binary add-on registry for Switch 2, which has no dynamic loader.
+//
+// A binary add-on (e.g. inputstream.adaptive) is linked into kodi.bin as one prelinked object whose
+// only global symbols are its C entry points, renamed with a per-add-on prefix
+// (ADDON_Create -> isa_ADDON_Create, ...; see homebrew/kodi/isa/build.sh "pack").
+// DlStubs.cpp's dlopen() asks this registry for the library file name Kodi computed from the add-on's
+// addon.xml (CAddonDll::LibPath, e.g. ".../addons/inputstream.adaptive/inputstream.adaptive.so")
+// and gets a pseudo-handle; dlsym() on that handle returns the renamed entry point.
+//
+// The functions are extern "C" so DlStubs.cpp can reference them weakly: a kodi.bin linked without
+// StaticAddons.cpp behaves exactly as before (every dlopen fails).
+
+#ifdef __cplusplus
+extern "C" {
+#endif
+
+struct KodiStaticAddonSymbol
+{
+  const char* name; // symbol name Kodi passes to dlsym(), e.g. "ADDON_Create"
+  void* address; // the add-on's renamed definition, e.g. &isa_ADDON_Create
+};
+
+struct KodiStaticAddon
+{
+  const char* library; // library file name as written in addon.xml (library="...")
+  const struct KodiStaticAddonSymbol* symbols; // terminated by a {nullptr, nullptr} entry
+};
+
+// The registry entry whose library file name equals the last path component of `path`, or nullptr.
+const struct KodiStaticAddon* kodi_static_addon_find(const char* path);
+
+// Non-zero when `handle` is a pointer returned by kodi_static_addon_find().
+int kodi_static_addon_is_handle(const void* handle);
+
+// The address registered for `name` in `addon`, or nullptr.
+void* kodi_static_addon_symbol(const struct KodiStaticAddon* addon, const char* name);
+
+#ifdef __cplusplus
+}
+#endif
