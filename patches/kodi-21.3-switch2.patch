+// "<ms> FATAL <fn> rc=.. lr=..(+offset) [a=.. b=..] [text]" to boot.txt and crash.txt, then a
+// backtrace (fp chain from `fp`) to crash.txt.
+void FatalLog(const char* fn, u64 rc, u64 lr, u64 fp, const char* text, bool args, u64 a, u64 b)
+{
+  if (g_fatalDepth.fetch_add(1) != 0)
+  {
+    g_fatalDepth.fetch_sub(1);
+    return;
+  }
+  ResolveModule();
+  Out o(g_fatalBuf);
+  o.Dec(static_cast<long long>(armTicksToNs(armGetSystemTick()) / 1000000ULL));
+  o.Put(" FATAL ");
+  o.Put(fn);
+  o.Kv("rc", rc);
+  o.Addr("lr", lr);
+  if (args)
+  {
+    o.Kv("a", a);
+    o.Kv("b", b);
+  }
+  u64 tid = 0;
+  svcGetThreadId(&tid, CUR_THREAD_HANDLE);
+  o.Put(" tid=");
+  o.Dec(static_cast<long long>(tid));
+  if (text)
+  {
+    o.Put(" ");
+    o.Put(text);
+  }
+  o.Put("\n");
+  // crash.txt first (its own fs session, rev 38): boot.txt is appended by path through libounce's
+  // fs session manager, which could block a thread that ends while holding it.
+  CrashWrite(o.buf, o.n);
+  Switch2RawAppend(BOOT, o.buf, o.n);
+  o.n = 0;
+  o.Put("=== FATAL ");
+  o.Put(fn);
+  o.Kv("base", g_textBase);
+  o.Put("\n");
+  o.Backtrace(fp);
+  Flush(o);
+  g_fatalDepth.fetch_sub(1);
+}
