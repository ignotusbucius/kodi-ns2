+
+// Read-only USB lifecycle. One worker owns mount, polling and volume publication.
+
+#include "UsbStorage.h"
+#include "UsbIdentity.h"
+#include "utils/StringUtils.h"
+
+#include "PosixCompat.h"
+#include "DiagLog.h"
+
+#include <atomic>
+#include <chrono>
+#include <condition_variable>
+#include <cstdio>
+#include <cstdlib>
+#include <cstring>
+#include <mutex>
+#include <thread>
+
+#include <usbfs2.h>
+
+namespace
+{
+std::mutex g_mutex; // guards everything below
+std::condition_variable g_wake;
+bool g_stopRequested = false;
+std::vector<SWITCH2USB::Volume> g_volumes; // listed volumes (hidden/dead ones removed)
+unsigned g_generation = 0;
+std::thread* g_thread = nullptr; // never destroyed: a joinable std::thread at static destruction would terminate
+std::atomic<bool> g_started{false};
+std::atomic<bool> g_stopped{false};
+std::atomic<bool> g_sessionOpen{false}; // usbfs2_init succeeded and usbfs2_exit has not run yet
+
+// usbfs2 log lines (level 0: milestones and errors) to boot.txt. Runs under usbfs2's mutex: it only
+// formats and appends to the SD card with fs IPC (no ums path, no usbfs2 call).
+void UsbLog(int, const char* line)
+{
+  Switch2DiagLog("%s", line);
+}
+
+std::string SizeText(unsigned long long bytes)
+{
+  char buf[32];
+  const double gib = static_cast<double>(bytes) / (1024.0 * 1024.0 * 1024.0);
+  if (gib >= 1024.0)
+    std::snprintf(buf, sizeof(buf), "%.1f TiB", gib / 1024.0);
+  else if (gib >= 10.0)
+    std::snprintf(buf, sizeof(buf), "%.0f GiB", gib);
+  else if (gib >= 1.0)
+    std::snprintf(buf, sizeof(buf), "%.1f GiB", gib);
+  else
+    std::snprintf(buf, sizeof(buf), "%.0f MiB", gib * 1024.0);
+  return buf;
+}
+
+// usbfs2 v1c reads each volume's label once at mount (f_getlabel, read-only). The entry is named by
+// that label ("FILMS"); a volume without one by its file system and size ("USB drive (exFAT, 954 GiB)").
+std::vector<SWITCH2USB::Volume> ReadVolumes(const std::string& key)
+{
+  std::vector<SWITCH2USB::Volume> out;
+  const int n = usbfs2_volume_count();
+  for (int i = 0; i < n; ++i)
+  {
+    Usbfs2Volume v;
+    if (usbfs2_volume(i, &v) != 0)
+      continue;
+    const int index = v.device[3] - '0';
+    if (index < 0 || index > 7)
+      continue;
+    SWITCH2USB::Volume vol;
+    vol.index = index;
+    vol.path = SWITCH2USB::SpecialRoot(index,key);
+    // The label as usbfs2 stored it: NUL-terminated inside the 36-byte field, control bytes already
+    // replaced; trailing spaces (FAT pads labels) dropped.
+    std::string label(v.label, strnlen(v.label, sizeof(v.label)));
+    while (!label.empty() && label.back() == ' ')
+      label.pop_back();
+    if (!label.empty())
+      vol.label = label;
+    else
+    {
+      vol.label = std::string("USB drive (") + (v.fs_name ? v.fs_name : "FAT") + ", " +
+                  SizeText(static_cast<unsigned long long>(v.block_count) * v.block_size);
+      if (n > 1)
+        vol.label += ", partition " + std::to_string(v.part_index);
+      vol.label += ")";
+    }
+    Switch2DiagLog("usbfs2: ums%d listed as '%s'", index, vol.label.c_str());
+    out.push_back(vol);
+  }
+  return out;
+}
+
+void CloseUsbfs2()
+{
+  if (g_sessionOpen.exchange(false))
+    usbfs2_exit();
+}
+
+void Worker()
+{
+  Switch2BootLog("usbfs2-thread", 0);
+  if (usbfs2_init(UsbLog, SWITCH2_DIAG ? 1 : 0) != 0)
+  {
+    // A failed usbfs2_init has opened no usb:hs session (uhs2_open closes what it opened before it
+    // returns -1), so there is nothing to close: no usbfs2_exit here (it would log "session closed").
+    Switch2BootLog("usbfs2-init-failed", 0);
+    Switch2DiagLog("usbfs2: no usb:hs session was opened; nothing to close");
+    return;
+  }
+  g_sessionOpen = true;
+  const std::string session = StringUtils::CreateUUID();
+  usbfs2_set_path_key(nullptr);
+  const int mounted = usbfs2_mount(); // <= ~2 s state-event wait + the drive's TEST UNIT READY retries
+  Switch2BootLog("usbfs2-mount", mounted);
+  unsigned attachment = 0;
+  bool refresh = mounted > 0;
+  std::unique_lock<std::mutex> lock(g_mutex);
+  while (!g_stopRequested)
+  {
+    if (refresh)
+    {
+      lock.unlock();
+      const auto key = session + "-" + std::to_string(attachment);
+      std::vector<SWITCH2USB::Volume> volumes;
+      if (usbfs2_volume_count() && !session.empty() && usbfs2_set_path_key(key.c_str()) == 0)
+        volumes = ReadVolumes(key);
+      for (auto& v : volumes) v.attachment = attachment;
+      lock.lock();
+      if (g_stopRequested) break;
+      g_volumes = std::move(volumes);
+      ++g_generation;
+    }
+    if (g_wake.wait_for(lock, std::chrono::seconds(1), [] { return g_stopRequested; })) break;
+    lock.unlock();
+    refresh = usbfs2_poll() != 0;
+    if (refresh) ++attachment;
+    lock.lock();
+  }
+}
+} // namespace
+
+namespace SWITCH2USB
+{
+void Start()
+{
+  if (g_started.exchange(true))
+    return;
+  // Backstop for exit() paths that never return to main (usbfs2_exit is idempotent). Registered
+  // after BringUpServices' handlers, so it runs before appletUnlockExit.
+  std::atexit([] { Stop(); });
+  try
+  {
+    g_thread = new std::thread(Worker);
+    Switch2BootLog("usbfs2-thread-started", 0);
+  }
+  catch (...)
+  {
+    g_thread = nullptr;
+    Switch2BootLog("usbfs2-thread-failed", 0);
+  }
+}
+
+void Stop()
+{
+  SWITCH2_STOP_MARK("SWITCH2USB::Stop enter started=%d stopped=%d", g_started ? 1 : 0,
+                    g_stopped ? 1 : 0);
+  if (!g_started || g_stopped.exchange(true))
+    return;
+  {
+    std::lock_guard<std::mutex> lock(g_mutex);
+    g_stopRequested = true;
+    g_volumes.clear();
+    ++g_generation;
+  }
+  g_wake.notify_all();
+  SWITCH2_STOP_MARK("SWITCH2USB::Stop join pre");
+  if (g_thread && g_thread->joinable())
+    g_thread->join(); // at most the rest of a mount attempt or one queued usbfs2_drive
+  SWITCH2_STOP_MARK("SWITCH2USB::Stop join post; usbfs2_exit pre session=%d",
+                    g_sessionOpen ? 1 : 0);
+  CloseUsbfs2(); // unmount every volume, release the interface, close usb:hs
+  Switch2BootLog("usbfs2-stopped", 0);
+}
+
+std::vector<Volume> Volumes()
+{
+  std::lock_guard<std::mutex> lock(g_mutex);
+  return g_volumes;
+}
+
+bool Retired(const std::string& path)
+{
+  if (!USBPath(path)) return false;
+  std::lock_guard<std::mutex> lock(g_mutex);
+  for (const auto& v : g_volumes) {
+    const auto slash = v.path.find('/',10);
+    if (SameTree(path,v.path) || SameTree(path,NativeRoot(v.path.substr(10,slash-10)))) return false;
+  }
+  return true;
+}
+
+unsigned Generation()
+{
+  std::lock_guard<std::mutex> lock(g_mutex);
+  return g_generation;
+}
+
+bool Hide(const std::string& path, unsigned& attachment)
+{
+  std::lock_guard<std::mutex> lock(g_mutex);
+  for (auto it = g_volumes.begin(); it != g_volumes.end(); ++it)
+  {
+    if (it->path == path || it->path == path + "/")
+    {
+      attachment = it->attachment;
+      g_volumes.erase(it);
+      ++g_generation;
+      return true;
+    }
+  }
+  return false;
+}
+} // namespace SWITCH2USB
diff --git a/xbmc/platform/switch2/UsbStorage.h b/xbmc/platform/switch2/UsbStorage.h
new file mode 100644
index 0000000..0137379
--- /dev/null
+++ b/xbmc/platform/switch2/UsbStorage.h
@@ -0,0 +1,44 @@
+/*
+ *  Copyright (C) 2026 Team Kodi
+ *  This file is part of Kodi - https://kodi.tv
+ *
+ *  SPDX-License-Identifier: GPL-2.0-or-later
+ *  See LICENSES/README.md for more information.
+ */
+
+#pragma once
+
+// Read-only USB drives through usbfs2 (homebrew/usbfs2, linked as libusbfs2.a): the FAT/exFAT volumes
+// of the first USB mass-storage drive currently attached become newlib devices "ums0:".."ums7:", which
+// Kodi reaches as special://usb0/..special://usb7/ (CSpecialProtocol) and lists as removable drives
+// (storage/Switch2StorageProvider.cpp). Replacements receive a fresh attachment identity.
+
+#include <string>
+#include <vector>
+
+namespace SWITCH2USB
+{
+struct Volume
+{
+  unsigned attachment = 0;
+  int index = 0;      // N of umsN: / special://usbN/
+  std::string path;   // "special://usbN/"
+  std::string label;  // the volume label, or "USB drive (exFAT, 931 GiB)" when it has none
+};
+
+// main thread, after the OpenSSL warm-up: opens the usb:hs session and attaches/mounts on a
+// background thread (the attach can wait seconds for the drive); returns at once.
+void Start();
+// After XBMC_Run returned (every Kodi reader stopped): joins the thread and closes usbfs2
+// (unmount, release the interface, close the session). Idempotent; also registered with atexit.
+void Stop();
+
+// The volumes Kodi lists now: mounted, the drive not marked dead, not ejected. Never blocks on USB.
+std::vector<Volume> Volumes();
+// Changes whenever Volumes() changes.
+unsigned Generation();
+bool Retired(const std::string& path);
+// "Remove safely": hide that volume's entry (read-only, so nothing to flush; no USB command).
+// true when `path` is one of the listed volumes.
+bool Hide(const std::string& path, unsigned& attachment);
+} // namespace SWITCH2USB
