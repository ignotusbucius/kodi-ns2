 {
+#if defined(TARGET_SWITCH2)
+  // USB drives are read-only (usbfs2: every write is EROFS). special://usbN/ (and its translation
+  // umsN:/) would otherwise pass IsHD below: no Delete/Rename/Move for them, and writers that ask
+  // here first (subtitle download "next to the video", .nfo/artwork export) use their fallback
+  // folder instead (CGUIDialogSubtitles::OnDownloadComplete: special://subtitles, else special://temp).
+  if (StringUtils::StartsWithNoCase(strPath, "special://usb") ||
+      (strPath.size() >= 5 && StringUtils::StartsWithNoCase(strPath, "ums") &&
+       strPath[3] >= '0' && strPath[3] <= '7' && strPath[4] == ':'))
+    return false;
+#endif
   // currently only hd, smb, nfs and dav support delete and rename
   if (URIUtils::IsHD(strPath))
     return true;
