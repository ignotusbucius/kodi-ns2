+#pragma once
+
+#include "windowing/OSScreenSaver.h"
+
+namespace KODI
+{
+namespace WINDOWING
+{
+namespace SWITCH2
+{
+
+// The console's idle dimming and auto-sleep, held off while Kodi inhibits the OS screen saver
+// (video playback etc., COSScreenSaverManager): appletSetMediaPlaybackState(true/false). That is a
+// per-process applet state (SetMediaPlaybackStateForApplication for an Application): the applet
+// manager drops it when the process ends, and nothing is written to system settings. Not
+// appletSetAutoSleepDisabled or the idle-time extensions.
+class COSScreenSaverSwitch2 : public IOSScreenSaver
+{
+public:
+  void Inhibit() override;
+  void Uninhibit() override;
+
+private:
+  bool m_inhibited = false;
+};
+
+} // namespace SWITCH2
+} // namespace WINDOWING
+} // namespace KODI
