diff --git a/xbmc/platform/switch2/main.cpp b/xbmc/platform/switch2/main.cpp
new file mode 100644
index 0000000..817a8cc
--- /dev/null
+++ b/xbmc/platform/switch2/main.cpp
@@ -0,0 +1,327 @@
+/*
+ *  Copyright (C) 2026 Team Kodi
+ *  This file is part of Kodi - https://kodi.tv
+ *
+ *  SPDX-License-Identifier: GPL-2.0-or-later
+ *  See LICENSES/README.md for more information.
+ */
+
+// Entry point of the Switch 2 NRO. Brings up the console services Kodi needs
+// (sockets, HID, audio, time), points Kodi at sdmc:/switch/kodi and runs it.
+
+#include "application/AppEnvironment.h"
+#include "application/AppParamParser.h"
+#include "cores/AudioEngine/Sinks/AESinkSwitch2.h"
+#include "cores/VideoPlayer/DVDCodecs/Video/DVDVideoCodecSwitch2.h"
+#include "platform/xbmc.h"
+#include "platform/switch2/DiagLog.h"
+#include "platform/switch2/PosixCompat.h"
+#include "platform/switch2/StartupProbe.h"
+#include "platform/switch2/UsbStorage.h"
+#include "interfaces/python/PythonInvoker.h"
+
+#include <atomic>
+#include <cstdio>
+#include <cstdlib>
+#include <cstring>
+#include <dirent.h>
+#include <malloc.h>
+#include <string>
+#include <thread>
+#include <locale.h>
+#include <sys/stat.h>
+#include <unistd.h>
+
+#include <switch.h>
+
+// libounce applet.c (weak, default 0); global scope: ExitCheck sits in an unnamed namespace.
+extern "C" u32 __nx_applet_exit_mode;
+
+namespace
+{
+// Device-qualified for mkdir/chdir (makes sdmc the default device); Kodi itself gets KODI_HOME.
+constexpr const char* KODI_ROOT = "sdmc:/switch/kodi";
+// Kodi and sqlite only treat paths starting with "/" as absolute (CURL::IsFullPath, unixFullPathname).
+constexpr const char* KODI_HOME = "/switch/kodi";
+
+void BringUpServices()
+{
+  // Leave the CPU at the title's setting; ask applet for focus events so HOME suspends us cleanly.
+  appletSetFocusHandlingMode(AppletFocusHandlingMode_SuspendHomeSleepNotify);
+  // Delay a HOME->Close exit (15 s limit) so appletMainLoop() reports it and Kodi saves its state.
+  appletLockExit();
+  // Every exit path (incl. exit() deep inside Kodi) must unlock before the process ends (applet.h).
+  atexit([] { appletUnlockExit(); });
+  // Registered after the unlock, so it runs first: an exit() that skips CApplication::Stop while
+  // video plays must not leave the console's dimming/auto-sleep held off (OSScreenSaverSwitch2).
+  atexit([] {
+    if (appletGetAppletType() != AppletType_None)
+      appletSetMediaPlaybackState(false);
+  });
+
+  SocketInitConfig sockCfg = *socketGetDefaultInitConfig();
+  sockCfg.tcp_tx_buf_size = 0x40000;
+  sockCfg.tcp_rx_buf_size = 0x80000;
+  sockCfg.tcp_tx_buf_max_size = 0x100000;
+  sockCfg.tcp_rx_buf_max_size = 0x200000;
+  sockCfg.sb_efficiency = 8;
+  // Every thread blocked in poll/recv/accept holds one bsd:u session until it returns (curl multi
+  // loops, libmicrohttpd, CPython/asyncio, Kodi's receivers): libounce's default of 3 stalls the
+  // rest. 8 of the 16 a session manager allows; the transfer memory does not depend on it.
+  sockCfg.num_bsd_sessions = 8;
+  Result rc = socketInitialize(&sockCfg);
+  Switch2BootLog("socket-init rc", static_cast<long long>(rc));
+  Switch2BootLog("socket-init sessions", static_cast<long long>(sockCfg.num_bsd_sessions));
+  if (R_FAILED(rc))
+  {
+    // Fall back to libounce's default session count.
+    sockCfg.num_bsd_sessions = 3;
+    rc = socketInitialize(&sockCfg);
+    Switch2BootLog("socket-init retry rc", static_cast<long long>(rc));
+    Switch2BootLog("socket-init retry sessions", static_cast<long long>(sockCfg.num_bsd_sessions));
+  }
+
+  // Mirror stdout to nxlink when hbmenu's NetLoader started us.
+  const int nxlink = nxlinkStdio();
+  // stderr goes to the SD card instead (one file per launch): CPython's fatal_error() writes
+  // "Fatal Python error: ..." and its traceback dump to fileno(stderr), and PyErr_Print/
+  // faulthandler write there too. Unbuffered, so a line is on the SD before the next call.
+  FILE* err = freopen("sdmc:/switch/kodi/stderr.txt", "w", stderr);
+  if (err)
+    setvbuf(stderr, nullptr, _IONBF, 0);
+#if SWITCH2_DIAG
+  Switch2BootLog("stderr-to-sd", err ? fileno(stderr) : -1);
+  Switch2BootLog("nxlink-stdio", nxlink);
+#else
+  (void)nxlink;
+#endif
+}
+
+#if SWITCH2_DIAG
+// One boot.txt line per second for the first minute, then every 5 s for the rest of the session:
+// "<ms> mem used=.. total=.. arena=.. inuse=.. free=.. pythreads=<running> threads cur/limit=<ours>/
+// <probed limit> live=<running> zombie=<ended, not joined> reapq=.. created=.. failed=..".
+// svcGetInfo for the process, mallinfo() of libounce's allocator; thread counts from PosixCompat.cpp
+// (Switch2ThreadCountsLine; cur = main + running + ended-unjoined threads, every kernel thread of
+// kodi.bin being a pthread). Never fatal: a failed query logs 0, a failed write is dropped.
+// Rev 38g: stoppable and joined at exit (StopMemoryMonitor). Kodi's exit does not end the loader's
+// process, and a monitor left looping ran on into the next launch, which is loaded at the same address.
+std::atomic<bool> g_monitorStop{false};
+std::thread* g_monitor = nullptr; // never destroyed: a joinable static std::thread would terminate at exit
+
+void StopMemoryMonitor()
+{
+  if (!g_monitor)
+    return;
+  g_monitorStop.store(true);
+  if (g_monitor->joinable())
+    g_monitor->join();
+  g_monitor = nullptr;
+  Switch2BootLog("monitor-stopped", 0);
+}
+
+void StartMemoryMonitor()
+{
+  try
+  {
+    g_monitor = new std::thread([] {
+      for (unsigned long i = 0; !g_monitorStop.load(); ++i)
+      {
+        const int steps = i < 60 ? 10 : 50; // 1 s, later 5 s, in 100 ms steps
+        for (int k = 0; k < steps && !g_monitorStop.load(); ++k)
+          svcSleepThread(100000000LL);
+        if (g_monitorStop.load())
+          break;
+        u64 used = 0, total = 0;
+        svcGetInfo(&used, InfoType_UsedMemorySize, CUR_PROCESS_HANDLE, 0);
+        svcGetInfo(&total, InfoType_TotalMemorySize, CUR_PROCESS_HANDLE, 0);
+        const struct mallinfo mi = mallinfo();
+        char counts[200];
+        Switch2ThreadCountsLine(counts, sizeof(counts));
+        char line[400];
+        const int n = snprintf(
+            line, sizeof(line),
+            "%llu mem used=%llu total=%llu arena=%llu inuse=%llu free=%llu pythreads=%ld %s\n",
+            static_cast<unsigned long long>(armTicksToNs(armGetSystemTick()) / 1000000ULL),
+            static_cast<unsigned long long>(used), static_cast<unsigned long long>(total),
+            static_cast<unsigned long long>(mi.arena), static_cast<unsigned long long>(mi.uordblks),
+            static_cast<unsigned long long>(mi.fordblks), g_switch2PyThreadsLive.load(), counts);
+        if (n > 0)
+          Switch2RawAppend("/switch/kodi/boot.txt", line,
+                           static_cast<size_t>(n) < sizeof(line) ? static_cast<size_t>(n)
+                                                                 : sizeof(line) - 1);
+      }
+    });
+    std::atexit([] { StopMemoryMonitor(); });
+    Switch2BootLog("mem-monitor-started", 0);
+  }
+  catch (...)
+  {
+    Switch2BootLog("mem-monitor-failed", 0);
+  }
+}
+
+#endif // SWITCH2_DIAG
+
+void TearDownServices()
+{
+  socketExit();
+}
+
+// Rev 38g: Kodi returns to the loader (hbmenu) and the next Kodi is loaded into the same process at the
+// same address. Anything of this launch still running then runs into the next one's memory (the reaper
+// did: findings 1571/1574). After stopping our own background threads, if a recorded thread still runs,
+// a stopped script left an interpreter running, or a detached thread had no record (never joined), end
+// the whole process instead of returning: the next launch then starts in a fresh process.
+// "exit-check ..." in boot.txt either way.
+void ExitCheck(int status)
+{
+#if SWITCH2_DIAG
+  StopMemoryMonitor();
+#endif
+  Switch2StopReaper();
+  const long live = g_switch2ThreadsLive.load();
+  const long zombie = g_switch2ThreadsZombie.load();
+  const long reapq = g_switch2ThreadsReapQueued.load();
+  const long leaked = Switch2DetachLeakedCount();
+  const bool pyAbandoned = CPythonInvoker::Switch2InterpreterAbandoned();
+  // Rev 39b: an audio session still open (sink not closed by AE shutdown) would also outlive it.
+  const bool audio = Switch2AudioSessionOpen();
+  const bool endProcess = live > 0 || leaked > 0 || pyAbandoned || audio;
+  // Rev 39e: end the application the way an NSO title does instead of svcExitProcess, which the
+  // system reports as a crash ("There was a problem, and the software needed to close", rev 39d
+  // operator run B). libounce applet.c: with __nx_applet_exit_mode = 1, _exit -> __libnx_exit
+  // (__appExit, drivers and every open service closed) -> _appletExitProcess -> ISelfController::Exit,
+  // then sleeps until the system ends the whole process (abandoned threads included); only if Exit
+  // is refused does it fall back to svcExitProcess. atexit handlers and static destructors are
+  // skipped (_exit): threads of this launch still run. Only for an Application/SystemApplication;
+  // any other applet type keeps svcExitProcess (the cleanup would otherwise return to the loader).
+  const AppletType type = appletGetAppletType();
+  const bool selfExit = type == AppletType_Application || type == AppletType_SystemApplication;
+  Switch2DiagLog(
+      "exit-check status=%d live=%ld zombie=%ld reapq=%ld detach_leaked=%ld py_abandoned=%d audio=%d "
+      "applet_type=%d -> %s",
+      status, live, zombie, reapq, leaked, pyAbandoned ? 1 : 0, audio ? 1 : 0, static_cast<int>(type),
+      !endProcess ? "return to the loader"
+      : selfExit  ? "application exit (ISelfController::Exit; threads or an audio session of this "
+                    "launch would outlive it)"
+                  : "svcExitProcess (threads or an audio session of this launch would outlive it)");
+  if (!endProcess)
+    return;
+  if (selfExit)
+  {
+    __nx_applet_exit_mode = 1;
+    _exit(status);
+  }
+  svcExitProcess();
+}
+// One flushed line per stage, before Kodi's own log exists (CLog starts in CApplication::Create).
+// Same raw writer as every other boot.txt line (PosixCompat.h): one writer path, serialised.
+void BootMark(const char* what, int value = 0)
+{
+  Switch2BootLog(what, value);
+}
+
+// Only one Kodi process can exist, so any sqlite dot-file lock left by a crash is stale.
+void ClearStaleDbLocks()
+{
+  const std::string dir = "sdmc:/switch/kodi/.kodi/userdata/Database";
+  DIR* d = opendir(dir.c_str());
+  if (!d)
+    return;
+  int removed = 0;
+  while (dirent* e = readdir(d))
+  {
+    const size_t len = std::strlen(e->d_name);
+    if (len > 5 && std::strcmp(e->d_name + len - 5, ".lock") == 0)
+      removed += rmdir((dir + "/" + e->d_name).c_str()) == 0;
+  }
+  closedir(d);
+  BootMark("stale-db-locks-removed", removed);
+}
+} // namespace
+
+int main(int argc, char* argv[])
+{
+  // First: crash.txt diagnostics for native exceptions, std::terminate and abort (CrashHandler.cpp).
+  Switch2InstallCrashHandlers();
+  BringUpServices();
+
+  mkdir(KODI_ROOT, 0777);
+  chdir(KODI_ROOT);
+  // Must be set before CAppEnvironment::SetUp: InitDirectoriesLinux derives special://home from
+  // $HOME (SettingsComponent.cpp), so user data lands in sdmc:/switch/kodi/.kodi.
+  setenv("HOME", KODI_HOME, 1);
+  // special://xbmcbin: /proc/self/exe does not exist here.
+  setenv("KODI_BIN_HOME", KODI_HOME, 1);
+  setlocale(LC_NUMERIC, "C");
+  BootMark("main-entered");
+  {
+    // Rev 38g: per launch, so a later launch in the same loader process shows what earlier ones left.
+    u64 used = 0, total = 0;
+    svcGetInfo(&used, InfoType_UsedMemorySize, CUR_PROCESS_HANDLE, 0);
+    svcGetInfo(&total, InfoType_TotalMemorySize, CUR_PROCESS_HANDLE, 0);
+    Switch2DiagLog("launch mem used=%llu total=%llu", static_cast<unsigned long long>(used),
+                   static_cast<unsigned long long>(total));
+  }
+  // Free part of the process thread limit, before any thread of ours exists (PosixCompat.cpp;
+  // boot.txt now, kodi.log from CPlatformSwitch2::InitStageTwo).
+  Switch2ThreadLimitProbe();
+#if SWITCH2_DIAG
+  Switch2OsslTraceInit();
+  {
+    const int selftest = Switch2OsslSelfTestMode();
+    // Build every OpenSSL method on the main thread before any add-on thread can be first
+    // (OsslTrace.cpp); skipped only for the thread-first self-test.
+    if (selftest < 2) // the "T" modes (2, 21-24) must make the first fetch themselves
+      Switch2OsslWarmUp();
+    Switch2OsslSelfTest(selftest);
+  }
+  StartMemoryMonitor();
+#else
+  // Build every OpenSSL method on the main thread before any add-on thread can be the first to
+  // construct one: a first construction from an add-on thread killed the process (rev 20/21,
+  // findings 1515/1516). OsslTrace.cpp.
+  Switch2OsslWarmUp();
+#endif
+  // Read-only USB drive (usbfs2, UsbStorage.cpp): after the warm-up, so no other thread exists before
+  // OpenSSL is built; the attach runs on its own thread (it can wait seconds for the drive) and the
+  // volumes appear as removable drives once mounted (storage/Switch2StorageProvider.cpp).
+  SWITCH2USB::Start();
+  ClearStaleDbLocks();
+  Switch2StartupProbe();
+
+  CAppParamParser appParamParser;
+  appParamParser.Parse(argv, argc);
+
+  CAppEnvironment::SetUp(appParamParser.GetAppParams());
+  BootMark("xbmc-run-start");
+  int status = XBMC_Run(true);
+  BootMark("xbmc-run-returned", status);
+  // XBMC_Run returns after CApplication::Stop + Cleanup: the player is closed, jobs cancelled, the
+  // library scanners, service add-ons and every Python script stopped, the GUI and the service
+  // manager torn down, so no Kodi thread reads a ums path any more. Unmount and close usb:hs here,
+  // before the environment teardown and socketExit (the atexit hook is only the backstop for exit()
+  // paths that never come back here).
+  // The hardware decoder's creator session, kept open for the whole process (rev 37).
+  SWITCH2_STOP_MARK("main: hw video decoder creator release pre");
+  CDVDVideoCodecSwitch2::Shutdown();
+  SWITCH2_STOP_MARK("main: SWITCH2USB::Stop pre");
+  SWITCH2USB::Stop();
+  // Rev 39d: a script thread left running (abandoned at its stop) may sit in a socket or file call:
+  // socketExit / the environment teardown would wake it into freed Kodi state. End the process
+  // here (ExitCheck: py_abandoned=1 -> application exit, back to HOME).
+  if (CPythonInvoker::Switch2InterpreterAbandoned())
+  {
+    SWITCH2_STOP_MARK("main: script abandoned: exit-check before CAppEnvironment::TearDown");
+    ExitCheck(status);
+  }
+  SWITCH2_STOP_MARK("main: SWITCH2USB::Stop post; CAppEnvironment::TearDown pre");
+  CAppEnvironment::TearDown();
+
+  SWITCH2_STOP_MARK("main: TearDownServices pre");
+  TearDownServices();
+  ExitCheck(status);
+  SWITCH2_STOP_MARK("main: return %d (atexit handlers, static destructors next)", status);
+  return status;
+}
