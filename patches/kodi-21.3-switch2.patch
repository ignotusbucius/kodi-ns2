+extern "C" void Switch2InstallCrashHandlers(void)
+{
+  g_sdmc = fsdevGetDeviceFileSystem("sdmc");
+  ResolveModule();
+  s64 bootRotated = 0, crashRotated = 0;
+  if (g_sdmc)
+  {
+    bootRotated = RotateIfLarger(BOOT, "/switch/kodi/boot.old.txt", 512 * 1024);
+    crashRotated = RotateIfLarger(CRASH, "/switch/kodi/crash.old.txt", 1024 * 1024);
+  }
+  if (g_sdmc)
+  {
+    fsFsCreateFile(g_sdmc, CRASH, 0, 0); // fails harmlessly when the file exists
+    s64 size = 0;
+    if (R_SUCCEEDED(fsFsOpenFile(g_sdmc, CRASH, FsOpenMode_Write | FsOpenMode_Append, &g_crashFile)))
+    {
+      if (R_SUCCEEDED(fsFileGetSize(&g_crashFile, &size)))
+      {
+        g_crashOff.store(size);
+        g_crashOpen.store(true);
+      }
+      else
+        fsFileClose(&g_crashFile);
+    }
+  }
+  // A session of its own for crash.txt writes when the file object lives on the shared root
+  // session (domain): see g_crashSession.
+  Service* root = fsGetServiceSession();
+  Result cloneRc = 0;
+  if (g_crashOpen.load() && root && g_crashFile.s.session == root->session)
+  {
+    Handle h = INVALID_HANDLE;
+    cloneRc = cmifCloneCurrentObject(root->session, &h);
+    if (R_SUCCEEDED(cloneRc))
+    {
+      g_crashSession.store(h);
+      std::atexit(CloseCrashSession); // runs before libounce's fsExit closes the other sessions
+    }
+  }
+  std::set_terminate(OnTerminate);
+  if (bootRotated)
+    Switch2BootLog("boot-txt-rotated-to-boot.old.txt bytes", static_cast<long long>(bootRotated));
+  if (crashRotated)
+    Switch2BootLog("crash-txt-rotated-to-crash.old.txt bytes", static_cast<long long>(crashRotated));
+  if (!g_crashOpen.load())
+    Switch2BootLog("crash-txt-preopen-failed", 0);
+  else
+  {
+    // rev 38e: one "<ms> launch" line per start, written exactly as a crash would be (CrashFileWrite on
+    // the session above), so that write path runs on every launch and its result is in boot.txt.
+    // About 20 bytes per launch against the 1 MiB start-up rotation of crash.txt.
+    char line[48];
+    const int n = std::snprintf(line, sizeof(line), "%llu launch\n",
+                                static_cast<unsigned long long>(armTicksToNs(armGetSystemTick()) /
+                                                                1000000ULL));
+    Result wrc = 0;
+    if (n > 0 && static_cast<size_t>(n) < sizeof(line))
+    {
+      const s64 off = g_crashOff.fetch_add(n);
+      wrc = CrashFileWrite(off, line, static_cast<u64>(n));
+    }
+    Switch2DiagLog("crash-txt-own-session rc=0x%x own=%d clone_rc=0x%x", static_cast<unsigned>(wrc),
+                   g_crashSession.load() != INVALID_HANDLE ? 1 : 0, static_cast<unsigned>(cloneRc));
+  }
+  Switch2BootLog("crash-handlers-armed base", static_cast<long long>(g_textBase));
+}
