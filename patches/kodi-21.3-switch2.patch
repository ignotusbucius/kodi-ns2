+  QueryDisplaySize(m_screenWidth, m_screenHeight, m_displayWidth, m_displayHeight);
+  CLog::Log(LOGINFO, "Switch2: display mode={} output {}x{} window {}x{}", m_operationMode,
+            m_screenWidth, m_screenHeight, m_displayWidth, m_displayHeight);
+  Switch2DiagLog("display mode=%d window=%dx%d default=%dx%d", m_operationMode, m_displayWidth,
+                 m_displayHeight, m_screenWidth, m_screenHeight);
+
+  if (!m_eglContext.CreateDisplay(EGL_DEFAULT_DISPLAY))
+    return false;
+  if (!m_eglContext.InitializeDisplay(EGL_OPENGL_ES_API))
+    return false;
+  if (!m_eglContext.ChooseConfig(EGL_OPENGL_ES3_BIT))
+    return false;
+  // CEGLContextUtils::ChooseConfig returns true even when no config matched; fail loudly instead.
+  if (m_eglContext.GetEGLConfig() == nullptr)
+  {
+    CLog::Log(LOGFATAL, "Switch2: no EGL config matched (ES3, RGB888, window)");
+    return false;
+  }
+
+  CEGLAttributesVec contextAttribs;
+  contextAttribs.Add({{EGL_CONTEXT_MAJOR_VERSION, 3}, {EGL_CONTEXT_MINOR_VERSION, 0}});
+  if (!m_eglContext.CreateContext(contextAttribs))
+    return false;
+
+  return CWinSystemBase::InitWindowSystem();
+}
+
+bool CWinSystemSwitch2GLESContext::DestroyWindowSystem()
+{
+  m_eglContext.Destroy();
+  return true;
+}
+
+bool CWinSystemSwitch2GLESContext::CreateNewWindow(const std::string& name,
+                                                   bool fullScreen,
+                                                   RESOLUTION_INFO& res)
+{
+  if (m_bWindowCreated)
+  {
+    // Same size: nothing to do; else a new EGL surface on the resized NWindow.
+    if (m_nWidth == m_displayWidth && m_nHeight == m_displayHeight)
+      return true;
+    return RecreateSurface(m_displayWidth, m_displayHeight);
+  }
+
+  // A fixed size (not nwindowSetModeDimensions with 0x0): Kodi renders its GUI and video into one
+  // GLES surface of the GUI resolution, so the buffers must have that size (<= 1920x1080); AM scales
+  // the layer to the TV output. MessagePump re-sizes it when the mode or the TV setting changes.
+  nwindowSetDimensions(m_window, m_displayWidth, m_displayHeight);
+  if (!m_eglContext.CreateSurface(reinterpret_cast<EGLNativeWindowType>(m_window)))
+    return false;
+  if (!m_eglContext.BindContext())
+    return false;
+
+  m_nWidth = m_displayWidth;
+  m_nHeight = m_displayHeight;
+  m_bFullScreen = true;
+  m_bWindowCreated = true;
+  return true;
+}
+
+bool CWinSystemSwitch2GLESContext::DestroyWindow()
+{
+  m_eglContext.DestroySurface();
+  m_bWindowCreated = false;
+  return true;
+}
+
+bool CWinSystemSwitch2GLESContext::ResizeWindow(int newWidth, int newHeight, int newLeft, int newTop)
+{
+  CRenderSystemGLES::ResetRenderSystem(m_displayWidth, m_displayHeight);
+  return true;
+}
+
+bool CWinSystemSwitch2GLESContext::SetFullScreen(bool fullScreen,
+                                                 RESOLUTION_INFO& res,
+                                                 bool blankOtherDisplays)
+{
+  if (!CreateNewWindow("", true, res))
+    return false;
+  CRenderSystemGLES::ResetRenderSystem(m_displayWidth, m_displayHeight);
+  return true;
+}
+
+void CWinSystemSwitch2GLESContext::QueryDisplaySize(int& outputW,
+                                                    int& outputH,
+                                                    int& guiW,
+                                                    int& guiH) const
+{
+  // AM's default display resolution for the current mode: 1920x1080 handheld, the TV output setting
+  // docked. Read only; nothing is changed (no appletUpdateDefaultDisplayResolution, no set:sys).
+  s32 w = 0, h = 0;
+  if (R_FAILED(appletGetDefaultDisplayResolution(&w, &h)) || w <= 0 || h <= 0)
+  {
+    w = 1920;
+    h = 1080;
+  }
+  outputW = w;
+  outputH = h;
+  // GUI cap, like GBM's videoscreen.limitguisize: never more than 1920x1080.
+  if (w > 1920 || h > 1080)
+  {
+    const float scale = std::min(1920.f / static_cast<float>(w), 1080.f / static_cast<float>(h));
+    w = static_cast<s32>(static_cast<float>(w) * scale + 0.5f);
+    h = static_cast<s32>(static_cast<float>(h) * scale + 0.5f);
+  }
+  guiW = w;
+  guiH = h;
+}
+
+// Called from MessagePump (the main/render thread) after appletMainLoop: on an operation-mode
+// message at once, otherwise at most every 2 s (the TV setting can change while docked).
+void CWinSystemSwitch2GLESContext::CheckDisplayChange()
+{
+  if (!m_bWindowCreated)
+    return;
+  const int mode = static_cast<int>(appletGetOperationMode());
+  const uint64_t nowNs = armTicksToNs(armGetSystemTick());
+  if (mode == m_operationMode && nowNs < m_nextDisplayPollNs)
+    return;
+  m_nextDisplayPollNs = nowNs + 2000000000ULL;
+
+  int outW, outH, guiW, guiH;
+  QueryDisplaySize(outW, outH, guiW, guiH);
+  if (mode == m_operationMode && outW == m_screenWidth && outH == m_screenHeight &&
+      guiW == m_displayWidth && guiH == m_displayHeight)
+    return;
+
+  Switch2DiagLog("display change mode=%d output=%dx%d window=%dx%d", mode, outW, outH, guiW, guiH);
+  CLog::Log(LOGINFO, "Switch2: display change mode={} output {}x{} window {}x{}", mode, outW, outH,
+            guiW, guiH);
+  m_operationMode = mode;
+  m_screenWidth = outW;
+  m_screenHeight = outH;
+  if (guiW == m_displayWidth && guiH == m_displayHeight)
+    return; // e.g. handheld <-> docked on a 1080p or 4K TV setting: same 1920x1080 surface
+
+  m_displayWidth = guiW;
+  m_displayHeight = guiH;
+  UpdateResolutions();
+  // Kodi -> SetFullScreen(RES_DESKTOP) -> CreateNewWindow -> RecreateSurface at the new size.
+  GetGfxContext().SetVideoResolution(RES_DESKTOP, true);
+}
+
+bool CWinSystemSwitch2GLESContext::RecreateSurface(int width, int height)
+{
+  {
+    std::unique_lock<CCriticalSection> lock(m_resourceSection);
+    for (IDispResource* resource : m_resources)
+      resource->OnLostDisplay();
+  }
+
+  // The NWindow cannot change size while buffers are registered: the EGL surface goes first.
+  m_eglContext.DestroySurface();
+  const Result rc = nwindowSetDimensions(m_window, width, height);
+  if (R_FAILED(rc))
+    CLog::Log(LOGERROR, "Switch2: nwindowSetDimensions({}x{}) failed 0x{:x}", width, height, rc);
+  if (!m_eglContext.CreateSurface(reinterpret_cast<EGLNativeWindowType>(m_window)) ||
+      !m_eglContext.BindContext())
+  {
+    Switch2DiagLog("egl surface recreate FAILED %dx%d", width, height);
+    return false;
+  }
+
+  EGLint sw = 0, sh = 0;
+  eglQuerySurface(m_eglContext.GetEGLDisplay(), m_eglContext.GetEGLSurface(), EGL_WIDTH, &sw);
+  eglQuerySurface(m_eglContext.GetEGLDisplay(), m_eglContext.GetEGLSurface(), EGL_HEIGHT, &sh);
+  Switch2DiagLog("egl surface %dx%d", sw, sh);
+
+  m_nWidth = width;
+  m_nHeight = height;
+  CRenderSystemGLES::ResetRenderSystem(width, height);
+
+  {
+    std::unique_lock<CCriticalSection> lock(m_resourceSection);
+    for (IDispResource* resource : m_resources)
+      resource->OnResetDisplay();
+  }
+  return true;
+}
+
+void CWinSystemSwitch2GLESContext::UpdateResolutions()
+{
+  CWinSystemBase::UpdateResolutions();
+
+  // iWidth/iHeight = iScreenWidth/iScreenHeight = the GUI/surface size (<= 1920x1080; AM scales the
+  // layer to the output). Not a split GUI/screen size: CBaseRenderer scales video rects by
+  // iScreenWidth/iWidth for a separate video plane, and here video is drawn into the GUI surface.
+  RESOLUTION_INFO& desktop = CDisplaySettings::GetInstance().GetResolutionInfo(RES_DESKTOP);
+  UpdateDesktopResolution(desktop, "Switch2", m_displayWidth, m_displayHeight, 60.0f, 0);
+  CServiceBroker::GetWinSystem()->GetGfxContext().ResetOverscan(desktop);
+  CDisplaySettings::GetInstance().ClearCustomResolutions();
+  CDisplaySettings::GetInstance().AddResolutionInfo(desktop);
+  CDisplaySettings::GetInstance().ApplyCalibrations();
+}
+
+void CWinSystemSwitch2GLESContext::Register(IDispResource* resource)
+{
+  std::unique_lock<CCriticalSection> lock(m_resourceSection);
+  m_resources.push_back(resource);
+}
+
+void CWinSystemSwitch2GLESContext::Unregister(IDispResource* resource)
+{
+  std::unique_lock<CCriticalSection> lock(m_resourceSection);
+  m_resources.erase(std::remove(m_resources.begin(), m_resources.end(), resource),
+                    m_resources.end());
+}
+
+void CWinSystemSwitch2GLESContext::SetVSyncImpl(bool enable)
+{
+  m_eglContext.SetVSync(enable);
+}
+
+void CWinSystemSwitch2GLESContext::PresentRenderImpl(bool rendered)
+{
+  if (rendered && !m_eglContext.TrySwapBuffers())
+    CEGLUtils::Log(LOGERROR, "eglSwapBuffers failed");
+}
+
+void CWinSystemSwitch2GLESContext::PushKey(uint32_t sym, bool down)
+{
+  XBMC_Event event{};
+  event.type = down ? XBMC_KEYDOWN : XBMC_KEYUP;
+  event.key.keysym.sym = static_cast<XBMCKey>(sym);
+  event.key.keysym.scancode = 0;
+  event.key.keysym.mod = XBMCKMOD_NONE;
+  event.key.keysym.unicode = 0;
+  SendEvent(event);
+}
+
+void CWinSystemSwitch2GLESContext::PollPad()
+{
+  padUpdate(&m_pad);
+  const uint64_t held = padGetButtons(&m_pad);
+
+  // Kodi expects the window system to auto-repeat held keys (scrolling, long press).
+  constexpr uint64_t kRepeatDelayNs = 400000000ULL;
+  constexpr uint64_t kRepeatRateNs = 80000000ULL;
+  const uint64_t nowNs = armTicksToNs(armGetSystemTick());
+  for (size_t i = 0; i < std::size(kPadKeys); ++i)
+  {
+    const PadKey& key = kPadKeys[i];
+    const bool down = (held & key.button) != 0;
+    const bool before = (m_heldMapped & key.button) != 0;
+    if (down != before)
+    {
+      PushKey(key.sym, down);
+      m_repeatAtNs[i] = nowNs + kRepeatDelayNs;
+    }
+    else if (down && nowNs >= m_repeatAtNs[i])
+    {
+      PushKey(key.sym, true);
+      m_repeatAtNs[i] = nowNs + kRepeatRateNs;
+    }
+  }
+  m_heldMapped = held;
+}
+
+void CWinSystemSwitch2GLESContext::PollTouch()
+{
+  HidTouchScreenState state{};
+  if (hidGetTouchScreenStates(&state, 1) == 0)
+    return;
+
+  // The touch panel reports 1280x720 coordinates in handheld mode.
+  const float sx = static_cast<float>(m_displayWidth) / 1280.f;
+  const float sy = static_cast<float>(m_displayHeight) / 720.f;
+
+  if (state.count > 0)
+  {
+    const float x = state.touches[0].x * sx;
+    const float y = state.touches[0].y * sy;
+    XBMC_Event motion{};
+    motion.type = XBMC_MOUSEMOTION;
+    motion.motion.x = static_cast<uint16_t>(x);
+    motion.motion.y = static_cast<uint16_t>(y);
+    SendEvent(motion);
+    if (!m_touchDown)
+    {
+      XBMC_Event press{};
+      press.type = XBMC_MOUSEBUTTONDOWN;
+      press.button.button = 1;
+      press.button.x = static_cast<uint16_t>(x);
+      press.button.y = static_cast<uint16_t>(y);
+      SendEvent(press);
+    }
+    m_touchDown = true;
+    m_touchX = x;
+    m_touchY = y;
+  }
+  else if (m_touchDown)
+  {
+    XBMC_Event release{};
+    release.type = XBMC_MOUSEBUTTONUP;
+    release.button.button = 1;
+    release.button.x = static_cast<uint16_t>(m_touchX);
+    release.button.y = static_cast<uint16_t>(m_touchY);
+    SendEvent(release);
+    m_touchDown = false;
+  }
+}
+
+void CWinSystemSwitch2GLESContext::HandleApplet()
+{
+  // appletMainLoop() processes HOME/sleep messages and returns false on an exit request.
+  if (!appletMainLoop())
+  {
+    XBMC_Event quit{};
+    quit.type = XBMC_QUIT;
+    SendEvent(quit);
+  }
+}
+
+bool CWinSystemSwitch2GLESContext::MessagePump()
+{
+  HandleApplet();
+  CheckDisplayChange();
+  PollPad();
+  PollTouch();
+  return true;
+}
+
+std::unique_ptr<KODI::WINDOWING::IOSScreenSaver> CWinSystemSwitch2GLESContext::GetOSScreenSaverImpl()
+{
+  return std::make_unique<COSScreenSaverSwitch2>();
+}
