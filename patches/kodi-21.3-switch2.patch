+// One full-screen window on the default NWindow, GLES 3 through OunceVK's EGL.
+// Input: the main controller is mapped to keyboard keys, the touch screen to the mouse.
+class CWinSystemSwitch2GLESContext : public CWinSystemBase, public CRenderSystemGLES
+{
+public:
+  CWinSystemSwitch2GLESContext();
+  ~CWinSystemSwitch2GLESContext() override;
+
+  static void Register();
+  static std::unique_ptr<CWinSystemBase> CreateWinSystem();
+
+  const std::string GetName() override { return "switch2"; }
+  // Idle dimming / auto-sleep held off while Kodi inhibits the OS screen saver (OSScreenSaverSwitch2).
+  std::unique_ptr<KODI::WINDOWING::IOSScreenSaver> GetOSScreenSaverImpl() override;
+  CRenderSystemBase* GetRenderSystem() override { return this; }
+
+  bool InitWindowSystem() override;
+  bool DestroyWindowSystem() override;
+  bool CreateNewWindow(const std::string& name, bool fullScreen, RESOLUTION_INFO& res) override;
+  bool DestroyWindow() override;
+  bool ResizeWindow(int newWidth, int newHeight, int newLeft, int newTop) override;
+  bool SetFullScreen(bool fullScreen, RESOLUTION_INFO& res, bool blankOtherDisplays) override;
+  void UpdateResolutions() override;
+  bool CanDoWindowed() override { return false; }
+  bool SupportsScreenMove() override { return false; }
+  bool HasCursor() override { return false; }
+  void Register(IDispResource* resource) override;
+  void Unregister(IDispResource* resource) override;
+  bool MessagePump() override;
+  void* GetHWContext() override { return m_eglContext.GetEGLContext(); }
+
+  EGLDisplay GetEGLDisplay() const { return m_eglContext.GetEGLDisplay(); }
+
+protected:
+  void SetVSyncImpl(bool enable) override;
+  void PresentRenderImpl(bool rendered) override;
+
+private:
+  void PollPad();
+  void PollTouch();
+  void PushKey(uint32_t sym, bool down);
+  void HandleApplet();
+  // Display size handling (rev 30): the console's output size for the current operation mode and
+  // the GUI/EGL surface size derived from it (capped at 1920x1080).
+  void QueryDisplaySize(int& outputW, int& outputH, int& guiW, int& guiH) const;
+  void CheckDisplayChange();
+  bool RecreateSurface(int width, int height);
+
+  CEGLContextUtils m_eglContext;
+  NWindow* m_window = nullptr;
+  // GUI/EGL surface (and NWindow buffer) size, <= 1920x1080.
+  int m_displayWidth = 1920;
+  int m_displayHeight = 1080;
+  // Output size reported by AM for the current mode (e.g. 3840x2160 docked on a 4K TV setting).
+  int m_screenWidth = 1920;
+  int m_screenHeight = 1080;
+  int m_operationMode = -1;
+  uint64_t m_nextDisplayPollNs = 0;
+
+  PadState m_pad{};
+  uint64_t m_heldMapped = 0;
+  uint64_t m_repeatAtNs[18] = {}; // per kPadKeys entry: next auto-repeat time while held
+  bool m_touchDown = false;
+  float m_touchX = 0.f;
+  float m_touchY = 0.f;
+
+  CCriticalSection m_resourceSection;
+  std::vector<IDispResource*> m_resources;
+};
+
+} // namespace SWITCH2
+} // namespace WINDOWING
+} // namespace KODI
