+++ b/xbmc/platform/switch2/PosixCompat.cpp
@@ -0,0 +1,482 @@
+/*
+ *  Copyright (C) 2026 Team Kodi
+ *  This file is part of Kodi - https://kodi.tv
+ *
+ *  SPDX-License-Identifier: GPL-2.0-or-later
+ *  See LICENSES/README.md for more information.
+ */
+
+#include "PosixCompat.h"
+
+// pthread_create wrapper (linked with -Wl,--wrap=pthread_create, see ArchSetup.cmake): newlib/libounce
+// give a thread without attributes 128 KiB of stack; Kodi, FFmpeg and Mesa expect Linux-sized stacks.
+#include <pthread.h>
+
+extern "C" int __real_pthread_create(pthread_t*, const pthread_attr_t*, void* (*)(void*), void*);
+
+extern "C" int __wrap_pthread_create(pthread_t* thread,
+                                     const pthread_attr_t* attr,
+                                     void* (*start)(void*),
+                                     void* arg)
+{
+  if (attr)
+    return __real_pthread_create(thread, attr, start, arg);
+  pthread_attr_t big;
+  pthread_attr_init(&big);
+  pthread_attr_setstacksize(&big, 1u << 20);
+  const int rc = __real_pthread_create(thread, &big, start, arg);
+  pthread_attr_destroy(&big);
+  return rc;
+}
+
+// pthread_detach() wrapper (linked with -Wl,--wrap=pthread_detach, see Install.cmake).
+// libounce links no __syscall_thread_detach, so pthread_detach() always returns ENOSYS and
+// std::thread::detach() throws std::system_error; CThread's autodelete path detaches its own
+// thread inside a noexcept destructor -> std::terminate (rev 8 crash ~30 s after the home screen).
+// Here "detach" hands the thread to a reaper that joins it once it has exited,
+// which is what frees its stack and handle on this platform.
+#include <condition_variable>
+#include <deque>
+#include <mutex>
+
+namespace
+{
+std::mutex g_reapMutex;
+std::condition_variable g_reapCv;
+std::deque<pthread_t> g_reapQueue;
+bool g_reaperRunning = false;
+
+void* Reaper(void*)
+{
+  for (;;)
+  {
+    pthread_t t;
+    {
+      std::unique_lock<std::mutex> lock(g_reapMutex);
+      g_reapCv.wait(lock, [] { return !g_reapQueue.empty(); });
+      t = g_reapQueue.front();
+      g_reapQueue.pop_front();
+    }
+    pthread_join(t, nullptr); // waits until t has really exited; the reaper never queues itself
+  }
+  return nullptr;
+}
+
+void StartReaper()
+{
+  pthread_attr_t attr;
+  pthread_attr_init(&attr);
+  pthread_attr_setstacksize(&attr, 64 * 1024);
+  pthread_t reaper;
+  const int rc = __real_pthread_create(&reaper, &attr, Reaper, nullptr);
+  pthread_attr_destroy(&attr);
+  g_reaperRunning = rc == 0;
+  // Without a reaper, detached threads are never joined (their stacks and handles leak), but
+  // detach still succeeds: failing it would bring back the std::terminate seen in rev 8.
+  Switch2BootLog(rc == 0 ? "reaper-started" : "reaper-pthread_create-failed", rc);
+}
+} // namespace
+
+extern "C" int __wrap_pthread_detach(pthread_t thread)
+{
+  static std::once_flag once;
+  std::call_once(once, StartReaper);
+  if (!g_reaperRunning)
+    return 0;
+  {
+    std::lock_guard<std::mutex> lock(g_reapMutex);
+    g_reapQueue.push_back(thread);
+  }
+  g_reapCv.notify_one();
+  return 0;
+}
+
+// ----------------------------------------------------------------------------------------------
+// fsdev (SD card) POSIX fixes. Measured on hardware (rev 4b-8 bring-up):
+//  * read() at or past end-of-file fails with EIO where POSIX returns 0 (sqlite maps EIO to
+//    SQLITE_CORRUPT/IOERR);
+//  * stat() of a file reopens it by path, and any second open of a file that is open for writing
+//    fails with EIO, so stat()/access() of an open database, log or settings file fails.
+// Wrapped at the newlib reentrant layer (-Wl,--wrap=_read_r,--wrap=_stat_r,--wrap=_open_r,
+// --wrap=_close_r,--wrap=lstat, see cmake/scripts/switch2/Install.cmake), so read(), stat(),
+// access(), fopen()/fread() (newlib __sread) and sqlite's system-call table all go through here.
+// ----------------------------------------------------------------------------------------------
+#include <atomic>
+#include <cerrno>
+#include <cstdint>
+#include <cstdio>
+#include <cstring>
+#include <fcntl.h>
+#include <reent.h>
+#include <sys/stat.h>
+#include <unistd.h>
+
+#include <switch.h>
+
+extern "C" _ssize_t __real__read_r(struct _reent* r, int fd, void* buf, size_t count);
+extern "C" int __real__open_r(struct _reent* r, const char* path, int flags, int mode);
+extern "C" int __real__close_r(struct _reent* r, int fd);
+extern "C" int __real__stat_r(struct _reent* r, const char* path, struct stat* st);
+extern "C" int __real_lstat(const char* path, struct stat* st);
+
+// Build with -DSWITCH2_STATFAIL_LOG=1 to append every stat()/lstat() failure other than ENOENT to
+// sdmc:/switch/kodi/boot.txt (rev 6 instrument; off by default, it was the bulk of boot.txt).
+#ifndef SWITCH2_STATFAIL_LOG
+#define SWITCH2_STATFAIL_LOG 0
+#endif
+
+namespace
+{
+// fd registry: which newlib fds are fsdev files, opened readable, and under which path. Indexed by
+// fd, lock-free (an fd number is only reused after its close). Lets read() bound itself by the file
+// size and lets stat() of an open file take its size from the open fd instead of a second open.
+constexpr int kMaxTrackedFd = 1024;
+constexpr uint32_t kTracked = 1u << 0;
+constexpr uint32_t kReadable = 1u << 1;
+
+struct FdInfo
+{
+  std::atomic<uint64_t> hash{0};
+  std::atomic<uint32_t> flags{0};
+};
+FdInfo g_fds[kMaxTrackedFd];
+
+uint64_t PathHash(const FsFileSystem* fs, const char* fspath)
+{
+  uint64_t h = 1469598103934665603ULL ^ reinterpret_cast<uintptr_t>(fs);
+  for (const unsigned char* p = reinterpret_cast<const unsigned char*>(fspath); *p; ++p)
+  {
+    h ^= *p;
+    h *= 1099511628211ULL;
+  }
+  return h ? h : 1;
+}
+
+// Resolves `path` to its fsdev file system and fs path (relative paths use fsdev's cwd).
+bool Translate(const char* path, FsFileSystem** fs, char (&fspath)[FS_MAX_PATH])
+{
+  *fs = nullptr;
+  fspath[0] = '\0';
+  const int saved = errno;
+  const bool ok = path && fsdevTranslatePath(path, fs, fspath) == 0 && *fs;
+  errno = saved;
+  return ok;
+}
+
+int FindOpenFd(uint64_t hash)
+{
+  for (int fd = 0; fd < kMaxTrackedFd; ++fd)
+    if ((g_fds[fd].flags.load(std::memory_order_acquire) & kTracked) &&
+        g_fds[fd].hash.load(std::memory_order_relaxed) == hash)
+      return fd;
+  return -1;
+}
+
+#if SWITCH2_STATFAIL_LOG
+std::atomic<int> g_statFailLines{0};
+
+void StatFailLog(const char* what, const char* path, int err, bool recovered)
+{
+  if (g_statFailLines.fetch_add(1) >= 256) // bounded: a hot failing path must not flood the SD
+    return;
+  char line[400];
+  const int n = snprintf(line, sizeof(line), "%s-fail path=%s errno=%d fallback=%d\n", what,
+                         path ? path : "-", err, recovered ? 1 : 0);
+  if (n > 0)
+    Switch2RawAppend("/switch/kodi/boot.txt", line,
+                     static_cast<size_t>(n) < sizeof(line) ? static_cast<size_t>(n) : sizeof(line) - 1);
+}
+#endif
+
+// stat() answer for a path whose fsdev stat failed with EIO (file open for writing in this
+// process): the entry type needs no open; a file's size and times come from our open fd when the
+// registry has one (it has, for anything opened through open()/fopen()), else st_size stays 0.
+bool StatFallback(struct _reent* r, const char* path, struct stat* st)
+{
+  FsFileSystem* fs;
+  char fspath[FS_MAX_PATH];
+  FsDirEntryType type;
+  if (!Translate(path, &fs, fspath) || R_FAILED(fsFsGetEntryType(fs, fspath, &type)))
+    return false;
+  std::memset(st, 0, sizeof(*st));
+  st->st_nlink = 1;
+  if (type != FsDirEntryType_File)
+  {
+    st->st_mode = S_IFDIR | 0755;
+    return true;
+  }
+  st->st_mode = S_IFREG | 0644;
+  const int fd = FindOpenFd(PathHash(fs, fspath));
+  struct stat fst;
+  const int saved = r->_errno;
+  if (fd >= 0 && _fstat_r(r, fd, &fst) == 0 && S_ISREG(fst.st_mode))
+  {
+    *st = fst;
+    st->st_mode |= 0644;
+    if (st->st_nlink == 0)
+      st->st_nlink = 1;
+  }
+  r->_errno = saved;
+  return true;
+}
+} // namespace
+
+extern "C" int Switch2PathIsOpen(const char* path)
+{
+  FsFileSystem* fs;
+  char fspath[FS_MAX_PATH];
+  return Translate(path, &fs, fspath) && FindOpenFd(PathHash(fs, fspath)) >= 0;
+}
+
+extern "C" int __wrap__open_r(struct _reent* r, const char* path, int flags, int mode)
+{
+  const int fd = __real__open_r(r, path, flags, mode);
+  if (fd >= 0 && fd < kMaxTrackedFd)
+  {
+    FsFileSystem* fs;
+    char fspath[FS_MAX_PATH];
+    if (Translate(path, &fs, fspath))
+    {
+      g_fds[fd].hash.store(PathHash(fs, fspath), std::memory_order_relaxed);
+      g_fds[fd].flags.store(kTracked | ((flags & O_ACCMODE) != O_WRONLY ? kReadable : 0),
+                            std::memory_order_release);
+    }
+    else
+      g_fds[fd].flags.store(0, std::memory_order_release);
+  }
+  return fd;
+}
+
+extern "C" int __wrap__close_r(struct _reent* r, int fd)
+{
+  if (fd >= 0 && fd < kMaxTrackedFd)
+    g_fds[fd].flags.store(0, std::memory_order_release);
+  return __real__close_r(r, fd);
+}
+
+// read(): for a readable fsdev file, take the position and size first: at/after EOF return 0 without
+// calling fsdev (whose EOF read fails with EIO, and whose bounce-buffer path would loop), otherwise
+// clamp the count to the bytes that exist. Sockets, romfs and other devices pass straight through.
+extern "C" _ssize_t __wrap__read_r(struct _reent* r, int fd, void* buf, size_t count)
+{
+  if (count != 0 && fd >= 0 && fd < kMaxTrackedFd &&
+      (g_fds[fd].flags.load(std::memory_order_acquire) & kReadable))
+  {
+    const int saved = r->_errno;
+    const _off_t pos = _lseek_r(r, fd, 0, SEEK_CUR);
+    struct stat st;
+    if (pos >= 0 && _fstat_r(r, fd, &st) == 0 && S_ISREG(st.st_mode))
+    {
+      if (pos >= st.st_size)
+      {
+        r->_errno = saved;
+        return 0;
+      }
+      const uint64_t left = static_cast<uint64_t>(st.st_size - pos);
+      if (count > left)
+        count = static_cast<size_t>(left);
+    }
+    r->_errno = saved;
+  }
+  const _ssize_t n = __real__read_r(r, fd, buf, count);
+  if (n < 0 && r->_errno == EIO)
+  {
+    // Untracked fd, or the file shrank under us: keep the rev 5 rule (EIO at/after EOF -> 0).
+    const int saved = r->_errno;
+    const _off_t pos = _lseek_r(r, fd, 0, SEEK_CUR);
+    struct stat st;
+    if (pos >= 0 && _fstat_r(r, fd, &st) == 0 && S_ISREG(st.st_mode) && pos >= st.st_size)
+    {
+      r->_errno = saved;
+      return 0;
+    }
+    r->_errno = saved;
+  }
+  return n;
+}
+
+extern "C" int __wrap__stat_r(struct _reent* r, const char* path, struct stat* st)
+{
+  const int before = r->_errno;
+  const int rc = __real__stat_r(r, path, st);
+  if (rc == 0 || r->_errno != EIO)
+    return rc;
+  const int err = r->_errno;
+  const bool ok = StatFallback(r, path, st);
+#if SWITCH2_STATFAIL_LOG
+  StatFailLog("stat", path, err, ok);
+#endif
+  r->_errno = ok ? before : err;
+  return ok ? 0 : rc;
+}
+
+// lstat() is its own libsysbase entry (it calls the devoptab directly, not _stat_r).
+extern "C" int __wrap_lstat(const char* path, struct stat* st)
+{
+  const int before = errno;
+  const int rc = __real_lstat(path, st);
+  if (rc == 0 || errno != EIO)
+    return rc;
+  const int err = errno;
+  const bool ok = StatFallback(_REENT, path, st);
+#if SWITCH2_STATFAIL_LOG
+  StatFailLog("lstat", path, err, ok);
+#endif
+  errno = ok ? before : err;
+  return ok ? 0 : rc;
+}
+
+// clock_gettime() wrapper (-Wl,--wrap=clock_gettime, see Install.cmake). libounce's
+// __syscall_clock_gettime accepts only CLOCK_REALTIME (1) and CLOCK_MONOTONIC (4); every other id
+// returns EINVAL without touching the timespec, and callers that ignore the return value (Kodi's
+// CurrentHostCounter used CLOCK_MONOTONIC_RAW) then read stack garbage. Map the Linux aliases.
+#include <time.h>
+
+extern "C" int __real_clock_gettime(clockid_t id, struct timespec* ts);
+
+extern "C" int __wrap_clock_gettime(clockid_t id, struct timespec* ts)
+{
+  switch (id)
+  {
+    case CLOCK_REALTIME_COARSE:
+#ifdef CLOCK_REALTIME_ALARM
+    case CLOCK_REALTIME_ALARM:
+#endif
+      id = CLOCK_REALTIME;
+      break;
+    case CLOCK_MONOTONIC_RAW:
+    case CLOCK_MONOTONIC_COARSE:
+    case CLOCK_BOOTTIME:
+#ifdef CLOCK_BOOTTIME_ALARM
+    case CLOCK_BOOTTIME_ALARM:
+#endif
+      id = CLOCK_MONOTONIC;
+      break;
+    default:
+      break;
+  }
+  return __real_clock_gettime(id, ts);
+}
+
+// Implementations behind the Switch 2 compat headers (compat/sys/sysinfo.h, compat/sys/utsname.h).
+
+#include <cstring>
+
+#include <sys/sysinfo.h>
+#include <sys/utsname.h>
+#include <time.h>
+
+#include <switch.h>
+
+extern "C" int sysinfo(struct sysinfo* info)
+{
+  if (!info)
+    return -1;
+  std::memset(info, 0, sizeof(*info));
+  u64 total = 0, used = 0;
+  svcGetInfo(&total, InfoType_TotalMemorySize, CUR_PROCESS_HANDLE, 0);
+  svcGetInfo(&used, InfoType_UsedMemorySize, CUR_PROCESS_HANDLE, 0);
+  info->totalram = total;
+  info->freeram = total > used ? total - used : 0;
+  info->uptime = static_cast<long>(armTicksToNs(armGetSystemTick()) / 1000000000ULL);
+  info->procs = 1;
+  info->mem_unit = 1;
+  return 0;
+}
+
+extern "C" int get_nprocs(void)
+{
+  return 3; // cores available to an application on the console
+}
+
+extern "C" int get_nprocs_conf(void)
+{
+  return 8;
+}
+
+extern "C" int uname(struct utsname* name)
+{
+  if (!name)
+    return -1;
+  std::memset(name, 0, sizeof(*name));
+  std::strncpy(name->sysname, "Horizon", sizeof(name->sysname) - 1);
+  std::strncpy(name->nodename, "switch2", sizeof(name->nodename) - 1);
+  std::strncpy(name->release, "kaiHEN", sizeof(name->release) - 1);
+  std::strncpy(name->version, "libounce", sizeof(name->version) - 1);
+  std::strncpy(name->machine, "aarch64", sizeof(name->machine) - 1);
+  return 0;
+}
+
+// Days from 1970-01-01 to y-m-d in the proleptic Gregorian calendar (Howard Hinnant's algorithm).
+static long long DaysFromCivil(long long y, unsigned m, unsigned d)
+{
+  y -= m <= 2;
+  const long long era = (y >= 0 ? y : y - 399) / 400;
+  const unsigned yoe = static_cast<unsigned>(y - era * 400);
+  const unsigned doy = (153 * (m + (m > 2 ? -3 : 9)) + 2) / 5 + d - 1;
+  const unsigned doe = yoe * 365 + yoe / 4 - yoe / 100 + doy;
+  return era * 146097 + static_cast<long long>(doe) - 719468;
+}
+
+extern "C" time_t timegm(struct tm* tm)
+{
+  if (!tm)
+    return static_cast<time_t>(-1);
+  // Normalise month overflow like mktime does.
+  long long year = 1900LL + tm->tm_year + tm->tm_mon / 12;
+  int mon = tm->tm_mon % 12;
+  if (mon < 0)
+  {
+    mon += 12;
+    year -= 1;
+  }
+  const long long days = DaysFromCivil(year, static_cast<unsigned>(mon + 1), 1) + (tm->tm_mday - 1);
+  const long long secs = days * 86400LL + tm->tm_hour * 3600LL + tm->tm_min * 60LL + tm->tm_sec;
+  const time_t t = static_cast<time_t>(secs);
+  struct tm norm;
+  if (gmtime_r(&t, &norm))
+    *tm = norm;
+  return t;
+}
+
+// Process APIs newlib declares but the console cannot provide: Kodi only calls them for
+// external players and resource accounting, so they fail with ENOSYS.
+#include <cerrno>
+#include <sys/resource.h>
+#include <sys/wait.h>
+#include <unistd.h>
+
+extern "C" int getrusage(int, struct rusage* usage)
+{
+  if (usage)
+    std::memset(usage, 0, sizeof(*usage));
+  return 0;
+}
+
+extern "C" pid_t waitpid(pid_t, int*, int)
+{
+  errno = ECHILD;
+  return -1;
+}
+
+extern "C" int execvp(const char*, char* const[])
+{
+  errno = ENOSYS;
+  return -1;
+}
+
+// No child processes on the console: Kodi's few popen() users (temperature commands,
+// external tools) take their failure path.
+#include <cstdio>
+
+extern "C" FILE* popen(const char*, const char*)
+{
+  errno = ENOSYS;
+  return nullptr;
+}
+
+extern "C" int pclose(FILE*)
+{
+  errno = ECHILD;
+  return -1;
+}
