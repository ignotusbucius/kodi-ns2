+namespace
+{
+// Calls fn on the top of stack[]; returns with the original sp. fn follows the AAPCS64.
+void RunOnStack(void (*fn)(), u8* top)
+{
+  asm volatile("mov x19, sp\n\t"
+               "mov sp, %0\n\t"
+               "blr %1\n\t"
+               "mov sp, x19\n\t"
+               :
+               : "r"(top), "r"(fn)
+               : "x0", "x1", "x2", "x3", "x4", "x5", "x6", "x7", "x8", "x9", "x10", "x11", "x12",
+                 "x13", "x14", "x15", "x16", "x17", "x18", "x19", "x30", "v0", "v1", "v2", "v3",
+                 "v4", "v5", "v6", "v7", "v16", "v17", "v18", "v19", "v20", "v21", "v22", "v23",
+                 "v24", "v25", "v26", "v27", "v28", "v29", "v30", "v31", "cc", "memory");
+}
+
+void LogNativeException()
+{
+  const ThreadExceptionDump* ctx = &g_dump;
+  ResolveModule();
+  Out o(g_nativeBuf);
+  o.Header("native exception");
+  o.Put("error_desc=");
+  o.Hex(ctx->error_desc);
+  o.Put(" ");
+  o.Put(DescName(ctx->error_desc));
+  o.Kv("esr", ctx->esr);
+  o.Kv("far", ctx->far.x);
+  o.Kv("pstate", ctx->pstate);
+  o.Kv("afsr0", ctx->afsr0);
+  o.Kv("afsr1", ctx->afsr1);
+  o.Put("\n");
+  o.Addr("pc", ctx->pc.x);
+  o.Addr("lr", ctx->lr.x);
+  o.Kv("sp", ctx->sp.x);
+  o.Kv("fp", ctx->fp.x);
+  o.Put("\n");
+  for (int i = 0; i < 29; ++i)
+  {
+    o.Put(" x");
+    o.Dec(i);
+    o.Put("=");
+    o.Hex(ctx->cpu_gprs[i].x);
+    if (i % 4 == 3)
+      o.Put("\n");
+  }
+  o.Put("\n");
+  Flush(o); // registers are on the SD before the walk touches any memory
+  o.Backtrace(ctx->fp.x);
+  o.StackScan(ctx->sp.x);
+  o.Put("=== end\n");
+  Flush(o);
+}
+} // namespace
+
+extern "C" void __libnx_exception_handler(ThreadExceptionDump* ctx)
+{
+  u64 tid = 0;
+  svcGetThreadId(&tid, CUR_THREAD_HANDLE);
+  if (!tid)
+    tid = ~0ULL;
+  u64 expected = 0;
+  if (!g_exceptionTid.compare_exchange_strong(expected, tid))
+  {
+    // A fault inside this handler on the same thread: give up (return -> svcBreak).
+    if (expected == tid)
+      return;
+    // Another thread faulted while the first is being logged: park it; the first thread's
+    // svcBreak ends the process.
+    for (;;)
+      svcSleepThread(INT64_MAX);
+  }
+  if (!ctx)
+    return;
+  std::memcpy(&g_dump, ctx, sizeof(g_dump));
+  RunOnStack(LogNativeException, g_walkStack + sizeof(g_walkStack));
+  // Returning makes libounce's __libnx_exception_returnentry call svcBreak: the process ends as before.
+}
+
+extern "C" unsigned long long Switch2TextBase(void)
+{
+  ResolveModule();
+  return g_textBase;
+}
+
+// ----------------------------------------------------------------------------------------------
+// CPU-exception entry (see the header comment). The kernel enters here on the faulting thread with
+// x0 = exception type (error_desc), x1 = its ThreadExceptionFrameA64 (x0-x8, lr, sp, elr, pstate,
+// afsr0/1, esr, far), x9-x29 still holding the faulting thread's values, x2-x8 free.
+// ----------------------------------------------------------------------------------------------
+extern "C"
+{
+alignas(16) u8 g_excStack[0x8000];
+u64 g_excRegs[24]; // [0..21] = x9..x30 at entry, [22] = entry sp
+u32 g_excLock = 0; // first thread in owns the handler
+u64 g_excOwner = 0; // its tpidrro_el0
+void Switch2ExceptionEntryC(u64 type, u64 info) __attribute__((noreturn, used));
+}
+
+// Another thread faulting meanwhile is parked; a fault inside the handler (same thread) exits.
+asm(R"ASM(
+  .pushsection .text.__libnx_exception_entry,"ax",%progbits
+  .global __libnx_exception_entry
+  .type __libnx_exception_entry, %function
+  .p2align 2
+__libnx_exception_entry:
+  adrp  x2, g_excLock
+  add   x2, x2, :lo12:g_excLock
+1:
+  ldaxr w3, [x2]
+  cbnz  w3, 2f
+  mov   w3, #1
+  stlxr w4, w3, [x2]
+  cbnz  w4, 1b
+  b     4f
+2:
+  clrex
+  mrs   x3, tpidrro_el0
+  adrp  x4, g_excOwner
+  ldr   x4, [x4, :lo12:g_excOwner]
+  cmp   x3, x4
+  b.eq  3f
+5:
+  mov   x0, #-1
+  lsr   x0, x0, #1
+  svc   #0xb
+  b     5b
+3:
+  svc   #0x7
+  b     3b
+4:
+  mrs   x3, tpidrro_el0
+  adrp  x4, g_excOwner
+  str   x3, [x4, :lo12:g_excOwner]
+  adrp  x2, g_excRegs
+  add   x2, x2, :lo12:g_excRegs
+  stp   x9, x10, [x2, #0]
+  stp   x11, x12, [x2, #16]
+  stp   x13, x14, [x2, #32]
+  stp   x15, x16, [x2, #48]
+  stp   x17, x18, [x2, #64]
+  stp   x19, x20, [x2, #80]
+  stp   x21, x22, [x2, #96]
+  stp   x23, x24, [x2, #112]
+  stp   x25, x26, [x2, #128]
+  stp   x27, x28, [x2, #144]
+  stp   x29, x30, [x2, #160]
+  mov   x3, sp
+  str   x3, [x2, #176]
+  adrp  x3, g_excStack
+  add   x3, x3, :lo12:g_excStack
+  add   x3, x3, #8, lsl #12
+  mov   sp, x3
+  mov   x29, #0
+  bl    Switch2ExceptionEntryC
+6:
+  b     6b
+  .size __libnx_exception_entry, .-__libnx_exception_entry
+  .popsection
+)ASM");
+
+namespace
+{
+// One write on the pre-opened crash.txt handle, no lock (the first thing the entry does).
+void ExcWrite(const char* buf, size_t len)
+{
+  if (!g_crashOpen.load() || !len)
+    return;
+  const s64 off = g_crashOff.fetch_add(static_cast<s64>(len));
+  fsFileWrite(&g_crashFile, off, buf, len, FsWriteOption_Flush);
+}
+} // namespace
+
+extern "C" void Switch2ExceptionEntryC(u64 type, u64 info)
+{
+  // 1. Marker + raw frame, one write.
+  {
+    Out o(g_excBuf);
+    o.Dec(static_cast<long long>(armTicksToNs(armGetSystemTick()) / 1000000ULL));
+    o.Put(" EXC-ENTRY");
+    o.Kv("type", type);
+    o.Kv("info", info);
+    o.Kv("entry_sp", g_excRegs[22]);
+    u64 tid = 0;
+    svcGetThreadId(&tid, CUR_THREAD_HANDLE);
+    o.Put(" tid=");
+    o.Dec(static_cast<long long>(tid));
+    o.Put("\n");
+    u64 len = 0x100;
+    if (!Readable(info, len))
+      len = Readable(info, sizeof(ThreadExceptionFrameA64)) ? sizeof(ThreadExceptionFrameA64) : 0;
+    for (u64 off = 0; off < len; off += 16)
+    {
+      o.Put(" +");
+      o.Hex(off);
+      o.Put(":");
+      o.Kv("", *reinterpret_cast<const u64*>(info + off));
+      o.Kv("", *reinterpret_cast<const u64*>(info + off + 8));
+      o.Put("\n");
+    }
+    ExcWrite(o.buf, o.n);
+  }
+  // 2. ThreadExceptionDump from the A64 frame and the saved registers, then the usual dump.
+  std::memset(&g_dump, 0, sizeof(g_dump));
+  g_dump.error_desc = static_cast<u32>(type);
+  if (Readable(info, sizeof(ThreadExceptionFrameA64)))
+  {
+    const auto* f = reinterpret_cast<const ThreadExceptionFrameA64*>(info);
+    for (int i = 0; i < 9; ++i)
+      g_dump.cpu_gprs[i].x = f->cpu_gprs[i];
+    g_dump.lr.x = f->lr;
+    g_dump.sp.x = f->sp;
+    g_dump.pc.x = f->elr_el1;
+    g_dump.pstate = f->pstate;
+    g_dump.afsr0 = f->afsr0;
+    g_dump.afsr1 = f->afsr1;
+    g_dump.esr = f->esr;
+    g_dump.far.x = f->far;
+  }
+  for (int i = 9; i < 29; ++i)
+    g_dump.cpu_gprs[i].x = g_excRegs[i - 9];
+  g_dump.fp.x = g_excRegs[20];
+  g_exceptionTid.store(1);
+  LogNativeException();
+  {
+    Out o(g_excBuf);
+    o.Put("EXC-END: svcBreak\n");
+    ExcWrite(o.buf, o.n);
+  }
+  // 3. End the process: system error panel as before; svcExitProcess if the break returns.
+  __real_svcBreak(0, 0, 0);
+  svcExitProcess();
+  for (;;)
+    svcSleepThread(INT64_MAX);
+}
+
