diff --git a/xbmc/platform/switch2/CrashHandler.cpp b/xbmc/platform/switch2/CrashHandler.cpp
new file mode 100644
index 0000000..099fda1
--- /dev/null
+++ b/xbmc/platform/switch2/CrashHandler.cpp
@@ -0,0 +1,982 @@
+/*
+ *  Copyright (C) 2026 Team Kodi
+ *  This file is part of Kodi - https://kodi.tv
+ *
+ *  SPDX-License-Identifier: GPL-2.0-or-later
+ *  See LICENSES/README.md for more information.
+ */
+
+// Crash diagnostics for the Switch 2 NRO. Everything goes to sdmc:/switch/kodi/crash.txt through
+// raw fs IPC (Switch2RawAppend): no stdio, no malloc, no newlib or Kodi locks, so it also works on a
+// thread that faulted while holding one of them.
+//  * Native CPU exceptions: libounce's crt0 (libnx-style) calls __libnx_exception_handler on
+//    __nx_exception_stack when the loader forwards the exception to this NRO. Logged: error_desc,
+//    pc/lr/sp/fp/far/esr, x0-x28, the module base (subtract it to symbolise against build/kodi.bin,
+//    whose image starts at 0), a frame-pointer backtrace and the code addresses found on the stack.
+//  * C++: std::terminate (uncaught exception, noexcept violation, pure virtual call) and abort():
+//    exception type, what(), backtrace.
+//  * Process-ending paths that never raise a CPU exception (rev 16): svcBreak (libounce's mutexLock /
+//    mutexUnlock on a failed svcArbitrate*, diagAbortWithResult, the exception return path),
+//    diagAbortWithResult, newlib __assert_func and CPython's _Py_FatalErrorFunc/_Py_FatalErrorFormat
+//    (all -Wl,--wrap, Install.cmake): one "FATAL ..." line to boot.txt and crash.txt plus a backtrace
+//    in crash.txt, then the real function.
+// crash.txt is opened once at start-up and kept open, so a crash write is one IFile::Write on that
+// handle (no create/open/size/close by path in the handler), sent on a session kept for it (rev 38:
+// no libounce fs session-manager lock); boot.txt is appended by path.
+//  * rev 18: our own STRONG __libnx_exception_entry (the CPU-exception entry _start branches to). The
+//    weak libounce one aborted (0xf801) whenever svcGetInfo(DebuggerAttached) returned non-zero and
+//    never reached __libnx_exception_handler under hbloader (finding 1509). Ours saves x9-x30 and the
+//    entry sp, moves to its own stack, writes "EXC-ENTRY" plus a hex dump of the kernel's exception
+//    frame to crash.txt with one fsFileWrite (no lock), logs the full dump (LogNativeException) and
+//    ends the process with svcBreak (system error panel, as before). No svcReturnFromException.
+
+#include "PosixCompat.h"
+
+#include <atomic>
+#include <cstdint>
+#include <cstdlib>
+#include <cstring>
+#include <cstdarg>
+#include <cstdio>
+#include <cxxabi.h>
+#include <exception>
+#include <typeinfo>
+
+#include <switch.h>
+
+extern "C"
+{
+// Our handler runs on this stack (libounce's weak default is 1 KiB).
+alignas(16) u8 __nx_exception_stack[0x8000];
+u64 __nx_exception_stack_size = sizeof(__nx_exception_stack);
+// Handle the exception ourselves even when a debugger is attached (kaiHEN session).
+u32 __nx_exception_ignoredebug = 1;
+
+void __libnx_exception_handler(ThreadExceptionDump* ctx);
+void __real_abort(void) __attribute__((noreturn));
+void __wrap_abort(void) __attribute__((noreturn));
+Result __real_svcBreak(u32 breakReason, uintptr_t inval1, uintptr_t inval2);
+Result __wrap_svcBreak(u32 breakReason, uintptr_t inval1, uintptr_t inval2);
+void __real_diagAbortWithResult(Result res) __attribute__((noreturn));
+void __wrap_diagAbortWithResult(Result res) __attribute__((noreturn));
+void __real___assert_func(const char* file, int line, const char* func, const char* expr)
+    __attribute__((noreturn));
+void __wrap___assert_func(const char* file, int line, const char* func, const char* expr)
+    __attribute__((noreturn));
+// CPython 3.11 (Python/pylifecycle.c); both end in abort().
+void __real__Py_FatalErrorFunc(const char* func, const char* msg) __attribute__((noreturn));
+void __wrap__Py_FatalErrorFunc(const char* func, const char* msg) __attribute__((noreturn));
+void __wrap__Py_FatalErrorFormat(const char* func, const char* format, ...)
+    __attribute__((noreturn));
+}
+
+namespace
+{
+constexpr const char* CRASH = "/switch/kodi/crash.txt";
+constexpr const char* BOOT = "/switch/kodi/boot.txt";
+
+FsFileSystem* g_sdmc = nullptr;
+u64 g_textBase = 0;
+u64 g_textEnd = 0;
+std::atomic<int> g_busy{0}; // soft-crash (terminate/abort) buffer owner
+std::atomic<int> g_appendLock{0}; // one Switch2RawAppend at a time: the FS refuses a second open
+std::atomic<u64> g_exceptionTid{0}; // thread handling the native exception, 0 = none
+std::atomic<int> g_inTerminate{0};
+// Separate buffers: a native fault while a soft crash is being logged must not mix the two.
+char g_excBuf[4 * 1024];
+char g_softBuf[8 * 1024];
+char g_nativeBuf[12 * 1024];
+char g_fatalBuf[6 * 1024];
+char g_pyFatalMsg[1024];
+std::atomic<int> g_fatalDepth{0}; // >0 while a FATAL line is being written (recursion guard)
+// crash.txt, opened once by Switch2InstallCrashHandlers and never closed.
+FsFile g_crashFile;
+std::atomic<bool> g_crashOpen{false};
+// rev 38: crash.txt is written over a session of fsp-srv's domain that only this file uses. libounce's
+// fsFileWrite on an object of the shared root session first takes a slot from fs.o's session manager
+// (sessionmgrAttachClient: mutexLock + condvarWait, disassembly of libounce.a fs.o): a thread that
+// faulted holding that mutex, or the last free slot, deadlocked its own crash log (reviewer item).
+// INVALID_HANDLE = the object has its own session (no manager) or the clone failed: fsFileWrite.
+// Rev 38f: closed at exit (CloseCrashSession). The NRO runs inside the loader's process, which lives on
+// after Kodi returns to hbmenu: an open clone kept fsp-srv's domain, and with it crash.txt open for
+// writing, alive, so the next launch's pre-open failed (rev 38ed launch 2, boot.txt "crash-txt-preopen-
+// failed") and that launch's FATAL record could not reach crash.txt at all (finding 1573).
+std::atomic<Handle> g_crashSession{INVALID_HANDLE};
+// Next free offset in crash.txt. Writers reserve their range with fetch_add before fsFileWrite, so
+// two threads (or the exception entry, which takes no lock) never write over each other.
+std::atomic<s64> g_crashOff{0};
+// The native handler copies the dump here at once and does its work on its own stack, so another
+// thread entering __libnx_exception_entry (which resets sp to the top of __nx_exception_stack and
+// rewrites __nx_exceptiondump) cannot corrupt it.
+ThreadExceptionDump g_dump;
+alignas(16) u8 g_walkStack[0x8000];
+
+void ResolveModule()
+{
+  if (g_textBase)
+    return;
+  MemoryInfo mi;
+  u32 pi;
+  if (R_SUCCEEDED(svcQueryMemory(&mi, &pi, reinterpret_cast<u64>(&ResolveModule))))
+  {
+    // NRO .text starts at the image base, so the RX region holding our code starts there.
+    g_textBase = mi.addr;
+    g_textEnd = mi.addr + mi.size;
+  }
+}
+
+bool Readable(u64 addr, u64 len)
+{
+  if (addr == 0 || len == 0 || addr + len < addr)
+    return false;
+  MemoryInfo mi;
+  u32 pi;
+  if (R_FAILED(svcQueryMemory(&mi, &pi, addr)))
+    return false;
+  if ((mi.type & 0xff) == MemType_Unmapped || !(mi.perm & Perm_R))
+    return false;
+  return addr + len <= mi.addr + mi.size;
+}
+
+bool InText(u64 a)
+{
+  return g_textBase && a >= g_textBase && a < g_textEnd;
+}
+
+struct Out
+{
+  char* buf;
+  size_t cap;
+  size_t n = 0;
+  template<size_t N>
+  explicit Out(char (&b)[N]) : buf(b), cap(N)
+  {
+  }
+  void Put(const char* s)
+  {
+    while (s && *s && n < cap - 1)
+      buf[n++] = *s++;
+  }
+  void Hex(u64 v)
+  {
+    char t[19];
+    t[0] = '0';
+    t[1] = 'x';
+    for (int i = 0; i < 16; ++i)
+      t[2 + i] = "0123456789abcdef"[(v >> ((15 - i) * 4)) & 0xf];
+    t[18] = '\0';
+    Put(t);
+  }
+  void Dec(long long v)
+  {
+    char t[24];
+    int i = 23;
+    t[i] = '\0';
+    const bool neg = v < 0;
+    unsigned long long u = neg ? 0ULL - static_cast<unsigned long long>(v) : v;
+    do
+    {
+      t[--i] = static_cast<char>('0' + u % 10);
+      u /= 10;
+    } while (u && i > 1);
+    if (neg)
+      t[--i] = '-';
+    Put(t + i);
+  }
+  void Kv(const char* k, u64 v)
+  {
+    Put(" ");
+    Put(k);
+    Put("=");
+    Hex(v);
+  }
+  void Addr(const char* k, u64 v)
+  {
+    Kv(k, v);
+    if (InText(v))
+    {
+      Put("(+");
+      Hex(v - g_textBase);
+      Put(")");
+    }
+  }
+  void Header(const char* what)
+  {
+    Put("=== ");
+    Put(what);
+    Put(" ms=");
+    Dec(static_cast<long long>(armTicksToNs(armGetSystemTick()) / 1000000ULL));
+    u64 tid = 0;
+    svcGetThreadId(&tid, CUR_THREAD_HANDLE);
+    Put(" tid=");
+    Dec(static_cast<long long>(tid));
+    Kv("base", g_textBase);
+    Kv("text_end", g_textEnd);
+    Put("\n");
+  }
+  void Backtrace(u64 fp)
+  {
+    Put("backtrace (fp chain, module offsets in parentheses):\n");
+    for (int i = 0; i < 48; ++i)
+    {
+      if ((fp & 7) != 0 || !Readable(fp, 16))
+        break;
+      const u64* frame = reinterpret_cast<const u64*>(fp);
+      const u64 next = frame[0];
+      const u64 lr = frame[1];
+      Put(" #");
+      Dec(i);
+      Addr("lr", lr);
+      Kv("fp", fp);
+      Put("\n");
+      if (next <= fp)
+        break;
+      fp = next;
+    }
+  }
+  void StackScan(u64 sp)
+  {
+    Put("code addresses on the stack (sp+off: value):\n");
+    int found = 0;
+    for (u64 off = 0; off < 0x2000 && found < 48; off += 8)
+    {
+      if (((sp + off) & 0xfff) == 0 || off == 0)
+        if (!Readable(sp + off, 8))
+          break;
+      const u64 v = *reinterpret_cast<const u64*>(sp + off);
+      if (!InText(v))
+        continue;
+      Put(" sp+");
+      Hex(off);
+      Addr(":", v);
+      Put("\n");
+      ++found;
+    }
+  }
+};
+
+bool LockAppend()
+{
+  // Serialise writers (a second open of a file open for writing fails on this FS). Bounded wait,
+  // then go ahead anyway: a thread that crashed inside here must not block the crash log forever.
+  for (int i = 0; i < 200; ++i)
+  {
+    int expected = 0;
+    if (g_appendLock.compare_exchange_strong(expected, 1))
+      return true;
+    svcSleepThread(1000000LL);
+  }
+  return false;
+}
+
+void UnlockAppend(bool locked)
+{
+  if (locked)
+    g_appendLock.store(0);
+}
+
+// fsFileWrite(&g_crashFile, off, buf, len, FsWriteOption_Flush) sent on g_crashSession: the same
+// IFile::Write (command 1, in = {option, pad, offset, size}, one in-buffer mapped by alias,
+// non-secure allowed) as libounce's fsFileWrite, without its session manager.
+Result CrashFileWrite(s64 off, const void* buf, u64 len)
+{
+  const Handle session = g_crashSession.load();
+  if (session == INVALID_HANDLE)
+    return fsFileWrite(&g_crashFile, off, buf, len, FsWriteOption_Flush);
+  const struct
+  {
+    u32 option;
+    u32 pad;
+    s64 offset;
+    u64 size;
+  } in = {FsWriteOption_Flush, 0, off, len};
+  SfDispatchParams disp;
+  std::memset(&disp, 0, sizeof(disp));
+  disp.target_session = session;
+  disp.buffer_attrs.attr0 =
+      SfBufferAttr_HipcMapAlias | SfBufferAttr_In | SfBufferAttr_HipcMapTransferAllowsNonSecure;
+  disp.buffers[0].ptr = buf;
+  disp.buffers[0].size = len;
+  return serviceDispatchImpl(&g_crashFile.s, 1, &in, sizeof(in), nullptr, 0, disp);
+}
+
+// One write on the pre-opened crash.txt handle; by path (Switch2RawAppend) if that open failed.
+void CrashWrite(const char* buf, size_t len)
+{
+  if (!len)
+    return;
+  if (!g_crashOpen.load())
+  {
+    Switch2RawAppend(CRASH, buf, len);
+    return;
+  }
+  const bool locked = LockAppend();
+  const s64 off = g_crashOff.fetch_add(static_cast<s64>(len));
+  CrashFileWrite(off, buf, len);
+  UnlockAppend(locked);
+}
+
+void Flush(Out& o)
+{
+  CrashWrite(o.buf, o.n);
+  o.n = 0;
+}
+
+const char* DescName(u32 d)
+{
+  switch (d)
+  {
+    case ThreadExceptionDesc_InstructionAbort:
+      return "InstructionAbort";
+    case ThreadExceptionDesc_MisalignedPC:
+      return "MisalignedPC";
+    case ThreadExceptionDesc_MisalignedSP:
+      return "MisalignedSP";
+    case ThreadExceptionDesc_SError:
+      return "SError";
+    case ThreadExceptionDesc_BadSVC:
+      return "BadSVC";
+    case ThreadExceptionDesc_Trap:
+      return "Trap";
+    case ThreadExceptionDesc_Other:
+      return "Other(DataAbort?)";
+    default:
+      return "?";
+  }
+}
+
+bool Acquire()
+{
+  int expected = 0;
+  return g_busy.compare_exchange_strong(expected, 1);
+}
+
+void Release()
+{
+  g_busy.store(0);
+}
+
+void LogSoftCrash(const char* what, const char* type, u64 fp)
+{
+  if (!Acquire())
+    return;
+  ResolveModule();
+  Out o(g_softBuf);
+  o.Header(what);
+  if (type)
+  {
+    o.Put("exception type: ");
+    o.Put(type);
+    o.Put("\n");
+  }
+  o.Backtrace(fp);
+  Flush(o);
+  Release();
+}
+
+[[noreturn]] void OnTerminate()
+{
+  g_inTerminate.store(1);
+  const std::type_info* t = abi::__cxa_current_exception_type();
+  LogSoftCrash("std::terminate", t ? t->name() : "(no active exception)",
+               reinterpret_cast<u64>(__builtin_frame_address(0)));
+  // Second line with what(): rethrowing allocates, so it comes after the flushed backtrace.
+  if (t)
+  {
+    try
+    {
+      std::rethrow_exception(std::current_exception());
+    }
+    catch (const std::exception& e)
+    {
+      if (Acquire())
+      {
+        Out o(g_softBuf);
+        o.Put("what(): ");
+        o.Put(e.what());
+        o.Put("\n");
+        Flush(o);
+        Release();
+      }
+    }
+    catch (...)
+    {
+    }
+  }
+  __real_abort();
+}
