diff --git a/cmake/scripts/switch2/ArchSetup.cmake b/cmake/scripts/switch2/ArchSetup.cmake
new file mode 100644
index 0000000..84037c1
--- /dev/null
+++ b/cmake/scripts/switch2/ArchSetup.cmake
@@ -0,0 +1,69 @@
+# Switch 2 (kaiHEN / libounce): static newlib + libounce, AArch64, GLES via OunceVK EGL.
+set(CORE_MAIN_SOURCE ${CMAKE_SOURCE_DIR}/xbmc/platform/switch2/main.cpp)
+
+list(APPEND ARCH_DEFINES -DTARGET_POSIX -DTARGET_SWITCH2 -D__SWITCH__ -D__SWITCH2__ -D_GNU_SOURCE)
+# Diagnostics build: OpenSSL trace wrappers + crumb sink, memory monitor, thread/TLS-key logging,
+# OpenSSL self-test (xbmc/platform/switch2). The release build keeps only the correctness wrappers,
+# the OpenSSL warm-up, the crash/FATAL handlers and a few boot.txt milestones.
+option(ENABLE_SWITCH2_DIAG "Switch 2 diagnostics instruments" OFF)
+if(ENABLE_SWITCH2_DIAG)
+  list(APPEND ARCH_DEFINES -DSWITCH2_DIAG=1)
+endif()
+set(SYSTEM_DEFINES -D__STDC_CONSTANT_MACROS -D_FILE_OFFSET_BITS=64)
+set(PLATFORM_DIR platform/switch2)
+set(PLATFORMDEFS_DIR platform/posix)
+set(ARCH aarch64)
+set(NEON True)
+set(ENABLE_STATIC_LIBS TRUE)
+set(USE_INTERNAL_LIBS ON)
+
+# No shared objects, no dlopen: binary add-ons and wrapped DLLs are not available.
+# Python add-ons: a static CPython 3.11 with every extension module built in (cmake/modules/FindPython.cmake,
+# homebrew/kodi/deps/build-deps.sh python3); its stdlib is packaged to special://xbmc/system/python.
+set(ENABLE_PYTHON ON CACHE BOOL "" FORCE)
+set(ENABLE_TESTING OFF CACHE BOOL "" FORCE)
+set(ENABLE_UPNP OFF CACHE BOOL "" FORCE)
+set(ENABLE_AIRTUNES OFF CACHE BOOL "" FORCE)
+set(ENABLE_OPTICAL OFF CACHE BOOL "" FORCE)
+set(ENABLE_DVDCSS OFF CACHE BOOL "" FORCE)
+set(ENABLE_EVENTCLIENTS OFF CACHE BOOL "" FORCE)
+set(ADDONS_CONFIGURE_AT_STARTUP OFF CACHE BOOL "" FORCE)
+
+
+
+# Compat headers for POSIX/Linux headers newlib lacks (sys/sysinfo.h, sys/utsname.h, sys/mman.h, mntent.h).
+# Only Kodi's own targets see them; bundled deps are built by their own projects.
+set(CMAKE_C_FLAGS "${CMAKE_C_FLAGS} -isystem ${CMAKE_SOURCE_DIR}/xbmc/platform/switch2/compat")
+set(CMAKE_CXX_FLAGS "${CMAKE_CXX_FLAGS} -isystem ${CMAKE_SOURCE_DIR}/xbmc/platform/switch2/compat")
+set(CMAKE_C_FLAGS "${CMAKE_C_FLAGS} -include ${CMAKE_SOURCE_DIR}/xbmc/platform/switch2/compat/switch2_posix.h")
+set(CMAKE_CXX_FLAGS "${CMAKE_CXX_FLAGS} -include ${CMAKE_SOURCE_DIR}/xbmc/platform/switch2/compat/switch2_posix.h")
+# Frame records in every Kodi function: the crash handler walks x29 (CrashHandler.cpp).
+set(CMAKE_C_FLAGS "${CMAKE_C_FLAGS} -fno-omit-frame-pointer")
+set(CMAKE_CXX_FLAGS "${CMAKE_CXX_FLAGS} -fno-omit-frame-pointer")
+# The internal crossguid is >= 0.2 (crossguid/guid.hpp).
+list(APPEND ARCH_DEFINES -DHAVE_NEW_CROSSGUID)
+# No libdl: dlopen & co. are stubs compiled into Kodi (xbmc/platform/switch2/DlStubs.cpp).
+set(CMAKE_DL_LIBS "")
+# Kodi's internal fmt/tinyxml2/crossguid are found as CMake config packages and are then not put on
+# the link line on this platform (Linux gets fmt through spdlog's target). Link them last, everywhere.
+set(CMAKE_CXX_STANDARD_LIBRARIES "${CMAKE_CXX_STANDARD_LIBRARIES} /k/prefix/lib/libspdlog.a /k/prefix/lib/libfmt.a /k/prefix/lib/libtinyxml2.a /k/prefix/lib/libcrossguid.a /k/prefix/lib/libuuid.a")
+# libdav1d (AV1 software decoding through FFmpeg's libdav1d wrapper, deps/build-deps.sh dav1d): FFmpeg's
+# libraries are found without their static Libs.private, so it goes last on the line as well.
+set(CMAKE_CXX_STANDARD_LIBRARIES "${CMAKE_CXX_STANDARD_LIBRARIES} /k/prefix/lib/libdav1d.a")
+# inputstream.adaptive, linked statically (homebrew/kodi/isa/INTEGRATE.md).
+option(ENABLE_STATIC_ISA "Link inputstream.adaptive into kodi.bin" ON)
+set(STATIC_ISA_LIBRARY /k/isa/out/lib/libkodiaddon_inputstream.adaptive.a CACHE FILEPATH "")
+if(ENABLE_STATIC_ISA)
+  if(NOT EXISTS ${STATIC_ISA_LIBRARY})
+    message(FATAL_ERROR "${STATIC_ISA_LIBRARY} missing: run homebrew/kodi/isa/build.sh all")
+  endif()
+  set(CMAKE_CXX_STANDARD_LIBRARIES "${CMAKE_CXX_STANDARD_LIBRARIES} ${STATIC_ISA_LIBRARY}")
+endif()
+# usbfs2: read-only USB mass storage (homebrew/usbfs2, the reviewed 4 KiB-transfer build), staged into
+# /k/prefix by homebrew/kodi/build.sh with its sha256 pinned; -lnx again after it for the libounce calls
+# only usbfs2 makes. build.sh's post-link guard (usbfs2-guard.py) checks what was linked.
+set(STATIC_USBFS2_LIBRARY /k/prefix/lib/libusbfs2.a CACHE FILEPATH "")
+if(NOT EXISTS ${STATIC_USBFS2_LIBRARY})
+  message(FATAL_ERROR "${STATIC_USBFS2_LIBRARY} missing: run homebrew/kodi/build.sh usbfs2")
+endif()
+set(CMAKE_CXX_STANDARD_LIBRARIES "${CMAKE_CXX_STANDARD_LIBRARIES} ${STATIC_USBFS2_LIBRARY} -lnx")
diff --git a/cmake/scripts/switch2/Install.cmake b/cmake/scripts/switch2/Install.cmake
new file mode 100644
index 0000000..e445a24
--- /dev/null
+++ b/cmake/scripts/switch2/Install.cmake
@@ -0,0 +1,87 @@
+# Switch 2 packaging: elf -> nro, plus the data tree copied to sdmc:/switch/kodi.
+set(APP_BINARY ${APP_NAME_LC}${APP_BINARY_SUFFIX})
+# Threads created without attributes get 1 MiB stacks (xbmc/platform/switch2/PosixCompat.cpp).
+# Only on the final link: bundled deps' configure checks must not see the wrap.
+target_link_options(${APP_NAME_LC} PRIVATE -Wl,--wrap=pthread_create)
+# libounce's __syscall_thread_create (newlib.o) turns every failure into ENOMEM; these pass-through
+# wrappers keep the failing step's Result for the first-failure log line (PosixCompat.cpp, rev 35).
+target_link_options(${APP_NAME_LC} PRIVATE -Wl,--wrap=threadCreate -Wl,--wrap=threadStart
+                                           -Wl,--wrap=svcSetThreadCoreMask)
+# gsvRegisterFrame: the hardware video decoder needs the frame mode that the root permitted to the
+# display's registration (OunceVK); libounce keeps it private (DVDVideoCodecSwitch2.cpp, rev 37).
+target_link_options(${APP_NAME_LC} PRIVATE -Wl,--wrap=gsvRegisterFrame)
+# getaddrinfo: a failed lookup is logged with the host name, once per host per minute (PosixCompat.cpp).
+target_link_options(${APP_NAME_LC} PRIVATE -Wl,--wrap=getaddrinfo)
+# pthread_detach is ENOSYS in libounce; the wrapper hands threads to a reaper (PosixCompat.cpp).
+# Rev 36: pthread_join/pthread_exit wrappers keep per-thread records, so a detached thread is reaped
+# once it has ended and ended-but-unjoined threads (each holding a kernel thread) are counted.
+target_link_options(${APP_NAME_LC} PRIVATE -Wl,--wrap=pthread_detach -Wl,--wrap=pthread_join
+                                           -Wl,--wrap=pthread_exit)
+# fsdev fixes at the newlib reentrant layer, so read()/stat()/access(), stdio (__sread) and sqlite all
+# go through them (PosixCompat.cpp): read() bounded by the file size (EOF read is EIO on this FS),
+# stat()/lstat() of a file open for writing answered without a second open, fd registry for both.
+target_link_options(${APP_NAME_LC} PRIVATE -Wl,--wrap=_read_r -Wl,--wrap=_stat_r -Wl,--wrap=lstat
+                                           -Wl,--wrap=_open_r -Wl,--wrap=_close_r)
+# clock_gettime: libounce supports only REALTIME/MONOTONIC; the wrapper maps the Linux aliases
+# (CLOCK_MONOTONIC_RAW etc.) instead of failing with an untouched timespec (PosixCompat.cpp).
+target_link_options(${APP_NAME_LC} PRIVATE -Wl,--wrap=clock_gettime)
+# abort() logs a backtrace to sdmc:/switch/kodi/crash.txt first (CrashHandler.cpp).
+target_link_options(${APP_NAME_LC} PRIVATE -Wl,--wrap=abort)
+# fcntl: libounce's is socket-only (F_GETFL/F_SETFL) and returns 95 for every other command; the wrapper
+# answers file fds and the other commands itself (PosixCompat.cpp).
+target_link_options(${APP_NAME_LC} PRIVATE -Wl,--wrap=fcntl)
+# Process-ending paths that raise no CPU exception: one FATAL line to boot.txt/crash.txt, then the real
+# function (CrashHandler.cpp).
+target_link_options(${APP_NAME_LC} PRIVATE -Wl,--wrap=svcBreak -Wl,--wrap=diagAbortWithResult
+                                           -Wl,--wrap=__assert_func -Wl,--wrap=_Py_FatalErrorFunc
+                                           -Wl,--wrap=_Py_FatalErrorFormat)
+# Link map: build.sh's usbfs2 guard reads where every libusbfs2.a input section was placed.
+target_link_options(${APP_NAME_LC} PRIVATE -Wl,-Map=${CMAKE_BINARY_DIR}/kodi.map)
+include(${CMAKE_SOURCE_DIR}/cmake/scripts/switch2/Package.cmake OPTIONAL)
+if(ENABLE_SWITCH2_DIAG)
+  # OpenSSL breadcrumbs, active only with sdmc:/switch/kodi/trace-ossl.flag (OsslTrace.cpp, same list).
+  set(SWITCH2_OSSL_TRACE_WRAPS
+      -Wl,--wrap=EVP_MD_fetch -Wl,--wrap=EVP_MD_CTX_new -Wl,--wrap=EVP_DigestInit_ex
+      -Wl,--wrap=EVP_DigestInit_ex2 -Wl,--wrap=EVP_MD_up_ref -Wl,--wrap=EVP_MD_free
+      -Wl,--wrap=evp_generic_fetch -Wl,--wrap=evp_md_new -Wl,--wrap=ossl_method_store_new
+      -Wl,--wrap=ossl_method_store_fetch -Wl,--wrap=ossl_method_store_add
+      -Wl,--wrap=ossl_method_store_cache_get -Wl,--wrap=ossl_method_store_cache_set
+      -Wl,--wrap=ossl_method_lock_store -Wl,--wrap=ossl_method_unlock_store
+      -Wl,--wrap=ossl_method_construct
+      -Wl,--wrap=ossl_parse_property -Wl,--wrap=ossl_parse_query -Wl,--wrap=ossl_property_merge
+      -Wl,--wrap=ossl_property_name -Wl,--wrap=ossl_property_value
+      -Wl,--wrap=ossl_property_match_count -Wl,--wrap=ossl_property_free
+      -Wl,--wrap=ossl_property_is_enabled -Wl,--wrap=ossl_ctx_global_properties
+      -Wl,--wrap=ossl_provider_ctx -Wl,--wrap=ossl_provider_libctx -Wl,--wrap=ossl_provider_up_ref
+      -Wl,--wrap=ossl_provider_test_operation_bit -Wl,--wrap=ossl_provider_set_operation_bit
+      -Wl,--wrap=ossl_provider_query_operation -Wl,--wrap=ossl_provider_unquery_operation
+      -Wl,--wrap=ossl_provider_doall_activated -Wl,--wrap=ossl_namemap_stored
+      -Wl,--wrap=ossl_namemap_name2num -Wl,--wrap=ossl_namemap_name2num_n
+      -Wl,--wrap=ossl_namemap_add_name -Wl,--wrap=ossl_namemap_add_names
+      -Wl,--wrap=ossl_namemap_num2name -Wl,--wrap=ossl_lib_ctx_get_data -Wl,--wrap=OPENSSL_LH_new
+      -Wl,--wrap=OPENSSL_LH_insert -Wl,--wrap=OPENSSL_LH_retrieve -Wl,--wrap=ERR_set_mark
+      -Wl,--wrap=ERR_pop_to_mark -Wl,--wrap=ERR_clear_last_mark -Wl,--wrap=ERR_new
+      -Wl,--wrap=ERR_set_debug -Wl,--wrap=ERR_clear_error -Wl,--wrap=ossl_err_get_state_int
+      -Wl,--wrap=ossl_init_thread_start -Wl,--wrap=CRYPTO_THREAD_run_once
+      -Wl,--wrap=CRYPTO_THREAD_init_local -Wl,--wrap=CRYPTO_THREAD_set_local
+      -Wl,--wrap=CRYPTO_THREAD_get_local -Wl,--wrap=CRYPTO_THREAD_lock_new
+      -Wl,--wrap=CRYPTO_THREAD_read_lock -Wl,--wrap=CRYPTO_THREAD_write_lock
+      -Wl,--wrap=CRYPTO_THREAD_unlock -Wl,--wrap=CRYPTO_malloc -Wl,--wrap=CRYPTO_zalloc
+      -Wl,--wrap=CRYPTO_realloc -Wl,--wrap=CRYPTO_free)
+  target_link_options(${APP_NAME_LC} PRIVATE ${SWITCH2_OSSL_TRACE_WRAPS})
+  # TLS keys: every pthread_key_create/delete and failing pthread_setspecific logged (PosixCompat.cpp).
+  target_link_options(${APP_NAME_LC} PRIVATE -Wl,--wrap=pthread_key_create -Wl,--wrap=pthread_key_delete
+                                             -Wl,--wrap=pthread_setspecific)
+endif()
+# libounce's SHA-256 uses the SHA2 instructions unconditionally: curl's Curl_libnx_sha256sum goes to
+# OpenSSL's SHA256() instead (PosixCompat.cpp).
+target_link_options(${APP_NAME_LC} PRIVATE -Wl,--wrap=sha256CalculateHash)
+# socketpair: libounce's is an ENOSYS stub; emulated over loopback TCP/UDP for libmicrohttpd's
+# wake-up channel, CPython's socket.socketpair and curl's multi wake-up (PosixCompat.cpp).
+target_link_options(${APP_NAME_LC} PRIVATE -Wl,--wrap=socketpair)
+# select: libounce's refuses nfds > 63 (EINVAL) although FD_SETSIZE is 64; rebuilt on poll() (rev 38,
+# PosixCompat.cpp / SelectPoll.h). Kodi's CurlFile no longer selects at all (curl_multi_wait).
+target_link_options(${APP_NAME_LC} PRIVATE -Wl,--wrap=select)
+# svcArbitrateLock: pass-through; a failure (mutexLock then svcBreaks) writes one crash.txt line with the
+# owner handle's state in the thread records first (rev 38f, CrashHandler.cpp).
+target_link_options(${APP_NAME_LC} PRIVATE -Wl,--wrap=svcArbitrateLock)
