+bool CPlatformSwitch2::InitStageOne()
+{
+  if (!CPlatformPosix::InitStageOne())
+    return false;
+
+  setenv("OS", "Switch2", true);
+
+  KODI::WINDOWING::SWITCH2::CWinSystemSwitch2GLESContext::Register();
+  CAESinkSwitch2::Register();
+  // Hardware video decoder, tried before FFmpeg (rev 37; falls back to FFmpeg on its own).
+  CDVDVideoCodecSwitch2::Register();
+  return true;
+}
+
+bool CPlatformSwitch2::InitStageTwo()
+{
+  if (!CPlatformPosix::InitStageTwo())
+    return false;
+  // kodi.log is open by now: "switch2: thread limit cur/limit: ..." from main's startup probe.
+  Switch2LogThreadLimit();
+  return true;
+}
+
+void CPlatformSwitch2::DeinitStageOne()
+{
+  CPlatformPosix::DeinitStageOne();
+}
