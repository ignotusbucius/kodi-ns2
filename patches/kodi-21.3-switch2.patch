+namespace
+{
+// "<ms> FATAL <fn> rc=.. lr=..(+offset) [a=.. b=..] [text]" to boot.txt and crash.txt, then a
+// backtrace (fp chain from `fp`) to crash.txt.
+void FatalLog(const char* fn, u64 rc, u64 lr, u64 fp, const char* text, bool args, u64 a, u64 b)
+{
+  if (g_fatalDepth.fetch_add(1) != 0)
+  {
+    g_fatalDepth.fetch_sub(1);
+    return;
+  }
+  ResolveModule();
+  Out o(g_fatalBuf);
+  o.Dec(static_cast<long long>(armTicksToNs(armGetSystemTick()) / 1000000ULL));
+  o.Put(" FATAL ");
+  o.Put(fn);
+  o.Kv("rc", rc);
+  o.Addr("lr", lr);
+  if (args)
+  {
+    o.Kv("a", a);
+    o.Kv("b", b);
+  }
+  u64 tid = 0;
+  svcGetThreadId(&tid, CUR_THREAD_HANDLE);
+  o.Put(" tid=");
+  o.Dec(static_cast<long long>(tid));
+  if (text)
+  {
+    o.Put(" ");
+    o.Put(text);
+  }
+  o.Put("\n");
+  Switch2RawAppend(BOOT, o.buf, o.n);
+  Flush(o);
+  o.Put("=== FATAL ");
+  o.Put(fn);
+  o.Kv("base", g_textBase);
+  o.Put("\n");
+  o.Backtrace(fp);
+  Flush(o);
+  g_fatalDepth.fetch_sub(1);
+}
+} // namespace
+
+// svcBreak: libounce's mutexLock/mutexUnlock call it when svcArbitrateLock/Unlock fails, and
+// diagAbortWithResult and the exception return path end in it. Notification-only breaks return.
+extern "C" Result __wrap_svcBreak(u32 breakReason, uintptr_t inval1, uintptr_t inval2)
+{
+  // rc= is the break reason; a/b the two arguments. diagAbortWithResult passes (&result, 4).
+  char text[40];
+  const char* t = nullptr;
+  if (inval2 == 4 && inval1 && Readable(inval1, 4))
+  {
+    std::snprintf(text, sizeof(text), "result=0x%x", *reinterpret_cast<const u32*>(inval1));
+    t = text;
+  }
+  FatalLog("svcBreak", breakReason, reinterpret_cast<u64>(__builtin_return_address(0)),
+           reinterpret_cast<u64>(__builtin_frame_address(0)), t, true, inval1, inval2);
+  return __real_svcBreak(breakReason, inval1, inval2);
+}
+
+extern "C" void __wrap_diagAbortWithResult(Result res)
+{
+  FatalLog("diagAbortWithResult", res, reinterpret_cast<u64>(__builtin_return_address(0)),
+           reinterpret_cast<u64>(__builtin_frame_address(0)), nullptr, false, 0, 0);
+  __real_diagAbortWithResult(res);
+}
+
+extern "C" void __wrap___assert_func(const char* file, int line, const char* func, const char* expr)
+{
+  char text[512];
+  std::snprintf(text, sizeof(text), "%s:%d %s: %s", file ? file : "?", line, func ? func : "?",
+                expr ? expr : "?");
+  FatalLog("__assert_func", static_cast<u64>(line), reinterpret_cast<u64>(__builtin_return_address(0)),
+           reinterpret_cast<u64>(__builtin_frame_address(0)), text, false, 0, 0);
+  __real___assert_func(file, line, func, expr);
+}
+
+extern "C" void __wrap__Py_FatalErrorFunc(const char* func, const char* msg)
+{
+  char text[600];
+  std::snprintf(text, sizeof(text), "Fatal Python error: %s: %s", func ? func : "?", msg ? msg : "?");
+  FatalLog("_Py_FatalErrorFunc", 0, reinterpret_cast<u64>(__builtin_return_address(0)),
+           reinterpret_cast<u64>(__builtin_frame_address(0)), text, false, 0, 0);
+  __real__Py_FatalErrorFunc(func, msg);
+}
+
+// Formats the message here and hands it to the real _Py_FatalErrorFunc, which prints the same
+// "Fatal Python error: <func>: <message>" text to stderr and aborts.
+extern "C" void __wrap__Py_FatalErrorFormat(const char* func, const char* format, ...)
+{
+  va_list ap;
+  va_start(ap, format);
+  std::vsnprintf(g_pyFatalMsg, sizeof(g_pyFatalMsg), format ? format : "?", ap);
+  va_end(ap);
+  char text[1100];
+  std::snprintf(text, sizeof(text), "Fatal Python error: %s: %s", func ? func : "?", g_pyFatalMsg);
+  FatalLog("_Py_FatalErrorFormat", 0, reinterpret_cast<u64>(__builtin_return_address(0)),
+           reinterpret_cast<u64>(__builtin_frame_address(0)), text, false, 0, 0);
+  __real__Py_FatalErrorFunc(func, g_pyFatalMsg);
+}
+
+extern "C" void __wrap_abort(void)
+{
+  if (!g_inTerminate.load())
+    LogSoftCrash("abort", nullptr, reinterpret_cast<u64>(__builtin_frame_address(0)));
+  __real_abort();
+}
