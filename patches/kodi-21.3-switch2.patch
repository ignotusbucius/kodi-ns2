diff --git a/xbmc/platform/switch2/ThreadRecords.inc b/xbmc/platform/switch2/ThreadRecords.inc
new file mode 100644
index 0000000..b3f24fb
--- /dev/null
+++ b/xbmc/platform/switch2/ThreadRecords.inc
@@ -0,0 +1,435 @@
+// Thread records: included once by PosixCompat.cpp and by homebrew/kodi/hosttools/tests/thread_records_test.cpp
+// (host pthreads). The includer provides, before this file:
+//   __real_pthread_create / __real_pthread_join / __real_pthread_exit,
+//   std::atomic<long> g_switch2ThreadsLive, g_switch2ThreadsZombie, g_switch2ThreadsReapQueued, g_threadsUntracked,
+//   void ThreadHandleBegin(int* slot), ThreadHandleEnded(int slot), ThreadHandleJoined(int slot)  (svcArbitrateLock
+//   diagnostic: kernel handle of each recorded thread), void DetachUnknownLeaked(long n), void ReaperStarted(int rc),
+//   void ReaperStopped(int rc).
+// With SWITCH2_DIAG: g_switch2PyThreadsLive and Switch2BootLog for the pythread lines.
+//
+// Rev 36: one record per thread created through the wrapper, from creation until the thread is joined (by its
+// owner through pthread_join, or by the reaper for a detached thread), in an intrusive list under g_thrMutex.
+// Why: libounce has no pthread_detach; rev <= 35 queued every detached thread and one reaper joined them in detach
+// order. CPython detaches every thread right after creating it, so the first long-lived Python thread sat at the
+// head of the queue and the reaper blocked in pthread_join on it: every later detached thread ended but was never
+// joined (libounce frees a thread's kernel object and stack only in pthread_join), until svcCreateThread returned
+// 0x10801 LimitReached (operator session 2026-11-25, "live=33 created=474"). A detached thread is handed to the
+// reaper only once it has ended, so the reaper's join returns at once.
+//
+// Rev 38f: a pthread_t value names a thread only until it is joined; libounce reuses the value (and the kernel
+// reuses the handle). rev 38b/38ed died in mutexLock (svcArbitrateLock failed: the lock word named an owner handle
+// that was no longer valid) when a thread ended (findings 1571, 1573). Three ways a value could be joined twice,
+// each closed here:
+//  (a) a record whose thread was joined outside the wrapper stays linked; a new thread with the same value then
+//      has two records, and a detach or join could act on the stale one. Linking a record, and every join, now
+//      drops any other record with the same value (RemoveStaleLocked).
+//  (b) pthread_detach of a thread without a record queued it for the reaper, which joined the value whenever it
+//      got to it (possibly after its owner had joined it, possibly a running thread: the reaper then blocked).
+//      Such a thread is now counted as leaked (its stack and handle stay; rare) and never joined.
+//  (c) a self-detach before the creator linked the record looked the value up first and could mark a stale
+//      record; the thread's own record (t_rec) is now used whenever a thread detaches itself.
+// Rev 38g: Kodi's exit does not end the process: the loader (hbmenu) lives on and the next Kodi is loaded at the
+// same address with fresh .bss. Rev <= 38f's reaper looped for ever in g_reapCv.wait, so launch 1's reaper still
+// waited on the address of launch 2's g_reapCv/g_thrMutex (reviewer: the likely cause of the launch-2-only
+// mutexLock break, findings 1571/1574). The reaper now stops: Switch2StopReaper (end of main, and atexit) sets
+// g_reaperStop, wakes it and joins it; it drains the ended threads already queued and returns.
+#include <condition_variable>
+#include <cstdlib>
+#include <mutex>
+#include <new>
+
+extern "C" int Switch2StopReaper(void);
+
+namespace
+{
+struct ThreadRec
+{
+  void* (*start)(void*);
+  void* arg;
+  bool python; // DIAG: log pythread-start/-exit lines
+  int hslot = -1; // ThreadHandleBegin slot, set by the thread itself before it can end
+  // Below: under g_thrMutex.
+  pthread_t self{};
+  bool linked = false;
+  bool detached = false; // pthread_detach called while it ran
+  bool ended = false; // start routine returned / pthread_exit
+  bool queued = false; // on the reap list
+  bool joining = false; // a join of it is in progress (owner or reaper): only that join drops it
+  ThreadRec* prev = nullptr;
+  ThreadRec* next = nullptr;
+  ThreadRec* reapNext = nullptr;
+};
+
+std::mutex g_thrMutex;
+std::condition_variable g_reapCv;
+ThreadRec* g_thrHead = nullptr; // all linked records
+ThreadRec* g_reapHead = nullptr; // ended + detached, FIFO
+ThreadRec* g_reapTail = nullptr;
+bool g_reaperRunning = false; // under g_reaperCtl
+bool g_reaperStarted = false; // under g_reaperCtl: started once per launch, never restarted after a stop
+bool g_reaperStop = false; // under g_thrMutex
+pthread_t g_reaperThread{};
+std::mutex g_reaperCtl;
+std::atomic<long> g_threadsDetachLeaked{0}; // detached without a record: never joined (rev 38f)
+thread_local ThreadRec* t_rec = nullptr;
+
+ThreadRec* FindLocked(pthread_t t)
+{
+  for (ThreadRec* r = g_thrHead; r; r = r->next)
+    if (pthread_equal(r->self, t))
+      return r;
+  return nullptr;
+}
+
+[[maybe_unused]] int CountRecordsLocked(pthread_t t) // host test
+{
+  int n = 0;
+  for (ThreadRec* r = g_thrHead; r; r = r->next)
+    n += pthread_equal(r->self, t) ? 1 : 0;
+  return n;
+}
+
+void UnlinkLocked(ThreadRec* r)
+{
+  if (!r->linked)
+    return;
+  if (r->prev)
+    r->prev->next = r->next;
+  else
+    g_thrHead = r->next;
+  if (r->next)
+    r->next->prev = r->prev;
+  r->prev = r->next = nullptr;
+  r->linked = false;
+}
+
+void UnqueueLocked(ThreadRec* r)
+{
+  if (!r->queued)
+    return;
+  ThreadRec* prev = nullptr;
+  for (ThreadRec* q = g_reapHead; q; prev = q, q = q->reapNext)
+    if (q == r)
+    {
+      (prev ? prev->reapNext : g_reapHead) = r->reapNext;
+      if (g_reapTail == r)
+        g_reapTail = prev;
+      g_switch2ThreadsReapQueued.fetch_sub(1, std::memory_order_relaxed);
+      break;
+    }
+  r->reapNext = nullptr;
+  r->queued = false;
+}
+
+// (a) Drops the linked records for `t` from `from` on (the list is newest first, so from = r->next means
+// "older than r"): their thread was joined (inside or outside the wrapper) and `t` now names another
+// thread or none. A record being joined right now belongs to that join and is skipped. Joins nothing.
+int RemoveStaleLocked(pthread_t t, ThreadRec* from)
+{
+  int removed = 0;
+  for (ThreadRec* r = from; r;)
+  {
+    ThreadRec* next = r->next;
+    if (!r->joining && pthread_equal(r->self, t))
+    {
+      UnlinkLocked(r);
+      UnqueueLocked(r);
+      if (r->ended)
+        g_switch2ThreadsZombie.fetch_sub(1, std::memory_order_relaxed);
+      ThreadHandleJoined(r->hslot);
+      std::free(r);
+      ++removed;
+    }
+    r = next;
+  }
+  return removed;
+}
+
+// Only a linked record (r->self is set once the creator has linked it): CountedCreate queues an
+// ended+detached record itself when it links it.
+bool QueueReapLocked(ThreadRec* r)
+{
+  if (r->queued || !r->linked)
+    return false;
+  r->queued = true;
+  r->reapNext = nullptr;
+  if (g_reapTail)
+    g_reapTail->reapNext = r;
+  else
+    g_reapHead = r;
+  g_reapTail = r;
+  g_switch2ThreadsReapQueued.fetch_add(1, std::memory_order_relaxed);
+  return true;
+}
+
+// The calling thread's start routine is done (returned or pthread_exit): off the live count, on the
+// zombie count until joined; a detached thread goes to the reaper now.
+void ThreadEnded(ThreadRec* r)
+{
+  g_switch2ThreadsLive.fetch_sub(1, std::memory_order_relaxed);
+  if (!r)
+    return;
+  bool wake = false;
+  {
+    std::lock_guard<std::mutex> lock(g_thrMutex);
+    if (r->ended)
+      return;
+    r->ended = true;
+    ThreadHandleEnded(r->hslot);
+    g_switch2ThreadsZombie.fetch_add(1, std::memory_order_relaxed);
+    if (r->detached)
+      wake = QueueReapLocked(r);
+  }
+  if (wake)
+    g_reapCv.notify_one();
+}
+
+// After a join of `t` (record `r`, marked joining before the join, may be null): on success the kernel
+// thread and stack are freed and `t` may already name a new thread (whose record is newer than r, so
+// before it in the list); drop r and any record for `t` older than r. On failure only clear the mark.
+void Joined(pthread_t t, ThreadRec* r, bool ok)
+{
+  if (!r)
+    return;
+  {
+    std::lock_guard<std::mutex> lock(g_thrMutex);
+    r->joining = false;
+    if (!ok)
+      return;
+    RemoveStaleLocked(t, r->next);
+    UnlinkLocked(r);
+    UnqueueLocked(r);
+    if (r->ended)
+      g_switch2ThreadsZombie.fetch_sub(1, std::memory_order_relaxed);
+    ThreadHandleJoined(r->hslot);
+  }
+  std::free(r);
+}
+
+void* ThreadTrampoline(void* p)
+{
+  ThreadRec* r = static_cast<ThreadRec*>(p);
+  t_rec = r;
+  ThreadHandleBegin(&r->hslot);
+#if SWITCH2_DIAG
+  u64 tid = 0;
+  if (r->python)
+  {
+    svcGetThreadId(&tid, CUR_THREAD_HANDLE);
+    const long live = g_switch2PyThreadsLive.fetch_add(1) + 1;
+    Switch2BootLog("pythread-start tid", static_cast<long long>(tid));
+    Switch2BootLog("pythread-live", live);
+  }
+  const bool python = r->python;
+#endif
+  void* rv = r->start(r->arg);
+#if SWITCH2_DIAG
+  if (python)
+  {
+    g_switch2PyThreadsLive.fetch_sub(1);
+    Switch2BootLog("pythread-exit tid", static_cast<long long>(tid));
+  }
+#endif
+  t_rec = nullptr;
+  ThreadEnded(r); // r may be freed by the reaper from here on
+  return rv;
+}
+
+// The real create with the live counter and the record. Without memory for the record (~90 bytes) the
+// thread is still created, counted as untracked for good (detaching it later leaks it: (b)).
+int CountedCreate(pthread_t* thread, const pthread_attr_t* attr, void* (*start)(void*), void* arg,
+                  bool python)
+{
+  void* mem = std::malloc(sizeof(ThreadRec));
+  if (!mem)
+  {
+    const int rc = __real_pthread_create(thread, attr, start, arg); // no record (as before rev 36)
+    if (rc == 0)
+      g_threadsUntracked.fetch_add(1, std::memory_order_relaxed);
+    return rc;
+  }
+  ThreadRec* r = new (mem) ThreadRec();
+  r->start = start;
+  r->arg = arg;
+  r->python = python;
+  g_switch2ThreadsLive.fetch_add(1, std::memory_order_relaxed);
+  // The new thread may run to its end (and detach itself) before the record is linked: ThreadEnded
+  // and a self-detach then only mark the record, and linking it below queues it for the reaper.
+  // Nobody else can detach or join the thread before this function has returned.
+  const int rc = __real_pthread_create(thread, attr, ThreadTrampoline, r);
+  if (rc != 0)
+  {
+    g_switch2ThreadsLive.fetch_sub(1, std::memory_order_relaxed);
+    std::free(mem);
+    return rc;
+  }
+  std::lock_guard<std::mutex> lock(g_thrMutex);
+  RemoveStaleLocked(*thread, g_thrHead); // (a): the value is new again; older records for it are stale
+  r->self = *thread;
+  r->linked = true;
+  r->prev = nullptr;
+  r->next = g_thrHead;
+  if (g_thrHead)
+    g_thrHead->prev = r;
+  g_thrHead = r;
+  if (r->ended && r->detached && QueueReapLocked(r))
+    g_reapCv.notify_one(); // under the lock: the reaper wakes once it is released
+  return 0;
+}
+} // namespace
+
+// pthread_join wrapper (-Wl,--wrap=pthread_join, Install.cmake): std::thread::join, CThread,
+// FFmpeg, Mesa, libmicrohttpd. Drops the thread's records once the join has freed the thread.
+extern "C" int __wrap_pthread_join(pthread_t thread, void** value)
+{
+  ThreadRec* r = nullptr;
+  {
+    std::lock_guard<std::mutex> lock(g_thrMutex);
+    r = FindLocked(thread); // newest first: the record linked for this value most recently
+    if (r && (r->joining || r->queued))
+      r = nullptr; // detached (reaper's) or joined twice: a caller bug; the record stays with its owner
+    if (r)
+      r->joining = true; // nobody else drops it while this join runs
+  }
+  const int rc = __real_pthread_join(thread, value);
+  Joined(thread, r, rc == 0);
+  return rc;
+}
+
+// pthread_exit wrapper (-Wl,--wrap=pthread_exit): a thread that ends this way never returns to
+// ThreadTrampoline (CPython's PyThread_exit_thread when the interpreter is finalising).
+extern "C" void __wrap_pthread_exit(void* value)
+{
+  ThreadRec* r = t_rec;
+  if (r)
+  {
+    t_rec = nullptr;
+#if SWITCH2_DIAG
+    if (r->python)
+      g_switch2PyThreadsLive.fetch_sub(1);
+#endif
+    ThreadEnded(r);
+  }
+  __real_pthread_exit(value);
+}
+
+// pthread_detach() wrapper (linked with -Wl,--wrap=pthread_detach, see Install.cmake).
+// libounce links no __syscall_thread_detach, so pthread_detach() always returns ENOSYS and
+// std::thread::detach() throws std::system_error; CThread's autodelete path detaches its own
+// thread inside a noexcept destructor -> std::terminate (rev 8, finding 1499). Here "detach" hands
+// the thread to a reaper that joins it once it has ended, which is what frees its kernel thread and
+// stack on this platform.
+namespace
+{
+void* Reaper(void*)
+{
+  for (;;)
+  {
+    ThreadRec* r = nullptr;
+    pthread_t self{};
+    {
+      std::unique_lock<std::mutex> lock(g_thrMutex);
+      g_reapCv.wait(lock, [] { return g_reapHead != nullptr || g_reaperStop; });
+      if (!g_reapHead)
+        return nullptr; // stopped and drained
+      r = g_reapHead;
+      g_reapHead = r->reapNext;
+      if (!g_reapHead)
+        g_reapTail = nullptr;
+      r->reapNext = nullptr;
+      r->queued = false;
+      r->joining = true;
+      g_switch2ThreadsReapQueued.fetch_sub(1, std::memory_order_relaxed);
+      self = r->self;
+    }
+    // r has ended: the join only waits for its last instructions (ThreadTrampoline's return).
+    Joined(self, r, __real_pthread_join(self, nullptr) == 0);
+  }
+}
+
+void StopReaperAtExit()
+{
+  Switch2StopReaper();
+}
+
+// Under g_reaperCtl.
+void StartReaper()
+{
+  pthread_attr_t attr;
+  pthread_attr_init(&attr);
+  pthread_attr_setstacksize(&attr, 64 * 1024);
+  const int rc = __real_pthread_create(&g_reaperThread, &attr, Reaper, nullptr);
+  pthread_attr_destroy(&attr);
+  g_reaperRunning = rc == 0;
+  if (rc == 0)
+  {
+    g_threadsUntracked.fetch_add(1, std::memory_order_relaxed);
+    static bool registered = false;
+    if (!registered)
+      registered = std::atexit(StopReaperAtExit) == 0;
+  }
+  // Without a reaper, detached threads are never joined (their stacks and handles leak), but
+  // detach still succeeds: failing it would bring back the std::terminate of finding 1499.
+  ReaperStarted(rc);
+}
+} // namespace
+
+// Stops and joins the reaper (idempotent): 1 = stopped now, 0 = was not running. Detaches after this are
+// not reaped (the launch is ending; main's exit check counts what is left).
+extern "C" int Switch2StopReaper(void)
+{
+  std::lock_guard<std::mutex> ctl(g_reaperCtl);
+  if (!g_reaperRunning)
+    return 0;
+  {
+    std::lock_guard<std::mutex> lock(g_thrMutex);
+    g_reaperStop = true;
+  }
+  g_reapCv.notify_all();
+  const int rc = __real_pthread_join(g_reaperThread, nullptr);
+  g_reaperRunning = false;
+  if (rc == 0)
+    g_threadsUntracked.fetch_sub(1, std::memory_order_relaxed);
+  ReaperStopped(rc);
+  return 1;
+}
+
+extern "C" int __wrap_pthread_detach(pthread_t thread)
+{
+  {
+    std::lock_guard<std::mutex> ctl(g_reaperCtl);
+    if (!g_reaperStarted)
+    {
+      g_reaperStarted = true;
+      StartReaper();
+    }
+    if (!g_reaperRunning)
+      return 0;
+  }
+  bool wake = false;
+  long leaked = 0;
+  {
+    std::lock_guard<std::mutex> lock(g_thrMutex);
+    // (c) a thread detaching itself: its own record, linked or not yet.
+    ThreadRec* r = (t_rec && pthread_equal(thread, pthread_self())) ? t_rec : FindLocked(thread);
+    if (r)
+    {
+      if (!r->detached && !r->queued && !r->joining)
+      {
+        r->detached = true;
+        if (r->ended)
+          wake = QueueReapLocked(r); // not yet linked: CountedCreate queues it when it links it
+      }
+    }
+    else
+    {
+      // (b) no record: never joined (stack and handle leak; rare: created without a record).
+      leaked = g_threadsDetachLeaked.fetch_add(1, std::memory_order_relaxed) + 1;
+    }
+  }
+  if (wake)
+    g_reapCv.notify_one();
+  if (leaked)
+    DetachUnknownLeaked(leaked);
+  return 0;
+}
diff --git a/xbmc/platform/switch2/UsbIdentity.h b/xbmc/platform/switch2/UsbIdentity.h
new file mode 100644
index 0000000..a0e1212
--- /dev/null
+++ b/xbmc/platform/switch2/UsbIdentity.h
@@ -0,0 +1,21 @@
+#pragma once
+#include <string>
+namespace SWITCH2USB {
+inline bool USBPath(const std::string& p) {
+  return p.compare(0,13,"special://usb")==0 || (p.size()>=5 && p.compare(0,3,"ums")==0 && p[3]>='0' && p[3]<='7' && p[4]==':');
+}
+inline std::string SpecialRoot(int slot,const std::string& key) {
+  return "special://usb"+std::to_string(slot)+"-"+key+"/";
+}
+// A retired URL translates to its OWN native key, not the current slot. The USB mutex
+// verifies that key again at actual stat/open/opendir time, even for an already translated URL.
+inline std::string NativeRoot(const std::string& root) {
+  if(root.size()<4 || root.compare(0,3,"usb") || root[3]<'0' || root[3]>'7') return {};
+  const std::string dev=std::string("ums")+root[3]+":/";
+  if(root.size()<6 || root[4]!='-' || root.find_first_not_of("0123456789abcdefABCDEF-",5)!=std::string::npos) return dev+"!invalid/";
+  return dev+root.substr(5)+"/";
+}
+inline bool SameTree(const std::string& path,const std::string& root) {
+  return path.compare(0,root.size(),root)==0 || path+"/"==root;
+}
+} // namespace SWITCH2USB
diff --git a/xbmc/platform/switch2/UsbStorage.cpp b/xbmc/platform/switch2/UsbStorage.cpp
