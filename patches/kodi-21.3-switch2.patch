+ *  This file is part of Kodi - https://kodi.tv
+ *
+ *  SPDX-License-Identifier: GPL-2.0-or-later
+ *  See LICENSES/README.md for more information.
+ */
+
+#include "OSScreenSaverSwitch2.h"
+
+#include "platform/switch2/PosixCompat.h"
+#include "utils/log.h"
+
+#include <atomic>
+
+#include <switch.h>
+
+using namespace KODI::WINDOWING::SWITCH2;
+
+namespace
+{
+std::atomic<bool> g_loggedOnce{false};
+
+void SetMediaPlayback(bool state)
+{
+  const Result rc = appletSetMediaPlaybackState(state);
+  // One boot.txt line for the first call (the result of the first inhibit); kodi.log gets failures.
+  if (!g_loggedOnce.exchange(true))
+    Switch2BootLog(state ? "media-playback-state on rc" : "media-playback-state off rc",
+                   static_cast<long long>(rc));
+  if (R_FAILED(rc))
+    CLog::Log(LOGWARNING, "COSScreenSaverSwitch2: appletSetMediaPlaybackState({}) failed: 0x{:x}",
+              state, rc);
+}
+} // namespace
+
+void COSScreenSaverSwitch2::Inhibit()
+{
+  if (m_inhibited)
+    return;
+  SetMediaPlayback(true);
+  m_inhibited = true;
+}
+
+void COSScreenSaverSwitch2::Uninhibit()
+{
+  if (!m_inhibited)
+    return;
+  SetMediaPlayback(false);
+  m_inhibited = false;
+}
