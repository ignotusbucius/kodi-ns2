+#include "Switch2StorageProvider.h"
+
+#include "MediaSource.h"
+#include "dialogs/GUIDialogKaiToast.h"
+#include "guilib/LocalizeStrings.h"
+#include "platform/switch2/UsbStorage.h"
+#include "utils/StringUtils.h"
+#include "utils/log.h"
+
+#include <algorithm>
+
+#include <sys/statvfs.h>
+
+std::unique_ptr<IStorageProvider> IStorageProvider::CreateInstance()
+{
+  return std::make_unique<CSwitch2StorageProvider>();
+}
+
+void CSwitch2StorageProvider::GetLocalDrives(VECSOURCES& localDrives)
+{
+  CMediaSource share;
+  share.strPath = "/"; // the SD card (sdmc is the default device)
+  share.strName = "SD card";
+  share.m_ignore = true;
+  share.m_iDriveType = CMediaSource::SOURCE_TYPE_LOCAL;
+  localDrives.push_back(share);
+}
+
+// Like the Linux providers' auto-mounted drives: generated on every call, never stored in sources.xml
+// (m_ignore), listed by Kodi under Videos/Music/Pictures -> Files, "Add ... -> Browse" and the file
+// manager. Only a snapshot is read here; nothing waits on USB.
+void CSwitch2StorageProvider::GetRemovableDrives(VECSOURCES& removableDrives)
+{
+  for (const auto& v : SWITCH2USB::Volumes())
+  {
+    CMediaSource share;
+    share.strPath = v.path;
+    share.strName = v.label;
+    share.m_ignore = true;
+    share.m_iDriveType = CMediaSource::SOURCE_TYPE_REMOVABLE;
+    removableDrives.push_back(share);
+  }
+}
+
+// "Remove safely": the volume is read-only (nothing to flush), so it is safe to unplug at any time.
+// Only its entry is hidden; no usbfs2 call and no USB command (usbfs2_unmount would drop every volume
+// of the drive and, with re-attach disabled, could not be undone; a player may still be reading).
+bool CSwitch2StorageProvider::Eject(const std::string& mountpath)
+{
+  // Volume paths are "special://usbN/"; Kodi may pass the path without its trailing slash.
+  const std::string path =
+      (!mountpath.empty() && mountpath.back() == '/') ? mountpath : mountpath + "/";
+  std::lock_guard<std::mutex> lock(m_hiddenLock);
+  unsigned attachment = 0;
+  const bool hidden = SWITCH2USB::Hide(path, attachment);
+  if (hidden) m_hidden.emplace(attachment, path);
+  return hidden;
+}
+
+std::vector<std::string> CSwitch2StorageProvider::GetDiskUsage()
+{
+  std::vector<std::string> result;
+  struct statvfs fs;
+  if (statvfs("/", &fs) == 0)
+  {
+    const double total = static_cast<double>(fs.f_blocks) * fs.f_frsize / (1024.0 * 1024 * 1024);
+    const double avail = static_cast<double>(fs.f_bavail) * fs.f_frsize / (1024.0 * 1024 * 1024);
+    result.push_back(StringUtils::Format("SD card: {:.1f} GB free of {:.1f} GB", avail, total));
+  }
+  // No statvfs on a USB volume here: it would wait on usbfs2's mutex behind a read (and usbfs2 reports
+  // no free space: the free-cluster count is a write-side FatFs function, compiled out).
+  for (const auto& v : SWITCH2USB::Volumes())
+    result.push_back(v.label + ": read-only");
+  return result;
+}
+
+// Called from CApplication::ProcessSlow. Reports the volumes once mounted (the attach runs on its
+// own thread) and their removal when usbfs2 marked the drive dead or the user chose "Remove safely".
+// Never mounts or re-attaches anything.
+bool CSwitch2StorageProvider::PumpDriveChangeEvents(IStorageEventsCallback* callback)
+{
+  const unsigned generation = SWITCH2USB::Generation();
+  if (generation == m_generation)
+    return false;
+  m_generation = generation;
+
+  std::vector<Listed> now;
+  for (const auto& v : SWITCH2USB::Volumes())
+    now.push_back({v.attachment, v.path, v.label});
+
+  auto contains = [](const std::vector<Listed>& list, const Listed& entry) {
+    return std::any_of(list.begin(), list.end(), [&](const Listed& l) { return l.path == entry.path && l.attachment == entry.attachment; });
+  };
+  bool changed = false;
+  for (const auto& l : m_listed)
+  {
+    if (contains(now, l))
+      continue;
+    changed = true;
+    // Only a user "Remove safely" (Eject -> Hide) is a safe removal. Any other removal means usbfs2
+    // marked the drive dead (a failed transfer, e.g. after an unplug during a read): unsafe.
+    bool userHidden;
+    {
+      std::lock_guard<std::mutex> lock(m_hiddenLock);
+      userHidden = m_hidden.erase({l.attachment, l.path}) > 0;
+    }
+    CLog::Log(LOGINFO, "Switch2StorageProvider: removable drive removed ({}): {} ({})",
+              userHidden ? "hidden by the user" : "drive went dead", l.label, l.path);
+    if (callback)
+    {
+      MEDIA_DETECT::STORAGE::StorageDevice device;
+      device.label = l.label;
+      device.path = l.path;
+      device.type = MEDIA_DETECT::STORAGE::Type::UNKNOWN;
+      if (userHidden)
+        callback->OnStorageSafelyRemoved(device);
+      else
+        callback->OnStorageUnsafelyRemoved(device);
+    }
+  }
+  for (const auto& l : now)
+  {
+    if (contains(m_listed, l))
+      continue;
+    changed = true;
+    CLog::Log(LOGINFO, "Switch2StorageProvider: removable drive added: {} ({})", l.label, l.path);
+    // CMediaManager::OnStorageAdded only notifies on builds with an optical drive: notify here.
+    CGUIDialogKaiToast::QueueNotification(CGUIDialogKaiToast::Info, g_localizeStrings.Get(13021),
+                                          l.label, TOAST_DISPLAY_TIME, false);
+  }
+  m_listed = std::move(now);
+  return changed;
+}
