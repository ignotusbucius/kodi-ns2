+ *  This file is part of Kodi - https://kodi.tv
+ *
+ *  SPDX-License-Identifier: GPL-2.0-or-later
+ *  See LICENSES/README.md for more information.
+ */
+
+#include "dlfcn.h"
+
+#include "StaticAddons.h"
+
+#include <atomic>
+
+// The static add-on registry (StaticAddons.cpp) is referenced weakly: without it every dlopen fails,
+// exactly as before it existed.
+#pragma weak kodi_static_addon_find
+#pragma weak kodi_static_addon_is_handle
+#pragma weak kodi_static_addon_symbol
+
+namespace
+{
+char kNoLoader[] = "dynamic loading is not available on Switch 2";
+char kNoSymbol[] = "symbol is not exported by this statically linked add-on";
+
+// dlerror() never returns nullptr here: Kodi passes its result straight to a log format.
+std::atomic<char*> g_lastError{kNoLoader};
+
+bool IsStaticAddon(void* handle)
+{
+  return handle && kodi_static_addon_is_handle && kodi_static_addon_is_handle(handle);
+}
+} // namespace
+
+// Returns a pseudo-handle (a registry entry) when `file` names a binary add-on library that is
+// linked into kodi.bin; every other library fails to load.
+extern "C" void* dlopen(const char* file, int)
+{
+  if (file && kodi_static_addon_find)
+  {
+    if (const KodiStaticAddon* addon = kodi_static_addon_find(file))
+      return const_cast<KodiStaticAddon*>(addon);
+  }
+  g_lastError.store(kNoLoader);
+  return nullptr;
+}
+
+extern "C" void* dlsym(void* handle, const char* name)
+{
+  if (IsStaticAddon(handle))
+  {
+    if (void* address = kodi_static_addon_symbol(static_cast<const KodiStaticAddon*>(handle), name))
+      return address;
+    g_lastError.store(kNoSymbol);
+    return nullptr;
+  }
+  g_lastError.store(kNoLoader);
+  return nullptr;
+}
+
+// Static add-ons are never unloaded; their code and data stay in kodi.bin.
+extern "C" int dlclose(void*)
+{
+  return 0;
+}
+
+extern "C" char* dlerror(void)
+{
+  return g_lastError.load();
+}
+
+// Kodi's Windows-DLL emulation layer (cores/DllLoader/exports/emu_msvcrt) is not built on Switch 2;
+// CApplication still calls its environment hooks.
+extern "C" void init_emu_environ() {}
+extern "C" void update_emu_environ() {}
+extern "C" void cleanup_emu_environ() {}
diff --git a/xbmc/platform/switch2/OsslTrace.cpp b/xbmc/platform/switch2/OsslTrace.cpp
new file mode 100644
index 0000000..0a2fe77
--- /dev/null
+++ b/xbmc/platform/switch2/OsslTrace.cpp
@@ -0,0 +1,849 @@
+/*
+ *  Copyright (C) 2026 Team Kodi
+ *  This file is part of Kodi - https://kodi.tv
+ *
+ *  SPDX-License-Identifier: GPL-2.0-or-later
+ *  See LICENSES/README.md for more information.
+ */
+
+// Switch 2 OpenSSL support. Always built: Switch2OsslWarmUp (bottom of the file). Diagnostics build
+// only (ENABLE_SWITCH2_DIAG=ON, SWITCH2_DIAG=1): the breadcrumbs, crumbs and self-test below.
+//
+// OpenSSL breadcrumbs for the Switch 2 port (rev 18 instrument). Active only when
+// sdmc:/switch/kodi/trace-ossl.flag exists at start-up (Switch2OsslTraceInit, called from main).
+// Each function in OSSL_TRACED below is linked with -Wl,--wrap=<fn> (cmake/scripts/switch2/
+// Install.cmake, same list). Logging window: armed by the first EVP_MD_fetch from a thread other
+// than the main thread, then the next kWindow lines are written, from any thread:
+//   "<ms> OSSL <fn> enter a0=.. a1=.. .. tid=.."   (written and flushed before the real call)
+//   "<ms> OSSL <fn> ret=.. tid=.."
+// Every line also carries "sp=<sp> room=<sp - stack bottom>" (rev 20), the stack bottom being the
+// current libnx Thread's stack_mirror (the mapping threads run on; stack_mem if sp lies there
+// instead), its size stack_sz; the first line of each thread is preceded by one
+// "<ms> OSSL-STACK tid=.. mem=.. mirror=.. size=.." line.
+// EVP_MD_fetch itself is logged whenever the flag is set. Lines go to boot.txt through the
+// synchronous raw append (no malloc, no stdio, no OpenSSL), so the last line before a silent death
+// names the call that did not return.
+//
+// The wrappers forward x0-x7 unchanged and return x0, so a traced function must take at most 8
+// integer/pointer arguments (a 9th is on the caller's stack and would be read from the wrapper's
+// frame), none variadic, no floating-point or by-value structure argument or result. Every entry
+// below was counted against deps/build/openssl (3.0.22) definitions (rev 19; ossl_algorithm_do_all,
+// 9 parameters, was wrapped in rev 18 and broke the fetch it was tracing: removed).
+
+#include "PosixCompat.h"
+
+#include <atomic>
+#include <cstdint>
+#include <initializer_list>
+#include <unistd.h>
+
+#include <switch.h>
+
+#if SWITCH2_DIAG
+// ============================ diagnostics build only (ENABLE_SWITCH2_DIAG) ============================
+
+namespace
+{
+constexpr int kWindow = 20000;
+bool g_traceOn = false;
+u64 g_mainTid = 0;
+std::atomic<bool> g_armedOnce{false};
+std::atomic<int> g_window{0};
+
+u64 Tid()
+{
+  u64 tid = 0;
+  svcGetThreadId(&tid, CUR_THREAD_HANDLE);
+  return tid;
+}
+
+// Stack bounds of the calling thread from libnx's Thread (threadGetSelf: stack_mem, stack_mirror,
+// stack_sz). Returns sp - bottom, or -1 when sp is in neither range (or there is no Thread).
+long long StackRoom(uintptr_t sp)
+{
+  const Thread* t = threadGetSelf();
+  if (!t || !t->stack_sz)
+    return -1;
+  for (const void* base : {t->stack_mirror, t->stack_mem})
+  {
+    const uintptr_t lo = reinterpret_cast<uintptr_t>(base);
+    if (lo && sp >= lo && sp < lo + t->stack_sz)
+      return static_cast<long long>(sp - lo);
+  }
+  return -1;
+}
+
+void LogStackOnce();
+
+struct Line
+{
+  char b[400];
+  unsigned n = 0;
+  void Put(const char* s)
+  {
+    while (*s && n < sizeof(b) - 2)
+      b[n++] = *s++;
+  }
+  void Hex(uintptr_t v)
+  {
+    char t[19];
+    t[0] = '0';
+    t[1] = 'x';
+    int i = 2;
+    bool started = false;
+    for (int sh = 60; sh >= 0; sh -= 4)
+    {
+      const int d = (v >> sh) & 0xf;
+      if (d || started || sh == 0)
+      {
+        t[i++] = "0123456789abcdef"[d];
+        started = true;
+      }
+    }
+    t[i] = '\0';
+    Put(t);
+  }
+  void Dec(unsigned long long u)
+  {
+    char t[24];
+    int i = 23;
+    t[i] = '\0';
+    do
+    {
+      t[--i] = static_cast<char>('0' + u % 10);
+      u /= 10;
+    } while (u && i > 0);
+    Put(t + i);
+  }
+  void Begin(const char* fn)
+  {
+    LogStackOnce();
+    Dec(armTicksToNs(armGetSystemTick()) / 1000000ULL);
+    Put(" OSSL ");
+    Put(fn);
+  }
+  void End()
+  {
+    uintptr_t sp;
+    asm volatile("mov %0, sp" : "=r"(sp));
+    Put(" sp=");
+    Hex(sp);
+    Put(" room=");
+    const long long room = StackRoom(sp);
+    if (room < 0)
+      Put("?");
+    else
+      Dec(static_cast<unsigned long long>(room));
+    Put(" tid=");
+    Dec(Tid());
+    b[n++] = '\n';
+    Switch2RawAppend("/switch/kodi/boot.txt", b, n);
+  }
+};
+
+// One "OSSL-STACK" line the first time a thread logs (up to 64 threads remembered).
+std::atomic<u64> g_seenTids[64];
+
+void LogStackOnce()
+{
+  const u64 tid = Tid();
+  for (auto& slot : g_seenTids)
+  {
+    u64 cur = slot.load(std::memory_order_relaxed);
+    if (cur == tid)
+      return;
+    if (cur == 0)
+    {
+      if (!slot.compare_exchange_strong(cur, tid))
+      {
+        if (cur == tid)
+          return;
+        continue;
+      }
+      const Thread* t = threadGetSelf();
+      Line l;
+      l.Dec(armTicksToNs(armGetSystemTick()) / 1000000ULL);
+      l.Put(" OSSL-STACK tid=");
+      l.Dec(tid);
+      l.Put(" mem=");
+      l.Hex(t ? reinterpret_cast<uintptr_t>(t->stack_mem) : 0);
+      l.Put(" mirror=");
+      l.Hex(t ? reinterpret_cast<uintptr_t>(t->stack_mirror) : 0);
+      l.Put(" size=");
+      l.Hex(t ? t->stack_sz : 0);
+      l.b[l.n++] = '\n';
+      Switch2RawAppend("/switch/kodi/boot.txt", l.b, l.n);
+      return;
+    }
+  }
+}
+
+// True when this call is to be logged (and takes one line of the window).
+bool Take(bool always)
+{
+  if (!g_traceOn)
+    return false;
+  if (always)
+    return true;
+  int w = g_window.load(std::memory_order_relaxed);
+  while (w > 0)
+    if (g_window.compare_exchange_weak(w, w - 1, std::memory_order_relaxed))
+      return true;
+  return false;
+}
+
+void Enter(const char* fn, const uintptr_t* a, int nargs)
+{
+  Line l;
+  l.Begin(fn);
+  l.Put(" enter");
+  for (int i = 0; i < nargs; ++i)
+  {
+    char k[5] = {' ', 'a', static_cast<char>('0' + i), '=', '\0'};
+    l.Put(k);
+    l.Hex(a[i]);
+  }
+  l.End();
+}
+
+void Ret(const char* fn, uintptr_t r)
+{
+  Line l;
+  l.Begin(fn);
+  l.Put(" ret=");
+  l.Hex(r);
+  l.End();
+}
+} // namespace
+
+// Source breadcrumbs from inside libcrypto (deps/patches/openssl/0002-switch2-crumbs.patch: S2CRUMB
+// calls a WEAK Switch2OsslCrumb; this strong definition makes them live). Logged only while the
+// window is armed, one line each: "<ms> CRUMB <where> a=.. b=.. tid=..". `where` is a string
+// literal in libcrypto, or an OSSL_ALGORITHM's algorithm_names (provider static data).
+extern "C" void Switch2OsslCrumb(const char* where, uintptr_t a, uintptr_t b)
+{
+  if (!Take(false))
+    return;
+  LogStackOnce();
+  Line l;
+  l.Dec(armTicksToNs(armGetSystemTick()) / 1000000ULL);
+  l.Put(" CRUMB ");
+  l.Put(where ? where : "?");
+  l.Put(" a=");
+  l.Hex(a);
+  l.Put(" b=");
+  l.Hex(b);
+  l.End();
+}
+
+extern "C" void Switch2OsslTraceInit(void)
+{
+  g_mainTid = Tid();
+  g_traceOn = access("sdmc:/switch/kodi/trace-ossl.flag", F_OK) == 0;
+  Switch2BootLog("ossl-trace-flag", g_traceOn ? 1 : 0);
+}
+
+#define OSSL_ARGS uintptr_t a0, uintptr_t a1, uintptr_t a2, uintptr_t a3, uintptr_t a4, uintptr_t a5, \
+                  uintptr_t a6, uintptr_t a7
+#define OSSL_FWD a0, a1, a2, a3, a4, a5, a6, a7
+
+// OSSL_WRAP(fn, number of arguments to print, logged outside the window)
+#define OSSL_WRAP(fn, nargs, always) \
+  extern "C" uintptr_t __real_##fn(OSSL_ARGS); \
+  extern "C" uintptr_t __wrap_##fn(OSSL_ARGS) \
+  { \
+    if (!Take(always)) \
+      return __real_##fn(OSSL_FWD); \
+    const uintptr_t a[8] = {OSSL_FWD}; \
+    Enter(#fn, a, nargs); \
+    const uintptr_t r = __real_##fn(OSSL_FWD); \
+    if (Take(always)) \
+      Ret(#fn, r); \
+    return r; \
+  }
+
+// The first EVP_MD_fetch from a non-main thread opens the window (before its own enter line).
+extern "C" uintptr_t __real_EVP_MD_fetch(OSSL_ARGS);
+extern "C" uintptr_t __wrap_EVP_MD_fetch(OSSL_ARGS)
+{
+  if (!g_traceOn)
+    return __real_EVP_MD_fetch(OSSL_FWD);
+  if (Tid() != g_mainTid && !g_armedOnce.exchange(true))
+  {
+    g_window.store(kWindow);
+    Switch2BootLog("ossl-trace-window-armed", kWindow);
+  }
+  const uintptr_t a[8] = {OSSL_FWD};
+  Enter("EVP_MD_fetch", a, 3);
+  const uintptr_t r = __real_EVP_MD_fetch(OSSL_FWD);
+  Ret("EVP_MD_fetch", r);
+  return r;
+}
+
+// clang-format off
+// EVP digest entry points
+OSSL_WRAP(EVP_MD_CTX_new, 0, false)
+OSSL_WRAP(EVP_DigestInit_ex, 3, false)
+OSSL_WRAP(EVP_DigestInit_ex2, 3, false)
+OSSL_WRAP(EVP_MD_up_ref, 1, false)
+OSSL_WRAP(EVP_MD_free, 1, false)
+OSSL_WRAP(evp_generic_fetch, 4, false)
+OSSL_WRAP(evp_md_new, 0, false)
+// method store / construction (crypto/property/property.c, crypto/core_fetch.c)
+OSSL_WRAP(ossl_method_store_new, 1, false)
+OSSL_WRAP(ossl_method_store_fetch, 5, false)
+OSSL_WRAP(ossl_method_store_add, 7, false)
+OSSL_WRAP(ossl_method_store_cache_get, 5, false)
+OSSL_WRAP(ossl_method_store_cache_set, 7, false)
+OSSL_WRAP(ossl_method_lock_store, 1, false)
+OSSL_WRAP(ossl_method_unlock_store, 1, false)
+OSSL_WRAP(ossl_method_construct, 6, false)
+// properties (crypto/property/property_parse.c, property_string.c, property_query.c)
+OSSL_WRAP(ossl_parse_property, 2, false)
+OSSL_WRAP(ossl_parse_query, 3, false)
+OSSL_WRAP(ossl_property_merge, 2, false)
+OSSL_WRAP(ossl_property_name, 3, false)
+OSSL_WRAP(ossl_property_value, 3, false)
+OSSL_WRAP(ossl_property_match_count, 2, false)
+OSSL_WRAP(ossl_property_free, 1, false)
+OSSL_WRAP(ossl_property_is_enabled, 3, false)
+OSSL_WRAP(ossl_ctx_global_properties, 2, false)
+// providers, names, library context
+OSSL_WRAP(ossl_provider_ctx, 1, false)
+OSSL_WRAP(ossl_provider_libctx, 1, false)
+OSSL_WRAP(ossl_provider_up_ref, 1, false)
+OSSL_WRAP(ossl_provider_test_operation_bit, 3, false)
+OSSL_WRAP(ossl_provider_set_operation_bit, 2, false)
+OSSL_WRAP(ossl_provider_query_operation, 3, false)
+OSSL_WRAP(ossl_provider_unquery_operation, 3, false)
+OSSL_WRAP(ossl_provider_doall_activated, 3, false)
+OSSL_WRAP(ossl_namemap_stored, 1, false)
+OSSL_WRAP(ossl_namemap_name2num, 2, false)
+OSSL_WRAP(ossl_namemap_name2num_n, 3, false)
+OSSL_WRAP(ossl_namemap_add_name, 3, false)
+OSSL_WRAP(ossl_namemap_add_names, 4, false)
+OSSL_WRAP(ossl_namemap_num2name, 3, false)
+OSSL_WRAP(ossl_lib_ctx_get_data, 3, false)
+OSSL_WRAP(OPENSSL_LH_new, 2, false)
+OSSL_WRAP(OPENSSL_LH_insert, 2, false)
+OSSL_WRAP(OPENSSL_LH_retrieve, 2, false)
+// error state and thread-local storage
+OSSL_WRAP(ERR_set_mark, 0, false)
+OSSL_WRAP(ERR_pop_to_mark, 0, false)
+OSSL_WRAP(ERR_clear_last_mark, 0, false)
+OSSL_WRAP(ERR_new, 0, false)
+OSSL_WRAP(ERR_set_debug, 3, false)
+OSSL_WRAP(ERR_clear_error, 0, false)
+OSSL_WRAP(ossl_err_get_state_int, 0, false)
+OSSL_WRAP(ossl_init_thread_start, 3, false)
+OSSL_WRAP(CRYPTO_THREAD_run_once, 2, false)
+OSSL_WRAP(CRYPTO_THREAD_init_local, 2, false)
+OSSL_WRAP(CRYPTO_THREAD_set_local, 2, false)
+OSSL_WRAP(CRYPTO_THREAD_get_local, 1, false)
+OSSL_WRAP(CRYPTO_THREAD_lock_new, 0, false)
+OSSL_WRAP(CRYPTO_THREAD_read_lock, 1, false)
+OSSL_WRAP(CRYPTO_THREAD_write_lock, 1, false)
+OSSL_WRAP(CRYPTO_THREAD_unlock, 1, false)
+// allocation (hot: window only)
+OSSL_WRAP(CRYPTO_malloc, 3, false)
+OSSL_WRAP(CRYPTO_zalloc, 3, false)
+OSSL_WRAP(CRYPTO_realloc, 4, false)
+OSSL_WRAP(CRYPTO_free, 3, false)
+// clang-format on
+
+// ----------------------------------------------------------------------------------------------
+// OpenSSL self-test (rev 20), only with sdmc:/switch/kodi/ossl-selftest.flag, run from main before
+// Kodi starts: MD5("x") through EVP_MD_fetch / EVP_MD_CTX_new / EVP_DigestInit_ex / Update / Final /
+// free, on the main thread, then in a std::thread (default attributes: 1 MiB from the
+// pthread_create wrapper), then in a pthread with a 256 KiB stack; each joined before the next.
+// Every step is one synchronous boot.txt line "SELFTEST <where> <step> <value>".
+// ----------------------------------------------------------------------------------------------
+#include <openssl/crypto.h>
+#include <openssl/evp.h>
+#include <openssl/ssl.h>
+
+#include <atomic>
+#include <cstdio>
+#include <cstring>
+#include <pthread.h>
+#include <thread>
+
+namespace
+{
+void SelfTestStep(const char* where, const char* step, long long value)
+{
+  char what[96];
+  std::strcpy(what, "SELFTEST ");
+  std::strncat(what, where, 20);
+  std::strcat(what, " ");
+  std::strncat(what, step, 40);
+  Switch2BootLog(what, value);
+}
+
+// One digest of "x" with `alg` (MD5 or SHA256). A "pre <step>" line is written (synchronously)
+// before each call, the result after it, so a death inside a call names that call.
+void SelfTestRun(const char* where, const char* alg = "MD5")
+{
+  SelfTestStep(where, "start", 0);
+  SelfTestStep(where, "pre EVP_MD_fetch", 0);
+  EVP_MD* md = EVP_MD_fetch(nullptr, alg, nullptr);
+  SelfTestStep(where, "EVP_MD_fetch", reinterpret_cast<long long>(md));
+  if (!md)
+    return;
+  SelfTestStep(where, "pre EVP_MD_CTX_new", 0);
+  EVP_MD_CTX* ctx = EVP_MD_CTX_new();
+  SelfTestStep(where, "EVP_MD_CTX_new", reinterpret_cast<long long>(ctx));
+  if (ctx)
+  {
+    SelfTestStep(where, "pre EVP_DigestInit_ex", 0);
+    int rc = EVP_DigestInit_ex(ctx, md, nullptr);
+    SelfTestStep(where, "EVP_DigestInit_ex", rc);
+    SelfTestStep(where, "pre EVP_DigestUpdate", 0);
+    rc = EVP_DigestUpdate(ctx, "x", 1);
+    SelfTestStep(where, "EVP_DigestUpdate", rc);
+    unsigned char out[EVP_MAX_MD_SIZE];
+    unsigned int len = 0;
+    SelfTestStep(where, "pre EVP_DigestFinal_ex", 0);
+    rc = EVP_DigestFinal_ex(ctx, out, &len);
+    SelfTestStep(where, "EVP_DigestFinal_ex", rc);
+    // MD5("x") = 9dd4e461268c8034f5c8564e155c67a6
+    static const unsigned char md5x[16] = {0x9d, 0xd4, 0xe4, 0x61, 0x26, 0x8c, 0x80, 0x34,
+                                           0xf5, 0xc8, 0x56, 0x4e, 0x15, 0x5c, 0x67, 0xa6};
+    // SHA256("x") = 2d711642b726b04401627ca9fbac32f5c8530fb1903cc4db02258717921a4881
+    static const unsigned char sha256x[32] = {
+        0x2d, 0x71, 0x16, 0x42, 0xb7, 0x26, 0xb0, 0x44, 0x01, 0x62, 0x7c, 0xa9, 0xfb, 0xac, 0x32, 0xf5,
+        0xc8, 0x53, 0x0f, 0xb1, 0x90, 0x3c, 0xc4, 0xdb, 0x02, 0x25, 0x87, 0x17, 0x92, 0x1a, 0x48, 0x81};
+    const bool isSha = std::strcmp(alg, "SHA256") == 0;
+    const unsigned char* want = isSha ? sha256x : md5x;
+    const unsigned int wantLen = isSha ? 32 : 16;
+    SelfTestStep(where, isSha ? "sha256-matches" : "md5-matches",
+                 len == wantLen && std::memcmp(out, want, wantLen) == 0 ? 1 : 0);
+    EVP_MD_CTX_free(ctx);
+    SelfTestStep(where, "EVP_MD_CTX_free", 0);
+  }
+  EVP_MD_free(md);
+  SelfTestStep(where, "EVP_MD_free done", 0);
+}
+
+// Expected digests of "x" for the concurrent tests.
+bool DigestMatches(const char* alg, const unsigned char* out, unsigned int len)
+{
+  static const unsigned char md5x[] = {0x9d, 0xd4, 0xe4, 0x61, 0x26, 0x8c, 0x80, 0x34,
+                                       0xf5, 0xc8, 0x56, 0x4e, 0x15, 0x5c, 0x67, 0xa6};
+  static const unsigned char sha1x[] = {0x11, 0xf6, 0xad, 0x8e, 0xc5, 0x2a, 0x29, 0x84, 0xab, 0xaa,
+                                        0xfd, 0x7c, 0x3b, 0x51, 0x65, 0x03, 0x78, 0x5c, 0x20, 0x72};
+  static const unsigned char sha256x[] = {
+      0x2d, 0x71, 0x16, 0x42, 0xb7, 0x26, 0xb0, 0x44, 0x01, 0x62, 0x7c, 0xa9, 0xfb, 0xac, 0x32, 0xf5,
+      0xc8, 0x53, 0x0f, 0xb1, 0x90, 0x3c, 0xc4, 0xdb, 0x02, 0x25, 0x87, 0x17, 0x92, 0x1a, 0x48, 0x81};
+  static const unsigned char sha512x[] = {
+      0xa4, 0xab, 0xd4, 0x44, 0x8c, 0x49, 0x56, 0x2d, 0x82, 0x81, 0x15, 0xd1, 0x3a, 0x1f, 0xcc, 0xea,
+      0x92, 0x7f, 0x52, 0xb4, 0xd5, 0x45, 0x92, 0x97, 0xf8, 0xb4, 0x3e, 0x42, 0xda, 0x89, 0x23, 0x8b,
+      0xc1, 0x36, 0x26, 0xe4, 0x3d, 0xcb, 0x38, 0xdd, 0xb0, 0x82, 0x48, 0x89, 0x27, 0xec, 0x90, 0x4f,
+      0xb4, 0x20, 0x57, 0x44, 0x39, 0x83, 0xe8, 0x85, 0x85, 0x17, 0x9d, 0x50, 0x55, 0x1a, 0xfe, 0x62};
+  const unsigned char* want = nullptr;
+  unsigned int n = 0;
+  if (!std::strcmp(alg, "MD5")) { want = md5x; n = sizeof(md5x); }
+  else if (!std::strcmp(alg, "SHA1")) { want = sha1x; n = sizeof(sha1x); }
+  else if (!std::strcmp(alg, "SHA256")) { want = sha256x; n = sizeof(sha256x); }
+  else if (!std::strcmp(alg, "SHA512")) { want = sha512x; n = sizeof(sha512x); }
+  return want && len == n && std::memcmp(out, want, n) == 0;
+}
+
+// T6-T8: kThreads std::threads (1 MiB) meet at a spin barrier, then all make their fetch at once.
+// A thread logs "ready" before the barrier and nothing between the barrier and its fetch (boot.txt
+// writes are serialised and would stagger the fetches), then the fetch result and the digest.
+constexpr int kThreads = 4;
+
+void ConcurrentFetch(const char* tag, const char* alg, OSSL_LIB_CTX* libctx, std::atomic<int>* barrier)
+{
+  SelfTestStep(tag, "cpu", svcGetCurrentProcessorNumber());
+  SelfTestStep(tag, "ready (pre EVP_MD_fetch)", 0);
+  barrier->fetch_add(1);
+  while (barrier->load() < kThreads)
+    std::this_thread::yield();
+  EVP_MD* md = EVP_MD_fetch(libctx, alg, nullptr);
+  SelfTestStep(tag, "EVP_MD_fetch", reinterpret_cast<long long>(md));
+  if (!md)
+    return;
+  unsigned char out[EVP_MAX_MD_SIZE];
+  unsigned int len = 0;
+  EVP_MD_CTX* ctx = EVP_MD_CTX_new();
+  const int rc = ctx && EVP_DigestInit_ex(ctx, md, nullptr) && EVP_DigestUpdate(ctx, "x", 1) &&
+                 EVP_DigestFinal_ex(ctx, out, &len);
+  SelfTestStep(tag, "digest rc", rc);
+  SelfTestStep(tag, "matches", rc && DigestMatches(alg, out, len) ? 1 : 0);
+  EVP_MD_CTX_free(ctx);
+  EVP_MD_free(md);
+  SelfTestStep(tag, "done", 0);
+}
+
+// One round: kThreads threads, digest i = algs[i] (or all MD5), fetched from libctx (NULL = default).
+void ConcurrentRound(const char* prefix, bool sameDigest, OSSL_LIB_CTX* libctx)
+{
+  static const char* const algs[kThreads] = {"MD5", "SHA1", "SHA256", "SHA512"};
+  static char tags[kThreads][24];
+  std::atomic<int> barrier{0};
+  std::thread threads[kThreads];
+  int started = 0;
+  for (int i = 0; i < kThreads; ++i)
+  {
+    const char* alg = sameDigest ? "MD5" : algs[i];
+    std::snprintf(tags[i], sizeof(tags[i]), "%s-%d-%s", prefix, i, alg);
+    try
+    {
+      threads[i] = std::thread(ConcurrentFetch, tags[i], alg, libctx, &barrier);
+      ++started;
+    }
+    catch (...)
+    {
+      SelfTestStep(prefix, "std::thread failed", i);
+      barrier.fetch_add(1); // let the others go
+    }
+  }
+  SelfTestStep(prefix, "threads started", started);
+  for (int i = 0; i < kThreads; ++i)
+    if (threads[i].joinable())
+      threads[i].join();
+  SelfTestStep(prefix, "all-joined", 0);
+}
+
+// std::thread (1 MiB through the pthread_create wrapper) running fn; joined. Logs create/join.
+template<typename F>
+void OnThread(const char* where, F fn)
+{
+  SelfTestStep(where, "pre std::thread", 0);
+  try
+  {
+    std::thread t(fn);
+    t.join();
+    SelfTestStep(where, "joined", 0);
+  }
+  catch (...)
+  {
+    SelfTestStep(where, "std::thread failed", 0);
+  }
+}
+
+void* SelfTest256K(void*)
+{
+  SelfTestRun("thr256K");
+  return nullptr;
+}
+} // namespace
+
+// Flag sdmc:/switch/kodi/ossl-selftest.flag: absent = 0 (no self-test); any content not starting
+// with 'T' = 1 (warm-up, then main, thr1M, thr256K); 'T' = 2 (no warm-up: thr1M then thr256K);
+// 'T1'..'T4' = 21..24, one experiment each, all without the warm-up so the experiment makes the
+// process's first OpenSSL method fetch:
+//   T1  first EVP_MD_fetch(MD5) on a std::thread (1 MiB)              - the decisive test
+//   T2  as T1, but the thread first pins itself to core 0 (svcSetThreadCoreMask, rc logged)
+//   T3  a std::thread does the first fetch (MD5), exits and is joined; a second std::thread
+//       then fetches SHA256                                            - heap/lifetime hypothesis
+//   T4  first fetch on the main thread                                 - control, should pass
+//   T5  main thread: OPENSSL_init_crypto(LOAD_CONFIG) + OPENSSL_init_ssl (no fetch); then the first
+//       fetch (MD5) on a std::thread - the field order (library init on main, method on worker)
+//   T6  4 std::threads released together by a barrier, each the first fetch of a different digest
+//       (MD5, SHA1, SHA256, SHA512) - concurrent first construction
+//   T7  as T6, all four fetch MD5
+//   T8  T6 five times, each round in a fresh OSSL_LIB_CTX (new / fetch(libctx) / free)
+// T1/T2/T5 also log svcGetCurrentProcessorNumber() on the main thread and on the test thread
+// before the fetch; T2 logs svcGetThreadCoreMask after pinning.
+// Every mode logs "ossl-selftest-mode <n>" and its SELFTEST lines, then Kodi starts as usual.
+extern "C" int Switch2OsslSelfTestMode(void)
+{
+  FILE* f = std::fopen("sdmc:/switch/kodi/ossl-selftest.flag", "rb");
+  if (!f)
+    return 0;
+  const int c = std::fgetc(f);
+  const int c2 = c == 'T' ? std::fgetc(f) : EOF;
+  std::fclose(f);
+  int mode = 1;
+  if (c == 'T')
+    mode = (c2 >= '1' && c2 <= '8') ? 20 + (c2 - '0') : 2;
+  Switch2BootLog("ossl-selftest-mode", mode);
+  return mode;
+}
+
+extern "C" void Switch2OsslSelfTest(int mode)
+{
+  switch (mode)
+  {
+    case 0:
+      return;
+    case 21: // T1
+      SelfTestStep("T1-main", "cpu", svcGetCurrentProcessorNumber());
+      OnThread("T1-thr1M", [] {
+        SelfTestStep("T1-thr1M", "cpu", svcGetCurrentProcessorNumber());
+        SelfTestRun("T1-thr1M");
+      });
+      return;
+    case 22: // T2
+      SelfTestStep("T2-main", "cpu", svcGetCurrentProcessorNumber());
+      OnThread("T2-core0", [] {
+        SelfTestStep("T2-core0", "pre svcSetThreadCoreMask", 0);
+        const Result rc = svcSetThreadCoreMask(CUR_THREAD_HANDLE, 0, 1);
+        SelfTestStep("T2-core0", "svcSetThreadCoreMask rc", static_cast<long long>(rc));
+        s32 preferred = -1;
+        u64 mask = 0;
+        const Result grc = svcGetThreadCoreMask(&preferred, &mask, CUR_THREAD_HANDLE);
+        SelfTestStep("T2-core0", "svcGetThreadCoreMask rc", static_cast<long long>(grc));
+        SelfTestStep("T2-core0", "preferred_core", preferred);
+        SelfTestStep("T2-core0", "affinity_mask", static_cast<long long>(mask));
+        SelfTestStep("T2-core0", "cpu", svcGetCurrentProcessorNumber());
+        SelfTestRun("T2-core0");
+      });
+      return;
+    case 23: // T3
+      OnThread("T3-first", [] { SelfTestRun("T3-first"); });
+      OnThread("T3-second", [] { SelfTestRun("T3-second", "SHA256"); });
+      return;
+    case 24: // T4
+      SelfTestRun("T4-main");
+      return;
+    case 26: // T6: 4 threads, different digests, default library context
+      SelfTestStep("T6", "cpu-main", svcGetCurrentProcessorNumber());
+      ConcurrentRound("T6", false, nullptr);
+      return;
+    case 27: // T7: 4 threads, all MD5
+      SelfTestStep("T7", "cpu-main", svcGetCurrentProcessorNumber());
+      ConcurrentRound("T7", true, nullptr);
+      return;
+    case 28: // T8: T6 five times, each in a fresh library context (first construction every round)
+      for (int round = 0; round < 5; ++round)
+      {
+        char prefix[8];
+        std::snprintf(prefix, sizeof(prefix), "T8r%d", round);
+        SelfTestStep(prefix, "pre OSSL_LIB_CTX_new", 0);
+        OSSL_LIB_CTX* libctx = OSSL_LIB_CTX_new();
+        SelfTestStep(prefix, "OSSL_LIB_CTX_new", reinterpret_cast<long long>(libctx));
+        if (!libctx)
+          continue;
+        ConcurrentRound(prefix, false, libctx);
+        SelfTestStep(prefix, "pre OSSL_LIB_CTX_free", 0);
+        OSSL_LIB_CTX_free(libctx);
+        SelfTestStep(prefix, "OSSL_LIB_CTX_free done", 0);
+      }
+      SelfTestStep("T8", "all rounds done", 0);
+      return;
+    case 25: // T5
+    {
+      SelfTestStep("T5-main", "cpu", svcGetCurrentProcessorNumber());
+      SelfTestStep("T5-main", "pre OPENSSL_init_crypto", 0);
+      const int crc = OPENSSL_init_crypto(OPENSSL_INIT_LOAD_CONFIG, nullptr);
+      SelfTestStep("T5-main", "OPENSSL_init_crypto", crc);
+      SelfTestStep("T5-main", "pre OPENSSL_init_ssl", 0);
+      const int src = OPENSSL_init_ssl(0, nullptr);
+      SelfTestStep("T5-main", "OPENSSL_init_ssl", src);
+      OnThread("T5-thr1M", [] {
+        SelfTestStep("T5-thr1M", "cpu", svcGetCurrentProcessorNumber());
+        SelfTestRun("T5-thr1M");
+      });
+      return;
+    }
+    default:
+      break;
+  }
+  // Mode 1 / 2 (rev 20/21 behaviour).
+  if (mode != 2)
+    SelfTestRun("main");
+  OnThread("thr1M", [] { SelfTestRun("thr1M"); });
+  pthread_attr_t attr;
+  pthread_attr_init(&attr);
+  pthread_attr_setstacksize(&attr, 256 * 1024);
+  pthread_t th;
+  const int rc = pthread_create(&th, &attr, SelfTest256K, nullptr);
+  pthread_attr_destroy(&attr);
+  SelfTestStep("thr256K", "pthread_create", rc);
+  if (rc == 0)
+  {
+    pthread_join(th, nullptr);
+    SelfTestStep("thr256K", "joined", 0);
+  }
+}
+
+#endif // SWITCH2_DIAG
+
+// ----------------------------------------------------------------------------------------------
+// OpenSSL warm-up (rev 21, always on unless the self-test flag starts with "T"), on the main
+// thread before Kodi starts. rev 20 found that the first construction of an OpenSSL method from an
+// add-on thread kills the process, while methods first built on the main thread work from any
+// thread. So every algorithm of every operation class is fetched once here into the default
+// library context's method store:
+//  * names: <class>_do_all_provided(NULL, cb, &set) with <class>_get0_name() (the store loader:
+//    OSSL_STORE_LOADER_names_do_all, first name), de-duplicated;
+//  * then <class>_fetch(NULL, name, NULL) for each name and <class>_free() of the returned
+//    reference (the store keeps its own).
+// Then the main-thread DRBG (RAND_bytes), a TLS client SSL_CTX with the CA bundle and one SSL, and
+// EC P-256 and X25519 key generation. One boot.txt line per class:
+// "<ms> OSSL-WARM <class> n=<fetched> fail=<failed> names=<enumerated> ms=<duration>", and
+// "OSSL-WARM done ms=". Failures are logged, never fatal.
+// ----------------------------------------------------------------------------------------------
+#include <openssl/decoder.h>
+#include <openssl/encoder.h>
+#include <openssl/err.h>
+#include <openssl/kdf.h>
+#include <openssl/rand.h>
+#include <openssl/ssl.h>
+#include <openssl/store.h>
+
+#include <cstdio>
+#include <set>
+#include <string>
+
+namespace
+{
+unsigned long long NowMs()
+{
+  return armTicksToNs(armGetSystemTick()) / 1000000ULL;
+}
+
+void WarmLog(const char* cls, long ok, long fail, long names, unsigned long long ms)
+{
+  // Release build: only a class with failures gets a line; the diagnostics build logs every class.
+  if (!SWITCH2_DIAG && fail == 0)
+    return;
+  char line[200];
+  const int n = std::snprintf(line, sizeof(line), "%llu OSSL-WARM %s n=%ld fail=%ld names=%ld ms=%llu\n",
+                              NowMs(), cls, ok, fail, names, ms);
+  if (n > 0)
+    Switch2RawAppend("/switch/kodi/boot.txt", line,
+                     static_cast<size_t>(n) < sizeof(line) ? static_cast<size_t>(n) : sizeof(line) - 1);
+}
+
+using NameSet = std::set<std::string>;
+
+void AddName(const char* name, NameSet* set)
+{
+  if (name)
+    set->insert(name);
+}
+} // namespace
+
+#define S2_WARM(T, PFX) \
+  do \
+  { \
+    const unsigned long long t0 = NowMs(); \
+    NameSet names; \
+    PFX##_do_all_provided( \
+        nullptr, [](T* m, void* arg) { AddName(PFX##_get0_name(m), static_cast<NameSet*>(arg)); }, \
+        &names); \
+    long ok = 0, fail = 0; \
+    for (const auto& n : names) \
+    { \
+      T* m = PFX##_fetch(nullptr, n.c_str(), nullptr); \
+      if (m) \
+      { \
+        ++ok; \
+        PFX##_free(m); \
+      } \
+      else \
+        ++fail; \
+    } \
+    ERR_clear_error(); \
+    WarmLog(#PFX, ok, fail, static_cast<long>(names.size()), NowMs() - t0); \
+  } while (0)
+
+extern "C" void Switch2OsslWarmUp(void)
+{
+  const unsigned long long start = NowMs();
+#if SWITCH2_DIAG
+  Switch2BootLog("OSSL-WARM start", 0);
+#endif
+  try
+  {
+    S2_WARM(EVP_MD, EVP_MD);
+    S2_WARM(EVP_CIPHER, EVP_CIPHER);
+    S2_WARM(EVP_MAC, EVP_MAC);
+    S2_WARM(EVP_KDF, EVP_KDF);
+    S2_WARM(EVP_RAND, EVP_RAND);
+    S2_WARM(EVP_KEYMGMT, EVP_KEYMGMT);
+    S2_WARM(EVP_KEYEXCH, EVP_KEYEXCH);
+    S2_WARM(EVP_SIGNATURE, EVP_SIGNATURE);
+    S2_WARM(EVP_ASYM_CIPHER, EVP_ASYM_CIPHER);
+    S2_WARM(EVP_KEM, EVP_KEM);
+    S2_WARM(OSSL_ENCODER, OSSL_ENCODER);
+    S2_WARM(OSSL_DECODER, OSSL_DECODER);
+    {
+      const unsigned long long t0 = NowMs();
+      NameSet names;
+      OSSL_STORE_LOADER_do_all_provided(
+          nullptr,
+          [](OSSL_STORE_LOADER* l, void* arg) {
+            // First name only (names_do_all may report several aliases).
+            struct First
+            {
+              bool done;
+              NameSet* set;
+            } first{false, static_cast<NameSet*>(arg)};
+            OSSL_STORE_LOADER_names_do_all(
+                l,
+                [](const char* name, void* data) {
+                  auto* f = static_cast<First*>(data);
+                  if (!f->done)
+                  {
+                    AddName(name, f->set);
+                    f->done = true;
+                  }
+                },
+                &first);
+          },
+          &names);
+      long ok = 0, fail = 0;
+      for (const auto& n : names)
+      {
+        OSSL_STORE_LOADER* l = OSSL_STORE_LOADER_fetch(nullptr, n.c_str(), nullptr);
+        if (l)
+        {
+          ++ok;
+          OSSL_STORE_LOADER_free(l);
+        }
+        else
+          ++fail;
+      }
+      ERR_clear_error();
+      WarmLog("OSSL_STORE_LOADER", ok, fail, static_cast<long>(names.size()), NowMs() - t0);
+    }
+    {
+      const unsigned long long t0 = NowMs();
+      unsigned char buf[16];
+      const int rc = RAND_bytes(buf, sizeof(buf));
+      WarmLog("RAND_bytes", rc == 1, rc != 1, 1, NowMs() - t0);
+    }
+    {
+      const unsigned long long t0 = NowMs();
+      long ok = 0, fail = 0;
+      SSL_CTX* ctx = SSL_CTX_new(TLS_client_method());
+      (ctx ? ok : fail)++;
+      if (ctx)
+      {
+        (SSL_CTX_load_verify_locations(ctx, "/switch/kodi/system/certs/cacert.pem", nullptr) == 1
+             ? ok
+             : fail)++;
+        SSL* ssl = SSL_new(ctx);
+        (ssl ? ok : fail)++;
+        SSL_free(ssl);
+        SSL_CTX_free(ctx);
+      }
+      ERR_clear_error();
+      WarmLog("SSL_CTX+verify+SSL", ok, fail, 3, NowMs() - t0);
+    }
+    {
+      const unsigned long long t0 = NowMs();
+      long ok = 0, fail = 0;
+      EVP_PKEY* ec = EVP_PKEY_Q_keygen(nullptr, nullptr, "EC", "P-256");
+      (ec ? ok : fail)++;
+      EVP_PKEY_free(ec);
+      EVP_PKEY* x = EVP_PKEY_Q_keygen(nullptr, nullptr, "X25519");
+      (x ? ok : fail)++;
+      EVP_PKEY_free(x);
+      ERR_clear_error();
+      WarmLog("keygen(P-256,X25519)", ok, fail, 2, NowMs() - t0);
+    }
+  }
+  catch (...)
+  {
+    Switch2BootLog("OSSL-WARM exception", 0);
+  }
+  Switch2BootLog("OSSL-WARM done ms", static_cast<long long>(NowMs() - start));
+}
+
