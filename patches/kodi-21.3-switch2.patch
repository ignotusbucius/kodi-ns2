+ *  This file is part of Kodi - https://kodi.tv
+ *
+ *  SPDX-License-Identifier: GPL-2.0-or-later
+ *  See LICENSES/README.md for more information.
+ */
+
+#pragma once
+
+#include "storage/IStorageProvider.h"
+
+#include <mutex>
+#include <set>
+#include <utility>
+#include <string>
+#include <vector>
+
+// The SD card is the one local drive. Removable drives: the read-only FAT/exFAT volumes of a USB drive
+// that usbfs2 mounted at startup (platform/switch2/UsbStorage.h), as special://usbN/ (N = umsN:).
+class CSwitch2StorageProvider : public IStorageProvider
+{
+public:
+  void Initialize() override {}
+  void Stop() override {}
+  void GetLocalDrives(VECSOURCES& localDrives) override;
+  void GetRemovableDrives(VECSOURCES& removableDrives) override;
+  bool Eject(const std::string& mountpath) override;
+  std::vector<std::string> GetDiskUsage() override;
+  bool PumpDriveChangeEvents(IStorageEventsCallback* callback) override;
+
+private:
+  struct Listed
+  {
+    unsigned attachment;
+    std::string path;
+    std::string label;
+  };
+  unsigned m_generation = 0;
+  std::vector<Listed> m_listed; // what the last PumpDriveChangeEvents saw
+  // Volumes the user hid with "Remove safely" (Eject): their removal is reported as safe; every other
+  // removal (usbfs2 marked the drive dead: a failed transfer) as unsafe.
+  std::mutex m_hiddenLock;
+  std::set<std::pair<unsigned, std::string>> m_hidden;
+};
