+CDVDVideoCodecSwitch2::~CDVDVideoCodecSwitch2()
+{
+  m_sw.reset();
+  if (m_created)
+    CLog::Log(LOGINFO,
+              "switch2 hw decode: {} closed: {} frames, {} submit retries, {} failed GetFrame",
+              m_codecName, m_framesTotal, m_submitRetries, m_getFrameFails);
+  CloseDecoder();
+  ClearQueues();
+  if (m_bsf)
+    av_bsf_free(&m_bsf);
+  if (m_pkt)
+    av_packet_free(&m_pkt);
+  if (m_claimed)
+    g_inUse.store(false);
+}
+
+bool CDVDVideoCodecSwitch2::Open(CDVDStreamInfo& hints, CDVDCodecOptions& options)
+{
+  m_hints = hints;
+  m_codecName = CodecName(hints.codec);
+
+  auto refuse = [&](const std::string& reason) {
+    CLog::Log(LOGINFO, "switch2 hw decode: {} {}x{} fallback({})", m_codecName, hints.width,
+              hints.height, reason);
+    return false;
+  };
+
+  const auto settings = CServiceBroker::GetSettingsComponent()
+                            ? CServiceBroker::GetSettingsComponent()->GetSettings()
+                            : nullptr;
+  if (settings && !settings->GetBool(CSettings::SETTING_VIDEOPLAYER_USESWITCH2HWDECODE))
+    return refuse("setting off");
+
+  SWITCH2HW::StreamFacts f;
+  switch (hints.codec)
+  {
+    case AV_CODEC_ID_H264:
+      f.codec = SWITCH2HW::Codec::H264;
+      m_viddecCodec = ViddecCodec_H264;
+      break;
+    case AV_CODEC_ID_VP9:
+      f.codec = SWITCH2HW::Codec::VP9;
+      m_viddecCodec = ViddecCodec_Vp9;
+      break;
+    case AV_CODEC_ID_AV1:
+      f.codec = SWITCH2HW::Codec::AV1;
+      m_viddecCodec = ViddecCodec_Av1;
+      break;
+    case AV_CODEC_ID_VP8:
+      f.codec = SWITCH2HW::Codec::VP8;
+      m_viddecCodec = ViddecCodec_Vp8;
+      break;
+    default:
+      return false; // not ours: no log line for every MPEG-2/HEVC/... open
+  }
+  f.width = hints.width;
+  f.height = hints.height;
+  f.interlaced = hints.interlaced;
+  f.encrypted = hints.cryptoSession != nullptr;
+  f.bitDepth = hints.bitdepth;
+  if (hints.fpsrate > 0 && hints.fpsscale > 0)
+    f.fps = static_cast<double>(hints.fpsrate) / hints.fpsscale;
+  const uint8_t* ex = hints.extradata.GetData();
+  const size_t exSize = hints.extradata.GetSize();
+  if (f.codec == SWITCH2HW::Codec::H264)
+  {
+    const SWITCH2HW::SpsInfo sps = SWITCH2HW::FindSps(ex, exSize);
+    f.haveConfig = sps.valid;
+    if (sps.valid)
+    {
+      f.chroma420 = sps.chromaFormatIdc == 1;
+      f.bitDepth = static_cast<int>(std::max(sps.bitDepthLuma, sps.bitDepthChroma));
+      f.interlaced = f.interlaced || !sps.frameMbsOnly; // PAFF/MBAFF possible
+    }
+  }
+  else if (f.codec == SWITCH2HW::Codec::VP9)
+  {
+    // Profile 0 = 8-bit 4:2:0 (1: 4:2:2/4:4:4, 2/3: 10/12-bit).
+    f.chroma420 = hints.profile == FF_PROFILE_VP9_0 ||
+                  (hints.profile == FF_PROFILE_UNKNOWN && (hints.bitdepth == 0 || hints.bitdepth == 8));
+  }
+  else if (f.codec == SWITCH2HW::Codec::AV1)
+  {
+    int depth = 0;
+    bool c420 = true;
+    if (SWITCH2HW::ParseAv1C(ex, exSize, depth, c420))
+    {
+      f.bitDepth = depth;
+      f.chroma420 = c420;
+    }
+    else
+      f.haveConfig = hints.bitdepth == 8;
+  }
+  const std::string reason = SWITCH2HW::RouteReason(f);
+  if (!reason.empty())
+    return refuse(reason);
+  if (f.codec != SWITCH2HW::Codec::H264 && Switch2FlagFile("hwdec-h264only.flag"))
+    return refuse("codec not enabled (hwdec-h264only.flag)");
+  const ColorChoice colour = ChooseColorPolicy(hints);
+  if (colour.policy == 0)
+    return refuse("BT.2020/HDR colour (" + colour.why + ")");
+  m_colorPolicy = colour.policy;
+  m_colorWhy = colour.why;
+
+  LogLastWork();
+
+  if (g_hwUnavailable.load())
+    return refuse("hardware decoder unavailable this run");
+  if (!g_frameRegistered.load())
+    return refuse("frame mode not registered");
+  if (!(g_permittedMode.load() & 2))
+    return refuse("frame mode " + Hex(static_cast<Result>(g_permittedMode.load())));
+
+  if (SWITCH2HW::SlotTryClaim(g_inUse))
+    m_claimed = true;
+  else
+  {
+    // Rev 39c handover: another stream's decoder is still open (an adaptive quality/stream switch
+    // opens the new codec before the old one is destroyed). Claim the slot at the first packet.
+    m_handover = true;
+    CLog::Log(LOGINFO,
+              "switch2 hw decode: {} {}x{} handover pending: the previous decoder is still open; "
+              "the slot is claimed at the first packet",
+              m_codecName, hints.width, hints.height);
+  }
+
+  const char* bsfName = f.codec == SWITCH2HW::Codec::H264  ? "h264_mp4toannexb"
+                        : f.codec == SWITCH2HW::Codec::VP9 ? "vp9_superframe_split"
+                                                           : nullptr;
+  if (bsfName)
+  {
+    const AVBitStreamFilter* filter = av_bsf_get_by_name(bsfName);
+    bool ok = filter && av_bsf_alloc(filter, &m_bsf) == 0;
+    if (ok)
+    {
+      m_bsf->par_in->codec_type = AVMEDIA_TYPE_VIDEO;
+      m_bsf->par_in->codec_id = hints.codec;
+      m_bsf->par_in->width = hints.width;
+      m_bsf->par_in->height = hints.height;
+      if (exSize > 0)
+      {
+        m_bsf->par_in->extradata =
+            static_cast<uint8_t*>(av_mallocz(exSize + AV_INPUT_BUFFER_PADDING_SIZE));
+        ok = m_bsf->par_in->extradata != nullptr;
+        if (ok)
+        {
+          memcpy(m_bsf->par_in->extradata, ex, exSize);
+          m_bsf->par_in->extradata_size = static_cast<int>(exSize);
+        }
+      }
+      m_bsf->time_base_in = AVRational{1, 1000000000};
+      ok = ok && av_bsf_init(m_bsf) == 0;
+    }
+    if (ok && f.codec == SWITCH2HW::Codec::H264 && m_bsf->par_out->extradata_size > 0)
+      m_codecConfig.assign(m_bsf->par_out->extradata,
+                           m_bsf->par_out->extradata + m_bsf->par_out->extradata_size);
+    if (!ok)
+    {
+      if (m_bsf)
+        av_bsf_free(&m_bsf);
+      if (m_claimed)
+        g_inUse.store(false);
+      m_claimed = false;
+      m_handover = false;
+      return refuse(std::string("bitstream filter ") + bsfName);
+    }
+  }
+  m_pkt = av_packet_alloc();
+  if (!m_pkt)
+  {
+    if (m_claimed)
+      g_inUse.store(false);
+    m_claimed = false;
+    m_handover = false;
+    return refuse("no packet");
+  }
+
+  m_cfgWidth = static_cast<unsigned>(f.codec == SWITCH2HW::Codec::H264 ? SWITCH2HW::Align16(f.width)
+                                                                       : (f.width + 1) & ~1);
+  m_cfgHeight = static_cast<unsigned>(f.codec == SWITCH2HW::Codec::H264 ? SWITCH2HW::Align16(f.height)
+                                                                        : (f.height + 1) & ~1);
+  m_frameRate = (f.fps >= 1 && f.fps <= VIDEO_DECODER_MAX_FRAME_RATE)
+                    ? static_cast<unsigned>(std::lround(f.fps))
+                    : 30;
+
+  m_name = std::string("switch2-hw-") + m_codecName;
+  m_processInfo.SetVideoDecoderName(m_name, true);
+  m_processInfo.SetVideoPixelFormat("nv12");
+  m_processInfo.SetVideoDimensions(hints.width, hints.height);
+  m_processInfo.SetVideoDeintMethod("none");
+
+  CLog::Log(LOGINFO, "switch2 hw decode: {} {}x{} on (configured {}x{} at {} fps)", m_codecName,
+            hints.width, hints.height, m_cfgWidth, m_cfgHeight, m_frameRate);
+  return true;
+}
+
+void CDVDVideoCodecSwitch2::LogLastWork()
+{
+  // The previous decoder's work memory, a few seconds after its close (see WorkReturned).
+  std::lock_guard<std::mutex> lock(g_memMutex);
+  if (!g_lastWorkChecked && g_lastWork)
+  {
+    const bool back = WorkReturned(g_lastWork);
+    CLog::Log(LOGINFO,
+              "switch2 hw decode: {:.1f} s after the last close: used memory {} bytes, work "
+              "memory ({} MiB) {}",
+              static_cast<double>(NowNs() - g_lastCloseNs) / 1e9, UsedMemory(),
+              g_lastWorkSize >> 20, back ? "given back" : "still held by the service");
+    g_lastWorkChecked = true;
+  }
+}
+
+// Rev 39c: a codec opened during another decoder's life (handover pending) takes the slot here, on
+// the VideoPlayerVideo thread at its first packet. CVideoPlayerVideo::OpenStream destroyed the old
+// codec (decoder closed, work memory checked, slot released) just before, so the slot is normally
+// free at once; a release still in flight elsewhere gets kHandoverWaitMs. If the old decoder's work
+// memory was lost (g_hwUnavailable) or the slot stays taken, this stream decodes in software.
+bool CDVDVideoCodecSwitch2::ClaimAfterHandover()
+{
+  unsigned waitedMs = 0;
+  const bool ok = SWITCH2HW::SlotClaimWithin(
+      g_inUse, kHandoverWaitMs, [] { return NowNs() / 1000000ULL; },
+      [](unsigned ms) { std::this_thread::sleep_for(std::chrono::milliseconds(ms)); },
+      [] { return g_hwUnavailable.load(); }, waitedMs);
+  m_handover = false;
+  if (!ok)
+  {
+    m_failReason = g_hwUnavailable.load()
+                       ? "handover: hardware decoder unavailable this run"
+                       : "handover: the previous decoder still open after " +
+                             std::to_string(waitedMs) + " ms";
+    Switch2DiagLog("hwdec: handover %s failed after %u ms", m_codecName.c_str(), waitedMs);
+    return false;
+  }
+  m_claimed = true;
+  LogLastWork();
+  CLog::Log(LOGINFO, "switch2 hw decode: {} {}x{} handover: decoder slot taken after {} ms",
+            m_codecName, m_hints.width, m_hints.height, waitedMs);
+  Switch2DiagLog("hwdec: handover %s %dx%d slot taken after %u ms", m_codecName.c_str(),
+                 m_hints.width, m_hints.height, waitedMs);
+  return true;
+}
+
+bool CDVDVideoCodecSwitch2::CreateDecoder()
+{
+  {
+    // One viddecInitialize reference for the whole process (see the top of the file).
+    std::lock_guard<std::mutex> lock(g_creatorMutex);
+    if (g_creatorReleased)
+    {
+      m_failReason = "shutting down";
+      return false;
+    }
+    if (!g_creatorPinned)
+    {
+      const Result rc = viddecInitialize();
+      Switch2DiagLog("hwdec: creator pin viddecInitialize rc=0x%x", static_cast<unsigned>(rc));
+      if (R_FAILED(rc))
+      {
+        // The creator could not be opened: no hardware decoding for the rest of the run.
+        g_hwUnavailable.store(true);
+        m_failReason = "viddecInitialize rc=" + Hex(rc);
+        return false;
+      }
+      g_creatorPinned = true;
+    }
+  }
+
+  auto* d = new (std::nothrow) VideoDecoder();
+  if (!d)
+  {
+    m_failReason = "no memory";
+    return false;
+  }
+  VideoDecoderConfig cfg = {};
+  cfg.codec = static_cast<ViddecCodec>(m_viddecCodec);
+  cfg.width = m_cfgWidth;
+  cfg.height = m_cfgHeight;
+  cfg.image_count = 0;
+  cfg.frame_rate = m_frameRate;
+  cfg.tiling = static_cast<ViddecTilingMode>(0);
+  cfg.color_policy = m_colorPolicy; // from the stream's colour tags (ChooseColorPolicy)
+  cfg.max_sample_size = 16ULL * 1024 * 1024;
+  cfg.codec_config = m_codecConfig.empty() ? nullptr : m_codecConfig.data();
+  cfg.codec_config_size = m_codecConfig.size();
+  const unsigned long long usedBefore = UsedMemory();
+  const uint64_t t0 = NowNs();
+  const Result rc = videoDecoderCreate(d, &cfg);
+  const uint64_t ms = (NowNs() - t0) / 1000000ULL;
+  Switch2DiagLog("hwdec: videoDecoderCreate %s %ux%u fps=%u color_policy=%u config=%zu rc=0x%x "
+                 "%llu ms",
+                 m_codecName.c_str(), m_cfgWidth, m_cfgHeight, m_frameRate, m_colorPolicy,
+                 m_codecConfig.size(), static_cast<unsigned>(rc), static_cast<unsigned long long>(ms));
+  CLog::Log(LOGINFO, "switch2 hw decode: {} color_policy {} (from {})", m_codecName, m_colorPolicy,
+            m_colorWhy);
+  if (R_FAILED(rc))
+  {
+    delete d; // videoDecoderCreate closed what it had opened
+    m_failReason = "create rc=" + Hex(rc);
+    return false;
+  }
+  m_decoder = d;
+  m_created = true;
+  m_usedBeforeCreate = usedBefore;
+  CLog::Log(LOGINFO,
+            "switch2 hw decode: {} decoder created in {} ms (work {} MiB, {} images; used memory "
+            "{} -> {} bytes)",
+            m_codecName, ms, d->work_size >> 20, d->image_count, usedBefore, UsedMemory());
+  return true;
+}
+
+void CDVDVideoCodecSwitch2::CloseDecoder()
+{
+  if (!m_decoder)
+    return;
+  auto* d = static_cast<VideoDecoder*>(m_decoder);
+  if (m_created)
+  {
+    const uintptr_t work = reinterpret_cast<uintptr_t>(d->work);
+    const uint64_t workSize = d->work_size;
+    videoDecoderClose(d); // waits up to 2 s for the work memory, frees it only if given back
+    const bool back = work && WorkReturned(work);
+    CLog::Log(LOGINFO,
+              "switch2 hw decode: {} decoder closed: used memory {} (before create {}) bytes, work "
+              "memory ({} MiB) {}",
+              m_codecName, UsedMemory(), m_usedBeforeCreate, workSize >> 20,
+              back ? "given back and freed" : "NOT given back: lost for this run");
+    Switch2DiagLog("hwdec: close work=%s size=%llu MiB", back ? "returned" : "LOST",
+                   static_cast<unsigned long long>(workSize >> 20));
+    if (!back)
+    {
+      // More than half the work size (all of it) stays lost: no second decoder this run.
+      g_hwUnavailable.store(true);
+      CLog::Log(LOGWARNING, "switch2 hw decode: hardware decoding off for the rest of this run "
+                            "(decoder work memory not returned)");
+    }
+    std::lock_guard<std::mutex> lock(g_memMutex);
+    g_lastWork = work;
+    g_lastWorkSize = workSize;
+    g_lastCloseNs = NowNs();
+    g_lastWorkChecked = false;
+  }
+  delete d;
+  m_decoder = nullptr;
+  m_created = false;
+}
+
+void CDVDVideoCodecSwitch2::ClearQueues()
+{
+  for (auto& r : m_ready)
+    if (r.buffer)
+      r.buffer->Release();
+  m_ready.clear();
+  m_toSubmit.clear();
+  m_haveHeld = false;
+  m_held = Pending();
+  m_eosQueued = false;
+  m_eosSeen = false;
+  m_drainStart = 0;
+}
+
+void CDVDVideoCodecSwitch2::Fail(const std::string& reason)
+{
+  if (m_failed)
+    return;
+  m_failed = true;
+  m_failReason = reason;
+  CLog::Log(LOGWARNING, "switch2 hw decode: {} stops: {}", m_codecName, reason);
+}
+
+bool CDVDVideoCodecSwitch2::SwitchToSoftware(const std::string& reason)
+{
+  CLog::Log(LOGINFO, "switch2 hw decode: {} {}x{} fallback({})", m_codecName, m_hints.width,
+            m_hints.height, reason);
+  CloseDecoder();
+  ClearQueues();
+  if (m_claimed)
+  {
+    g_inUse.store(false);
+    m_claimed = false;
+  }
+  m_failed = false;
+  auto sw = std::make_unique<CDVDVideoCodecFFmpeg>(m_processInfo);
+  CDVDStreamInfo hints(m_hints);
+  CDVDCodecOptions options;
+  if (!sw->Open(hints, options))
+  {
+    CLog::Log(LOGERROR, "switch2 hw decode: software decoder did not open either");
+    m_dead = true;
+    return false;
+  }
+  m_sw = std::move(sw);
+  m_sw->SetCodecControl(m_codecFlags & ~DVD_CODEC_CTRL_SWITCH2_STALL);
+  return true;
+}
+
+bool CDVDVideoCodecSwitch2::Filter(const DemuxPacket& packet, std::deque<Pending>& out)
+{
+  double ts = packet.pts != DVD_NOPTS_VALUE ? packet.pts : packet.dts;
+  int64_t ns = 0;
+  if (ts == DVD_NOPTS_VALUE)
+    m_sawNoPts = true;
+  else
+    ns = static_cast<int64_t>(std::llround(ts * 1000.0)); // DVD_TIME_BASE = microseconds
+
+  if (!m_bsf)
+  {
+    Pending p;
+    p.data.assign(packet.pData, packet.pData + packet.iSize);
+    p.ns = ns;
+    out.push_back(std::move(p));
+    return true;
+  }
+  av_packet_unref(m_pkt);
+  if (av_new_packet(m_pkt, packet.iSize) < 0)
+    return false;
+  memcpy(m_pkt->data, packet.pData, packet.iSize);
+  m_pkt->pts = ns;
+  if (av_bsf_send_packet(m_bsf, m_pkt) < 0)
+  {
+    av_packet_unref(m_pkt);
+    return false;
+  }
+  for (;;)
+  {
+    const int r = av_bsf_receive_packet(m_bsf, m_pkt);
+    if (r == AVERROR(EAGAIN) || r == AVERROR_EOF)
+      break;
+    if (r < 0)
+      return false;
+    Pending p;
+    p.data.assign(m_pkt->data, m_pkt->data + m_pkt->size);
+    p.ns = m_pkt->pts != AV_NOPTS_VALUE ? m_pkt->pts : ns;
+    out.push_back(std::move(p));
+    av_packet_unref(m_pkt);
+  }
+  return true;
+}
+
+void CDVDVideoCodecSwitch2::PumpSubmit()
+{
+  auto* d = static_cast<VideoDecoder*>(m_decoder);
+  unsigned tries = 0;
+  while (d && !m_failed && !m_toSubmit.empty())
+  {
+    Pending& p = m_toSubmit.front();
+    const Result rc =
+        videoDecoderSubmit(d, p.data.data(), p.data.size(), p.ns, p.eos, kSubmitTimeoutNs);
+    if (R_SUCCEEDED(rc))
+    {
+      m_submittedMax = std::max(m_submittedMax, p.ns);
+      m_toSubmit.pop_front();
+      ++m_submittedSinceFlush;
+      m_submitStuckTries = 0;
+      continue;
+    }
+    if (rc == KERNELRESULT(TimedOut) || rc == VIDDEC_RESULT_SUBMIT_BUSY)
+    {
+      ++m_submitRetries;
+      ++m_diagRetries;
+      if (++m_submitStuckTries > kSubmitStuckLimit)
+      {
+        Fail("decoder takes no input");
+        return;
+      }
+      TakeFrames(0);
+      if (++tries >= kSubmitTriesPerCall)
+        return; // the next AddData/GetPicture goes on
+      continue;
+    }
+    Fail("submit rc=" + Hex(rc));
+    return;
+  }
+}
+
+bool CDVDVideoCodecSwitch2::CopyOut(const void* frame, Ready& out)
+{
+  const auto* f = static_cast<const VideoFrame*>(frame);
+  auto* d = static_cast<VideoDecoder*>(m_decoder);
+  const int w = static_cast<int>(f->width) & ~1;
+  const int h = static_cast<int>(f->height) & ~1;
+  if (w <= 0 || h <= 0)
+    return false;
+  const int size = w * h + 2 * ((w / 2) * (h / 2));
+  CVideoBuffer* buf = m_processInfo.GetVideoBufferManager().Get(AV_PIX_FMT_YUV420P, size, nullptr);
+  if (!buf)
+    return false;
+  int strides[YuvImage::MAX_PLANES] = {w, w / 2, w / 2};
+  buf->SetDimensions(w, h, strides);
+  uint8_t* planes[YuvImage::MAX_PLANES] = {};
+  buf->GetPlanes(planes);
+  if (!planes[0] || !planes[1] || !planes[2])
+  {
+    buf->Release();
+    return false;
+  }
+  const uint64_t t0 = NowNs();
+  if (f->tiling == ViddecTilingMode_PitchLinear && f->planes[0] && f->planes[1])
+  {
+    SWITCH2HW::Nv12ToYuv420p(f->planes[0], f->pitches[0], f->planes[1], f->pitches[1], w, h,
+                             planes[0], strides[0], planes[1], strides[1], planes[2], strides[2]);
+  }
+  else
+  {
+    // Block-linear (AV1): libounce converts into pitch-linear NV12; Y straight into the buffer.
+    const size_t uvSize = static_cast<size_t>(w) * (h / 2);
+    if (m_scratch.size() < uvSize)
+      m_scratch.resize(uvSize);
+    const Result rc = videoDecoderCopyFrame(d, f, planes[0], static_cast<size_t>(strides[0]),
+                                            m_scratch.data(), static_cast<size_t>(w));
+    if (R_FAILED(rc))
+    {
+      buf->Release();
+      return false;
+    }
+    SWITCH2HW::Nv12ToYuv420p(nullptr, 0, m_scratch.data(), static_cast<size_t>(w), w, h, planes[0],
+                             strides[0], planes[1], strides[1], planes[2], strides[2], false);
+  }
+  m_diagCopyMs += static_cast<double>(NowNs() - t0) / 1e6;
+  out.buffer = buf;
+  out.ns = f->timestamp_ns;
+  out.width = static_cast<unsigned>(w);
+  out.height = static_cast<unsigned>(h);
+  return true;
+}
+
+void CDVDVideoCodecSwitch2::TakeFrames(uint64_t timeoutNs)
+{
+  auto* d = static_cast<VideoDecoder*>(m_decoder);
+  while (d && !m_failed)
+  {
+    VideoFrame f;
+    const Result rc = videoDecoderGetFrame(d, &f, timeoutNs);
+    timeoutNs = 0;
+    if (rc == KERNELRESULT(TimedOut))
+      break;
+    if (R_FAILED(rc))
+    {
+      // The image had no frame; libounce gave it back to the decoder.
+      ++m_getFrameFails;
+      if (++m_getFrameFailsInRow >= kGetFrameFailLimit)
+        Fail("GetFrame rc=" + Hex(rc) + " " + std::to_string(m_getFrameFailsInRow) + " times");
+      break;
+    }
+    m_getFrameFailsInRow = 0;
+    m_stallWatch = false;
+    if (f.end_of_stream)
+      m_eosSeen = true;
+    // A frame stamped after every submitted sample is not one of ours (KaiVideo).
+    if (m_submittedMax != INT64_MIN && f.timestamp_ns > m_submittedMax)
+    {
+      videoDecoderReleaseFrame(d, &f);
+      continue;
+    }
+    Ready r{};
+    const bool ok = CopyOut(&f, r);
+    videoDecoderReleaseFrame(d, &f);
+    if (ok)
+    {
+      m_ready.push_back(r);
+      ++m_framesTotal;
+      ++m_framesSinceFlush;
+      ++m_diagFrames;
+    }
+  }
+  if (!m_failed && m_stallWatch && m_framesSinceFlush == 0 && m_submittedSinceFlush >= kStallSamples)
+    Fail("no frame after " + std::to_string(m_submittedSinceFlush) + " samples");
+}
+
+void CDVDVideoCodecSwitch2::DiagTick()
+{
+#if SWITCH2_DIAG
+  const uint64_t now = NowNs();
+  if (m_diagT0 == 0)
+    m_diagT0 = now;
+  if (now - m_diagT0 < 1000000000ULL)
+    return;
+  const double secs = static_cast<double>(now - m_diagT0) / 1e9;
+  Switch2DiagLog("hwdec %s fps=%.1f frames=%u retries=%u getframe_fail=%u copy_ms=%.2f ready=%zu "
+                 "queued=%zu",
+                 m_codecName.c_str(), m_diagFrames / secs, m_framesTotal, m_diagRetries,
+                 m_getFrameFails, m_diagFrames ? m_diagCopyMs / m_diagFrames : 0.0, m_ready.size(),
+                 m_toSubmit.size());
+  m_diagT0 = now;
+  m_diagFrames = 0;
+  m_diagRetries = 0;
+  m_diagCopyMs = 0;
+#endif
+}
+
+bool CDVDVideoCodecSwitch2::AddData(const DemuxPacket& packet)
+{
+  if (m_sw)
+    return m_sw->AddData(packet);
+  if (m_dead)
+    return true; // dropped: nothing can decode it
+  if (!m_created)
+  {
+    if ((m_handover && !ClaimAfterHandover()) || !CreateDecoder())
+    {
+      if (!SwitchToSoftware(m_failReason))
+        return true;
+      return m_sw->AddData(packet);
+    }
+  }
+  if (m_failed)
+    return true; // VideoPlayer keeps these packets and sends them again after VC_REOPEN
+  if (!packet.pData || packet.iSize <= 0)
+    return true;
+
+  auto* d = static_cast<VideoDecoder*>(m_decoder);
+  if (m_needFlush)
+  {
+    // The decoder saw end_of_stream (a drain while the stream went on): start it again.
+    videoDecoderFlush(d);
+    ClearQueues();
+    m_needFlush = false;
+    m_submittedMax = INT64_MIN;
+    m_submittedSinceFlush = 0;
+    m_framesSinceFlush = 0;
+    m_stallWatch = false; // the stream goes on mid-GOP: no frame until the next keyframe is normal
+  }
+
+  PumpSubmit();
+  if (m_failed || !m_toSubmit.empty() || m_ready.size() >= kMaxReady)
+    return m_failed; // not taken: VideoPlayer gets the pictures, then gives this packet again
+
+  std::deque<Pending> samples;
+  if (!Filter(packet, samples))
+  {
+    CLog::Log(LOGDEBUG, "switch2 hw decode: bitstream filter dropped a packet");
+    return true;
+  }
+  for (auto& s : samples)
+  {
+    if (m_haveHeld)
+      m_toSubmit.push_back(std::move(m_held));
+    m_held = std::move(s);
+    m_haveHeld = true;
+  }
+  PumpSubmit();
+  DiagTick();
+  return true;
+}
+
+void CDVDVideoCodecSwitch2::Reset()
+{
+  if (m_sw)
+  {
+    m_sw->Reset();
+    return;
+  }
+  if (m_created)
+    videoDecoderFlush(static_cast<VideoDecoder*>(m_decoder));
+  ClearQueues();
+  if (m_bsf)
+    av_bsf_flush(m_bsf);
+  m_needFlush = false;
+  m_submittedMax = INT64_MIN;
+  m_submittedSinceFlush = 0;
+  m_framesSinceFlush = 0;
+  m_getFrameFailsInRow = 0;
+  m_submitStuckTries = 0;
+  m_stallWatch = true; // VideoPlayer restarts at a keyframe after a flush (seek)
+}
+
+CDVDVideoCodec::VCReturn CDVDVideoCodecSwitch2::GetPicture(VideoPicture* pVideoPicture)
+{
+  if (m_sw)
+    return m_sw->GetPicture(pVideoPicture);
+  if (m_dead)
+    return VC_ERROR;
+  if (m_failed)
+    return VC_REOPEN; // VideoPlayer resends its packets and calls Reopen(): FFmpeg from here on
+  if (!m_created)
+    return VC_BUFFER;
+
+  PumpSubmit();
+  TakeFrames(0);
+
+  // A drain for a stalled demuxer (VideoPlayer's stillframe squeeze, flagged
+  // DVD_CODEC_CTRL_SWITCH2_STALL) keeps the decoder's state: no end_of_stream, so the stream goes on
+  // without a mid-GOP restart. End of file and stream changes still send end_of_stream.
+  if (m_ready.empty() && (m_codecFlags & DVD_CODEC_CTRL_DRAIN) &&
+      (m_codecFlags & DVD_CODEC_CTRL_SWITCH2_STALL) && !m_failed)
+    return VC_BUFFER;
+  if (m_ready.empty() && (m_codecFlags & DVD_CODEC_CTRL_DRAIN) && !m_failed)
+  {
+    if (!m_eosQueued && m_haveHeld)
+    {
+      m_held.eos = true;
+      m_toSubmit.push_back(std::move(m_held));
+      m_haveHeld = false;
+      m_eosQueued = true;
+      m_drainStart = NowNs();
+    }
+    if (m_eosQueued)
+    {
+      // The last frames come out only after end_of_stream: wait for them (bounded).
+      while (m_ready.empty() && !m_eosSeen && !m_failed && NowNs() - m_drainStart < kDrainWaitNs)
+      {
+        PumpSubmit();
+        TakeFrames(m_toSubmit.empty() ? 20000000ULL : 0);
+      }
+    }
+    if (m_ready.empty() && !m_failed)
+    {
+      if (m_eosQueued)
+        m_needFlush = true; // new data after this drain needs a flushed decoder
+      m_eosQueued = false;
+      m_eosSeen = false;
+      return VC_EOF;
+    }
+  }
+  if (m_failed)
+    return VC_REOPEN;
+  DiagTick();
+  if (m_ready.empty())
+    return VC_BUFFER;
+
+  Ready r = m_ready.front();
+  m_ready.pop_front();
+
+  pVideoPicture->Reset();
+  pVideoPicture->videoBuffer = r.buffer;
+  pVideoPicture->iWidth = r.width;
+  pVideoPicture->iHeight = r.height;
+  pVideoPicture->iDisplayWidth = r.width;
+  pVideoPicture->iDisplayHeight = r.height;
+  if (m_hints.aspect > 0.0)
+  {
+    pVideoPicture->iDisplayWidth = static_cast<unsigned>(std::lrint(r.height * m_hints.aspect)) & ~3u;
+    if (pVideoPicture->iDisplayWidth > r.width)
+    {
+      pVideoPicture->iDisplayWidth = r.width;
+      pVideoPicture->iDisplayHeight = static_cast<unsigned>(std::lrint(r.width / m_hints.aspect)) & ~3u;
+    }
+  }
+  pVideoPicture->pts = (m_sawNoPts && r.ns == 0) ? DVD_NOPTS_VALUE : static_cast<double>(r.ns) / 1000.0;
+  pVideoPicture->dts = DVD_NOPTS_VALUE;
+  if (pVideoPicture->pts != DVD_NOPTS_VALUE)
+    m_lastPts = pVideoPicture->pts;
+  // Rev 37c: the decoder's output is taken to be BT.709 limited whatever the input policy (it
+  // converts the input to that: finding 1561 sweep, a hypothesis until a tagged-601 flight shows
+  // it), so the renderer always gets BT.709 limited for hardware frames.
+  pVideoPicture->color_range = 0;
+  pVideoPicture->color_space = AVCOL_SPC_BT709;
+  pVideoPicture->color_primaries = AVCOL_PRI_BT709;
+  pVideoPicture->m_originalColorPrimaries = AVCOL_PRI_BT709;
+  pVideoPicture->color_transfer = AVCOL_TRC_BT709;
+  pVideoPicture->chroma_position = AVCHROMA_LOC_LEFT;
+  pVideoPicture->colorBits = 8;
+  pVideoPicture->pixelFormat = AV_PIX_FMT_YUV420P;
+  if (m_codecFlags & DVD_CODEC_CTRL_DROP)
+    pVideoPicture->iFlags |= DVP_FLAG_DROPPED;
+  return VC_PICTURE;
+}
+
+const char* CDVDVideoCodecSwitch2::GetName()
+{
+  return m_sw ? m_sw->GetName() : m_name.c_str();
+}
+
+unsigned CDVDVideoCodecSwitch2::GetConvergeCount()
+{
+  // Packets VideoPlayer keeps to send again after VC_REOPEN (a switch to software mid-stream).
+  return m_sw ? m_sw->GetConvergeCount() : 64;
+}
+
+unsigned CDVDVideoCodecSwitch2::GetAllowedReferences()
+{
+  return m_sw ? m_sw->GetAllowedReferences() : 0;
+}
+
+void CDVDVideoCodecSwitch2::SetCodecControl(int flags)
+{
+  m_codecFlags = flags;
+  if (m_sw)
+    m_sw->SetCodecControl(flags & ~DVD_CODEC_CTRL_SWITCH2_STALL);
+}
+
+void CDVDVideoCodecSwitch2::SetSpeed(int iSpeed)
+{
+  if (m_sw)
+    m_sw->SetSpeed(iSpeed);
+}
+
+bool CDVDVideoCodecSwitch2::GetCodecStats(double& pts, int& droppedFrames, int& skippedPics)
+{
+  if (m_sw)
+    return m_sw->GetCodecStats(pts, droppedFrames, skippedPics);
+  return false;
+}
+
+bool CDVDVideoCodecSwitch2::Reconfigure(CDVDStreamInfo& hints)
+{
+  // Keep this decoder only for a stream it is already configured for (same codec, size within the
+  // configuration, same codec configuration); anything else gets a new codec.
+  if (m_sw || m_dead || m_failed || hints.codec != m_hints.codec || hints.width <= 0 ||
+      hints.height <= 0 || static_cast<unsigned>(hints.width) > m_cfgWidth ||
+      static_cast<unsigned>(hints.height) > m_cfgHeight ||
+      hints.extradata.GetSize() != m_hints.extradata.GetSize() ||
+      (hints.extradata.GetSize() > 0 &&
+       memcmp(hints.extradata.GetData(), m_hints.extradata.GetData(), hints.extradata.GetSize()) != 0) ||
+      hints.cryptoSession || ChooseColorPolicy(hints).policy != m_colorPolicy)
+    return false;
+  const double aspect = hints.aspect;
+  m_hints.width = hints.width;
+  m_hints.height = hints.height;
+  m_hints.aspect = aspect;
+  m_hints.forced_aspect = hints.forced_aspect;
+  m_hints.colorSpace = hints.colorSpace;
+  m_hints.colorPrimaries = hints.colorPrimaries;
+  m_hints.colorTransferCharacteristic = hints.colorTransferCharacteristic;
+  m_processInfo.SetVideoDimensions(hints.width, hints.height);
+  CLog::Log(LOGINFO, "switch2 hw decode: {} {}x{} reconfigure: decoder kept", m_codecName,
+            hints.width, hints.height);
+  return true;
+}
+
+void CDVDVideoCodecSwitch2::Reopen()
+{
+  if (m_sw)
+  {
+    m_sw->Reopen();
+    return;
+  }
+  if (m_failed)
+    SwitchToSoftware(m_failReason);
+}
