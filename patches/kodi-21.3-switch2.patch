+# Kodi's read-only data and user data both live on the SD card.
+set(prefix ${CMAKE_BINARY_DIR}/install)
+set(CMAKE_INSTALL_PREFIX ${prefix})
+set(libdir ${prefix}/lib)
+set(bindir ${prefix}/bin)
+set(includedir ${prefix}/include)
+set(datarootdir ${prefix}/share)
+set(datadir ${datarootdir})
+# Device-less paths: Kodi (CURL::IsFullPath) and sqlite (unixFullPathname) only treat paths starting
+# with "/" as absolute. main.cpp chdirs to sdmc:/switch/kodi, so sdmc is the default device.
+set(PATH_DEFINES -DBIN_INSTALL_PATH=\"/switch/kodi\" -DINSTALL_PATH=\"/switch/kodi\")
+list(APPEND final_message "Install path on SD: sdmc:/switch/kodi")
