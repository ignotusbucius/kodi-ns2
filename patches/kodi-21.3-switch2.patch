+namespace
+{
+int CreateThread(pthread_t* thread, const pthread_attr_t* attr, void* (*start)(void*), void* arg,
+                 size_t* stackOut)
+{
+  if (attr)
+  {
+    size_t stack = 0;
+    pthread_attr_getstacksize(attr, &stack);
+    *stackOut = stack;
+    // libounce refuses (EINVAL) a stack size that is not a multiple of 4 KiB; threading.stack_size()
+    // accepts any size >= 32 KiB (enabled by python3 patch 0004 in rev 35). Round up.
+    if (stack & 0xFFF)
+    {
+      pthread_attr_t rounded = *attr;
+      *stackOut = (stack + 0xFFF) & ~static_cast<size_t>(0xFFF);
+      pthread_attr_setstacksize(&rounded, *stackOut);
+      return CountedCreate(thread, &rounded, start, arg, false);
+    }
+#if SWITCH2_DIAG
+    return CountedCreate(thread, attr, start, arg, stack == kPyThreadStack);
+#else
+    return CountedCreate(thread, attr, start, arg, false);
+#endif
+  }
+  pthread_attr_t big;
+  pthread_attr_init(&big);
+  pthread_attr_setstacksize(&big, 1u << 20);
+  *stackOut = 1u << 20;
+  const int rc = CountedCreate(thread, &big, start, arg, false);
+  pthread_attr_destroy(&big);
+  return rc;
+}
+} // namespace
